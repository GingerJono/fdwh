@inject StateService stateService
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
 
            <header class="app-header sticky @headerClass" id="header">

                <!-- Start::main-header-container -->
                <div class="main-header-container container-fluid">

                    <!-- Start::header-content-left -->
                    <div class="header-content-left">

                        <!-- Start::header-element -->
                        <div class="header-element">
                            <div class="horizontal-logo">
                                <a href="/index" class="header-logo">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/desktop-logo.png")" alt="logo" class="desktop-logo">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/toggle-dark.png")" alt="logo" class="toggle-dark">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/desktop-dark.png")" alt="logo" class="desktop-dark">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/toggle-logo.png")" alt="logo" class="toggle-logo">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/toggle-white.png")" alt="logo" class="toggle-white">
                                    <img src="@($"{NavigationManager.BaseUri}assets/images/brand-logos/desktop-white.png")" alt="logo" class="desktop-white">
                                </a>
                            </div>
                        </div>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <div class="header-element mx-lg-0 mx-2">
                            <a aria-label="Hide Sidebar"  @onclick="ToggleMenu" class="sidemenu-toggle header-link animated-arrow hor-toggle horizontal-navtoggle" data-bs-toggle="sidebar" href="javascript:void(0);"><span></span></a>
                        </div>
                        <!-- End::header-element -->    

                        <!-- Start::header-element -->
                        <div class="header-element header-search d-md-block d-none my-auto auto-complete-search">
                            <!-- Start::header-link -->
                            <input type="text" class="header-search-bar form-control" id="header-search" placeholder="Search anything here ..." spellcheck=false autocomplete="off" autocapitalize="off">
                            <a href="javascript:void(0);" class="header-search-icon border-0">
                                <i class="ri-search-line"></i>
                            </a>
                            <!-- End::header-link -->
                        </div>
                        <!-- End::header-element -->

                    </div>
                    <!-- End::header-content-left -->

                    <!-- Start::header-content-right -->
                    <ul class="header-content-right list-unstyled">

                        <!-- Start::header-element -->
                        <li class="header-element d-md-none d-block">
                            <a href="javascript:void(0);" class="header-link" data-bs-toggle="modal" data-bs-target="#header-responsive-search">
                                <!-- Start::header-link-icon -->
                                <i class="bi bi-search header-link-icon"></i>
                                <!-- End::header-link-icon -->
                            </a>  
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li>
                            <SpkDropdowns Tag="a" DropdownMainClass="header-element country-selector" DropdownClass="header-link" data-bs-auto-close="outside">
                                <ChildContent>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802" />
                                    </svg>
                                </ChildContent>
                                <ChildContent2>
                                    <ul class="main-header-dropdown dropdown-menu dropdown-menu-end" data-popper-placement="none">
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center">
                                                        <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                            <img src="@($"{NavigationManager.BaseUri}assets/images/flags/us_flag.jpg")" alt="img">
                                                        </span>
                                                        English
                                                    </div>
                                                </div>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/spain_flag.jpg")" alt="img" >
                                                </span>
                                                español
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/french_flag.jpg")" alt="img" >
                                                </span>
                                                français
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/uae_flag.jpg")" alt="img" >
                                                </span>
                                                عربي
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/germany_flag.jpg")" alt="img" >
                                                </span>
                                                Deutsch
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/china_flag.jpg")" alt="img" >
                                                </span>
                                                中国人
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/italy_flag.jpg")" alt="img" >
                                                </span>
                                                Italiano
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item d-flex align-items-center" href="javascript:void(0);">
                                                <span class="avatar avatar-rounded avatar-xs lh-1 me-2">
                                                    <img src="@($"{NavigationManager.BaseUri}assets/images/flags/russia_flag.jpg")" alt="img" >
                                                </span>
                                                Русский
                                            </a>
                                        </li>
                                    </ul>
                                </ChildContent2>
                            </SpkDropdowns>
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li class="header-element header-theme-mode" @onclick='() => colorthemeFn()'>
                            <!-- Start::header-link|layout-setting -->
                            <a href="javascript:void(0);" class="header-link layout-setting">
                                <span class="light-layout">
                                    <!-- Start::header-link-icon -->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
                                    </svg>
                                    <!-- End::header-link-icon -->
                                </span>
                                <span class="dark-layout">
                                    <!-- Start::header-link-icon -->
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
                                    </svg>
                                    <!-- End::header-link-icon -->
                                </span>
                            </a>
                            <!-- End::header-link|layout-setting -->
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li>
                            <SpkDropdowns Tag="a" DropdownMainClass="header-element cart-dropdown" DropdownClass="header-link" data-bs-auto-close="outside">
                                <!-- Start::header-link|dropdown-toggle -->
                                <ChildContent>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                                    </svg>
                                    <SpkBadge BadgeClass="bg-secondary header-icon-badge" IsRounded=true  id="cart-icon-badge">@(CartListData.Count)</SpkBadge>
                                </ChildContent>
                                <!-- End::header-link|dropdown-toggle -->
                                <ChildContent2>
                                    <!-- Start::main-header-dropdown -->
                                    <div class="main-header-dropdown dropdown-menu dropdown-menu-end" data-popper-placement="none">
                                        <div class="p-3">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <p class="mb-0 fs-16">Cart Items
                                                    <SpkBadge BadgeClass="bg-primary2 text-fixed-white ms-1 fs-12 rounded-circle" id="cart-data">@(CartListData.Count)</SpkBadge>
                                                </p>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fs-12 fw-medium text-muted">Sub Total : </span>
                                                    <h6 class="mb-0"> $740</h6>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                        <BlazorOverlayScrollbars>
                                            <BlazorOverlayScrollbarsContent>
                                                <ul class="list-unstyled mb-0" id="header-cart-items-scroll">
                                                    @foreach (var CartList in CartListData) {
                                                        <li class="dropdown-item">
                                                            <div class="d-flex align-items-center cart-dropdown-item gap-3">
                                                                <div class="lh-1">
                                                                    <span class="avatar avatar-xl bg-primary-transparent">
                                                                        <img src="@CartList.img" alt="@CartList.imgalt">
                                                                    </span>
                                                                </div>
                                                                <div class="flex-fill">
                                                                    <div class="d-flex align-items-center justify-content-between mb-0">
                                                                        <div class="mb-0 fs-14 fw-medium">
                                                                            <a href="/cart" target="_blank">@CartList.title</a>
                                                                            <div class="text-truncate">
                                                                                <p class="mb-0 header-cart-text text-truncate fs-11 text-muted">@CartList.desc</p>
                                                                                <h6 class="fw-medium mb-0 mt-1"><span class="text-success fw-normal me-1 fs-11 d-inline-block">(@CartList.quantity)</span>@CartList.originalprice</h6>
                                                                            </div>
                                                                        </div>
                                                                        <div class="text-end">
                                                                            <a href="javascript:void(0);" class="header-cart-remove dropdown-item-close" @onclick="@(() => DeleteCartlist(CartList))"><i class="ri-close-line"></i></a>
                                                                            <h6 class="fw-medium mb-0 mt-3"><span class="text-info op-4 fw-normal me-1 fs-11 d-inline-block">Total :</span>@CartList.price</h6>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            
                                                        </li>
                                                    }
                                                </ul>
                                            </BlazorOverlayScrollbarsContent>
                                        </BlazorOverlayScrollbars>

                                        @if (CartListData.Count < 1)
                                        {
                                            <div class="p-5 empty-item">
                                                <div class="text-center">
                                                    <span class="avatar avatar-xl avatar-rounded bg-primary-transparent">
                                                        <i class="ri-shopping-cart-2-line fs-2"></i>
                                                    </span>
                                                    <h6 class="fw-medium mb-1 mt-3">Your Cart is Empty</h6>
                                                    <span class="mb-3 fw-normal fs-13 d-block">Add some items to make me happy :)</span>
                                                    <SpkButtons Tag="a" href="/products" ButtonClass="btn-primary1 m-1" ButtonSize="btn-sm" data-abc="true">continue shopping <i class="bi bi-arrow-right ms-1"></i></SpkButtons>
                                                </div>
                                            </div>
                                        }
                                        else {
                                        <div class="p-3 empty-header-item border-top d-flex gap-2 align-items-center">
                                            <SpkButtons Tag="a" href="/checkout" ButtonClass="flex-fill btn-primary">Proceed to checkout</SpkButtons>
                                        </div>
                                        }
                                    </div>
                                    <!-- End::main-header-dropdown -->
                                </ChildContent2>
                            </SpkDropdowns>
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li>
                            <SpkDropdowns Tag="a" DropdownMainClass="header-element notifications-dropdown d-xl-block d-none" DropdownId="messageDropdown" DropdownClass="header-link" data-bs-auto-close="outside">
                                <!-- Start::header-link|dropdown-toggle -->
                                <ChildContent>
                                    <span class="header-icon-pulse bg-primary2 rounded pulse pulse-secondary"></span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0M3.124 7.5A8.969 8.969 0 0 1 5.292 3m13.416 0a8.969 8.969 0 0 1 2.168 4.5" />
                                    </svg>
                                </ChildContent>
                                <!-- End::header-link|dropdown-toggle -->
                                <ChildContent2>
                                    <!-- Start::main-header-dropdown -->
                                    <div class="main-header-dropdown dropdown-menu dropdown-menu-end" data-popper-placement="none">
                                        <div class="p-3">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <p class="mb-0 fs-15 fw-medium">Notifications</p>
                                                <SpkBadge BadgeClass="bg-secondary text-fixed-white"  id="notifiation-data">@(NotifyListData.Count) Unread</SpkBadge>
                                            </div>
                                        </div>
                                        <div class="dropdown-divider"></div>
                                        <BlazorOverlayScrollbars>
                                            <BlazorOverlayScrollbarsContent>
                                                <ul class="list-unstyled mb-0" id="header-notification-scroll">
                                                    @foreach (var NotifyList in NotifyListData)
                                                    {
                                                        <li class="dropdown-item">
                                                            <div class="d-flex align-items-center">
                                                                <div class="pe-2 lh-1">
                                                                    <span class="avatar avatar-md avatar-rounded @NotifyList.iconBg">
                                                                        @if(!string.IsNullOrEmpty(@NotifyList.icon)) {
                                                                            <i class="@NotifyList.icon lh-1 "></i>
                                                                        }
                                                                        else {
                                                                        <img src="@NotifyList.img" alt="user1">
                                                                        }
                                                                    </span>
                                                                </div>
                                                                <div class="flex-grow-1 d-flex align-items-center justify-content-between">
                                                                    <div>
                                                                        <p class="mb-0 fw-medium"><a href="/chat">@NotifyList.title</a></p>
                                                                        <div class="text-muted fw-normal fs-12 header-notification-text text-truncate">
                                                                            @NotifyList.description   
                                                                            @if(!string.IsNullOrEmpty(@NotifyList.description2)) {
                                                                                <span class="@NotifyList.description2color mx-1">@NotifyList.description2</span>
                                                                            }
                                                                            @NotifyList.description3  
                                                                            </div>
                                                                        <div class="fw-normal fs-10 text-muted op-8">@NotifyList.msgtime</div>
                                                                    </div>
                                                                    <div>
                                                                        <a href="javascript:void(0);" @onclick="@(() => DeleteNotifyList(NotifyList))" class="min-w-fit-content text-muted dropdown-item-close1"><i class="ri-close-line"></i></a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            </BlazorOverlayScrollbarsContent>
                                        </BlazorOverlayScrollbars>

                                        @if (NotifyListData.Count < 1)
                                        {
                                            <div class="p-5 empty-item1">
                                                <div class="text-center">
                                                    <span class="avatar avatar-xl avatar-rounded bg-secondary-transparent">
                                                        <i class="ri-notification-off-line fs-2"></i>
                                                    </span>
                                                    <h6 class="fw-medium mt-3">No New Notifications</h6>
                                                </div>
                                            </div>
                                        }
                                        else { 
                                            <div class="p-3 empty-header-item1 border-top">
                                                <div class="d-grid">
                                                    <SpkButtons Tag="a" ButtonClass="btn-primary">View All</SpkButtons>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                    <!-- End::main-header-dropdown -->
                                </ChildContent2>
                            </SpkDropdowns>
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li class="header-element header-fullscreen">
                            <!-- Start::header-link -->
                            <a onclick="openFullscreen();" href="javascript:void(0);" class="header-link">
                                 <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 full-screen-open header-link-icon" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                                </svg>
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 full-screen-close header-link-icon d-none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 9V4.5M9 9H4.5M9 9 3.75 3.75M9 15v4.5M9 15H4.5M9 15l-5.25 5.25M15 9h4.5M15 9V4.5M15 9l5.25-5.25M15 15h4.5M15 15v4.5m0-4.5 5.25 5.25" />
                                </svg>
                            </a>
                            <!-- End::header-link -->
                        </li>
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li>
                            <SpkDropdowns Tag="a" DropdownMainClass="header-element" DropdownId="mainHeaderProfile" DropdownClass="header-link" data-bs-auto-close="outside">
                                <!-- Start::header-link|dropdown-toggle -->
                                <ChildContent>
                                    <div class="d-flex align-items-center">
                                    <div>
                                        <img src="@($"{NavigationManager.BaseUri}assets/images/faces/15.jpg")" alt="img" class="avatar avatar-sm">
                                    </div>
                                </div>
                                </ChildContent>
                                <!-- End::header-link|dropdown-toggle -->
                                <ChildContent2>
                                    <ul class="main-header-dropdown dropdown-menu pt-0 overflow-hidden header-profile-dropdown dropdown-menu-end" aria-labelledby="mainHeaderProfile">
                                        <li>
                                            <div class="dropdown-item text-center border-bottom">
                                                <span>
                                                    Mr.Henry
                                                </span>
                                                <span class="d-block fs-12 text-muted">UI/UX Designer</span>
                                            </div>
                                        </li>
                                        <li><a class="dropdown-item d-flex align-items-center" href="/profile"><i class="fe fe-user p-1 rounded-circle bg-primary-transparent me-2 fs-16"></i>Profile</a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" href="/mail"><i class="fe fe-mail p-1 rounded-circle bg-primary-transparent me-2 fs-16"></i>Mail Inbox</a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" href="/filemanager"><i class="fe fe-database p-1 rounded-circle bg-primary-transparent klist me-2 fs-16"></i>File Manager<SpkBadge BadgeClass="bg-primary1 text-fixed-white ms-auto fs-9">2</SpkBadge></a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" href="/mail-settings"><i class="fe fe-settings p-1 rounded-circle bg-primary-transparent ings me-2 fs-16"></i>Settings</a></li>
                                        <li class="border-top bg-light"><a class="dropdown-item d-flex align-items-center" href="/chat"><i class="fe fe-help-circle p-1 rounded-circle bg-primary-transparent set me-2 fs-16"></i>Help</a></li>
                                        <li><a class="dropdown-item d-flex align-items-center" href="/signin-cover"><i class="fe fe-lock p-1 rounded-circle bg-primary-transparent ut me-2 fs-16"></i>Log Out</a></li>
                                    </ul>
                                </ChildContent2>
                            </SpkDropdowns>
                        </li>  
                        <!-- End::header-element -->

                        <!-- Start::header-element -->
                        <li class="header-element">
                            <!-- Start::header-link|switcher-icon -->
