@page "/BinderMetadata"
@inject Sandbox.Services.WindowpaneService WindowpaneService
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor
@using Sandbox.Models.Windowpane
@using Microsoft.AspNetCore.Http

<style>
    .filter-section { margin-bottom: 1.5rem; }
    .filter-row { margin-bottom: 0.75rem; }
    .filter-btn {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
        border-radius: 0.25rem;
        border: 1px solid #4a5568;
        background-color: white;
        color: #4a5568;
        cursor: pointer;
        margin-right: 0.25rem;
        margin-bottom: 0.25rem;
    }
    .filter-btn.active {
        background-color: #4299e1;
        color: white;
        border-color: #4299e1;
    }
    .filter-btn:hover:not(.active) {
        background-color: #e2e8f0;
    }
    .binder-table { font-size: 0.9rem; }
    .binder-table th, .binder-table td {
        padding: 0.5rem;
        vertical-align: middle;
    }
    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 24px;
    }
    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }
    .toggle-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .4s;
        border-radius: 24px;
    }
    .toggle-slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 3px;
        bottom: 3px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }
    input:checked + .toggle-slider {
        background-color: #4299e1;
    }
    input:checked + .toggle-slider:before {
        transform: translateX(26px);
    }
</style>

<div class="row mt-3 mb-3">
    <div class="col">
        <h3>Binder Metadata</h3>
        <p class="text-muted">Manage binder metadata and claims BDX requirements</p>
    </div>
</div>

<!-- Filters -->
<div class="filter-section">
    <div class="filter-row">
        <label class="form-label d-block mb-2" style="font-weight: 600;">Class:</label>
        @foreach (var cls in availableClasses)
        {
            <button class="filter-btn @(cls == selectedClass ? "active" : "")"
                    @onclick="() => SelectClass(cls)">
                @cls
            </button>
        }
    </div>
    <div class="filter-row">
        <label class="form-label d-block mb-2" style="font-weight: 600;">Year of Account:</label>
        @foreach (var year in availableYears)
        {
            <button class="filter-btn @(year == selectedYear ? "active" : "")"
                    @onclick="() => SelectYear(year)">
                @year
            </button>
        }
    </div>
</div>

<!-- Data Table -->
@if (binderMetadata == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow mb-4 border">
        <div class="table-responsive">
            <table class="table table-striped table-hover binder-table">
                <thead class="table-dark">
                    <tr>
                        <th>Policy Reference</th>
                        <th>Assured Name</th>
                        <th>Class</th>
                        <th>YOA</th>
                        <th>Requires Claims BDX</th>
                        <th>Last Updated</th>
                        <th>Updated By</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in FilteredBinderMetadata)
                    {
                        <tr>
                            <td>@item.PolicyRef</td>
                            <td>@item.AssuredName</td>
                            <td>@item.Class</td>
                            <td>@item.Yoa</td>
                            <td>
                                @if (item.RequiresClaimsBdx.HasValue)
                                {
                                    <span class="badge @(item.RequiresClaimsBdx == 1 ? "bg-success" : "bg-secondary")">
                                        @(item.RequiresClaimsBdx == 1 ? "Yes" : "No")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Not Set</span>
                                }
                            </td>
                            <td>@item.LastUpdated?.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@item.UpdatedBy</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => ShowEditModal(item)">
                                    Edit
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!FilteredBinderMetadata.Any())
    {
        <div class="alert alert-info">
            <strong>No binders found.</strong> Try adjusting your filters.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <strong>Total:</strong> @FilteredBinderMetadata.Count() binders
        </div>
    }
}

<!-- Edit Modal -->
@if (showModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Binder Metadata</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @if (currentItem != null)
                    {
                        <div class="mb-3">
                            <label class="form-label"><strong>Policy Reference:</strong></label>
                            <div class="form-control-plaintext">@currentItem.PolicyRef</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><strong>Assured Name:</strong></label>
                            <div class="form-control-plaintext">@currentItem.AssuredName</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><strong>Class:</strong></label>
                            <div class="form-control-plaintext">@currentItem.Class</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><strong>Year of Account:</strong></label>
                            <div class="form-control-plaintext">@currentItem.Yoa</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label"><strong>Requires Claims BDX:</strong></label>
                            <div class="d-flex align-items-center">
                                <span class="me-3">@(editRequiresClaimsBdx == 1 ? "Yes" : "No")</span>
                                <label class="toggle-switch">
                                    <input type="checkbox"
                                           checked="@(editRequiresClaimsBdx == 1)"
                                           @onchange="ToggleRequiresClaimsBdx" />
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="SubmitUpdate" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Submit</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<BindersMetadataItem> binderMetadata;
    private List<string> availableClasses = new List<string> { "All", "CA", "EN", "HC", "MR", "PF", "PI", "PL", "PO", "PR", "PS", "SI" };
    private List<string> availableYears = new List<string>();
    private string selectedClass = "All";
    private string selectedYear = "All";

    private bool showModal = false;
    private bool isSubmitting = false;
    private BindersMetadataItem currentItem;
    private int editRequiresClaimsBdx = 0;

    private IEnumerable<BindersMetadataItem> FilteredBinderMetadata
    {
        get
        {
            if (binderMetadata == null) return Enumerable.Empty<BindersMetadataItem>();

            var items = binderMetadata.AsEnumerable();

            if (selectedClass != "All")
            {
                items = items.Where(i => i.Class == selectedClass);
            }

            if (selectedYear != "All")
            {
                if (int.TryParse(selectedYear, out int year))
                {
                    items = items.Where(i => i.Yoa == year);
                }
            }

            return items.OrderBy(i => i.PolicyRef);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        binderMetadata = (await WindowpaneService.GetBindersMetadataAsync()).ToList();

        // Extract unique years from data
        availableYears = new List<string> { "All" };
        var years = binderMetadata
            .Where(i => i.Yoa.HasValue)
            .Select(i => i.Yoa.Value.ToString())
            .Distinct()
            .OrderByDescending(y => y)
            .ToList();
        availableYears.AddRange(years);
    }

    private void SelectClass(string cls)
    {
        selectedClass = cls;
    }

    private void SelectYear(string year)
    {
        selectedYear = year;
    }

    private void ShowEditModal(BindersMetadataItem item)
    {
        currentItem = item;
        editRequiresClaimsBdx = item.RequiresClaimsBdx ?? 0;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        currentItem = null;
    }

    private void ToggleRequiresClaimsBdx(ChangeEventArgs e)
    {
        editRequiresClaimsBdx = (bool)e.Value ? 1 : 0;
    }

    private async Task SubmitUpdate()
    {
        if (currentItem == null) return;

        isSubmitting = true;
        try
        {
            var context = HttpContextAccessor.HttpContext;
            var username = context?.User?.Identity?.Name ?? "Unknown";

            var request = new UpdateBindersMetadataRequest
            {
                PolicyRef = currentItem.PolicyRef,
                RequiresClaimsBdx = editRequiresClaimsBdx,
                UpdatedBy = username
            };

            await WindowpaneService.UpdateBindersMetadataAsync(request);

            // Reload data to reflect changes
            await LoadData();

            CloseModal();
        }
        catch (Exception ex)
        {
            // TODO: Add proper error handling/notification
            Console.WriteLine($"Error updating binder metadata: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
