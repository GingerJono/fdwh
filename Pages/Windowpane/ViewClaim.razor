@page "/ViewClaim/{ID}"
@using Sandbox.Models.Windowpane
@using Sandbox.Services
@inject WindowpaneService WindowpaneService
@inject NavigationManager NavigationManager

@if (Model?.ID != null)
{
	<!-- Breadcrumbs -->
	<ol class="breadcrumb">
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/Search"))">SEARCH</a>
		</li>
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/ViewClaim"))">VIEW CLAIM</a>
		</li>
		<li class="breadcrumb-item active">@Model.ID</li>
	</ol>

	<!-- Header cards -->
	<div class="row display-flex">
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-red-pink">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3 fs-16px">Claim Ref</h5>
					<h3 class="text-white mt-n1">@Model.ID</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-4 col-8 mb-4">
			<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-custom-orange">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3 fs-16px">Assured</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Assured")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-custom-teal">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3 fs-16px">Loss Date</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("LossDate")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-custom-blue">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3 fs-16px">Event</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Event")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-custom-indigo">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3 fs-16px">Status</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Status")</h3>
				</div>
			</div>
		</div>
	</div>

	@if (!string.IsNullOrEmpty(HeaderData.GetValueOrDefault("Narrative")))
	{
		<div class="row display-flex">
			<div class="col">
				<div class="card mb-3 overflow-hidden h-100 fs-13px border-0 bg-gradient-custom-indigo">
					<div class="card-body position-relative">
						<h5 class="text-white text-opacity-80 mb-3 fs-16px">Narrative</h5>
						<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Narrative")</h3>
					</div>
				</div>
			</div>
		</div>
	}

	<!-- Nav Pills -->
	<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
		<li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pills-snapshot" type="button">Snapshot</button></li>
		<li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pills-movements" type="button">Movements</button></li>
		<li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pills-reinsurance" type="button">Reinsurance</button></li>
	</ul>

	<!-- Tabs -->
	<div class="tab-content" id="pills-tabContent">
		<div class="tab-pane fade show active" id="pills-snapshot">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="SnapshotDates" MethodName="GetClaimsSnapshotDates" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="SnapshotEvents" MethodName="GetClaimsSnapshotEvents" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="SnapshotNarratives" MethodName="GetClaimsSnapshotNarratives" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="SnapshotSummary" MethodName="GetClaimsSnapshotSummary" ID="@Model.ID" />
			</div>
		</div>

		<div class="tab-pane fade" id="pills-movements">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="MovementsSummary" MethodName="GetClaimsMovementsSummary" ID="@Model.ID" />
			</div>
		</div>

		<div class="tab-pane fade" id="pills-reinsurance">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="ReinsuranceCatXL" MethodName="GetClaimsReinsuranceCatXL" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="ReinsuranceFac" MethodName="GetClaimsReinsuranceFac" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="ReinsuranceQuotaShare" MethodName="GetClaimsReinsuranceQuotaShare" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="ReinsuranceRiskXL" MethodName="GetClaimsReinsuranceRiskXL" ID="@Model.ID" />
			</div>
		</div>
	</div>
}
else
{
	<ol class="breadcrumb">
		<li class="breadcrumb-item active">VIEW CLAIM</li>
	</ol>

	<h1 class="page-header mb-3">View Claim.</h1>
}

@code {
	[Parameter] public string ID { get; set; }

	private WindowpaneViewXModel Model { get; set; } = new();
	private Dictionary<string, string> HeaderData { get; set; } = new();

	protected override void OnInitialized()
	{
		if (!string.IsNullOrWhiteSpace(ID))
		{
			Model.ID = ID;
			HeaderData = WindowpaneService.GetClaimHeaderKeyValuePairs(ID)
				?? new Dictionary<string, string>();
		}
	}
}
