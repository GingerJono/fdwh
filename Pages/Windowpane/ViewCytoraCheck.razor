@page "/ViewCytoraCheck/{JobID:int}"
@inject Sandbox.Services.WindowpaneService WindowpaneService
@using Sandbox.Models.Windowpane
@using Markdig

@if (IsLoading)
{
    <p>Loading job details...</p>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p class="text-danger">@ErrorMessage</p>
}
else if (Check != null)
{
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/CytoraChecking">Cytora Checking</a></li>
            <li class="breadcrumb-item active" aria-current="page">Job @Check.JobID</li>
        </ol>
    </nav>

    <!-- Email Section -->
    <div class="card shadow mb-4 border border-dark">
        <div class="card-body">
            <h5>Email</h5>
            <p><strong>Subject:</strong> @Check.EmailSubject</p>
            <p><strong>From:</strong> @Check.EmailFrom</p>
            <p><strong>To:</strong> @Check.EmailTo</p>
            <p><strong>Date Sent:</strong> @Check.EmailDateSent</p>
            <p><strong>File Size (MB):</strong> @Check.EmailFileSizeInMB</p>
        </div>
    </div>

    <!-- Outputs Comparison -->
    <div class="card shadow mb-4 border">
        <div class="card-body">
            <h5>Outputs Comparison</h5>
            <table class="table table-bordered table-sm text-nowrap">
                <thead>
                    <tr>
                        <th>Field</th>
                        <th>NDEX</th>
                        <th>Cytora</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>Insured</td><td>@Check.NDEXInsuredName (@Check.NDEXDomicileCountry / @Check.NDEXInsuredState)</td><td>@Check.OutputInsuredName (@Check.OutputInsuredDomicile / @Check.OutputInsuredState)</td></tr>
                    <tr><td>Reinsured</td><td>@Check.NDEXReinsuredName (@Check.NDEXReinsuredDomicile / @Check.NDEXReinsuredState)</td><td>@Check.OutputReinsuredName (@Check.OutputReinsuredDomicile / @Check.OutputReinsuredState)</td></tr>
                    <tr><td>Broker</td><td>@Check.NDEXBrokerCompany – @Check.NDEXBrokerContact</td><td>@Check.OutputBrokerCompany – @Check.OutputBrokerContact</td></tr>
                    <tr><td>Line of Business</td><td>@Check.NDEXLineOfBusiness</td><td>@Check.OutputLineOfBusiness</td></tr>
                    <tr><td>Policy Type</td><td>@Check.NDEXPolicyType</td><td>@Check.OutputPolicyType</td></tr>
                    <tr><td>Underwriter</td><td>@Check.NDEXUnderwriter</td><td>@Check.OutputUnderwriter</td></tr>
                    <tr><td>Inception</td><td>@Check.NDEXInceptionDate?.ToString("yyyy-MM-dd")</td><td>@Check.OutputInceptionDate?.ToString("yyyy-MM-dd")</td></tr>
                    <tr><td>Expiry</td><td>@Check.NDEXExpiryDate?.ToString("yyyy-MM-dd")</td><td>@Check.OutputExpiryDate?.ToString("yyyy-MM-dd")</td></tr>
                    <tr><td>Risk Location</td><td>@Check.NDEXRiskLocation</td><td>@Check.OutputRiskLocation</td></tr>
                    <tr><td>New/Renewal</td><td>@Check.NDEXNewRenewal</td><td>@Check.OutputNewRenewal</td></tr>
                    <tr><td>Renewed From</td><td>@Check.NDEXRenewedFrom</td><td>@Check.OutputRenewedFrom</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Markdown Columns -->
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header">Submission Summary</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Check.OutputSubmissionSummary))
                    {
                        @((MarkupString)Markdown.ToHtml(Check.OutputSubmissionSummary ?? string.Empty))
                    }
                    else
                    {
                        <p class="text-muted">No submission summary.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header">Renewal Terms Comparison</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Check.OutputRenewalTermsComparison))
                    {
                        @((MarkupString)Markdown.ToHtml(Check.OutputRenewalTermsComparison ?? string.Empty))
                    }
                    else
                    {
                        <p class="text-muted">No renewal terms comparison.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int JobID { get; set; }
    private CytoraCheck Check { get; set; }
    private bool IsLoading { get; set; } = true;
    private string ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Check = await WindowpaneService.GetCytoraCheckByJobIdAsync(JobID);
            if (Check == null)
            {
                ErrorMessage = $"No record found for JobID {JobID}.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error loading job details.";
            Console.WriteLine(ex);
        }
        finally
        {
            IsLoading = false;
        }
    }
}
