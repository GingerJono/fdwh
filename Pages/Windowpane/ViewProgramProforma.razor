@page "/ViewProgramProforma/{ID}"
@using Sandbox.Models.Windowpane
@using Sandbox.Services
@using CardModel
@inject WindowpaneService WindowpaneService
@inject NavigationManager NavigationManager

<style>
	.table thead th {
		background-color: #002855;
		color: white;
		border-color: #dee2e6;
	}

	.card h2, .card h3 {
		margin-bottom: 0.25rem;
	}

	.row.display-flex {
		display: flex;
		flex-wrap: wrap;
	}

		.row.display-flex > [class*='col-'] {
			flex-grow: 1;
		}

	.bg-printable {
		background-color: #FFF;
	}

		.bg-printable > div > h5,
		.bg-printable > div > h3,
		.bg-printable > div > p {
			color: #000;
		}

	.table > :not(caption) > * > * {
		padding: 0.25rem !important;
	}

	.app-content {
		padding: 1rem;
	}

	.app {
		padding-top: 0;
	}

	.row > * {
		padding-right: 0;
	}
</style>

@if (Model?.ID != null)
{
	<ol class="breadcrumb">
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/Search"))">SEARCH</a>
		</li>
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/ViewProgram"))">VIEW PROGRAM</a>
		</li>
		<li class="breadcrumb-item active">@Model.ID</li>
	</ol>

	<!-- Header cards -->
	<div class="row display-flex">
		<div class="col-lg-2 col-4 mb-2">
			<div class="card overflow-hidden h-100 fs-13px bg-printable">
				<div class="card-body position-relative">
					<h5 class="text-opacity-80 fs-16px">Program Ref / UMR</h5>
					<h3 class="mt-n1">@Model.ID</h3>
					<p class="mt-n1 mb-0">@HeaderData.GetValueOrDefault("UMR")</p>
				</div>
			</div>
		</div>
		<div class="col-lg-4 col-8 mb-2">
			<div class="card overflow-hidden h-100 fs-13px bg-printable">
				<div class="card-body position-relative">
					<h5 class="text-opacity-80 fs-16px">Assured</h5>
					<h3 class="mt-n1">@HeaderData.GetValueOrDefault("Assured")</h3>
					<p class="mt-n1 mb-0">@HeaderData.GetValueOrDefault("RiskDescription")</p>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-2">
			<div class="card overflow-hidden h-100 fs-13px bg-printable">
				<div class="card-body position-relative">
					<h5 class="text-opacity-80 fs-16px">Inception</h5>
					<h3 class="mt-n1">@HeaderData.GetValueOrDefault("Inception")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-2">
			<div class="card overflow-hidden h-100 fs-13px bg-printable">
				<div class="card-body position-relative">
					<h5 class="text-opacity-80 fs-16px">UW</h5>
					<h3 class="mt-n1">@HeaderData.GetValueOrDefault("UW")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-2">
			<div class="card overflow-hidden h-100 fs-13px bg-printable">
				<div class="card-body position-relative">
					<h5 class="text-opacity-80 fs-16px">Status</h5>
					<h3 class="mt-n1">@HeaderData.GetValueOrDefault("Status")</h3>
				</div>
			</div>
		</div>
	</div>

	<!-- Snapshot section -->
	<div class="tab-pane fade show active" id="pills-snapshot">
		<div class="row display-flex mb-2">
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Key Stats" MethodName="GetProgramSnapshotKeyStats" ID="@Model.ID" />
			</div>
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Dates" MethodName="GetProgramSnapshotDates" ID="@Model.ID" />
			</div>
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Companies" MethodName="GetProgramSnapshotCompanies" ID="@Model.ID" />
			</div>
		</div>
		<div class="row mb-2">
			<div class="col">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Lines" MethodName="GetProgramSnapshotLines" ID="@Model.ID" />
			</div>
		</div>
		<div class="row display-flex mb-2">
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Geographical" MethodName="GetProgramSnapshotGeographical" ID="@Model.ID" />
			</div>
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Deductions" MethodName="GetProgramSnapshotDeductions" ID="@Model.ID" />
			</div>
			<div class="col-6 col-md-4">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Segmentation" MethodName="GetProgramSnapshotSegmentation" ID="@Model.ID" />
			</div>
		</div>
		<div class="row mb-2">
			<div class="col-6">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Risk Code Matrix" MethodName="GetProgramSnapshotRiskCodes" ID="@Model.ID" />
			</div>
			<div class="col-6">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="Documents" MethodName="GetProgramSnapshotDocuments" ID="@Model.ID" />
			</div>
		</div>
		<div class="row mb-2">
			<div class="col">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="History" MethodName="GetProgramSnapshotHistory" ID="@Model.ID" />
			</div>
		</div>
		<div class="row mb-2">
			<div class="col">
				<DataCard DivClasses="mb-2 h-100" HeaderTitle="NDEX Notes" MethodName="GetProgramSnapshotNDEXNotes" ID="@Model.ID" />
			</div>
		</div>
	</div>
}
else
{
	<ol class="breadcrumb">
		<li class="breadcrumb-item active">VIEW PROGRAM</li>
	</ol>

	<h1 class="page-header mb-3">View Program.</h1>
}

@code {
	[Parameter] public string ID { get; set; }

	private WindowpaneViewXModel Model { get; set; } = new();
	private Dictionary<string, string> HeaderData { get; set; } = new();

	protected override void OnInitialized()
	{
		if (!string.IsNullOrWhiteSpace(ID))
		{
			Model.ID = ID;
			HeaderData = WindowpaneService.GetProgramHeaderKeyValuePairs(ID) ?? new Dictionary<string, string>();
		}
	}
}