@page "/CytoraChecking"
@inject Sandbox.Services.WindowpaneService WindowpaneService
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject Sandbox.Services.CytoraCheckingFilterState FilterState
@using Sandbox.Models.Windowpane

<div class="row mt-4 mb-4">
    <h3>Cytora Checking Jobs</h3>
</div>

<div class="row mb-3">
    <div class="col-md-2">
        <label for="minJobId" class="form-label">Min JobID</label>
        <input id="minJobId" type="number" class="form-control"
               @bind="FilterState.MinJobID" @bind:event="oninput" />
    </div>
    <div class="col-md-2">
        <label for="maxJobId" class="form-label">Max JobID</label>
        <input id="maxJobId" type="number" class="form-control"
               @bind="FilterState.MaxJobID" @bind:event="oninput" />
    </div>
</div>

@if (Checks == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow mb-4 border">
        <div class="table-responsive">
            <table class="table table-striped table-fixed text-nowrap">
                <thead>
                    <tr>
                        <th>Job ID</th>
                        <th>Status</th>
                        <th>Email Subject</th>
                        <th>Email From</th>
                        <th>Email Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in FilteredChecks)
                    {
                        <tr>
                            <td>@c.JobID</td>
                            <td>@c.ProcessingStatus</td>
                            <td>@c.EmailSubject</td>
                            <td>@c.EmailFrom</td>
                            <td>@c.EmailDateSent?.ToString("yyyy-MM-dd")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"
                                        @onclick='() => NavigationManager.NavigateTo($"ViewCytoraCheck/{c.JobID}")'>
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<CytoraCheck> Checks;

    private IEnumerable<CytoraCheck> FilteredChecks =>
        Checks?
            .Where(c =>
                (!FilterState.MinJobID.HasValue || c.JobID >= FilterState.MinJobID.Value) &&
                (!FilterState.MaxJobID.HasValue || c.JobID <= FilterState.MaxJobID.Value))
            .OrderByDescending(c => c.JobID)
        ?? Enumerable.Empty<CytoraCheck>();

    protected override async Task OnInitializedAsync()
    {
        Checks = (await WindowpaneService.GetCytoraChecksAsync()).ToList();
    }
}
