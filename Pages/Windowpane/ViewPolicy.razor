@page "/ViewPolicy/{ID}"
@using Sandbox.Models.Windowpane
@using Sandbox.Services
@using CardModel
@inject NavigationManager NavigationManager
@inject WindowpaneService WindowpaneService
@inject IJSRuntime JSRuntime

@if (Model?.ID != null)
{
	<ol class="breadcrumb">
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/Search"))">SEARCH</a>
		</li>
		<li class="breadcrumb-item">
			<a @onclick="@(() => NavigationManager.NavigateTo("/Windowpane/ViewPolicy"))">VIEW POLICY</a>
		</li>
		<li class="breadcrumb-item active">@Model.ID</li>
	</ol>

	<!-- Header cards -->
	<div class="row display-flex">
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 border-0 bg-primary-gradient bg-opacity-100">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3">Policy Ref</h5>
					<h3 class="text-white mt-n1">@Model.ID</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-4 col-8 mb-4">
			<div class="card mb-3 overflow-hidden h-100 border-0 bg-primary-gradient bg-opacity-75">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3">Assured</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Assured")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 border-0 bg-primary-gradient bg-opacity-100">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3">Inception</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Inception")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 border-0 bg-primary-gradient bg-opacity-75">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3">UW</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("UW")</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-2 col-4 mb-4">
			<div class="card mb-3 overflow-hidden h-100 border-0 bg-primary-gradient bg-opacity-100">
				<div class="card-body position-relative">
					<h5 class="text-white text-opacity-80 mb-3">Status</h5>
					<h3 class="text-white mt-n1">@HeaderData.GetValueOrDefault("Status")</h3>
				</div>
			</div>
		</div>
	</div>

	<!-- Tabs -->
	<ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
		<li class="nav-item" role="presentation">
			<button class="nav-link active" id="pills-snapshot-tab" data-bs-toggle="pill" data-bs-target="#pills-snapshot" type="button" role="tab">Snapshot</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-premium-tab" data-bs-toggle="pill" data-bs-target="#pills-premium" type="button" role="tab">Premium</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-claims-tab" data-bs-toggle="pill" data-bs-target="#pills-claims" type="button" role="tab">Claims</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-aggregates-tab" data-bs-toggle="pill" data-bs-target="#pills-aggregates" type="button" role="tab">Aggregates</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-pricing-tab" data-bs-toggle="pill" data-bs-target="#pills-pricing" type="button" role="tab">Pricing</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-exceptions-tab" data-bs-toggle="pill" data-bs-target="#pills-exceptions" type="button" role="tab">Exceptions</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-audit-tab" data-bs-toggle="pill" data-bs-target="#pills-audit" type="button" role="tab">Audit</button>
		</li>
		<li class="nav-item" role="presentation">
			<button class="nav-link" id="pills-notes-tab" data-bs-toggle="pill" data-bs-target="#pills-notes" type="button" role="tab">Notes</button>
		</li>
		<li class="nav-item">
			<a class="nav-link bg-info text-white" href="@($"{NavigationManager.BaseUri}ViewProgramProforma/{ID}")" target="_blank">Proforma</a>
		</li>
	</ul>

	<div class="tab-content" id="pills-tabContent">
		<!-- Snapshot -->
		<div class="tab-pane fade show active" id="pills-snapshot" role="tabpanel" aria-labelledby="pills-snapshot-tab">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="Summary" MethodName="GetPolicySnapshotSummary" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Dates" MethodName="GetPolicySnapshotDates" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Companies" MethodName="GetPolicySnapshotCompanies" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Deductions" MethodName="GetPolicySnapshotDeductions" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Documents" MethodName="GetPolicySnapshotDocuments" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Geographical" MethodName="GetPolicySnapshotGeographical" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="History" MethodName="GetPolicySnapshotHistory" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="KeyStats" MethodName="GetPolicySnapshotKeyStats" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="LinesLimits" MethodName="GetPolicySnapshotLinesLimits" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Period" MethodName="GetPolicySnapshotPeriod" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="RelatedPolicies" MethodName="GetPolicySnapshotRelatedPolicies" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Review" MethodName="GetPolicySnapshotReview" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="RiskCodes" MethodName="GetPolicySnapshotRiskCodes" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Segmentation" MethodName="GetPolicySnapshotSegmentation" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Statuses" MethodName="GetPolicySnapshotStatuses" ID="@Model.ID" />
			</div>
		</div>

		<!-- Premium -->
		<div class="tab-pane fade" id="pills-premium">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="Currencies" MethodName="GetPolicyPremiumCurrencies" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="History" MethodName="GetPolicyPremiumHistory" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Patterns" MethodName="GetPolicyPremiumPatterns" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Signings" MethodName="GetPolicyPremiumSignings" ID="@Model.ID" />
			</div>
		</div>

		<!-- Claims -->
		<div class="tab-pane fade" id="pills-claims">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="Development" MethodName="GetPolicyClaimsDevelopment" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Events" MethodName="GetPolicyClaimsEvents" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="List" MethodName="GetPolicyClaimsList" ID="@Model.ID" />
			</div>
		</div>

		<!-- Aggregates -->
		<div class="tab-pane fade" id="pills-aggregates">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="Country" MethodName="GetPolicyAggregatesCountry" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="County" MethodName="GetPolicyAggregatesCounty" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Historical" MethodName="GetPolicyAggregatesHistorical" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="State" MethodName="GetPolicyAggregatesState" ID="@Model.ID" />
			</div>
		</div>

		<!-- Pricing -->
		<div class="tab-pane fade" id="pills-pricing">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="ELRs" MethodName="GetPolicyPricingELRs" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="OptalitixQuotes" MethodName="GetPolicyPricingOptalitixQuotes" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="PremiumSplits" MethodName="GetPolicyPricingPremiumSplits" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="RateChange" MethodName="GetPolicyPricingRateChange" ID="@Model.ID" />
			</div>
		</div>

		<!-- Exceptions -->
		<div class="tab-pane fade" id="pills-exceptions">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="Checked" MethodName="GetPolicyExceptionsChecked" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="Unchecked" MethodName="GetPolicyExceptionsUnchecked" ID="@Model.ID" />
			</div>
		</div>

		<!-- Audit -->
		<div class="tab-pane fade" id="pills-audit">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="AuditLog" MethodName="GetPolicyAuditAuditLog" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="LifeCycle" MethodName="GetPolicyAuditLifeCycle" ID="@Model.ID" />
			</div>
		</div>

		<!-- Notes -->
		<div class="tab-pane fade" id="pills-notes">
			<div class="row">
				<DataCard DivClasses="mb-4" HeaderTitle="NDEXNotes" MethodName="GetPolicyNotesNDEXNotes" ID="@Model.ID" />
				<DataCard DivClasses="mb-4" HeaderTitle="WorkbenchNotes" MethodName="GetPolicyNotesWorkbenchNotes" ID="@Model.ID" />
			</div>
		</div>

		<!-- Proforma -->
		<div class="tab-pane fade" id="pills-proforma">
			<div class="row mb-3">
				<a class="btn btn-primary"
				   href="@($"{NavigationManager.BaseUri}Windowpane/DownloadDFProformaExcelFile?policyRef={Model.ID}")">
					Download D&F Pro-Forma
				</a>
			</div>
			<div class="row">
				<div class="col">
					<p><i>Note: below cards show unformatted data which is mapped to a formatted version in the Excel export.</i></p>
					<DataCard DivClasses="mb-4" HeaderTitle="DFProFormaSummary" MethodName="GetDFProFormaSummary" ID="@Model.ID" />
					<DataCard DivClasses="mb-4" HeaderTitle="DFProFormaPerformance" MethodName="GetDFProFormaPerformance" ID="@Model.ID" />
				</div>
			</div>
		</div>
	</div>
}
else
{
	<ol class="breadcrumb">
		<li class="breadcrumb-item active">VIEW POLICY</li>
	</ol>

	<h1 class="page-header mb-3">View Policy.</h1>
}

@code {
	[Parameter] public string ID { get; set; }

	private WindowpaneViewXModel Model { get; set; } = new();
	private Dictionary<string, string> HeaderData { get; set; } = new();
	private string ActiveTab => "snapshot";
	private List<string> Tabs => new() { "Snapshot", "Premium", "Claims", "Aggregates", "Pricing", "Exceptions", "Audit", "Notes", "Proforma" };

	private List<(string Header, string Method)> SnapshotCards => new()
	{
		("Summary", "GetPolicySnapshotSummary"),
		("Dates", "GetPolicySnapshotDates"),
		("Companies", "GetPolicySnapshotCompanies"),
		("Deductions", "GetPolicySnapshotDeductions"),
		("Documents", "GetPolicySnapshotDocuments"),
		("Geographical", "GetPolicySnapshotGeographical"),
		("History", "GetPolicySnapshotHistory"),
		("KeyStats", "GetPolicySnapshotKeyStats"),
		("LinesLimits", "GetPolicySnapshotLinesLimits"),
		("Period", "GetPolicySnapshotPeriod"),
		("RelatedPolicies", "GetPolicySnapshotRelatedPolicies"),
		("Review", "GetPolicySnapshotReview"),
		("RiskCodes", "GetPolicySnapshotRiskCodes"),
		("Segmentation", "GetPolicySnapshotSegmentation"),
		("Statuses", "GetPolicySnapshotStatuses"),
	};

	protected override void OnInitialized()
	{
		if (!string.IsNullOrWhiteSpace(ID))
		{
			Model.ID = ID;
			HeaderData = WindowpaneService.GetPolicyHeaderKeyValuePairs(ID)
				?? new Dictionary<string, string>();
		}
	}
}
