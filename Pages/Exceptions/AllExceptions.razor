@page "/AllExceptions"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@using Sandbox.Models.Exceptions
@using Sandbox.Services
@inject ExceptionService ExceptionService

<div class="row mt-4 mb-4">
    <h3>Exceptions</h3>
</div>

@if (AllExceptions_ == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row mb-4">
        <div class="col-md-6">
            <label class="form-label">Filter by Class Code</label>
            <select class="form-select" @onchange="OnClassFilterChanged">
                <option value="">All Classes</option>
                @foreach (var classCode in AvailableClasses)
                {
                    <option value="@classCode" selected="@(SelectedClass == classCode)">@classCode</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Filter by Rule</label>
            <select class="form-select" @onchange="OnRuleFilterChanged">
                <option value="">All Rules</option>
                @foreach (var rule in AvailableRules)
                {
                    <option value="@rule" selected="@(SelectedRule == rule)">@rule</option>
                }
            </select>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow mb-4 border">
                <div class="card-body">
                    <h5 class="card-title mb-1">Total Exceptions</h5>
                    <p class="fs-4 fw-bold mb-0">@FilteredExceptions.Count()</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow mb-4 border">
                <div class="card-body">
                    <h5 class="card-title mb-1">Open Exceptions</h5>
                    <p class="fs-4 fw-bold text-danger mb-0">@FilteredExceptions.Count(e => e.Status == "Open")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow mb-4 border">
                <div class="card-body">
                    <h5 class="card-title mb-1">Recently Updated</h5>
                    <p class="fs-4 fw-bold text-warning mb-0">@FilteredExceptions.Count(e => e.LastUpdated >= DateTime.Now.AddDays(-7))</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow mb-4 border">
        <div class="table-responsive">
            <table class="table table-striped table-fixed text-nowrap">
                <colgroup>
                    <col style="width: 6%" />
                    <col style="width: 6%" />
                    <col style="width: 12%" />
                    <col style="width: 8%" />
                    <col style="width: 10%" />
                    <col style="width: 15%" />
                    <col style="width: 15%" />
                    <col style="width: 8%" />
                    <col style="width: 8%" />
                    <col style="width: 6%" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Exception ID</th>
                        <th>Rule ID</th>
                        <th>Business ID</th>
                        <th>Status</th>
                        <th>Prior Status</th>
                        <th>Value</th>
                        <th>Reason</th>
                        <th>Created</th>
                        <th>Last Updated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ex in PagedExceptions)
                    {
                        <tr>
                            <td>@ex.ExceptionID</td>
                            <td>@ex.RuleID</td>
                            <td>@ex.BusinessID</td>
                            <td>
                                <span class="@($"badge {(ex.Status?.Equals("Open", StringComparison.OrdinalIgnoreCase) == true ? "bg-danger" : "bg-success")}")">
                                    @ex.Status
                                </span>
                            </td>
                            <td>@ex.PriorStatus</td>
                            <td>
                                @(
                                                        !string.IsNullOrEmpty(ex.ValueDescriptive) ? ex.ValueDescriptive :
                                                        ex.ValueText ??
                                                        ex.ValueInt?.ToString() ??
                                                        ex.ValueDecimal?.ToString("0.###") ??
                                                        (ex.ValueDate?.ToString("yyyy-MM-dd") ?? "")
                                                        )
                        </td>
                        <td>@ex.Reason</td>
                        <td>@ex.CreatedDate.ToString("yyyy-MM-dd")</td>
                        <td>@ex.LastUpdated?.ToString("yyyy-MM-dd")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick='() => NavigationManager.NavigateTo($"Exception/{ex.RuleID}/{ex.BusinessID}")'>
                                View
                            </button>
                        </td>
                    </tr>
                                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="px-3 pb-3">
        <div class="d-flex justify-content-between align-items-center mt-3">
            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
                @foreach (var size in PageSizeOptions)
                {
                    <option value="@size" selected="@(PageSize == size)">
                        @size per page
                    </option>
                }
            </select>

            <nav>
                <ul class="pagination mb-0">
                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
                    </li>

                    @for (int i = StartPage; i <= EndPage && i <= TotalPages; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                        </li>
                    }

                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                        <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
                    </li>
                </ul>
            </nav>
        </div>
    </div>
}

@code {
    private List<ExceptionRecord> AllExceptions_ = new();
    private List<ExceptionRecord> FilteredExceptions = new();
    private List<ExceptionRecord> PagedExceptions = new();
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalRecords = 0;
    private List<int> PageSizeOptions = new() { 10, 20, 50, 100 };

    private List<string> AvailableClasses = new();
    private List<string> AvailableRules = new();
    private string SelectedClass = "";
    private string SelectedRule = "";

    private const int MaxVisiblePages = 10;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalRecords / PageSize));
    private int StartPage => Math.Max(1, ((CurrentPage - 1) / MaxVisiblePages) * MaxVisiblePages + 1);
    private int EndPage => Math.Min(StartPage + MaxVisiblePages - 1, TotalPages);

    protected override async Task OnInitializedAsync()
    {
        AllExceptions_ = (await ExceptionService.GetExceptions()).ToList();

        // Populate filter options
        AvailableClasses = AllExceptions_
            .Where(e => !string.IsNullOrEmpty(e.Class))
            .Select(e => e.Class!)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        AvailableRules = AllExceptions_
            .Where(e => !string.IsNullOrEmpty(e.RuleDescription))
            .Select(e => e.RuleDescription!)
            .Distinct()
            .OrderBy(r => r)
            .ToList();

        ApplyFilters();
        ApplyPagination();
    }

    private void ApplyFilters()
    {
        FilteredExceptions = AllExceptions_;

        if (!string.IsNullOrEmpty(SelectedClass))
        {
            FilteredExceptions = FilteredExceptions.Where(e => e.Class == SelectedClass).ToList();
        }

        if (!string.IsNullOrEmpty(SelectedRule))
        {
            FilteredExceptions = FilteredExceptions.Where(e => e.RuleDescription == SelectedRule).ToList();
        }
    }

    private void ApplyPagination()
    {
        TotalRecords = FilteredExceptions.Count;
        PagedExceptions = FilteredExceptions
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private async Task GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
            ApplyPagination();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
            ApplyPagination();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnClassFilterChanged(ChangeEventArgs e)
    {
        SelectedClass = e.Value?.ToString() ?? "";
        CurrentPage = 1;
        ApplyFilters();
        ApplyPagination();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRuleFilterChanged(ChangeEventArgs e)
    {
        SelectedRule = e.Value?.ToString() ?? "";
        CurrentPage = 1;
        ApplyFilters();
        ApplyPagination();
        await InvokeAsync(StateHasChanged);
    }
}
