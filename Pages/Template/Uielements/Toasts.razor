// TOASTIFY JS //

    private List<ToastMessage> toastQueue = new();
    private bool isDisplayingToast = false;

    private async Task toastbuttonBtn()
    {
        // Add a new toast to the queue
        toastQueue.Add(new ToastMessage { Id = Guid.NewGuid(), Message = "I'm a toast Message" });

        // Process the queue if not already processing
        if (!isDisplayingToast)
        {
            await ProcessToasts();
        }
    }

    private async Task ProcessToasts()
    {
        isDisplayingToast = true;

        // Process each toast in the queue
        while (toastQueue.Any())
        {
            var toastMessage = toastQueue.First();
            StateHasChanged(); // Trigger UI update

            // Wait for the duration of the toast
            await Task.Delay(2000);

            // Remove the displayed toast from the queue
            toastQueue.Remove(toastMessage);
            StateHasChanged(); // Trigger UI update

            // Wait for a short delay before showing the next toast
            await Task.Delay(500); // Adjust this delay if needed
        }

        isDisplayingToast = false;
    }

    private void CloseToast(Guid id)
    { Console.WriteLine($"Attempting to close toast with Id: {id}");
        var toastToRemove = toastQueue.FirstOrDefault(t => t.Id == id);
        if (toastToRemove != null)
        {
            toastQueue.Remove(toastToRemove);
            StateHasChanged(); // Trigger UI update
        }
    }

    private class ToastMessage
    {
        public Guid Id { get; set; }
        public string? Message { get; set; }
    }
