                </div>
                <div class="card-footer d-none border-top-0">
<!-- Prism Code -->
<pre class="language-html"><code class="language-html">&lt;div class="toast-container position-static"&gt;
&lt;div class="toast fade show" role="alert" aria-live="assertive"
aria-atomic="true"&gt;
