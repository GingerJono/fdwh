@page "/filemanager"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using ApexSeries
@using FilemanagerData
@inject FilemanagerService FilemanagerService

    <!-- Filepond CSS -->
    <link rel="stylesheet" href="@($"{NavigationManager.BaseUri}assets/libs/filepond/dist/filepond.min.css")">
    <link rel="stylesheet" href="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.css")">
    <link rel="stylesheet" href="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-edit/dist/filepond-plugin-image-edit.min.css")">

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start:: row-1 -->
    <div class="row">
        <div class="col-xxl-3">
            <div class="card custom-card">
                <div class="d-flex p-3 flex-wrap gap-2 align-items-center justify-content-between border-bottom">
                    <div class="flex-fill">
                        <h6 class="fw-medium mb-0">File Manager</h6>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3 p-3 border-bottom border-block-end-dashed">
                    <span class="avatar avatar-xl online">
                        <img src="../assets/images/faces/9.jpg" alt="">
                    </span>
                    <div class="main-profile-info">
                        <h6 class="fw-semibold mb-1">Daniel David </h6>
                        <p class="text-muted fs-11 mb-2">Web Designer</p>
                        <p class="mb-0">danieldavid@mail.com </p>
                    </div>
                </div>
                <div class="card-body"> 
                    <ul class="list-unstyled files-main-nav" id="files-main-nav">
                        <li class="px-0 pt-0">
                            <span class="fs-12 text-muted">My Files</span>
                        </li>
                        @foreach(var list in FilemanagerService.GetFileListData().Take(9)){
                            <li class="files-type @(list == FilemanagerService.GetFileListData().ToList().First() ? "active" : "")">
                                <a href="javascript:void(0)">
                                    <div class="d-flex align-items-center">
                                        <div class="me-2">
                                            <i class="@list.Icon fs-16"></i>
                                        </div>
                                        <span class="flex-fill text-nowrap">
                                            @list.Title
                                        </span>
                                        @if(!string.IsNullOrEmpty(list.Total)) {
                                            <SpkBadge BadgeClass="@list.TotalColor">@list.Total</SpkBadge>
                                        }
                                    </div>
                                </a>
                            </li>
                        }
                        <li class="px-0 pt-0">
                            <span class="fs-12 text-muted">Most Recent</span>
                        </li>
                        @foreach(var list in FilemanagerService.GetFileListData().Skip(9).Take(3)){
                        <li>
                            <div class="d-flex align-items-center gap-2">
                                <div class="me-0">
                                    <span class="avatar avatar-md bg-@list.IconColor-transparent text-@list.IconColor">
                                        @((MarkupString)(list.Icon ?? string.Empty))
                                    </span>
                                </div>
                                <div>
                                    <a href="javascript:void(0);" data-bs-toggle="offcanvas"
                                    data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">@list.Title</a>
                                </div>
                                <div class="ms-auto">
                                    <span class="fw-medium text-muted">@list.Total</span>
                                </div>
                            </div>
                        </li>
                        }
                        <li class="px-0 pt-3">
                            <span class="fs-12 text-muted">Upload File</span>
                        </li>
                        <li class="p-4 border border-dashed File-item">
                            <label class="form-label">Drop File here :</label> 
                            <input type="file" class="multiple-filepond" name="filepond" multiple data-allow-reorder="true" data-max-file-size="3MB" data-max-files="6">
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xxl-6">
            <div class="card custom-card overflow-hidden">
                <div class="card-body p-0">
                    <div class="file-manager-folders">
                        <div class="d-flex p-3 flex-wrap gap-2 align-items-center justify-content-between border-bottom">
                            <div class="flex-fill">
                                <h6 class="fw-medium mb-0">All Folders</h6>
                            </div>
                            <div class="d-flex gap-2 flex-lg-nowrap flex-wrap justify-content-sm-end w-75">
                                <div class="input-group">
                                    <input type="text" class="form-control w-50" placeholder="Search File" aria-describedby="button-addon01">
                                    <SpkButtons ButtonClass="btn-primary-light" id="button-addon01"><i class="ri-search-line"></i></SpkButtons>
                                </div>
                                <SpkButtons ButtonClass="btn-primary d-flex align-items-center justify-content-center text-nowrap" ButtonWidth="btn-w-md" data-bs-toggle="modal" data-bs-target="#create-folder"><i class="ri-add-circle-line align-middle me-1"></i>Create Folder</SpkButtons>
                                <div class="modal fade" id="create-folder" tabindex="-1" aria-labelledby="create-folder" data-bs-keyboard="false" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h6 class="modal-title" id="staticBackdropLabel">Create Folder
                                                </h6>
                                                <SpkButtons ButtonClass="btn-close" data-bs-dismiss="modal" aria-label="Close"></SpkButtons>
                                            </div>
                                            <div class="modal-body">
                                                <label for="create-folder1" class="form-label">Folder Name</label>
                                                <input type="text" class="form-control" id="create-folder1" placeholder="Folder Name">
                                            </div>
                                            <div class="modal-footer">
                                                <SpkButtons ButtonClass="btn-icon btn-light" ButtonSize="btn-sm" data-bs-dismiss="modal"><i class="ri-close-fill"></i></SpkButtons>
                                                <SpkButtons ButtonClass="btn-success" ButtonSize="btn-sm">Create</SpkButtons>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <SpkButtons ButtonClass="btn-primary1 d-flex align-items-center justify-content-center text-nowrap" ButtonWidth="btn-w-md" data-bs-toggle="modal" data-bs-target="#create-file"><i class="ri-add-circle-line align-middle me-1"></i>Create File</SpkButtons>
                                <div class="modal fade" id="create-file" tabindex="-1" aria-labelledby="create-file" data-bs-keyboard="false" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h6 class="modal-title" id="staticBackdropLabel1">Create File
                                                </h6>
                                                <SpkButtons ButtonClass="btn-close" data-bs-dismiss="modal" aria-label="Close"></SpkButtons>
                                            </div>
                                            <div class="modal-body">
                                                <label for="create-file1" class="form-label">File Name</label>
                                                <input type="text" class="form-control" id="create-file1" placeholder="File Name">
                                            </div>
                                            <div class="modal-footer">
                                                <SpkButtons ButtonClass="btn-icon btn-light" ButtonSize="btn-sm" data-bs-dismiss="modal"><i class="ri-close-fill"></i></SpkButtons>
                                                <SpkButtons ButtonClass="btn-success" ButtonSize="btn-sm">Create</SpkButtons>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="p-3 file-folders-container">
                            <div class="d-flex mb-3 align-items-center justify-content-between">
                                <p class="mb-0 fw-medium fs-14">Quick Access</p>
                                <a href="javascript:void(0);" class="fs-12 text-muted fw-medium"> View All<i class="ti ti-arrow-narrow-right ms-1"></i> </a>
                            </div>
                            <div class="row mb-3">
                                @foreach(var item in FilemanagerService.GetAccessListData().Take(6)){
                                    <div class="col-xxl-4 col-xl-6 col-lg-6 col-md-6">
                                        <div class="card custom-card shadow-none border">
                                            <div class="card-body">
                                                <div class="d-flex align-items-center gap-3 flex-wrap">
                                                    <div class="main-card-icon @item.IconColor">
                                                        <div class="avatar avatar-md bg-@item.IconColor-transparent border border-@item.IconColor border-opacity-10">
                                                            <div class="avatar avatar-sm text-@item.IconColor">
                                                                <i class="@item.Icon fs-24"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="flex-fill">
                                                        <a href="javascript:void(0);" class="d-block fw-medium">@item.Title</a>
                                                        <span class="fs-12 text-muted">@item.Storage</span>
                                                    </div>
                                                    <div class="text-end">
                                                        <span class="fw-medium">@item.Files</span>
                                                        <span class="d-block fs-12 text-muted">@item.Size</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="d-flex mb-3 align-items-center justify-content-between">
                                <p class="mb-0 fw-medium fs-14">Folders</p>
                                <a href="javascript:void(0);" class="fs-12 text-muted fw-medium"> View All<i class="ti ti-arrow-narrow-right ms-1"></i> </a>
                            </div>
                            <div class="row mb-2">
                                @foreach(var item in FilemanagerService.GetAccessListData().Skip(6).Take(4)){
                                    <div class="col-xxl-3 col-xl-6 col-lg-6 col-md-6">
                                        <div class="card custom-card shadow-none border">
                                            <div class="card-body">
                                                <div class="mb-4 folder-svg-container d-flex flex-wrap justify-content-between align-items-top">
                                                    <div class="avatar">
                                                        <img src="../assets/images/media/file-manager/1.png" alt="" class="img-fluid">
                                                    </div>
                                                    <div>
                                                        <SpkDropdowns DropdownClass="" Tag="a" DropdownText="<i class='ri-more-fill fw-semibold text-muted'></i>" DropdownToggle=false>
                                                            <ChildContent2>
                                                                <ul class="dropdown-menu">
                                                                    <li><a class="dropdown-item" href="javascript:void(0);" @onclick="@(() => DeleteFile(item.Id))">Delete</a></li>
                                                                    <li><a class="dropdown-item" href="javascript:void(0);">Rename</a></li>
                                                                    <li><a class="dropdown-item" href="javascript:void(0);">Hide Folder</a></li>
                                                                </ul>
                                                            </ChildContent2>
                                                        </SpkDropdowns>
                                                    </div>
                                                </div>
                                                <p class="fs-14 fw-medium mb-1 lh-1">
                                                    <a href="javascript:void(0);">@item.Title</a>
                                                </p>
                                                <div class="d-flex align-items-center justify-content-between flex-wrap">
                                                    <div>
                                                        <span class="text-muted fs-12">
                                                            @item.Files
                                                        </span>
                                                    </div>
                                                    <div>
                                                        <span class="text-default fw-medium">
                                                             @item.Size
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="d-flex mb-3 align-items-center justify-content-between">
                                <p class="mb-0 fw-medium fs-14">Recent Files</p>
                                <a href="javascript:void(0);" class="fs-12 text-muted fw-medium"> View All<i class="ti ti-arrow-narrow-right ms-1"></i> </a>
                            </div>
                            <div class="row">
                                <div class="col-xl-12">
                                    <SpkTables Tableclass="text-nowrap table-hover" Items="FilemanagerService.GetFilesHeadersData()" class="files-list" TableResponsiveclass="border border-bottom-0" TableFoot=true>
                                        <ChildContent>
                                            @foreach(var list in FilemanagerService.GetRecentListData()){
                                                <tr class="@(list == FilemanagerService.GetRecentListData().ToList().Skip(2).First() ? "table-active" : "")">
                                                    <th scope="row">
                                                        <div class="d-flex align-items-center">
                                                            <div class="me-0">
                                                                <span class="avatar avatar-md svg-@list.IconColor text-@list.IconColor">
                                                                    @((MarkupString)(list.Icon ?? string.Empty))
                                                                </span>
                                                            </div>
                                                            <div>
                                                                <a href="javascript:void(0);" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">@list.Title</a>
                                                            </div>
                                                        </div>
                                                    </th>
                                                    <td>@list.Category</td>
                                                    <td>@list.Size</td>
                                                    <td>@list.Date</td>
                                                    <td>
                                                        <div class="hstack gap-2 fs-15">
                                                            <SpkButtons Tag="a" ButtonClass="btn-icon btn-primary2-light" ButtonSize="btn-sm"><i class="ri-eye-line"></i></SpkButtons>
                                                            <SpkButtons Tag="a" ButtonClass="btn-icon btn-primary3-light" ButtonSize="btn-sm"  @onclick="@(() => DeleteFileList(list.Id))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </ChildContent>
                                        <ChildContent2>
                                            <tr>
                                                <td colspan="5">
                                                    <nav aria-label="Page navigation">
                                                        <nav aria-label="Page navigation" class="pagination-style-4 float-end">
                                                            <ul class="pagination mb-0">
                                                                <li class="page-item disabled">
                                                                    <a class="page-link" href="javascript:void(0)">
                                                                        Prev
                                                                    </a>
                                                                </li>
                                                                <li class="page-item active"><a class="page-link" href="javascript:void(0)">1</a></li>
                                                                <li class="page-item"><a class="page-link" href="javascript:void(0)">2</a></li>
                                                                <li class="page-item">
                                                                    <a class="page-link text-primary" href="javascript:void(0)">
                                                                        next
                                                                    </a>
                                                                </li>
                                                            </ul>
                                                        </nav>
                                                    </nav>
                                                </td>
                                            </tr>
                                        </ChildContent2>
                                    </SpkTables>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3">
            <div class="card custom-card overflow-hidden">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <div>
                            <span class="avatar avatar-md bg-secondary-transparent">
                                <i class="ri-hard-drive-2-fill fs-16"></i>
                            </span>
                        </div>
                        <div class="flex-fill">
                            <div class=" mb-3"> All Folders
                                <p class="mb-0"><span class="fw-bold fs-14">68.12GB</span> Used</p>
                                <p class="fs-11 text-muted mb-0">21.35GB free space</p>
                            </div>
                        </div>
                    </div>
                    <div id="file-manager-storage">
                        <SpkApex TItem="Storage" ApexHeight="164" Items="storage" ChartOptions="FilemanagerStorageChartOptions" Series="StorageSeriesConfigs"></SpkApex>
                    </div>
                </div>
                <div class="card-footer p-0">
                    <div class="m-3 mb-0">
                        <span class="fs-12 text-muted">Storage Details</span>
                    </div>
                    <ul class="list-group list-group-flush">
                        @foreach(var list in FilemanagerService.GetStorageListData()){
                            <li class="list-group-item">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="main-card-icon @list.IconColor">
                                        <div class="avatar avatar-lg bg-@list.IconColor-transparent border border-@list.IconColor border-opacity-10">
                                            <div class="avatar avatar-sm text-@list.IconColor">
                                                <i class="@list.Icon fs-20"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex-fill">
                                        <span class="fw-medium">@list.Title</span>
                                        <span class="text-muted fs-12 d-block">@list.Files</span>
                                    </div>
                                    <div>
                                        <span class="fw-medium text-@list.IconColor mb-0 fs-14">@list.Size</span>
                                    </div>
                                </div>
                                <SpkProgress ProgressClass="@($"p-1 mt-3 bg-{list.IconColor}-transparent")" ProgressSize="progress-md" ProgressValue="@list.Storage">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-@list.IconColor" style="width: @list.Storage%"></div>
                                </SpkProgress>
                            </li>
                        }
                    </ul>
                </div>
            </div>
            <div class="card custom-card">
                <div class="card-body">
                    <div class="filemanager-upgrade-storage w-100 text-center"> 
                        <span class="d-block mb-3 pb-1 bg-primary1-transparent rounded-2"> <img src="../assets/images/media/file-manager/2.png" alt=""> </span>
                        <span class="fs-16 fw-semibold text-default">Get more storage with Pro.</span>
                        <span class="d-block text-muted mt-2">Upgrade now for increased storage space and enhanced functionality.</span> 
                        <div class="mt-4 d-grid"> 
                            <SpkButtons ButtonClass="btn-primary" ButtonSize="btn-lg">Upgrade Now</SpkButtons>
                        </div> 
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End:: row-1 -->

    <!-- Start::mail information offcanvas -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight">
        <div class="offcanvas-body p-0">
        <div class="selected-file-details">
                <div class="d-flex p-3 align-items-center justify-content-between border-bottom">
                    <div>
                        <h6 class="fw-medium mb-0">File Details</h6>
                    </div>
                    <div class="d-flex align-items-center">
                        <SpkDropdowns DropdownClass="btn btn-sm btn-icon btn-primary-light" DropdownMainClass="me-1" DropdownText="<i class='ri-more-2-fill'></i>" DropdownToggle=false>
                            <ChildContent2>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="javascript:void(0);">Share</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Copy</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Move</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Delete</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Raname</a></li>
                            </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                        <SpkButtons ButtonClass="btn-icon btn-outline-light border" ButtonSize="btn-sm" data-bs-dismiss="offcanvas" aria-label="Close"><i class="ri-close-line"></i></SpkButtons>
                    </div>
                </div>
                <div class="filemanager-file-details" id="filemanager-file-details">
                    <div class="p-3 text-center border-bottom border-block-end-dashed">
                        <div class="file-details mb-3">
                            <img src="../assets/images/media/blog/9.jpg" alt="">
                        </div>
                        <div>
                            <p class="mb-0 fw-medium fs-16">IMG-09123878-SPK734.jpeg</p>
                            <p class="mb-0 text-muted fs-10">422KB | 23,Nov 2024</p>
                        </div>
                    </div>
                    <div class="p-3 border-bottom border-block-end-dashed">
                        <ul class="list-group">
                            <li class="list-group-item">
                                <div>
                                    <span class="fw-medium">File Format : </span><span class="fs-12 text-muted">jpeg</span>
                                </div>
                            </li>
                            <li class="list-group-item">
                                <div>
                                    <p class="fw-medium mb-0">File Description : </p>
                                    <span class="fs-12 text-muted">This file contains 3 folder Sandbox.main & Sandbox.premium & Sandbox.featured and 42 images and layout styles are added in this update.</span>
                                </div>
                            </li>
                            <li class="list-group-item">
                                <p class="fw-medium mb-0">File Location : </p>
                                <span class="fs-12 text-muted">Device/Storage/Archives/IMG-09123878-SPK734.jpeg</span>
                            </li>
                        </ul>
                    </div>
                    <div class="p-3 border-bottom border-block-end-dashed">
                        <p class="mb-1 fw-medium fs-14">Downloaded from :</p>
                        <a class="text-primary fw-medium text-break" href="https://themeforest.net/user/spruko/portfolio" target="_blank">
                            <u>https://themeforest.net/user/spruko/portfolio</u>
                        </a>
                    </div>
                    <div class="p-3">
                        <p class="mb-2 fw-medium fs-14">Shared With :</p>
                        <a href="javascript:void(0);">
                                <div class="d-flex align-items-center p-2 mb-1">
                                <span class="avatar avatar-sm me-2 avatar-rounded">
                                    <img src="../assets/images/faces/1.jpg" alt="">
                                </span>
                                <span class="fw-medium flex-fill">Akira Susan</span>
                                <SpkBadge BadgeClass="bg-success-transparent fw-normal">28,Nov 2024</SpkBadge>
                            </div>
                        </a>
                        <a href="javascript:void(0);">
                            <div class="d-flex align-items-center p-2 mb-1">
                                <span class="avatar avatar-sm me-2 avatar-rounded">
                                    <img src="../assets/images/faces/15.jpg" alt="">
                                </span>
                                <span class="fw-medium flex-fill">Khalid Ahmad</span>
                                <SpkBadge BadgeClass="bg-success-transparent fw-normal">16,Oct 2024</SpkBadge>
                            </div>
                        </a>
                        <a href="javascript:void(0);">
                            <div class="d-flex align-items-center p-2 mb-1">
                                <span class="avatar avatar-sm me-2 avatar-rounded">
                                    <img src="../assets/images/faces/8.jpg" alt="">
                                </span>
                                <span class="fw-medium flex-fill">Jeremiah Jackson</span>
                                <SpkBadge BadgeClass="bg-success-transparent fw-normal">05,Dec 2024</SpkBadge>
                            </div>
                        </a>    
                        <a href="javascript:void(0);">
                            <div class="d-flex align-items-center p-2">
                                <span class="avatar avatar-sm me-2 avatar-rounded">
                                    <img src="../assets/images/faces/13.jpg" alt="">
                                </span>
                                <span class="fw-medium flex-fill">Brigo Jhonson</span>
                                <SpkBadge BadgeClass="bg-success-transparent fw-normal">26,Apr 2024</SpkBadge>
                            </div>
                        </a>    
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End::mail information offcanvas -->

    <!-- Filepond JS -->
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond/dist/filepond.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-exif-orientation/dist/filepond-plugin-image-exif-orientation.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-file-validate-size/dist/filepond-plugin-file-validate-size.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-file-encode/dist/filepond-plugin-file-encode.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-edit/dist/filepond-plugin-image-edit.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-crop/dist/filepond-plugin-image-crop.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-resize/dist/filepond-plugin-image-resize.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/libs/filepond-plugin-image-transform/dist/filepond-plugin-image-transform.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/js/filepond.js")"></script>  


@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Pages" },
        new SpkPageHeader.PageItem { PageTitle = "File Manager" },
    };

    //  Task Activity Start //
    private List<Storage> storage { get; set; } = FilemanagerService.GetStorage();    
    private ApexChartOptions<Storage> FilemanagerStorageChartOptions { get; set; } = new();
    private List<SeriesConfig<Storage>>? StorageSeriesConfigs { get; set; }
    //  Task Activity End //

    protected override void OnInitialized() {

        FilemanagerStorageChartOptions = new ApexChartOptions<Storage> {
            Chart = new () {
                Height ="243",
            }, 
            Stroke = new Stroke { 
                Show= true,
                Curve = Curve.Smooth,
                LineCap = ApexCharts.LineCap.Round,
                Width = 0,
            },
            Legend = new Legend  { 
                Show= false,
            }, 
            Grid = new Grid {
                Padding= new() {
                    Bottom = -100
                }
            },
            Colors = new Color(new List<string> {"var(--primary-color)", "rgba(227, 84, 212, 1)", "rgba(255, 93, 159, 1)", "rgba(255, 142, 88, 1)"}),
            PlotOptions = new PlotOptions {
                Pie = new PlotOptionsPie { 
                    StartAngle = -90,
                    EndAngle = 90,
                    OffsetY = 10,
                    Donut= new PlotOptionsDonut{
                        Size = "75%",
                        Labels = new(){
                            Show = true,
                            Name = new(){
                                Show = true,
                                FontSize = "20px",
                                OffsetY = -3
                            },
                            Value = new(){
                                Show = true,
                                FontSize = "28px",
                                OffsetY = -40,
                                FontWeight = 700,
                                Formatter = @"function (val) {
                                    return val + '%'
                                }"
                            },
                            Total = new(){
                                Show = true,
                                ShowAlways = true,
                                FontSize = "12px",
                                FontWeight = 400,
                                Label = "Used of 720 GB",
                            }
                        }
                    },
                } 
            },
        };
    
        StorageSeriesConfigs = new List<SeriesConfig<Storage>>
        {
            new SeriesConfig<Storage>
            {
                SeriesType = SeriesType.Donut,
                XValueSelector = e => e.Source  ?? "unknown",
                YAggregateSelector = e => e.Sum(e => e.SourceValue)
            },
        };
    }
    
    protected void DeleteFile(decimal Id)
    {
        var FileToRemove = FilemanagerService.GetAccessListData().FirstOrDefault(o => o.Id == Id);
        if (FileToRemove != null)
        {
            FilemanagerService.GetAccessListData().Remove(FileToRemove);
        }
    }
    protected void DeleteFileList(decimal Id)
    {
        var FileToRemove = FilemanagerService.GetRecentListData().FirstOrDefault(o => o.Id == Id);
        if (FileToRemove != null)
        {
            FilemanagerService.GetRecentListData().Remove(FileToRemove);
        }
    }
}
        