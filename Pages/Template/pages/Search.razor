@page "/search-results"
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using SearchData
@inject SearchService SearchService

    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="../assets/libs/glightbox/dist/css/glightbox.min.css">

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card custom-card overflow-hidden">
                <div class="card-body p-0">
                    <div class="p-3 border-bottom">
                        <div class="input-group mb-3 search-result-input gap-2">
                            <input type="text" class="form-control form-control-lg bg-light rounded-pill" placeholder="Search Here ..." aria-label="Search Here ..." aria-describedby="button-addon1">
                            <span class="position-absolute start-0 text-muted mt-3 ms-3 lh-1 search-result-icon"><i class="ri-search-line"></i></span>
                            <SpkButtons ButtonClass="btn-primary" ButtonWidth="btn-w-sm" IsRounded=true id="button-addon1">Search</SpkButtons>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var Taglist in SearchService.GetTagsData())
                            { 
                                <a href="javascript:void(0);">
                                    <SpkBadge Tag="a" BadgeClass="bg-light border text-default" IsRounded=true>@Taglist.Tag<a href="javascript:void(0);"><i class="ri-close-line"></i></a></SpkBadge>
                                </a>
                            }
                            <div class="ms-auto">
                                <a href="javascript:void(0);" class="text-primary text-decoration-underline fw-medium mx-2"> Clear All </a>
                            </div>
                        </div>
                    </div>
                    <div class="p-3 d-flex gap-2 justify-content-between flex-wrap align-items-center">
                        <div class="text-muted">Total of 55,142 results were found.</div>
                        <div class="ms-auto d-flex gap-2">
                            <SpkDropdowns DropdownClass="btn btn-sm btn-light text-muted" Tag="a" DropdownText="Sort By">
                                <ChildContent2>
                                    <ul class="dropdown-menu"> 
                                        <li><a class="dropdown-item" href="javascript:void(0);">Alphabets</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);">First Word</a></li> 
                                        <li><a class="dropdown-item" href="javascript:void(0);">Numeric</a></li>  
                                    </ul> 
                                </ChildContent2>
                            </SpkDropdowns>
                            <SpkDropdowns DropdownClass="btn btn-sm btn-primary" Tag="a" DropdownText="Filter By">
                                <ChildContent2>
                                    <ul class="dropdown-menu"> 
                                    <li><a class="dropdown-item" href="javascript:void(0);">Alphabets</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">First Word</a></li> 
                                    <li><a class="dropdown-item" href="javascript:void(0);">Numeric</a></li> 
                                    </ul> 
                                </ChildContent2>
                            </SpkDropdowns>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 px-3 pt-1 pb-3">
                        <ul class="nav nav-tabs tab-style-6 p-0 search-tab gap-2" role="tablist">
                            <li class="nav-item" role="presentation">
                                <a class="nav-link active fw-medium" data-bs-toggle="tab" role="tab" aria-current="page" href="#search-all" aria-selected="true"><i class="ri-search-line me-2"></i>All</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link fw-medium" data-bs-toggle="tab" role="tab" aria-current="page" href="#search-images" aria-selected="false" tabindex="-1"><i class="ri-image-line me-2"></i>Images</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link fw-medium" data-bs-toggle="tab" role="tab" aria-current="page" href="#search-books" aria-selected="false" tabindex="-1"><i class="ri-book-line me-2"></i>Books</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link fw-medium" data-bs-toggle="tab" role="tab" aria-current="page" href="#search-news" aria-selected="false" tabindex="-1"><i class="ri-newspaper-line me-2"></i>News</a>
                            </li>
                            <li class="nav-item" role="presentation">
                                <a class="nav-link fw-medium" data-bs-toggle="tab" role="tab" aria-current="page" href="#search-videos" aria-selected="false" tabindex="-1"><i class="ri-live-line me-2"></i>Videos</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->
    
    <!-- Start:: row-2 -->
    <div class="row">
        <div class="col-xl-12">
            <div class="tab-content">
                <div class="tab-pane p-0 border-0 show active" id="search-all" role="tabpanel">
                    <div class="row">
                        @foreach(var list in SearchService.GetSearchCardData()){
                            <div class="col-xl-6">
                                <div class="card custom-card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start justify-content-between flex-wrap gap-1 mb-3">
                                            <div>
                                                <div class="">
                                                    <span class="d-block fw-medium"><a href="javascript:void(0);">@list.SubTitle</a></span>
                                                    <a href="javascript:void(0);" class="link-primary1">@list.Url</a>
                                                </div>
                                            </div>
                                            <SpkDropdowns DropdownMainClass="ms-auto" DropdownClass="btn btn-light btn-sm btn-wave" Tag="a" DropdownText="View<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>" DropdownToggle=false>
                                                <ChildContent2>
                                                    <ul class="dropdown-menu" role="menu"> 
                                                        <li><a class="dropdown-item" href="javascript:void(0);">Week</a></li> 
                                                        <li><a class="dropdown-item" href="javascript:void(0);">Day</a></li> 
                                                        <li><a class="dropdown-item" href="javascript:void(0);">Year</a></li> 
                                                    </ul> 
                                                </ChildContent2>
                                            </SpkDropdowns>
                                        </div>
                                        <div class="mb-3">
                                            <h6 class="fw-semibold mb-1"><a href="javascript:void(0)" class="searched-item-main-link">@((MarkupString)(list.Title ?? string.Empty)):</a></h6>
                                            @if(!string.IsNullOrEmpty(list.Desc)){
                                                <span class="text-muted fw-normal fs-13"> @list.Desc.</span>
                                            }
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            @if(list.Tags?.Any() == true){
                                                @foreach (var Taglist in list.Tags)
                                                {
                                                    <a href="javascript:void(0);">
                                                        <SpkBadge Tag="a" BadgeClass="bg-primary-transparent fs-12">@Taglist.Tag</SpkBadge>
                                                    </a>
                                                }
                                            }
                                            <div class="ms-auto">
                                                @if(list.Media?.Any() == true){
                                                    @foreach (var medialist in list.Media?.Take(3) ?? Enumerable.Empty<Media>())
                                                    {
                                                    <img class="avatar avatar-lg flex-shrink-0 ms-1" src="@medialist.Img " alt="">
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <nav aria-label="Page navigation" class="pagination-style-4">
                        <ul class="pagination text-center justify-content-center gap-1">
                            <li class="page-item disabled">
                                <a class="page-link" href="javascript:void(0)">
                                    Prev
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="javascript:void(0)">1</a></li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">2</a></li>
                            <li class="page-item">
                                <a class="page-link" href="javascript:void(0)">
                                    <i class="bi bi-three-dots"></i>
                                </a>
                            </li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">16</a></li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">17</a></li>
                            <li class="page-item">
                                <a class="page-link text-primary" href="javascript:void(0)">
                                    next
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>   
                <div class="tab-pane border-0 p-0" id="search-images" role="tabpanel">
                    <div class="card custom-card">
                        <div class="card-body pb-0">
                            <div class="row">
                                @foreach (var medialist in SearchService.GetMediaData())
                                {
                                    <div class="col-xl-3 col-lg-3 col-md-4 col-sm-6 col-12">
                                        <a href="@medialist.Img" class="glightbox card search-images-card" data-gallery="gallery1">
                                            <img src="@medialist.Img" alt="image" >
                                            <div class="p-3 text-center bg-light">
                                                <div class="d-flex align-items-center gap-1 justify-content-center mb-1">
                                                    <div class="avatar avatar-xs">
                                                        <img src="@medialist.CompanyImg" alt="">
                                                    </div>
                                                    <div class="figure-caption fs-14 fw-medium text-default">@medialist.Title</div>
                                                </div>
                                                <div class="fs-12 text-muted">@medialist.Company</div>
                                            </div>
                                        </a>
                                    </div>
                                }
                                <div class="col-xl-12 mb-4">
                                    <SpkButtons ButtonClass="btn-info-light btn-loader mx-auto">
                                        <span class="me-2">Loading</span>
                                        <span class="loading"><i class="ri-loader-4-line fs-16"></i></span>
                                    </SpkButtons>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> 
                <div class="tab-pane border-0 p-0" id="search-books" role="tabpanel">
                    <div class="row">
                        @foreach (var medialist in SearchService.GetBooksData())
                        {
                            <div class="col-xl-6">
                                <div class="card custom-card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-start flex-wrap gap-3 justify-content-between">
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    <span class="avatar avatar-xl bg-primary bg-opacity-10 border">
                                                        <img src="@medialist.Img" alt="">
                                                    </span>
                                                </div>
                                                <div class="ms-2">
                                                    <div><span class="text-muted">Published On</span> - <span class="fw-medium mb-0">@medialist.Date</span></div>
                                                    <h6 class="fw-medium my-1 d-flex align-items-center"><a href="javascript:void(0);"> @medialist.Title</a></h6>
                                                    <span class="d-block text-muted">@medialist.Desc</span>
                                                </div>
                                            </div> 
                                            <div class="btn-list">
                                                <SpkTooltip Tag="a" TooltipClass="btn btn-sm btn-icon btn-primary1-light" TooltipTitle="Add to favourite"><i class="ri-heart-3-line align-middle"></i></SpkTooltip>
                                                <SpkTooltip Tag="a" TooltipClass="btn btn-sm btn-icon btn-primary2-light me-0" TooltipTitle="Share Link"><i class="ri-share-line"></i></SpkTooltip>
                                            </div>
                                        </div>
                                        <div class="d-flex gap-2 justify-content-between mt-3">
                                            <div class="popular-tags">
                                                @if(medialist.Tags?.Any() == true){
                                                    @foreach (var Taglist in medialist.Tags){
                                                        <SpkBadge Tag="a" BadgeClass="bg-primary-transparent me-1" IsRounded=true>@Taglist.Tag</SpkBadge>
                                                    }
                                                }
                                            </div>
                                            <a href="javascript:void(0);"><span class="fw-semibold">Author:</span> <i>@medialist.Author</i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="col-xl-12 mb-4">
                            <SpkButtons ButtonClass="btn-info-light btn-loader mx-auto">
                                <span class="me-2">Loading</span>
                                <span class="loading"><i class="ri-loader-4-line fs-16"></i></span>
                            </SpkButtons>
                        </div>
                    </div>
                </div>
                <div class="tab-pane border-0 p-0" id="search-news" role="tabpanel">
                    <div class="row">
                        @foreach(var list in SearchService.GetNewsData()){
                            <div class="col-xl-4">
                                <div class="card custom-card">
                                    <div class="card-body">
                                        <a href="javascript:void(0);" class="stretched-link"></a>
                                        <div class="mb-2">
                                            <h6 class="mb-3"> @list.Title</h6>
                                            <div class="mb-1"><i class="ri-calendar-line p-1 bg-primary-transparent text-primary rounded-circle lh-1 mb-1"></i> @list.Date</div>
                                            <div><i class="ri-map-pin-line text-primary1 p-1 bg-primary1-transparent rounded-circle lh-1"></i> @list.Location</div>
                                        </div>
                                        <span class="text-muted">
                                           @list.Desc
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <nav aria-label="Page navigation" class="pagination-style-4">
                        <ul class="pagination text-center justify-content-center gap-1">
                            <li class="page-item disabled">
                                <a class="page-link" href="javascript:void(0)">
                                    Prev
                                </a>
                            </li>
                            <li class="page-item active"><a class="page-link" href="javascript:void(0)">1</a></li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">2</a></li>
                            <li class="page-item">
                                <a class="page-link" href="javascript:void(0)">
                                    <i class="bi bi-three-dots"></i>
                                </a>
                            </li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">16</a></li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0)">17</a></li>
                            <li class="page-item">
                                <a class="page-link text-primary" href="javascript:void(0)">
                                    next
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <div class="tab-pane border-0 p-0" id="search-videos" role="tabpanel">
                    <div class="card custom-card">
                        <div class="card-body pb-1">
                            <div class="row gy-4">
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/HWvHA2FY8Ok?si=Bf-6pyMAcBG-_dR0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">Valex - Bootstrap 5 Admin & Dashboard HTML Template</div>
                                        </div>
                                        <a href="https://www.spruko.com/demo/valex/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://www.spruko.com/demo/valex/</a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/Zx1HjMhcQdE?si=Nhbu6XA2PoyAlYhy" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">Azea - Admin & Dashboard Bootstrap 5 HTML5 Template</div>
                                        </div>
                                        <a href="https://spruko.com/demo/azea/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://spruko.com/demo/azea/</a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/JP_os1DC1MQ?si=qyUJRBl7ZJBhR_P5" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">YNEX - HTML Installation & Usage process</div>
                                        </div>
                                        <a href="https://spruko.com/demo/ynex/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://spruko.com/demo/ynex/</a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/-lDlbQ7DiCI?si=-GRS_5Dco6Qc5ius" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">Sash - Admin and Dashboard Multipurpose HTML Advanced Template</div>
                                        </div>
                                        <a href="https://spruko.com/demo/sash/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://spruko.com/demo/sash/</a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/JP_os1DC1MQ?si=qyUJRBl7ZJBhR_P5" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">Ynex - Bootstrap 5 Admin & Dashboard HTML5 Template</div>
                                        </div>
                                        <a href="https://spruko.com/demo/ynex/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://spruko.com/demo/ynex/</a>
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-3 col-sm-6 col-12">
                                    <div class="ratio ratio-16x9">
                                        <iframe src="https://www.youtube.com/embed/bVRW4Li8inE?si=pOpS9ep2Hn3cGL3y" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                                    </div>    
                                    <div class="p-2">
                                        <div class="d-flex align-items-center gap-1">
                                            <div class="figure-caption fs-13 fw-medium text-default text-truncate">Zanex - Bootstrap 5 Admin & Dashboard HTML5 Template</div>
                                        </div>
                                        <a href="https://spruko.com/demo/zanex/" target="_blank" class="fs-12 link-primary text-decoration-underline">https://spruko.com/demo/zanex/</a>
                                    </div>
                                </div>
                                <div class="col-xl-12 my-3">
                                    <SpkButtons ButtonClass="btn-info-light btn-loader mx-auto">
                                        <span class="me-2">Loading</span>
                                        <span class="loading"><i class="ri-loader-4-line fs-16"></i></span>
                                    </SpkButtons>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End:: row-2 -->

    <!-- Gallery JS -->
    <script src="../assets/libs/glightbox/dist/js/glightbox.min.js"></script>
    <script src="../assets/js/gallery.js"></script>

    
@code {   
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Pages" },
        new SpkPageHeader.PageItem { PageTitle = "Search" },
    }; 
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.interop.initializeTooltips");
        }
    }
}