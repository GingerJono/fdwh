    protected void DeleteTask(decimal Id)
    {
        var TaskRemove = CrmService.GetCrmTasksData().FirstOrDefault(o => o.Id == Id);
        if (TaskRemove != null)
        {
            CrmService.GetCrmTasksData().Remove(TaskRemove);
        }
    } 
    protected void DeleteLead(decimal Id)
    {
        var TaskRemove = CrmService.GetLeadsTableData().FirstOrDefault(o => o.Id == Id);
        if (TaskRemove != null)
        {
            CrmService.GetLeadsTableData().Remove(TaskRemove);
        }
    }
    

