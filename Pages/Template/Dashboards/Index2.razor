@code {    
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Dashboards" },
        new SpkPageHeader.PageItem { PageTitle = "Analytics" },
    };

    // AnalyticChart Start //
    private ApexChartOptions<AnalyticChart> GenerateDynamicChartOptions(AnalyticMainChart mainChart)
    {
        switch (mainChart.Title)
        {
            case "Total Followers":
            return new ApexChartOptions<AnalyticChart>
            {
                Chart = AnalyticChartOptions.Chart,
                Tooltip = AnalyticChartOptions.Tooltip,
                DataLabels = AnalyticChartOptions.DataLabels,
                Grid = AnalyticChartOptions.Grid,
                Xaxis = AnalyticChartOptions.Xaxis,
                Colors = AnalyticChartOptions.Colors,
                Stroke = AnalyticChartOptions.Stroke,
                Fill = AnalyticChartOptions.Fill
            };
            case "Session Rate":
                return new ApexChartOptions<AnalyticChart>
                {
                    Chart = AnalyticChartOptions2.Chart,
                    Tooltip = AnalyticChartOptions2.Tooltip,
                    DataLabels = AnalyticChartOptions2.DataLabels,
                    Grid = AnalyticChartOptions2.Grid,
                    Xaxis = AnalyticChartOptions2.Xaxis,
                    Colors = AnalyticChartOptions2.Colors,
                    Stroke = AnalyticChartOptions2.Stroke,
                    Fill = AnalyticChartOptions2.Fill
                };

            case "Conversion Rate":
                return new ApexChartOptions<AnalyticChart>
                {
                    Chart = AnalyticChartOptions3.Chart,
                    Tooltip = AnalyticChartOptions3.Tooltip,
                    DataLabels = AnalyticChartOptions3.DataLabels,
                    Grid = AnalyticChartOptions3.Grid,
                    Xaxis = AnalyticChartOptions3.Xaxis,
                    Colors = AnalyticChartOptions3.Colors,
                    Stroke = AnalyticChartOptions3.Stroke,
                    Fill = AnalyticChartOptions3.Fill
                };

            default:
                return new ApexChartOptions<AnalyticChart>
                {
                    Chart = AnalyticChartOptions4.Chart,
                    Tooltip = AnalyticChartOptions4.Tooltip,
                    DataLabels = AnalyticChartOptions4.DataLabels,
                    Grid = AnalyticChartOptions4.Grid,
                    Xaxis = AnalyticChartOptions4.Xaxis,
                    Colors = AnalyticChartOptions4.Colors,
                    Stroke = AnalyticChartOptions4.Stroke,
                    Fill = AnalyticChartOptions4.Fill
                };
        }
    }

    private List<SeriesConfig<AnalyticChart>> GenerateDynamicSeriesConfigs(AnalyticMainChart mainChart)
    {
        switch (mainChart.Title) 
        {
            case "Total Followers":
                return new List<SeriesConfig<AnalyticChart>>
                {
                    new SeriesConfig<AnalyticChart>
                    {
                        SeriesType = SeriesType.Area,  
                        XValueSelector = e => e.Series,  
                        YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
                    },
                };

            case "Session Rate":
                return new List<SeriesConfig<AnalyticChart>>
                {
                    new SeriesConfig<AnalyticChart>
                    {
                        SeriesType = SeriesType.Area,
                        XValueSelector = e => e.Series,  
                        YAggregateSelector = items => (decimal?)items.Average(e => e.Value) 
                    },
                };

            case "Conversion Rate":
                return new List<SeriesConfig<AnalyticChart>>
                {
                    new SeriesConfig<AnalyticChart>
                    {
                        SeriesType = SeriesType.Area, 
                        XValueSelector = e => e.Series,  
                        YAggregateSelector = items => (decimal?)items.Max(e => e.Value)
                    },
                };

            default:
                return new List<SeriesConfig<AnalyticChart>>
                {
                    new SeriesConfig<AnalyticChart>
                    {
                        SeriesType = SeriesType.Area,  
                        XValueSelector = e => e.Series,  
                        YAggregateSelector = items => (decimal?)items.Sum(e => e.Value) 
                    },
                };
        }
    }
