    // AnalyticChart Start //
    private ApexChartOptions<T> InitializeChartOptions<T>(List<string> colors) where T : class, ILineGraph
    {
        return new ApexChartOptions<T>
        {
            Chart = new () {
                Toolbar = new ApexCharts.Toolbar {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false,Pan = false, Reset = false,  Download = false},
                }, 
                Width ="100px",
                Height ="85px",
                Sparkline = new () {
                    Enabled = true
                },
                DropShadow = new ApexCharts.DropShadow {
                    Enabled = false,
                },
            },  
            Tooltip = new Tooltip { 
                Enabled= true,
                X= new() {
                    Show= false
                },
                Y = new() {
                    Title=new() {
                        Formatter= @"function (seriesName) {
                            return ''
                        }"
                    }
                },
                Marker = new() {
                    Show= false
                }
            },
            DataLabels = new DataLabels {
                Enabled = false,
            }, 
            Grid = new Grid {
                BorderColor = "transparent",
            },
            Xaxis =  new XAxis {
                Crosshairs= new() {
                    Show= false
                }
            },
            Yaxis = new List<YAxis>() {
                new YAxis {
                    Max = 65,
                }
            },
            Colors = new Color(colors),  // Use the passed color list here
            Stroke = new Stroke { 
                Width = .75,
            },
            Fill = new Fill {
                Type = new List<FillType> { FillType.Gradient},
                Opacity = 0.001,
                Gradient = new FillGradient {
                    Shade = ApexCharts.GradientShade.Light,
                    Type = ApexCharts.GradientType.Horizontal,
                    ShadeIntensity = 0.5,
                    OpacityFrom = 0.35,
                    OpacityTo = 0.05,
                    Stops= [0, 50, 100],
                    ColorStops = new List<FillGradientStops> {
                        new FillGradientStops { Offset = 0, Color = colors.Count > 1 ? colors[1] : colors[0], Opacity = 1 },
                        new FillGradientStops { Offset = 55, Color = colors.Count > 2 ? colors[2] : colors[0], Opacity = 0.1 },
                        new FillGradientStops { Offset = 100, Color = colors.Count > 3 ? colors[3] : colors[0], Opacity = 0.3 },
                    }
                },
            },
        };
    }
    //  AnalyticChart End // 

