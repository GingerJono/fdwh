@page "/index2"
@using ApexCharts
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager 
@using Analytics
@inject AnalyticsService AnalyticsService
@using Sandbox._Spk
@using ApexSeries
@using CardModel

    <!-- Start::page-header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- End::page-header -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xxl-4">
            <div class="card custom-card main-dashboard-banner main-dashboard-banner2 overflow-hidden">
                <div class="card-body p-4">
                    <div class="row justify-content-between">
                        <div class="col-xxl-8 col-xl-4 col-lg-5 col-md-5 col-sm-5">
                            <h4 class="mb-3 fw-medium text-fixed-white">Upgrade to get more</h4>
                            <p class="mb-3 text-fixed-white fs-11">Upgrade Now for Premium Access and Unlock Exclusive Features!</p>
                            <a href="javascript:void(0);" class="fw-medium text-fixed-white text-decoration-underline">Upgrade Now<i class="ti ti-arrow-narrow-right"></i></a>
                        </div>
                        <div class="col-xxl-4 col-xl-7 col-lg-7 col-md-7 col-sm-7 d-sm-block d-none text-end my-auto">
                            <img src="../assets/images/media/media-91.png" alt="" class="img-fluid">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-8">
            <div class="row">
                @foreach(var Mainchart in AnalyticsService.GetAnalyticMainChart()) {
                    var chartItems = AnalyticsService.GetAnalyticChart(Mainchart);
                    var dynamicChartOptions = GenerateDynamicChartOptions(Mainchart);
                    var dynamicSeriesConfigs = GenerateDynamicSeriesConfigs(Mainchart);
                    <div class="col-xxl-3 col-lg-6 col-md-6 col-sm-12">
                        <SpkAnalyticsCard MainCard="Mainchart" 
                        ChartOptions="dynamicChartOptions"
                        ChartItems="@AnalyticsService.GetAnalyticChart(Mainchart)" 
                        SeriesConfigs="dynamicSeriesConfigs" />
                    </div>
                }
            </div>
        </div>
    </div>
    <!--End::row-1 -->

    <!-- Start::row-2 -->
    <div class="row">
        <div class="col-xxl-3">
            <div class="card custom-card">
                <div class="card-header justify-content-between flex-wrap pb-1">
                    <div class="card-title">
                        Activity
                    </div>
                    <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-icons btn-sm text-muted" DropdownToggle=false DropdownText="
                            <i class='fe fe-more-vertical'></i>">
                        <ChildContent2>
                            <ul class="dropdown-menu" role="menu">
                                <li class="border-bottom"><a class="dropdown-item" href="javascript:void(0);">Today</a></li>
                                <li class="border-bottom"><a class="dropdown-item" href="javascript:void(0);">This Week</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last Week</a></li>
                            </ul>
                        </ChildContent2>
                    </SpkDropdowns>
                </div>
                <div class="card-body">
                    <div class="analytics-timeline">
                        <ul class="list-unstyled analytics-activity mb-0">
                            @foreach (var Activity in AnalyticsService.GetAnalyticActivity().ToList()) {
                                  <li class="@(Activity == AnalyticsService.GetAnalyticActivity().ToList().Last() ? "mb-0" : "")">
                                    <div class="d-flex align-items-center gap-2">
                                        <div>
                                            <span class="avatar avatar-md avatar-rounded @Activity.IconClass">
                                                <i class="@Activity.Icon"></i>
                                            </span>
                                        </div>
                                        <div class="flex-fill">
                                            <span class="d-block fw-medium">@Activity.Title</span>
                                            <span class="fs-13 text-muted">@(Activity?.IsIncreased == true ? "Increased by" : "Decreased by") <span class="@(Activity?.IsIncreased == true ? "text-success" : "text-danger") fw-medium ms-1">@Activity?.Percentage
                                               @((MarkupString)(Activity?.IsIncreased == true ? "<i class='ti ti-arrow-narrow-up'></i>" : "<i class='ti ti-arrow-narrow-down'></i>"))
                                                </span></span>
                                        </div>
                                        <div>
                                            <span class="d-block fs-15 mb-0 fw-medium">@Activity?.TotalValue</span>
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-6">
            <div class="card custom-card">
                <div class="card-header justify-content-between">
                    <div class="card-title">
                        Visitor Analytics
                    </div>
                    <div>
                        <SpkButtons ButtonClass="btn-primary-light" ButtonSize="btn-sm"><i class="ri-share-forward-line me-1 align-middle d-inline-block"></i>Export</SpkButtons>
                    </div>
                </div>
                <div class="card-body pb-0">
                    <div id="audienceMetric">
                        <SpkApex TItem="AudienceMetric" ApexHeight="398" ChartOptions="AudienceMetricOptions" Items="audienceMetric" Series="MetricSeriesConfigs" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-3">
            <div class="card custom-card">
                <div class="card-header justify-content-between">
                    <div class="card-title">
                        Users By Countries
                    </div>
                    <div class="">
                        <SpkButtons Tag="a" ButtonClass="btn-light text-muted" ButtonSize="btn-sm">View All</SpkButtons>
                    </div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0 analytics-visitors-countries">
                        @foreach (var Users in AnalyticsService.GetAnalyticUsers()) {
                            <li class="@(Users == AnalyticsService.GetAnalyticUsers().ToList().Last() ? "mb-2" : "mb-4")">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="lh-1">
                                        <span class="avatar avatar-xs avatar-rounded text-default">
                                            <img src="@Users.Icon" alt="">
                                        </span>
                                    </div>
                                    <div class="ms-1 flex-fill lh-1">
                                        <span class="fs-14">@Users.Title</span>
                                    </div>
                                    <div class="@(Users?.IsIncreased == true ? "text-success" : "text-danger") ms-1">@Users?.Percentage%
                                        @((MarkupString)(Users?.IsIncreased == true ? "<i class='ti ti-arrow-narrow-up'></i>" : "<i class='ti ti-arrow-narrow-down'></i>"))
                                    </div>
                                    <div>
                                        <SpkBadge BadgeClass="text-default bg-light fw-medium">@Users?.TotalValue</SpkBadge>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-2 -->

    <!-- Start::row-3 -->
