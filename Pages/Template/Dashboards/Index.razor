    // Generic method to initialize chart options

    private ApexChartOptions<LineGraphChart> GenerateDynamicChartOptions(OverallStats overallStats)
    {
        var optionsMap = new Dictionary<string, ApexChartOptions<LineGraphChart>>
        {
            { "Total Expenses", GraphChartOptions ?? new ApexChartOptions<LineGraphChart>() },
            { "General Leads", LineGraphChart2Options ?? new ApexChartOptions<LineGraphChart>() },
            { "Churn Rate", LineGraphChart3Options ?? new ApexChartOptions<LineGraphChart>() },
            { "New Users", LineGraphChart4Options ?? new ApexChartOptions<LineGraphChart>() },
            { "Returning Users", LineGraphChart5Options ?? new ApexChartOptions<LineGraphChart>() },
        };

        return optionsMap.TryGetValue(overallStats?.Title ?? string.Empty, out var selectedOptions) ? 
        new ApexChartOptions<LineGraphChart>
        {
            Chart = selectedOptions?.Chart,
            Tooltip = selectedOptions?.Tooltip,
            Colors = selectedOptions?.Colors,
            Stroke = selectedOptions?.Stroke,
        }
        : new ApexChartOptions<LineGraphChart>
        {
            Chart = LineGraphChart5Options?.Chart,
            Tooltip = LineGraphChart5Options?.Tooltip,
            Colors = LineGraphChart5Options?.Colors,
            Stroke = LineGraphChart5Options?.Stroke,
        };
    }
    
   private List<SeriesConfig<LineGraphChart>> GenerateDynamicSeriesConfigs()
    {
        return new List<SeriesConfig<LineGraphChart>>
        {
            new SeriesConfig<LineGraphChart>
            {
                SeriesType = SeriesType.Line,
                XValueSelector = e => e.Series,
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            }
        };
    }
    private ApexChartOptions<T> InitializeChartOptions<T>(List<string> colors) where T : class, ILineGraph
    {
        return new ApexChartOptions<T>
        {
            Chart = new ()
            {
                Toolbar = new ApexCharts.Toolbar
                {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false, Pan = false, Reset = false, Download = false },
                },
                Width = "100px",
                Height = "30px",
                Sparkline = new () { Enabled = true },
                DropShadow = new ApexCharts.DropShadow { Enabled = false },
            },
            Tooltip = new Tooltip { Enabled = false },
            Colors = new Color(colors),  // Use the passed color list here
            Stroke = new Stroke { Curve = Curve.Smooth, LineCap = ApexCharts.LineCap.Butt, Width = 2 },
        };
    }

    // Generic method to initialize series configuration
    private List<SeriesConfig<T>> InitializeSeriesConfig<T>() where T : class, ILineGraph
    {
        return new List<SeriesConfig<T>>
        {
            new SeriesConfig<T>
            {
                SeriesType = SeriesType.Line,
                XValueSelector = e => e.Series,
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            },
        };
    }

    private bool selectAll;
    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var OrdersList in Index1Service.GetOrders())
        {
            OrdersList.Selected = selectAll;
        }
    }
    
    protected void DeleteOrder(decimal id)
    {
        var orderToRemove = Index1Service.GetOrders().FirstOrDefault(o => o.id == id);
        if (orderToRemove != null)
        {
            Index1Service.GetOrders().Remove(orderToRemove);
        }
    }
    
