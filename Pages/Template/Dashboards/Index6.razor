@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Dashboards" },
        new SpkPageHeader.PageItem { PageTitle = "NFT" },
    };
    //  Total Statistics  Start //
    private List<Statistics> statistics { get; set; } = NftService.GetStatisticsData();
    private ApexChartOptions<Statistics> StatisticsOptions { get; set; } = new();
    private List<SeriesConfig<Statistics>>? StatisticsSeriesConfigs { get; set; }
    //  Total Statistics  End //

    protected override void OnInitialized() {

        StatisticsOptions = new ApexChartOptions<Statistics> {
            Chart = new () {
                Toolbar = new ApexCharts.Toolbar {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false,Pan = false, Reset = false,  Download = false},
                }, 
                DropShadow = new ApexCharts.DropShadow {
                    Enabled = true,
                    Color = ["var(--primary-color)", "rgb(227, 84, 212)"],
                    Top = 7,
                    Left = 0,
                    Blur = 1,
                    Opacity = 0.05
                }
            },
            Grid = new Grid {
                BorderColor = "#f1f1f1",
                StrokeDashArray = 3
            },
            Colors = new Color(new List<string> {"var(--primary-color)", "rgb(227, 84, 212)"}),
            Stroke = new Stroke { 
                Curve = Curve.Smooth,
                Width= [1.5, 2],
                DashArray= [0, 5],
            },
            DataLabels = new DataLabels {
                Enabled = false,
            },
            Fill = new Fill {
                Type = new List<FillType> { FillType.Solid, FillType.Gradient },
                Gradient = new FillGradient {
                    ShadeIntensity = 0.3,
                    OpacityFrom = 0.23,
                    OpacityTo = 0.23,
                },
            },
            Legend = new Legend {
                Show = false,
            }, 
            Xaxis =  new XAxis {
                AxisBorder = new () {
                    Show = true,
                    Color = "#e9e9e9",
                },
            },
            Yaxis = new List<YAxis>() {
                new YAxis // Define the first YAxis object
                {
                    Min = 35,
                    Max = 65,
                    StepSize = 5,
                }
            },
        };
        StatisticsSeriesConfigs = new List<SeriesConfig<Statistics>>
        {
            new SeriesConfig<Statistics>
            {
                SeriesType = SeriesType.Line,
                Name="Last Year",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.LastYear)
            },
            new SeriesConfig<Statistics>
            {
                SeriesType = SeriesType.Area,
                Name="This Year",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.ThisYear)
            },
        };
    }
}