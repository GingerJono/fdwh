                                    </div>
                                    <div class="m-sm-0 m-2">
                                        <span>Market Cap</span>
                                        <p class="mb-0">$1.32T</p>
                                    </div>
                                </div>
                            </div>
                            <div id="crypto-analysis">
                                <SpkApex TItem="CryptoCandlestickchart" ChartOptions="CryptoChartOptions" Items="CryptoCandlestickcharts" Series="CryptoCandlestickchartSeriesConfig"></SpkApex>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xxl-4">
                    <div class="card custom-card">
