                                    var chartItems = CryptoService.GetCryptoChart(MainCard);
                                    var dynamicChartOptions = GenerateDynamicChartOptions(MainCard);
                                    var dynamicSeriesConfigs = GenerateDynamicSeriesConfigs();
                                    <div class="Carousel-slide">
                                        <SpkCryptoCard MainCard="MainCard" ChartOptions="dynamicChartOptions" ChartItems="@CryptoService.GetCryptoChart(MainCard)" SeriesConfigs="dynamicSeriesConfigs"/>
                                    </div>
                                }
                            </BlazorSlickCarouselContent>
                        </BlazorSlickCarousel>
                    </div>
                </div>
            </div>
            <!-- End::row-1 -->

            <!-- Start:: row-2 -->
            <div class="row">
                <div class="col-xxl-8">
