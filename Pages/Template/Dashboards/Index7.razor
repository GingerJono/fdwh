                                        <li><a class="dropdown-item" href="javascript:void(0);">This week</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);">Last Week</a></li>
                                    </ul>
                                </ChildContent2>
                            </SpkDropdowns>
                        </div>
                        <div class="card-body p-0">
                            <div id="balanceAnalysis">
                                <SpkApex TItem="BalanceAnalysis" ChartOptions="BalanceAnalysisChartOptions" ApexHeight="290" Items="balanceanalysis" Series="BalanceAnalysisSeriesConfig"></SpkApex>
                            </div>
