    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        { 
            await Task.Delay(1000);
            if (theCarousel != null)
            {
                await theCarousel.Destroy();
                await theCarousel.Constroy(theCarousel.Configurations);
            }
        }
    }
