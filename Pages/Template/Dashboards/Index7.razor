        <!-- TomSelect JS -->
        <script src="@($"{NavigationManager.BaseUri}assets/libs/tom-select/dist/js/tom-select.complete.min.js")"></script>
        <script src="@($"{NavigationManager.BaseUri}assets/js/tomselect.js")"></script>


@code {   
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Dashboards" },
        new SpkPageHeader.PageItem { PageTitle = "Crypto" },
    };
    public BlazorSlickCarousel? theCarousel;
    public WMBSCInitialSettings? CryptoConfigurations;

    // CryptoCard Start //
    private ApexChartOptions<CryptoChart> GenerateDynamicChartOptions(CryptoMainChart MainCard) =>
    MainCard.CryptoTitle switch
    {
        "Bitcoin" => BtcChartOptions,
        "Binanace" => BinanaceChartOptions,
        "Cardano" => ADAChartOptions,
        "Ethereum" => ETHChartOptions,
        "Tether" => USDTChartOptions,
        "Ripple" => XRPChartOptions,
        _ => SOLChartOptions
    };
    private List<SeriesConfig<CryptoChart>> GenerateDynamicSeriesConfigs() {
        return new List<SeriesConfig<CryptoChart>>
        {
            new SeriesConfig<CryptoChart>
            {
                SeriesType = SeriesType.Line,  
                XValueSelector = e => e.Series,  
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            },
        };
    } 
    private ApexChartOptions<CryptoChart> BtcChartOptions { get; set; } = new();
    private ApexChartOptions<CryptoChart> BinanaceChartOptions { get; set; } = new();
    private ApexChartOptions<CryptoChart> ADAChartOptions { get; set; } = new();
    private ApexChartOptions<CryptoChart> ETHChartOptions { get; set; } = new(); 
    private ApexChartOptions<CryptoChart> USDTChartOptions { get; set; } = new();
    private ApexChartOptions<CryptoChart> XRPChartOptions { get; set; } = new(); 
    private ApexChartOptions<CryptoChart> SOLChartOptions { get; set; } = new();
    //  CryptoCard End // 

    // CryptoCard Start //
    private ApexChartOptions<PortfolioChart> GeneratePortfolioOptions(Portfolio MainCard) =>
    MainCard.Coin switch
    {
         "Bitcoin - BTC"=> BtcChangeChartOptions ,
         "Etherium - ETH"=> ETHChangeChartOptions ,
         "Tether - USDT"=> USDTChangeChartOptions  ,
         "Solana - SOL"=> SOLChangeChartOptions  ,
         "Cardano - ADA"=> ADAChangeChartOptions  ,
         _ => BNBChangeChartOptions 
    };
    private List<SeriesConfig<PortfolioChart>> GeneratePortfolioSeriesConfigs()
    {
        return new List<SeriesConfig<PortfolioChart>>
        {
            new SeriesConfig<PortfolioChart>
            {
                SeriesType = SeriesType.Line,  
                XValueSelector = e => e.Series,  
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            },
        };
    } 
    private ApexChartOptions<PortfolioChart> BtcChangeChartOptions  { get; set; } = new();
    private ApexChartOptions<PortfolioChart> ETHChangeChartOptions  { get; set; } = new();
    private ApexChartOptions<PortfolioChart> USDTChangeChartOptions { get; set; } = new();
    private ApexChartOptions<PortfolioChart> SOLChangeChartOptions { get; set; } = new(); 
    private ApexChartOptions<PortfolioChart> ADAChangeChartOptions { get; set; } = new();
    private ApexChartOptions<PortfolioChart> BNBChangeChartOptions { get; set; } = new(); 
    //  CryptoCard End // 

    // Coin Analysis Chart Start //
    private List<CryptoCandlestickchart> CryptoCandlestickcharts { get; set; } = CryptoService.GetCryptoData();
    private ApexChartOptions<CryptoCandlestickchart> CryptoChartOptions { get; set; } = new();
    private List<SeriesConfig<CryptoCandlestickchart>>? CryptoCandlestickchartSeriesConfig { get; set; }
    
    // Coin Analysis Chart End //
    
    //  BalanceAnalysis Start //
    private List<BalanceAnalysis> balanceanalysis { get; set; } = CryptoService.BalanceAnalysis();
    private ApexChartOptions<BalanceAnalysis> BalanceAnalysisChartOptions { get; set; } = new();    
    private List<SeriesConfig<BalanceAnalysis>>? BalanceAnalysisSeriesConfig { get; set; }
    //  BalanceAnalysis End //
    protected override void OnInitialized() { 

        WMBSCSettings breakpoint1600Settings = new WMBSCSettings
        {
            slidesToShow = 4,
            arrows = false,
            dots = false,
            slidesToScroll = 1,
