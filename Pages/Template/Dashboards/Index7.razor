                                                </div>
                                                <div class="flex-fill">
                                                    <span class="d-block fw-medium">@crypto.Coin</span>
                                                    <span class="d-block text-muted">@crypto.Coinvalue</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@crypto.Transaction</td>
                                        <td>@crypto.Transactiondate</td>
                                        <td>
                                            <span class="@(crypto.IsIncreased ?"text-success":"text-danger")">@crypto.IncreasedValue<i class="@(crypto.IsIncreased ?"ri-arrow-up-line text-success":"ri-arrow-down-line text-danger") fs-12 lh-1  ms-1"></i></span>
                                        </td>
