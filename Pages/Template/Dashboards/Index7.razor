                                            <span class="@(MainCard.IsIncreased ? "text-success" :"text-danger")"><i class="@(MainCard.IsIncreased ? "ri-arrow-up-s-fill" :"ri-arrow-down-s-fill") me-1 fs-15 align-middle"></i>@MainCard.Change</span>
