@page "/apex-mixed-charts"
@using System.Collections.Generic
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using ApexSeries
@using ApexCharts
@using MixedChartData
@inject MixedChartService MixedChartService

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Line & Column Chart</div>
                </div>
                <div class="card-body">
                    <div id="mixed-linecolumn">
                        <SpkApex TItem="Mixedbasic" Items="Mixedbasics" Title="Traffic Sources" ChartOptions="MixedbasicOptions" XAxisType="XAxisType.Datetime" ApexHeight="320" Series="MixedbasicSeriesConfigs" Debug=true></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Multiple Y-Axis Chart</div>
                </div>
                <div class="card-body">
                    <div id="mixed-multiple-y">
                        <SpkApex TItem="MixedMultiple" Items="MixedMultiples" Title="XYZ - Stock Analysis (2009 - 2016)" ChartOptions="MixedMultipleOptions"  ApexHeight="320" Series="MixedMultipleSeriesConfigs"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Line & Area Chart</div>
                </div>
                <div class="card-body">
                    <div id="mixed-linearea">
                        <SpkApex TItem="MixedLinearea" Items="MixedLineareas"  ChartOptions="MixedLineareaOptions"  ApexHeight="320" Series="MixedLineareaSeriesConfigs"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Line,Column & Area Chart</div>
                </div>
                <div class="card-body">
                    <div id="mixed-all">
                        <SpkApex TItem="MixedAll" Items="MixedAlls"  ChartOptions="MixedAllOptions"  ApexHeight="320" Series="MixedAllSeriesConfigs"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->

@code {    
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Charts" },
        new SpkPageHeader.PageItem { PageTitle = "Apex Charts" },
        new SpkPageHeader.PageItem { PageTitle = "Apex Mixed Charts" },
    };

    // Basic Mixed Chart Start //
    private List<Mixedbasic> Mixedbasics { get; set; } = MixedChartService.GetMixedbasics();
    private ApexChartOptions<Mixedbasic> MixedbasicOptions { get; set; } = new();
    private List<SeriesConfig<Mixedbasic>>? MixedbasicSeriesConfigs { get; set; }
    //  Basic Mixed Chart End //

    // Multiple Mixed Chart Start //
    private List<MixedMultiple> MixedMultiples { get; set; } = MixedChartService.GetMixedMultiples();
    private ApexChartOptions<MixedMultiple> MixedMultipleOptions { get; set; } = new();
    private List<SeriesConfig<MixedMultiple>>? MixedMultipleSeriesConfigs { get; set; }
    //  Multiple Mixed Chart End //

    // Linearea Mixed Chart Start //
    private List<MixedLinearea> MixedLineareas { get; set; } = MixedChartService.GetMixedLineareas();
    private ApexChartOptions<MixedLinearea> MixedLineareaOptions { get; set; } = new();
    private List<SeriesConfig<MixedLinearea>>? MixedLineareaSeriesConfigs { get; set; }
    //  Linearea Mixed Chart End //

    // All Mixed Chart Start //
