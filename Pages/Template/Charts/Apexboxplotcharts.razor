                            FontSize = "11px",
                            FontWeight = 600,
                            CssClass = "apexcharts-yaxis-label",
                        },
                    },
                    Min = 20,
                    Max = 100,
                    StepSize = 20,
                }
            },
        };
        BoxplotbasicchartSeriesConfigs = new List<SeriesConfig<Boxplotbasicchart>>
        {
            new SeriesConfig<Boxplotbasicchart>
            {
                Name = "boxPlot",
                XValueSelector = e => e.Name ?? "unknown",
                MinSelector =e => (decimal)e.Min,
                Quantile1Selector =e => (decimal)e.Q1,
                MedianSelector =e => (decimal)e.Median,
                Quantile3Selector =e => (decimal)e.Q3,
                MaxSelector =e => (decimal)e.Max,
