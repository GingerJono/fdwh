            },
            Yaxis = new List<YAxis>() {
                new YAxis // Define the first YAxis object
                {
                    Labels = new YAxisLabels
                    {
                        Show = true,
                        Style = new() {
                            Colors = "#8c9097",
                            FontSize = "11px",
                            FontWeight = 600,
                            CssClass = "apexcharts-yaxis-label",
                        },
                    },
                    Min = 20,
                    Max = 100,
                    StepSize = 20,
                }
            },
        };
        BoxplotTimechartSeriesConfigs = new List<SeriesConfig<BoxplotTimechart>>
        {
            new SeriesConfig<BoxplotTimechart>
            {
                Name = "box",
                XValueSelector = e => e.Date ,
                MinSelector =e => (decimal)e.Min,
                Quantile1Selector =e => (decimal)e.Q1,
                MedianSelector =e => (decimal)e.Median,
                Quantile3Selector =e => (decimal)e.Q3,
                MaxSelector =e => (decimal)e.Max,
            },
        };

        boxplotcolorschartoptions = new ApexChartOptions<Boxplotcolorschart> {
            Title = new Title{
                Style = new TitleStyle {
                    FontSize= "13px",
                    FontWeight= 600,
                    Color= "#8c9097"
                },
            },
            Grid = new Grid {
                BorderColor = "#f2f5f7",
            },
            PlotOptions = new PlotOptions 
            {
                BoxPlot = new PlotOptionsBoxPlot
                {    
                    Colors =  new() {
                        Upper = "#5c67f7",
                        Lower = "#e354d4"
                    }
                }
            },
            Xaxis =  new XAxis {  
                Labels = new XAxisLabels {
                    Show = true,
                    Style = new() {
                        Colors = "#8c9097",
                        FontSize = "11px",
                        FontWeight = 600,
                        CssClass = "apexcharts-xaxis-label",
                    },
                },
            },
            Yaxis = new List<YAxis>() {
                new YAxis // Define the first YAxis object
                {
                    Labels = new YAxisLabels
                    {
                        Show = true,
                        Style = new() {
                            Colors = "#8c9097",
                            FontSize = "11px",
                            FontWeight = 600,
                            CssClass = "apexcharts-yaxis-label",
                        },
                    },
                    Min = 20,
                    Max = 100,
                    StepSize = 20,
                }
            },
        };
        BoxplotcolorschartSeriesConfigs = new List<SeriesConfig<Boxplotcolorschart>>
        {
            new SeriesConfig<Boxplotcolorschart>
            {
                Name = "incidents",
                XValueSelector = e => e.Name ?? "null" ,
                MinSelector =e => (decimal)e.Min,
                Quantile1Selector =e => (decimal)e.Q1,
                MedianSelector =e => (decimal)e.Median,
                Quantile3Selector =e => (decimal)e.Q3,
                MaxSelector =e => (decimal)e.Max,
            },
        };

        boxplothorizontalchartoptions = new ApexChartOptions<Boxplothorizontalchart> {
            Title = new Title{
                Style = new TitleStyle {
                    FontSize= "13px",
                    FontWeight= 600,
                    Color= "#8c9097"
                },
            },
            Grid = new Grid {
                BorderColor = "#f2f5f7",
            },
            PlotOptions = new PlotOptions 
            { 
                Bar = new PlotOptionsBar { Horizontal = true,BarHeight = "50%" },
                BoxPlot = new PlotOptionsBoxPlot
                {   
                    Colors =  new() {
                        Upper = "#e9ecef",
                        Lower = "#f8f9fa"
                    }
                }
            },
            Xaxis =  new XAxis {  
                Labels = new XAxisLabels {
                    Show = true,
                    Style = new() {
