@page "/apex-boxplot-charts"
@using System.Collections.Generic
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using ApexSeries
@using ApexCharts
@using BoxplotData
@inject BoxplotService BoxplotService


    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Basic Boxplot Chart</div>
                </div>
                <div class="card-body">
                    <div id="boxplot-basic">
                        <SpkApex TItem="Boxplotbasicchart" Items="incidents" ApexHeight="320" Title="Basic BoxPlot Chart" ChartOptions="BoxplotbasicchartOptions" Series="BoxplotbasicchartSeriesConfigs" Debug=true></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">Boxplot Time Series Chart</div>
            </div>
            <div class="card-body">
                <div id="boxplot-time-series">
                    <SpkApex TItem="BoxplotTimechart" Items="Timeincidents" ApexHeight="320" Title="BoxPlot - Time Series Chart" ChartOptions="BoxplotTimechartOptions" Series="BoxplotTimechartSeriesConfigs" Debug=true XAxisType="XAxisType.Datetime"></SpkApex>
                </div>
            </div>
        </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Colors Boxplot Chart</div>
                </div>
                <div class="card-body">
                <SpkApex TItem="Boxplotcolorschart" Items="Boxplotcolorschartincidents" ApexHeight="320" ChartOptions="boxplotcolorschartoptions" Series="BoxplotcolorschartSeriesConfigs"></SpkApex>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Horizontal Boxplot Chart</div>
                </div>
                <div class="card-body">
                <SpkApex TItem="Boxplothorizontalchart" Items="Boxplothorizontalchartincidents" ApexHeight="320" ChartOptions="boxplothorizontalchartoptions" Series="BoxplothorizontalchartSeriesConfigs"></SpkApex>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->

@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Charts" },
        new SpkPageHeader.PageItem { PageTitle = "Apex Charts" },
        new SpkPageHeader.PageItem { PageTitle = "Apex Boxplot Charts" },
    };
    // Basic BoxplotChart Start //     
    private List<Boxplotbasicchart> incidents { get; set; } = BoxplotService.GetBoxplotbasiccharts();
    private ApexChartOptions<Boxplotbasicchart> BoxplotbasicchartOptions { get; set; } = new();
    private List<SeriesConfig<Boxplotbasicchart>>? BoxplotbasicchartSeriesConfigs { get; set; }
    // Basic BoxplotChart End //     
    
    // Time BoxplotChart Start //     
    private List<BoxplotTimechart> Timeincidents { get; set; } = BoxplotService.GetBoxplotTimecharts();
    private ApexChartOptions<BoxplotTimechart> BoxplotTimechartOptions { get; set; } = new();
    private List<SeriesConfig<BoxplotTimechart>>? BoxplotTimechartSeriesConfigs { get; set; }
    // Time BoxplotChart End //    

    // Color BoxplotChart Start //     
    private List<Boxplotcolorschart> Boxplotcolorschartincidents { get; set; } = BoxplotService.GetBoxplotcolorscharts();
    private ApexChartOptions<Boxplotcolorschart> boxplotcolorschartoptions { get; set; } = new();
    private List<SeriesConfig<Boxplotcolorschart>>? BoxplotcolorschartSeriesConfigs { get; set; }
    // Color BoxplotChart End //        
   
   // Horizontal BoxplotChart End //        
    private List<Boxplothorizontalchart> Boxplothorizontalchartincidents { get; set; } = BoxplotService.GetBoxplothorizontalcharts();
    private ApexChartOptions<Boxplothorizontalchart> boxplothorizontalchartoptions { get; set; } = new ApexChartOptions<Boxplothorizontalchart>();
    private List<SeriesConfig<Boxplothorizontalchart>>? BoxplothorizontalchartSeriesConfigs { get; set; }
   // Horizontal BoxplotChart End //       
    protected override void OnInitialized()
    {
        BoxplotbasicchartOptions = new ApexChartOptions<Boxplotbasicchart> {
            Title = new Title{
                Style = new TitleStyle {
                    FontSize= "13px",
                    FontWeight= 600,
                    Color= "#8c9097"
                },
            },
            Grid = new Grid {
                BorderColor = "#f2f5f7",
            },
             PlotOptions = new PlotOptions 
            {
                BoxPlot = new PlotOptionsBoxPlot
                {    
                    Colors =  new() {
                        Upper = "#5c67f7",
                        Lower = "#e354d4"
                    }
                }
            },
            Xaxis =  new XAxis {  
                Labels = new XAxisLabels {
                    Show = true,
                    Style = new() {
                        Colors = "#8c9097",
                        FontSize = "11px",
                        FontWeight = 600,
                        CssClass = "apexcharts-xaxis-label",
                    },
                },
            },
