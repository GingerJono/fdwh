@code {   
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Utilities" },
        new SpkPageHeader.PageItem { PageTitle = "Colors" },
    };
}