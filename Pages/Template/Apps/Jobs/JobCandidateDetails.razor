@code {
    
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Apps" },
        new SpkPageHeader.PageItem { PageTitle = "Jobs" },
        new SpkPageHeader.PageItem { PageTitle = "Candidate Details" },
    };
    public WMBSCInitialSettings? VerticalConfigurations;

    protected override void OnInitialized()
    {
         VerticalConfigurations = new WMBSCInitialSettings
        {
            vertical = true,
            verticalSwiping = true,
            arrows = false,
            dots = false,
            slidesToShow = 3,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
            dotsClass = "slick-dots Vertical-slick-dots",
        };
        
        
    }   
}

@code {    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.interop.initializeTooltips");
        }
    }
}