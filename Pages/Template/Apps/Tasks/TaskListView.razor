@page "/task-list-view"
@inject IJSRuntime JSRuntime
@using FlatpickrBlazor
@using FlatpickrBlazor.Components
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using TasksData
@inject TasksService TasksService

    <!-- Flatpickr Css -->
    <link href="_content/FlatpickrBlazor/flatpickr.min.css" rel="stylesheet" />
    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        @foreach(var MainCard in TasksService.GetTaskCardData()) {
            <div class="col-xxl-3 col-xl-6">
                <SpkSalesCard MainCard="MainCard"></SpkSalesCard>
            </div>
        }
    </div>
    <!--End::row-1 -->

    <!-- Start::row-2 -->
    <div class="row">
        <div class="col-xxl-12 col-xl-12">
            <div class="card custom-card">
                <div class="card-header justify-content-between">
                    <div class="card-title">
                        Total Tasks
                    </div>
                    <div class="d-flex">
                        <SpkButtons ButtonClass="btn-primary" ButtonSize="btn-sm" data-bs-toggle="modal" data-bs-target="#create-task"><i class="ri-add-line fw-medium align-middle me-1"></i> Create Task</SpkButtons>
                        <!-- Start::add task modal -->
                        <div class="modal fade" id="create-task" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h6 class="modal-title">Add Task</h6>
                                        <SpkButtons ButtonClass="btn-close" data-bs-dismiss="modal" aria-label="Close"></SpkButtons>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row gy-2">
                                            <div class="col-xl-6">
                                                <label for="task-name" class="form-label">Task Name</label>
                                                <input type="text" class="form-control" id="task-name" placeholder="Task Name">
                                            </div>
                                            <div class="col-xl-6">
                                                <label for="task-id" class="form-label">Task ID</label>
                                                <input type="text" class="form-control" id="task-id" placeholder="Task ID">
                                            </div>
                                            <div class="col-xl-6">
                                                <label class="form-label">Assigned Date</label>
                                                <div class="form-group">
                                                    <div class="input-group">
                                                        <div class="input-group-text text-muted"> <i class="ri-calendar-line"></i> </div>
                                                        <Flatpickr class="form-control" @ref="_datetime" Options="@_flatpickrOptions2"  placeholder="Choose date and time"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-6">
                                                <label class="form-label">Due Date</label>
                                                <div class="form-group">
                                                    <div class="input-group">
                                                        <div class="input-group-text text-muted"> <i class="ri-calendar-line"></i> </div>
                                                        <Flatpickr class="form-control" @ref="_datetime" Options="@_flatpickrOptions2"  placeholder="Choose date and time"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-xl-6">
                                                <label class="form-label">Status</label>
                                                <select class="form-control tomselect">
                                                    <option value="New">New</option>
                                                    <option value="Completed">Completed</option>
                                                    <option value="Inprogress">Inprogress</option>
                                                    <option value="Pending">Pending</option>
                                                </select>
                                            </div>
                                            <div class="col-xl-6">
                                                <label class="form-label">Priority</label>
                                                <select class="form-control tomselect">
                                                    <option value="High">High</option>
                                                    <option value="Medium">Medium</option>
                                                    <option value="Low">Low</option>
                                                </select>
                                            </div>
                                            <div class="col-xl-12">
                                                <label class="form-label">Assigned To</label>
                                                <select class="form-control tomselect-multiple" multiple>
                                                    <option value="Choice 1">Angelina May</option>
                                                    <option value="Choice 2">Sarah Ruth</option>
                                                    <option value="Choice 3">Hercules Jhon</option>
                                                    <option value="Choice 4">Mayor Kim</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <SpkButtons ButtonClass="btn-light" data-bs-dismiss="modal">Cancel</SpkButtons>
                                        <SpkButtons ButtonClass="btn-primary">Add Task</SpkButtons>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End::add task modal -->
                        <SpkDropdowns DropdownMainClass="ms-2" DropdownClass="btn-icon btn-secondary-light btn-sm " DropdownToggle=false DropdownText="<i class='ti ti-dots-vertical'></i>">
                            <ChildContent2>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="javascript:void(0);">New Tasks</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Pending Tasks</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Completed Tasks</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Inprogress Tasks</a></li>
                            </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                </div>
                <div class="card-body p-0">
                    <SpkTables Items="TasksService.GetTasksHeadersData()" Tableclass="text-nowrap" ShowCheckbox=true SelectAllClick="ToggleSelectAll">
                        @foreach (var TaskList in TasksService.GetTaskLists()) {
                            <tr class="task-list">
                                <td class="task-checkbox">
                                    <input class="form-check-input" type="checkbox" value="" @bind="@TaskList.Selected" aria-label="...">
                                </td>
                                <td>
                                    <span class="fw-medium">@TaskList.TaskName</span>
                                </td>
                                <td>
                                    <span class="fw-medium">@TaskList.TaskListId</span>
                                </td>
                                <td>
                                    @TaskList.AssignedDate
                                </td>
                                <td>
                                    <span class="fw-medium @(TaskList.Status == "New" ? "text-primary" : TaskList.Status == "Inprogress" ? "text-secondary":TaskList.Status == "Pending" ? "text-warning" :"text-success")">@TaskList.Status</span>
                                </td>
                                <td>
                                    @TaskList.DueDate
                                </td>
                                <td>
                                    <SpkBadge BadgeClass="@(TaskList.Priority == "High" ? "bg-danger-transparent" : TaskList.Priority == "Medium" ? "bg-secondary-transparent" : "bg-success-transparent")">@TaskList.Priority</SpkBadge>
                                </td>
                                <td>
                                    <div class="avatar-list-stacked">
                                        @foreach (var TeamList in TaskList.TeamList?.Take(3) ?? Enumerable.Empty<TeamList>())
                                        {
                                            <span class="avatar avatar-sm avatar-rounded">
                                                <img src="@TeamList.Img" alt="img">
                                            </span>
                                        }
                                        @if (TaskList.TeamList?.Count > 3)
                                        {
                                            <a class="avatar avatar-sm bg-primary avatar-rounded text-fixed-white" href="javascript:void(0);">
                                                +@((TaskList.TeamList.Count - 3))
                                            </a>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <SpkButtons ButtonClass="btn-primary-light btn-icon" ButtonSize="btn-sm"> <i class="ri-edit-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-danger-light btn-icon ms-1 task-delete-btn" ButtonSize="btn-sm"  @onclick="@(() => { if (TaskList?.TaskListId != null) DeleteTaskList(TaskList.TaskListId); })"> <i class="ri-delete-bin-5-line"></i></SpkButtons>
                                    </div>
                                </td>
                                <td>
                                    <SpkBadge BadgeClass="@(TaskList.Statusupdate == "In Review" ? "bg-info-transparent" : "bg-warning-transparent")">@TaskList.Statusupdate</SpkBadge>
                                </td>
                            </tr>
                        }
                    </SpkTables>
                </div>
                <div class="card-footer border-top-0">
                    <nav aria-label="Page navigation">
                        <ul class="pagination mb-0 float-end">
                            <li class="page-item disabled">
                                <a class="page-link">Previous</a>
                            </li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0);">1</a></li>
                            <li class="page-item active" aria-current="page">
                                <a class="page-link" href="javascript:void(0);">2</a>
                            </li>
                            <li class="page-item"><a class="page-link" href="javascript:void(0);">3</a></li>
                            <li class="page-item">
                                <a class="page-link" href="javascript:void(0);">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-2 -->

    <!-- TomSelect JS -->
    <script src="@($"{NavigationManager.BaseUri}assets/libs/tom-select/dist/js/tom-select.complete.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/js/tomselect.js")"></script>

@code {
    
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Apps" },
        new SpkPageHeader.PageItem { PageTitle = "Task" },
        new SpkPageHeader.PageItem { PageTitle = "Task List View" },
    };
    private bool selectAll;
    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var TaskList in TasksService.GetTaskLists())
        {
            TaskList.Selected = selectAll;
        }
    }
    
    protected void DeleteTaskList(string TaskListId)
    {
        var orderToRemove = TasksService.GetTaskLists().FirstOrDefault(o => o.TaskListId == TaskListId);
        if (orderToRemove != null)
        {
            TasksService.GetTaskLists().Remove(orderToRemove);
        }
    }
    <!-- Flatpickr JS Start -->
    public Flatpickr? _datetime;
    private FlatpickrBlazor.FlatpickrOptions _flatpickrOptions2 = new FlatpickrBlazor.FlatpickrOptions   
    {
        EnableTime = true,
        DateFormat = "Y-m-d H:i",
    };
}