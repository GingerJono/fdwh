@page "/task-details"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using TasksData
@inject TasksService TasksService

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-3">
            <div class="card custom-card overflow-hidden">
                <div class="card-header">
                    <div class="card-title">
                        Task Information
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="p-3 d-flex gap-4 border-bottom bg-light">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="assign" id="assign1" checked="">
                            <label class="form-check-label" for="assign1">
                                Assign Lead
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="assign" id="assign2">
                            <label class="form-check-label" for="assign2">
                                Assign Member
                            </label>
                        </div>
                    </div>
                    <SpkTables>
                        <tr>
                            <td><span class="fw-medium">Task ID :</span></td>
                            <td>SPK - 456</td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Task Tags :</span></td>
                            <td>
                                <SpkBadge BadgeClass="bg-info-transparent">Marketing</SpkBadge>
                                <SpkBadge BadgeClass="bg-primary3-transparent">Campaign</SpkBadge>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Project Name :</span></td>
                            <td>New Product Launch Strategy</td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Assigned By :</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="me-2 lh-1">
                                        <span class="avatar avatar-xs avatar-rounded">
                                            <img src="../assets/images/faces/11.jpg" alt="">
                                        </span>
                                    </div>
                                    <span class="d-block fs-14 fw-medium">Emily Watson</span>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Progress :</span></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <SpkProgress ProgressClass="progress-animate flex-fill me-2" ProgressSize="progress-sm" ProgressValue="45">
                                        <div class="progress-bar bg-primary progress-bar-striped progress-bar-animated" style="width: 45%"></div>
                                    </SpkProgress>
                                    <div class="text-muted fs-11">45%</div>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Project Status :</span></td>
                            <td><span class="fw-medium text-secondary">Inprogress</span></td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Project Priority :</span></td>
                            <td><SpkBadge BadgeClass="bg-danger-transparent"><i class="ri-circle-fill fs-8"></i> High</SpkBadge></td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Start Date :</span></td>
                            <td>13, June 2024</td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">End Date :</span></td>
                            <td> 31, Dec 2024</td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Assigned To :</span></td>
                            <td>
                                <div class="avatar-list-stacked">
                                    <SpkTooltip Tag="span" TooltipClass="avatar avatar-sm avatar-rounded" TooltipCustomClass="tooltip-primary" TooltipTitle="Simon">
                                        <img src="../assets/images/faces/4.jpg" alt="Simon">
                                    </SpkTooltip>
                                    <SpkTooltip Tag="span" TooltipClass="avatar avatar-sm avatar-rounded" TooltipCustomClass="tooltip-primary" TooltipTitle="Sasha">
                                        <img src="../assets/images/faces/12.jpg" alt="Sasha">
                                    </SpkTooltip>
                                    <SpkTooltip Tag="span" TooltipClass="avatar avatar-sm avatar-rounded" TooltipCustomClass="tooltip-primary" TooltipTitle="Anagha">
                                        <img src="../assets/images/faces/5.jpg" alt="Anagha">
                                    </SpkTooltip>
                                    <SpkTooltip Tag="span" TooltipClass="avatar avatar-sm avatar-rounded" TooltipCustomClass="tooltip-primary" TooltipTitle="Hishen">
                                        <img src="../assets/images/faces/6.jpg" alt="Hishen">
                                    </SpkTooltip>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td><span class="fw-medium">Last Updated Date :</span></td>
                            <td>
                                <span class="text-primary1 fw-medium">18, June 2024</span>
                                <span class="text-primary1 fw-medium">10:30</span>
                            </td>
                        </tr>
                    </SpkTables>
                </div>                            
            </div>
            <div class="card custom-card overflow-hidden">
                <div class="card-header">
                    <div class="card-title">Attachments list</div>
                    <SpkButtons Tag="a" ButtonClass="btn-primary-light ms-auto mt-1" ButtonSize="btn-sm">View More</SpkButtons>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach(var List in TasksService.GetAttachmentsListData()){
                            <li class="list-group-item">
                                <div class="d-flex align-items-center flex-wrap gap-2">
                                    <div class="lh-1">
                                        <span class="avatar avatar-rounded p-2 bg-light">
                                            <img src="@List.Project" alt="">
                                        </span>
                                    </div>
                                    <div class="flex-fill">
                                        <a href="javascript:void(0);"><span class="d-block fw-medium">@List.ProjectTitle</span></a>
                                        <span class="d-block text-muted fs-12 fw-normal">@List.Status</span>
                                    </div>
                                    <div class="btn-list">
                                        <SpkButtons ButtonClass="btn-icon btn-info-light" ButtonSize="btn-sm"><i class="ri-edit-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-icon btn-danger-light" ButtonSize="btn-sm" @onclick="@(() => DeleteAttachment(List.ProjectId))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-xl-9">
            <div class="card custom-card">
                <div class="card-header justify-content-between align-items-center">
                    <div class="card-title">Task Details</div>
                    <div class="btn-list">
                        <SpkButtons ButtonClass="btn-primary me-0" ButtonSize="btn-sm"><i class="ri-edit-line me-1 align-middle"></i>Edit Task</SpkButtons>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex gap-2 mb-4 align-items-center">
                        <div class="fs-15 fw-medium">Task Title :</div>
                        <h5 class="fw-medium mb-0"> Develop New Website Features <SpkBadge BadgeClass="bg-primary1-transparent fs-10 fw-medium"># created on 12 June, 2024</SpkBadge></h5>
                    </div>
                    <div class="fs-15 fw-medium mb-2">Task Description :</div>
                    <p class="text-muted mb-4">Enhance existing website features to improve user engagement and streamline user experience. Implement new functionalities to support business growth and adaptability.</p>
                    <div class="row mb-4">
                        <div class="col-xl-6">
                            <div class="fs-15 fw-medium mb-2">Key tasks :</div>
                            <ul class="task-details-key-tasks mb-0">
                                <li>Review current website features and identify areas for improvement.</li>
                                <li>Brainstorm and develop ideas for new website functionalities.</li>
                                <li>Design wireframes and prototypes for new features.</li>
                                <li>Implement front-end and back-end development for new functionalities.</li>
                                <li>Perform comprehensive testing and debugging.</li>
                                <li>Launch and monitor performance of new website features.</li>
                            </ul>
                        </div>
                        <div class="col-xl-6">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="fs-15 fw-medium">Sub Tasks :</div>
                                <SpkButtons Tag="a" ButtonClass="btn-info-light" ButtonSize="btn-sm">See More</SpkButtons>
                            </div>
                            <ul class="list-group mb-0">
                                <li class="list-group-item">
                                    <div class="d-flex align-items-center">
                                        <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                        <div class="fw-medium">Research latest web development trends.</div>
                                    </div>
                                </li>
                                <li class="list-group-item">
                                    <div class="d-flex align-items-center">
                                        <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                        <div class="fw-medium">Create technical specifications document.</div>
                                    </div>
                                </li>
                                <li class="list-group-item">
                                    <div class="d-flex align-items-center">
                                        <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                        <div class="fw-medium">Optimize website for mobile responsiveness.</div>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <div class="fs-15 fw-medium mb-2">Uploads :</div>
                    <div class="d-flex gap-2 mb-0 flex-wrap">
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl">
                            <img src="../assets/images/media/media-37.jpg" alt="File 1">
                        </a>
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl">
                            <img src="../assets/images/media/media-38.jpg" alt="File 2">
                        </a>
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl">
                            <img src="../assets/images/media/media-39.jpg" alt="File 3">
                        </a>
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl">
                            <img src="../assets/images/media/media-40.jpg" alt="File 4">
                        </a>
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl">
                            <img src="../assets/images/media/media-41.jpg" alt="File 5">
                        </a>
                        <a aria-label="anchor" href="javascript:void(0);" class="avatar avatar-xl bg-primary text-fixed-white">
                            +2
                        </a>
                    </div>
                </div>                            
            </div>
            <div class="card custom-card">
                <div class="card-header justify-content-between">
                    <ul class="nav nav-tabs tab-style-8 scaleX profile-settings-tab" id="myTab4" role="tablist">
                        <li class="nav-item flex-fill" role="presentation">
                            <SpkButtons ButtonClass="nav-link bg-primary-transparent px-3 active" id="task-activity" data-bs-toggle="tab" data-bs-target="#task-activity-pane" role="tab" aria-controls="task-activity-pane" aria-selected="true">Task Activity</SpkButtons>
                        </li>
                        <li class="nav-item flex-fill" role="presentation">
                            <SpkButtons ButtonClass="nav-link bg-primary-transparent px-3" id="task-comments-tab" data-bs-toggle="tab" data-bs-target="#task-comments-tab-pane" role="tab" aria-controls="task-comments-tab-pane" aria-selected="false" tabindex="-1">Comments</SpkButtons>
                        </li>
                    </ul>
                </div>
                <div class="card-body tab-content">
                    <div class="tab-pane show active overflow-hidden p-0 border-0" id="task-activity-pane" role="tabpanel" aria-labelledby="task-activity" tabindex="0">
                        <ul class="list-unstyled profile-timeline mb-3">
                            @foreach(var list in TasksService.GetActivityData()) {
                                <SpkActivity activity="list"></SpkActivity>
                            }
                        </ul>
                        <div class="p-3 mt-2 bg-light rounded">
                            <div class="d-sm-flex align-items-center lh-1">
                                <div class="me-sm-3 mb-2 mb-sm-0">
                                    <span class="avatar avatar-md avatar-rounded">
                                        <img src="../assets/images/faces/9.jpg" alt="">
                                    </span>
                                </div>
                                <div class="flex-fill me-sm-2">
                                    <div class="input-group">
                                        <input type="text" class="form-control shadow-none border" placeholder="Post Anything" aria-label="Recipient's username with two button addons">
                                        <SpkButtons ButtonClass="btn-outline-light border"><i class="bi bi-emoji-smile"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-outline-light border"><i class="bi bi-paperclip"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-outline-light border"><i class="bi bi-camera"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-primary">Post</SpkButtons>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane overflow-hidden p-0 border-0" id="task-comments-tab-pane" role="tabpanel" aria-labelledby="task-comments-tab" tabindex="0">
                        <ul class="list-group">
                            <li class="list-group-item">
                                <div class="d-flex align-items-start gap-3 flex-wrap">
                                    <div>
                                        <span class="avatar avatar-lg avatar-rounded">
                                            <img src="../assets/images/faces/1.jpg" alt="">
                                        </span>
                                    </div>
                                    <div class="flex-fill w-50">
                                        <span class="fw-medium d-block mb-1">Mary Cateline</span>
                                        <span class="d-block mb-3">Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium doloremque laudantium, totam rem aperiam, eaque ipsa quae ab illo</span>
                                        <div class="btn-list">
                                            <SpkButtons ButtonClass="btn-primary-light" ButtonSize="btn-sm">Reply<i class="ri-reply-line ms-1"></i></SpkButtons>
                                            <SpkButtons ButtonClass="btn-primary1-light" ButtonSize="btn-sm">View Details<i class="ri-eye-line ms-1"></i></SpkButtons>
                                        </div>
                                    </div>
                                    <div class="btn-list">
                                        <SpkButtons ButtonClass="btn-icon btn-primary2-light" ButtonSize="btn-sm"><i class="ri-thumb-up-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-icon btn-primary3-light" ButtonSize="btn-sm"><i class="ri-thumb-down-line"></i></SpkButtons>
                                    </div>
                                </div>
                            </li>
                            <li class="list-group-item">
                                <div class="d-flex align-items-start gap-3 flex-wrap">
                                    <div>
                                        <span class="avatar avatar-lg avatar-rounded">
                                            <img src="../assets/images/faces/13.jpg" alt="">
                                        </span>
                                    </div>
                                    <div class="flex-fill w-50">
                                        <span class="fw-medium d-block mb-1">Monte vin</span>
                                        <span class="d-block mb-3">Dolorem ipsum quia dolor sit amet, consectetur, adipisci velit, sed quia non numquam eius modi tempora incidunt ut labore et dolore magnam</span>
                                        <div class="btn-list">
                                            <SpkButtons ButtonClass="btn-primary-light" ButtonSize="btn-sm">Reply<i class="ri-reply-line ms-1"></i></SpkButtons>
                                            <SpkButtons ButtonClass="btn-primary1-light" ButtonSize="btn-sm">View Details<i class="ri-eye-line ms-1"></i></SpkButtons>
                                        </div>
                                    </div>
                                    <div class="btn-list">
                                        <SpkButtons ButtonClass="btn-icon btn-primary2-light" ButtonSize="btn-sm"><i class="ri-thumb-up-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-icon btn-primary3-light" ButtonSize="btn-sm"><i class="ri-thumb-down-line"></i></SpkButtons>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->
    
@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Apps" },
        new SpkPageHeader.PageItem { PageTitle = "Task" },
        new SpkPageHeader.PageItem { PageTitle = "Task Details" },
    };
    
    protected void DeleteAttachment(decimal ProjectId)
    {
        var AttachmentToRemove = TasksService.GetAttachmentsListData().FirstOrDefault(o => o.ProjectId == ProjectId);
        if (AttachmentToRemove != null)
        {
            TasksService.GetAttachmentsListData().Remove(AttachmentToRemove);
        }
    }
}