@page "/crm-contacts"
@using FlatpickrBlazor
@using FlatpickrBlazor.Components
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using CrmData
@inject CrmDataService CrmDataService

    <!-- Flatpickr Css -->
    <link href="_content/FlatpickrBlazor/flatpickr.min.css" rel="stylesheet" />

    <!-- Start::page-header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- End::page-header -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card custom-card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="card-title">Contacts <SpkBadge BadgeClass="bg-primary ms-2 fs-12 align-middle">28</SpkBadge> </div>
                    <div class="d-flex flex-wrap gap-2">
                        <SpkButtons ButtonClass="btn-primary" ButtonSize="btn-sm" data-bs-toggle="modal" data-bs-target="#create-contact"><i class="ri-add-line me-1 fw-medium align-middle"></i>Create Contact</SpkButtons>
                        <SpkButtons ButtonClass="btn-success-light" ButtonSize="btn-sm">Export As CSV</SpkButtons>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-sm" DropdownText="Sort By<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>" DropdownToggle=false>
                            <ChildContent2>
                                <ul class="dropdown-menu" role="menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Newest</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Date Added</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">A - Z</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                </div>
                <div class="card-body p-0">
                    <SpkTables Tableclass="text-nowrap table-hover" Items="CrmDataService.GetContactsHeadersData()"  ShowCheckbox=true SelectAllClick="ToggleSelectAll">
                        @foreach (var CrmContacts in CrmDataService.GetCrmContacts()){
                            <tr class="crm-contact contacts-list">
                                <td class="contacts-checkbox">
                                    <input class="form-check-input" type="checkbox" value="" aria-label="..." @bind="@CrmContacts.Selected">
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lh-1">
                                            <span class="avatar avatar-rounded avatar-sm">
                                                <img src="@CrmContacts.ContactImg" alt="">
                                            </span>
                                        </div>
                                        <div>
                                            <a data-bs-toggle="offcanvas" href="#offcanvasExample" role="button" aria-controls="offcanvasExample"><span class="d-block fw-medium">@CrmContacts.ContactName</span></a>
                                            <SpkTooltip TooltipClass="d-block text-muted fs-11" Tag="span" TooltipCustomClass="tooltip-primary" TooltipTitle="Last Contacted"><i class="ri-account-circle-line me-1 fs-13 align-middle"></i>@CrmContacts.ContactDetails</SpkTooltip>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <span class="d-block mb-1"><i class="ri-mail-line me-2 align-middle fs-14 text-muted"></i>@CrmContacts.Email</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lh-1">
                                            <span class="avatar avatar-sm p-1 bg-light avatar-rounded">
                                                <img src="@CrmContacts.CompanyImg" alt="">
                                            </span>
                                        </div>
                                        <div>@CrmContacts.Company</div>
                                    </div>
                                </td>
                                <td>
                                    @CrmContacts.LeadScore
                                </td>
                                <td>
                                    <SpkBadge BadgeClass="@(CrmContacts.Priority == "High"? "bg-danger-transparent" : CrmContacts.Priority == "Medium"? "bg-warning-transparent" :"bg-success-transparent")">@CrmContacts.Priority Priority</SpkBadge>
                                </td>
                                <td>
                                    <div>
                                        <span class="d-block"><i class="ri-phone-line me-2 align-middle fs-14 text-muted"></i>@CrmContacts.Phone</span>
                                    </div>
                                </td>
                                <td>
                                    <SpkBadge BadgeClass="bg-primary-transparent">@CrmContacts.Tag</SpkBadge>
                                </td>
                                <td>
                                    @CrmContacts.LeadSource
                                </td>
                                <td>
                                    <div class="btn-list">
                                        <SpkButtons ButtonClass="btn-primary-light btn-icon" Tag="a" ButtonSize="btn-sm" data-bs-toggle="offcanvas" href="#offcanvasExample" aria-controls="offcanvasExample"><i class="ri-eye-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-info-light btn-icon" ButtonSize="btn-sm"><i class="ri-pencil-line"></i></SpkButtons>
                                        <SpkButtons ButtonClass="btn-primary2-light btn-icon contact-delete" ButtonSize="btn-sm"  @onclick="@(() => DeleteCrmContacts(CrmContacts.ContactId))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                    </div>
                                </td>
                            </tr>
                        }
                    </SpkTables>
                </div>
                <div class="card-footer border-top-0">
                    <div class="d-flex align-items-center">
                        <div>
                            Showing 8 Entries <i class="bi bi-arrow-right ms-2 fw-medium"></i>
                        </div>
                        <div class="ms-auto">
                            <nav aria-label="Page navigation" class="pagination-style-4">
                                <ul class="pagination mb-0">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="javascript:void(0);">
                                            Prev
                                        </a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="javascript:void(0);">1</a></li>
                                    <li class="page-item"><a class="page-link" href="javascript:void(0);">2</a></li>
                                    <li class="page-item">
                                        <a class="page-link text-primary" href="javascript:void(0);">
                                            next
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->

    <!-- Start:: Contact Details Offcanvas -->
