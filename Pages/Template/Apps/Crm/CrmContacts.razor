                <div><SpkBadge BadgeClass="bg-danger-transparent p-1 lh-1 align-middle fs-15 me-1 rounded"><i class="ri-instagram-line"></i></SpkBadge>Instagram</div>
            </div>
            <div class="p-3 border-bottom border-block-end-dashed d-flex align-items-center flex-wrap gap-4">
                <p class="fs-14 mb-0 fw-medium">Social Networks :</p>
                <div class="btn-list mb-0">
                    <SpkButtons ButtonSize="btn-sm" ButtonClass="btn-icon btn-primary-light mb-0">
