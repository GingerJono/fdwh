    protected void DeleteCourseList(decimal CourseId)
    {
        var CourseToRemove = CoursesService.GetCoursesListData().FirstOrDefault(o => o.CourseId == CourseId);
        if (CourseToRemove != null)
        {
            CoursesService.GetCoursesListData().Remove(CourseToRemove);
        }
    }
