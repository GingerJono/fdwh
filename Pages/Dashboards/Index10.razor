@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Dashboards" },
        new SpkPageHeader.PageItem { PageTitle = "Courses" },
    };

    // Earning Start //
    private List<Earning> earning { get; set; } = CoursesService.GetEarning();
    private ApexChartOptions<Earning> EarningChartOptions { get; set; } = new();
    private List<SeriesConfig<Earning>>? EarningSeriesConfig { get; set; }
    // Earning End //
    public BlazorSlickCarousel? theCarousel;
    public WMBSCInitialSettings? CryptoConfigurations;
    protected override void OnInitialized() { 
        
        WMBSCSettings breakpoint1600Settings = new WMBSCSettings
        {
            slidesToShow = 4,
            arrows = false,
            dots = false,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
        };
        WMBSCResponsiveSettings breakpoint1600Responsive = new WMBSCResponsiveSettings
        {
            breakpoint = 1600,
            settings = breakpoint1600Settings
        };
        WMBSCSettings breakpoint1200Settings = new WMBSCSettings
        {
            slidesToShow = 3,
            arrows = false,
            dots = false,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
        };
        WMBSCResponsiveSettings breakpoint1200Responsive = new WMBSCResponsiveSettings
        {
            breakpoint = 1200,
            settings = breakpoint1200Settings
        };
        WMBSCSettings breakpoint768Settings = new WMBSCSettings
        {
            slidesToShow = 2,
            arrows = false,
            dots = false,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
        };
        WMBSCResponsiveSettings breakpoint768Responsive = new WMBSCResponsiveSettings
        {
            breakpoint = 768,
            settings = breakpoint768Settings
        };
        WMBSCSettings breakpoint500Settings = new WMBSCSettings
        {
            slidesToShow = 1,
            arrows = false,
            dots = false,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
        };
        WMBSCResponsiveSettings breakpoint500Responsive = new WMBSCResponsiveSettings
        {
            breakpoint = 500,
            settings = breakpoint500Settings
        };
        List<WMBSCResponsiveSettings> responsiveSettingsList = new List<WMBSCResponsiveSettings>();
        responsiveSettingsList.Add(breakpoint1600Responsive);
        responsiveSettingsList.Add(breakpoint1200Responsive);
        responsiveSettingsList.Add(breakpoint768Responsive);
        responsiveSettingsList.Add(breakpoint500Responsive);
        CryptoConfigurations = new WMBSCInitialSettings
        {
            arrows = false,
            dots = false,
            slidesToShow = 4,
            slidesToScroll = 1,
            infinite = true,
            autoplay = true,
            autoplaySpeed = 1500,
            responsive = responsiveSettingsList,
        };

        EarningChartOptions = new ApexChartOptions<Earning> {
            Chart = new () {
                Toolbar = new ApexCharts.Toolbar {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false,Pan = false, Reset = false,  Download = false},
                }, 
                DropShadow = new ApexCharts.DropShadow {
                    Enabled = true,
                    Color = "#000",
                    Top = 1,
                    Left = 0,
                    Blur = 3,
                    Opacity = 0.1
                },
            },
            Grid = new Grid {
                BorderColor = "rgba(119, 119, 142, 0.1)",
                StrokeDashArray = 4
            },
            Stroke = new Stroke { 
                Curve = Curve.Straight,
                Width = [1.5, 2],
                DashArray = [0, 5],
                Colors = new Color(new List<string> {"var(--primary-color)", "rgba(227, 84, 212, 0.5)"}),
            },
            Legend = new Legend {
                Show = true,
                Position = LegendPosition.Top,
                HorizontalAlign = Align.Center,
                FontWeight = 600,
                FontSize = "11px",
                TooltipHoverFormatter = @"function (val, opts) { return (val +' - ' + opts.w.globals.series[opts.seriesIndex][opts.dataPointIndex] +''); }",
                Labels = new() {
                    Colors = "#74767c",
                },
                Markers=  new(){
                    Width =  8,
                    Height = 8,
                    Radius = 50,
                    OffsetX = 0,
                    OffsetY = 0
                },
            },
            Fill = new Fill {
                Opacity = 1,
                Type = new List<FillType> { FillType.Gradient,FillType.Solid},
                Gradient = new ApexCharts.FillGradient {
                    Shade = ApexCharts.GradientShade.Light,
                    Type = ApexCharts.GradientType.Vertical,
                    GradientToColors = new Color(new List<string> {"var(--primary-color)", "rgba(227, 84, 212, 0.5)"}),
                    ShadeIntensity = 0.01,
                    OpacityFrom =  [0.02,1],
                    OpacityTo = [0.02,1],
                }
            },
            Colors = new Color(new List<string> {"var(--primary-color)", "rgba(227, 84, 212, 0.5)"}),
            DataLabels = new DataLabels {
                Enabled = false,
            }, 
            Yaxis = new List<YAxis>() {
                new YAxis {
                    Show = true,
                    Title = new () {
                        Style = new () {
                            Color = "#adb5be",
                            FontSize = "14px",
                            FontFamily = "poppins, sans-serif",
                            FontWeight = 600,
                            CssClass = "apexcharts-yaxis-label",
                        },
                    },
                    Labels = new YAxisLabels {
                        Show = true,
                        Style = new() {
                            Colors = "#8c9097",
