    // CryptoCard Start //
    private ApexChartOptions<StocksChart> GenerateDynamicChartOptions(CryptoMainChart MainCard) =>
    MainCard.CryptoTitle switch
    {
        "Apple" => Stock1ChartOptions ,
        "Bitcoin" => Stock2ChartOptions ,
        "Tesla" => Stock3ChartOptions ,
        "Amazon" => Stock4ChartOptions ,
        "Aliexpress" => Stock5ChartOptions ,
        "Samsung" => Stock6ChartOptions ,
        _ => Stock7ChartOptions 
    };
    private List<SeriesConfig<StocksChart>> GenerateDynamicSeriesConfigs() {
        return new List<SeriesConfig<StocksChart>>
        {
            new SeriesConfig<StocksChart>
            {
                SeriesType = SeriesType.Line,  
                XValueSelector = e => e.Series,  
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            },
        };
    } 
    private ApexChartOptions<StocksChart> Stock1ChartOptions  { get; set; } = new();
    private ApexChartOptions<StocksChart> Stock2ChartOptions { get; set; } = new();
    private ApexChartOptions<StocksChart> Stock3ChartOptions { get; set; } = new();
    private ApexChartOptions<StocksChart> Stock4ChartOptions { get; set; } = new(); 
    private ApexChartOptions<StocksChart> Stock5ChartOptions { get; set; } = new();
    private ApexChartOptions<StocksChart> Stock6ChartOptions { get; set; } = new(); 
    private ApexChartOptions<StocksChart> Stock7ChartOptions { get; set; } = new();
    //  CryptoCard End // 

    
