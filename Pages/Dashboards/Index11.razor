                                    <div><span class="fs-16 fw-medium">1,153</span> </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-6 col-lg-6">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header  justify-content-between">
                        <div class="card-title">My Stocks</div>
