                            <ChildContent2>
                                <ul class="dropdown-menu dropdown-menu-end" role="menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);"> All Stocks</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Wishlist</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Stocks</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Crypto</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">ETFs</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Bonds</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                    <div class="card-body p-0">
                        <SpkTables Items="StocksService.GetStockslistHeadersData()" Tableclass="table-hover text-nowrap">
                            @foreach( var stocks in StocksService.GetStockslist()){
                                <tr>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <span class="avatar rounded-circle avatar-sm bg-@stocks.StockClass-transparent svg-@stocks.StockClass">
                                                <i class="@stocks.StockIcon fs-16"></i>
                                            </span>
                                            <div class="flex-fill">
                                                <div>@stocks.Stock</div>
                                                <div class="text-muted">@stocks.StockSubTitle</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@stocks.Quantity</td>
                                    <td class="fw-medium">@stocks.Price</td>
                                    <td><span class="@(stocks.IsIncreased ? "text-success":"text-danger")">@stocks.Change</span></td>
                                    <td>@stocks.StockValue</td>
                                    <td class="btn-list">
                                        <SpkButtons Tag="a" ButtonClass="btn-primary-light" ButtonSize="btn-sm">Buy</SpkButtons>
                                        <SpkButtons Tag="a" ButtonClass="btn-primary1-light" ButtonSize="btn-sm">Sell</SpkButtons>
                                    </td>
                                </tr>
                            }
                        </SpkTables>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header justify-content-between">
                        <h6 class="card-title">Growth Analysis</h6>
                        <SpkButtons ButtonClass="btn-light" ButtonSize="btn-sm">View All<i class="ti ti-arrow-narrow-right ms-1"></i></SpkButtons>
                    </div>
                    <div class="card-body pb-1">
                        <div class="p-3 bg-light text-default rounded border border-dashed d-flex justify-content-between gap-2 align-items-end">
                            <div>
                                <span class="d-block mb-1">Tesla, Inc (TSLA)</span>
                                <h5 class="fw-semibold lh-1 mb-0">$ 17,782.00</h5>
                            </div>
                            <SpkBadge BadgeClass="bg-success fw-semibold ms-2">0.64%<i class="ri-arrow-up-s-line ms-1"></i></SpkBadge>
                        </div>
                        <div id="visitors-report">
                            <SpkApex TItem="Analysis" ApexHeight="267" ChartOptions="AnalysisChartOptions" Items="GrowthAnalysis" Series="AnalysisSeriesConfig"></SpkApex>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End:: row-2 -->

        <!-- Start:: row-3 -->
        <div class="row">
            <div class="col-xl-6">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Transaction History
                        </div>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-sm " DropdownToggle=false DropdownText="All<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>">
                            <ChildContent2>
                                <ul class="dropdown-menu dropdown-menu-end" role="menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Buy</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Sell</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                    <div class="card-body p-0">
                        <SpkTables Items="StocksService.GetTransactionHeadersData()" Tableclass="table-hover text-nowrap">
                            @foreach(var Transactions in StocksService.GetTransactionlist()){
                                <tr>
                                    <td>@Transactions.Date</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="avatar avatar-sm p-1 avatar-rounded border border-@Transactions.StockClass border-opacity-10 bg-@Transactions.StockClass-transparent">
                                                @if(!string.IsNullOrEmpty(Transactions.StockImg)) {
                                                    <img src="@Transactions.StockImg" alt="" class="invert-1">
                                                }
                                                else {
                                                    <i class="@Transactions.StockIcon"></i>
                                                }
                                            </span>
                                            <div>
                                                <a href="javascript:void(0);" class="fw-medium">@Transactions.Stock</a>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@Transactions.Shares</td>
                                    <td>
                                        <SpkBadge BadgeClass="@(Transactions.TransactionType ? "bg-primary-transparent":"bg-primary1-transparent")">@(Transactions.TransactionType ? "Buy":"Sell")</SpkBadge>
                                    </td>
                                    <td>
                                        <div class="fw-medium">@Transactions.Price</div>
                                        <div class="text-muted">Value: @Transactions.PriceValue</div>
                                    </td>
                                    <td><span class="@(Transactions.IsIncreased ? "text-success":"text-danger")">@Transactions.Change</span></td>
                                </tr>
                            }
                        </SpkTables>
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Market Movers
                        </div>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-sm " DropdownToggle=false DropdownText="All<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>">
                            <ChildContent2>
                                <ul class="dropdown-menu dropdown-menu-end" role="menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Buy</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Sell</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                    <div class="card-body p-0">
                        <SpkTables Items="StocksService.GetMarketHeadersData()" Tableclass="text-nowrap">
                            @foreach(var Transactions in StocksService.GetMarketList()){
                                <tr>
                                    <td>@Transactions.Symbol</td>
                                    <td>@Transactions.Market</td>
                                    <td><span class="@(Transactions.IsIncreased? "text-success":"text-danger")">@Transactions.Change</span></td>
                                    <td class="fw-medium fs-14">@Transactions.Price</td>
                                    <td><span class="@(Transactions.IsIncreased? "text-success":"text-danger")">@Transactions.Changepercentage</span></td>
                                    <td>@Transactions.Volume</td>
                                </tr>
                            }
                        </SpkTables>
                    </div>
                </div>
            </div>
        </div>
