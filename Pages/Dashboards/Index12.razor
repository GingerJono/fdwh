                        <div class="card-title">Staff Attendance</div>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-sm btn-light text-muted" DropdownText="This week<i class='ri-arrow-down-s-line align-middle ms-1 fs-14 d-inline-block'></i>" DropdownToggle=false>
                        <ChildContent2>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="javascript:void(0);">Today </a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">This week</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Last Week</a></li>
                            </ul>
                        </ChildContent2>
                        </SpkDropdowns>
                    </div>
                    <div class="card-body py-0">
                        <div id="staff-work">
                            <SpkApex TItem="Staff" ApexHeight="335" ChartOptions="StaffChartOptions" Items="Attendance" Series="StaffSeriesConfig"></SpkApex>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End::Row-3 -->

        <!-- Start::Row-4 -->
        <div class="row">
            <div class="col-xl-12">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Patients List
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <div>
                                <input class="form-control form-control-sm " type="text" placeholder="Search Here" aria-label="example">
                            </div>
                            <SpkDropdowns Tag="a" DropdownToggle=false DropdownClass="btn btn-primary btn-sm " DropdownText=" Sort By<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>">
                                <ChildContent2>
                                    <ul class="dropdown-menu" role="menu">
                                        <li><a class="dropdown-item" href="javascript:void(0);">New</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);">Popular</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);">Relevant</a></li>
                                    </ul>
                                </ChildContent2>
                            </SpkDropdowns>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <SpkTables Items="MedicalService.GetPatientsListHeadersData()" Tableclass="text-nowrap">
                            @foreach(var patients in MedicalService.GetPatientsListData()) {

                                    <tr>
                                        <td class="text-center">@patients.Id</td>
                                        <td>@patients.PatientID</td>
                                        <td>
