@page "/index12"
@using ApexCharts
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using ApexSeries
@using CardModel
@using Medical
@inject MedicalService MedicalService

        <!-- Start::page-header -->
        <SpkPageHeader PageItems="PageItems" />
        <!-- End::page-header -->

        <!-- Start::Row-1 -->
        <div class="row">
            <div class="col-xxl-7">
                <div class="card med-banner-card d-flex align-items-center justify-content-between flex-row">
                    <div class="card-body p-4">
                        <div class="row mx-0">
                            <div class="col-md-8">
                                <h4 class="fw-semibold text-fixed-white">Welcome to your Medical Dashboard!</h4>
                                <span class="d-block text-fixed-white op-7 mt-2 pt-1">Simplify medical practice management with streamlined patient profiles, appointment scheduling, and comprehensive record-keeping—all in one platform.</span> 
                                <div class="mt-3"> 
                                    <SpkButtons ButtonClass="btn-primary1" ButtonSize="btn-lg">Get Started <i class="ti ti-arrow-narrow-right ms-1"></i></SpkButtons>
                                </div>
                            </div>
                        </div>
                    </div>
                    <img src="../assets/images/media/media-71.png" alt="" class="img-fluid med-banner-img">
                </div>
            </div>
            <div class="col-xxl-5">
                <div class="row">
                    @foreach(var Medical in MedicalService.GetMedicalData()){
                        <div class="col-sm-6">
                            <SPkMedicalCard MedicalCard="Medical"></SPkMedicalCard>
                        </div>
                    }
                </div>
            </div>
        </div>
        <!-- End::Row-1 -->

        <!-- Start::Row-2 -->
        <div class="row">
            <div class="col-xxl-4">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title">Patients Survey</div>
                        <div class="d-flex gap-2">
                            <SpkButtons ButtonClass="btn-outline-light border btn-full" ButtonSize="btn-sm">Today</SpkButtons>
                            <SpkButtons ButtonClass="btn-outline-light border btn-full" ButtonSize="btn-sm">Weakly</SpkButtons>
                            <SpkButtons ButtonClass="btn-light border btn-full" ButtonSize="btn-sm">Yearly</SpkButtons>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="statistics">
                            <SpkApex TItem="Patients" ApexHeight="361" ChartOptions="PatientsChartOptions" Items="Survey" Series="PatientsSeriesConfig"></SpkApex>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-5">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Doctors List
                        </div>
                        <SpkButtons ButtonClass="btn-light" ButtonSize="btn-sm">View All<i class="ti ti-arrow-narrow-right ms-1"></i></SpkButtons>
                    </div>
                    <div class="card-body p-0">
                        <SpkTables Items="MedicalService.GetDoctorslistHeadersData()" Tableclass="text-nowrap">
                            @foreach(var Medical in MedicalService.GetDoctorsList()){
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@Medical.DoctorImg" alt="" class="avatar avatar-sm avatar-rounded">
                                            <div class="">
                                                <span class="d-block fw-medium lh-1">
                                                    @Medical.Doctor
                                                </span>
                                                <span class="text-muted fs-12">@Medical.Specialist</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@Medical.Qualification</td>
                                    <td>@Medical.Experience</td>
                                    <td>
                                        <div class="btn-list">
                                            <SpkTooltip Tag="a" TooltipClass="btn btn-icon btn-sm rounded-pill btn-primary-light" TooltipPlacement="top" TooltipTitle="View"><i class="ti ti-eye"></i></SpkTooltip>
                                            <SpkTooltip Tag="a" TooltipClass="btn btn-icon btn-sm rounded-pill btn-secondary-light" TooltipPlacement="top" TooltipTitle="Edit"><i class="ti ti-pencil"></i></SpkTooltip>
                                            <SpkTooltip Tag="a" TooltipClass="btn btn-icon btn-sm rounded-pill btn-danger-light" TooltipPlacement="top" TooltipTitle="Delete" @onclick="@(() => DeleteDoctorsList(Medical.Id))"><i class="ti ti-trash"></i></SpkTooltip>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </SpkTables>
                    </div>
                </div>
            </div>
            <div class="col-xxl-3">
                <div class="card custom-card">
                    <div class="card-header justify-content-between">
                        <div class="card-title"> Revenue Statistics</div>
                        <SpkButtons ButtonClass="btn-light" ButtonSize="btn-sm">View All<i class="ti ti-arrow-narrow-right ms-1"></i></SpkButtons>
                    </div>
                    <div class="card-body px-0 my-1">
                        <div id="revenue-stats" class="mx-auto text-center">
                            <SpkApex TItem="RevenueStatistics" ApexHeight="300" ChartOptions="RevenueStatisticsChartOptions" Items="RevenueStatisticsItems" Series="RevenueStatisticsSeriesConfig"></SpkApex>
                        </div>
                    </div>
                    <div class="card-body pt-0">
                        <div class="p-3 bg-light d-flex gap-2 rounded align-items-center flex-wrap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="55" height="55" fill="currentColor" class="flex-shrink-0 text-primary bg-primary-transparent rounded-circle" viewBox="0 0 256 256"><path d="M224,128a96,96,0,1,1-96-96A96,96,0,0,1,224,128Z" opacity="0.2"></path><path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm40-68a28,28,0,0,1-28,28h-4v8a8,8,0,0,1-16,0v-8H104a8,8,0,0,1,0-16h36a12,12,0,0,0,0-24H116a28,28,0,0,1,0-56h4V72a8,8,0,0,1,16,0v8h16a8,8,0,0,1,0,16H116a12,12,0,0,0,0,24h24A28,28,0,0,1,168,148Z"></path></svg>
                            <div>
                                <h5 class="mb-0">$87,847.00</h5>
                                <div class="fw-medium text-muted">Total Revenue
                                </div>
                            </div>
                            <SpkBadge BadgeClass="fw-normal bg-success ms-auto">+ 5.03% <i class="ri-arrow-up-s-fill"></i></SpkBadge>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- End::Row-2 -->

        <!-- Start::Row-3 -->
        <div class="row">
            <div class="col-xxl-3 col-xl-12">
                <div class="card custom-card overflow-hidden">
                    <div class="card-header justify-content-between">
                        <div class="card-title">
                            Patients Overview
                        </div>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-sm text-muted" DropdownToggle=false DropdownText="This Week<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>">
                            <ChildContent2>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Today</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">This Week</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Last Week</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                    <div class="card-body border-bottom border-top py-0">
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6 border-end p-3">
                                <div class="d-flex justify-content-center">
                                    <div>
                                        <span class="avatar avatar-md avatar-rounded p-2 bg-primary-transparent">
                                            <i class="ri-men-line fs-17"></i>
                                        </span>
                                    </div>
                                    <div  class="ms-2">
                                        <h6 class="mb-1 fw-medium">Male</h6>
                                        <p class="mb-0 text-muted">567
                                            <SpkBadge BadgeClass="fw-normal bg-success-transparent ">+2.15%  <i class="ri-arrow-up-s-fill"></i></SpkBadge>
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6 col-6 p-3">
                                <div class="d-flex justify-content-center">
                                    <div>
                                        <span class="avatar avatar-md avatar-rounded p-2 bg-secondary-transparent">
                                            <i class="ri-women-line fs-17"></i>
                                        </span>
                                    </div>
                                    <div class="ms-2">
                                        <h6 class="mb-1 fw-medium">Female</h6>
                                        <p class="mb-0 text-muted">208
                                            <SpkBadge BadgeClass="fw-normal bg-danger-transparent ">- 2.15%  <i class="ri-arrow-down-s-fill"></i></SpkBadge>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="patients-chart">
                            <SpkApex TItem="PatientsOverview" ApexHeight="280" ChartOptions="PatientsOverviewChartOptions" Items="patientsoverview" Series="PatientsOverviewSeriesConfig"></SpkApex>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-xxl-5 col-xl-12">
