    protected void DeleteOrder(decimal id)
    {
        var orderToRemove = EcommerceService.GetEcommerceProducts().FirstOrDefault(o => o.Id == id);
        if (orderToRemove != null)
        {
            EcommerceService.GetEcommerceProducts().Remove(orderToRemove);
        }
    }
