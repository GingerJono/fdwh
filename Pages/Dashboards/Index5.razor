@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Dashboards" },
        new SpkPageHeader.PageItem { PageTitle = "HRM" },
    };
    // HrmMainCard Start //
    private ApexChartOptions<HrmChart> GenerateDynamicChartOptions(HrmMainCard mainChart) =>
    mainChart.Title switch
    {
        "Total Employees" => employeesChartOptions,
        "Total Job Applied" => AppliedChartOptions,
        "Total Compensation" => CompensationChartOptions,
        _ => AnnualCompensationChartOptions
    };
    private List<SeriesConfig<HrmChart>> GenerateDynamicSeriesConfigs()
    {
        return new List<SeriesConfig<HrmChart>>
        {
            new SeriesConfig<HrmChart>
            {
                SeriesType = SeriesType.Area,  
                XValueSelector = e => e.Series,  
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Value)
            },
        };
    }
    private ApexChartOptions<HrmChart> employeesChartOptions { get; set; } = new();
    private ApexChartOptions<HrmChart> AppliedChartOptions { get; set; } = new();
    private ApexChartOptions<HrmChart> CompensationChartOptions { get; set; } = new();
    private ApexChartOptions<HrmChart> AnnualCompensationChartOptions { get; set; } = new();
    //  HrmMainCard End // 
    

    // Project Analysis Start //
    private List<Project> project { get; set; } = HrmService.GetProjectData();
    private ApexChartOptions<Project> ProjectChartOptions { get; set; } = new();
    private List<SeriesConfig<Project>>? ProjectSeriesConfigs { get; set; }
    // Project Analysis End //
    // Project Analysis Start //
    private List<Gender> gender  { get; set; } = HrmService.GetGenderData();
    private ApexChartOptions<Gender> GenderChartOptions { get; set; } = new();
    private List<SeriesConfig<Gender>>? GenderSeriesConfigs { get; set; }
    // Project Analysis End //

    protected override void OnInitialized() {
        // HrmMainCard Start //
        List<string> color1 = new List<string> { "var(--primary-color)","var(--primary01)","var(--primary01)"};
        List<string> color2 = new List<string> { "rgb(227, 84, 212)","rgba(227, 84, 212, 0.1)","rgba(227, 84, 212, 0.1)"};
        List<string> color3 = new List<string> { "rgb(255, 93, 159)","rgba(255, 93, 159, 0.1)","rgba(255, 93, 159, 0.1)"};
        List<string> color4 = new List<string> { "rgb(255, 142, 111)","rgba(255, 142, 111, 0.1)","rgba(255, 142, 111, 0.1)"};
        employeesChartOptions = InitializeChartOptions<HrmChart>(color1);
        AppliedChartOptions = InitializeChartOptions<HrmChart>(color2);
        CompensationChartOptions = InitializeChartOptions<HrmChart>(color3);
        AnnualCompensationChartOptions = InitializeChartOptions<HrmChart>(color4);
        //  HrmMainCard End // 
        
        ProjectChartOptions = new ApexChartOptions<Project> {
            Chart = new () {
                RedrawOnWindowResize= true,
                Toolbar = new ApexCharts.Toolbar {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false,Pan = false, Reset = false,  Download = false},
                }, 
                DropShadow = new ApexCharts.DropShadow {
                    Enabled = false,
                },
            }, 
            PlotOptions = new PlotOptions {
                Bar = new PlotOptionsBar {
                    Horizontal = false,
                    BorderRadius = 3,
                    ColumnWidth = "33%",
                    BorderRadiusApplication = BorderRadiusApplication.Around,
                    BorderRadiusWhenStacked = BorderRadiusWhenStacked.All
                }
            },
            Grid = new Grid {
                BorderColor = "#f5f4f4",
                StrokeDashArray = 5,
                Yaxis = new(){
                    Lines = new(){
                        Show = true,
                    },
                },
            },
            Stroke = new Stroke { 
                Curve = Curve.Smooth,
                LineCap = ApexCharts.LineCap.Butt,
                Width = [5, 5, 2, 2],
                DashArray= [0, 0, 3, 3],
                Show= true,
            },
            DataLabels = new DataLabels {
                Enabled = false,
            }, 
            Colors = new Color(new List<string> { "var(--primary-color)", "rgba(227, 84, 212, 0.4)", "rgba(255, 93, 159, 0.2)", "rgba(255, 142, 111, 0.1)" }),
            Legend = new Legend {
                Show = false,
            },
            Yaxis = new List<YAxis>() {
                new YAxis {
                    Title = new AxisTitle {
                        Style = new AxisTitleStyle {
                            Color = "#adb5be",
                            FontSize = "14px",
                            FontFamily = "poppins, sans-serif",
                            FontWeight = 600,
                            CssClass = "apexcharts-yaxis-label"
                        }
                    },
                    Min = 0,
                    Max = 60,
                    StepSize = 10,
                    Labels = new YAxisLabels {
                        Formatter= @"function (y) {return y.toFixed(0) + '';}",
                    },
                    AxisBorder = new () {
                        Show = true,
                        Color = "rgba(119, 119, 142, 0.05)",
                        OffsetX = 0,
                        OffsetY = 0,
                    },
                    AxisTicks = new () {
                        Show = true,
                        Color = "rgba(119, 119, 142, 0.05)",
                        BorderType = ApexCharts.BorderType.Solid,
                        OffsetX = 0,
                        OffsetY = 0,
                    },
                },
            },
            Xaxis =  new XAxis {
                AxisBorder = new () {
                    Show = true,
                    Color = "rgba(119, 119, 142, 0.05)",
                    OffsetX = 0,
                    OffsetY = 0,
                },
                AxisTicks = new () {
                    Show = true,
                    Color = "rgba(119, 119, 142, 0.05)",
                    BorderType = ApexCharts.BorderType.Solid,
                    OffsetX = 0,
                    OffsetY = 0,
                },
                Labels = new XAxisLabels {
                    Rotate = -90,
                    Show = true,
                },
            },
        };
        ProjectSeriesConfigs = new List<SeriesConfig<Project>>
        {
            new SeriesConfig<Project>
            {
                SeriesType = SeriesType.Bar,
                Name = "New",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.New)
            },
            new SeriesConfig<Project>
            {
                SeriesType = SeriesType.Bar,
                Name = "Inprogress",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Inprogress)
            },
            new SeriesConfig<Project>
            {
                SeriesType = SeriesType.Line,
                Name = "Completed",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Completed)
            },
            new SeriesConfig<Project>
            {
                SeriesType = SeriesType.Area,
                Name = "Onhold",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.Onhold)
            }
        };

        GenderChartOptions = new ApexChartOptions<Gender> {
            Colors = new Color(new List<string> { "var(--primary-color)", "rgb(227, 84, 212)", "rgb(255, 93, 159)" }),
            Fill = new Fill {
                Opacity = 0.9,
            },
            Stroke = new Stroke { 
                Width = 1,
                Colors = null,
            },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
            }
        };
        GenderSeriesConfigs = new List<SeriesConfig<Gender>>
        {
            new SeriesConfig<Gender>
            {
                SeriesType = SeriesType.PolarArea,
                Name = "New",
                XValueSelector = e => e.GenderSeries ?? "unknown",
                YAggregateSelector = items => (decimal?)items.Sum(e => e.GenderValue)
            },
        };
    }
    // HrmMainCard Start //
    private ApexChartOptions<T> InitializeChartOptions<T>(List<string> colors) where T : class, ILineGraph
    {
        return new ApexChartOptions<T>
        {
            Chart = new () {
                Toolbar = new ApexCharts.Toolbar {
                    Tools = new Tools { Zoom = false, Zoomin = false, Zoomout = false,Pan = false, Reset = false,  Download = false},
                }, 
                Height = 50,
                Sparkline = new () {
                    Enabled = true
                },
                DropShadow = new () {
                    Enabled= true,
                    Top= 0,
                    Left= 0,
                    Blur= 3,
                    Color= colors,
                    Opacity= 0.4
                }
            },  
            Colors = new Color(colors),  // Use the passed color list here
            Tooltip = new Tooltip { 
                Enabled= true,
                Fixed = new(){
                    Enabled = false,
                },
                X = new(){
                    Show = false,
                },
                Y = new(){
                    Title = new(){
                        Formatter = @"function (seriesName) {
                        return '';
                        }",
                    },
                },
            },
            Stroke = new Stroke { 
                Show = true,
                Curve = Curve.Straight,
                LineCap = ApexCharts.LineCap.Butt,
                Width = 1,
                DashArray = 0,
            },
            Fill = new Fill {
                Type = new List<FillType> { FillType.Gradient},
                Gradient = new FillGradient {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.5,
                    OpacityTo = 0.2,
                    Stops= [0, 60],
                    ColorStops = new List<FillGradientStops> {
                        new FillGradientStops { Offset = 0, Color = colors.Count > 1 ? colors[1] : colors[0], Opacity = 0.3 },
                        new FillGradientStops { Offset = 60, Color = colors.Count > 2 ? colors[2] : colors[0], Opacity =0.3 },
                    }
                },
            },
        };
    }
