    protected void DeleteEmployee(decimal Id)
    {
        var EmployeeToRemove = HrmService.GetEmployeeList().FirstOrDefault(o => o.Id == Id);
        if (EmployeeToRemove != null)
        {
            HrmService.GetEmployeeList().Remove(EmployeeToRemove);
        }
    }
    
    protected void DeleteEmployeeList(decimal Id)
    {
        var EmployeeToRemove = HrmService.GetEmployeeDirectory().FirstOrDefault(o => o.Id == Id);
        if (EmployeeToRemove != null)
        {
            HrmService.GetEmployeeDirectory().Remove(EmployeeToRemove);
        }
    }


