        <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Basic Bar Chart</div>
                </div>
                <div class="card-body">
                    <div id="bar-basic">
                        <SpkApex TItem="Barbasicchart" Items="Barbasiccharts" ApexHeight="320" ChartOptions="BasicBarChartOptions" Series="BarbasicchartSeriesConfigs" ></SpkApex>
                    </div>
                </div>
            </div>
        </div>
