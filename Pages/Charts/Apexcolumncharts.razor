@page "/apex-column-charts"
@using Sandbox._Spk
@using ApexSeries
@using ApexCharts
@using ColumnData
@inject ColumnService ColumnService

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Basic Column Chart</div>
                </div>
                <div class="card-body">
                    <div id="column-basic">
                        <SpkApex TItem="Columnbasicchart" Items="Columnbasiccharts" ApexHeight="320" ChartOptions="ColumnbasicChartOptions" Series="ColumnbasicchartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Column Chart With Datalabels</div>
                </div>
                <div class="card-body">
                    <div id="column-datalabels">
                        <SpkApex TItem="ColumnDatalabelschart" Items="ColumnDatalabelscharts" ApexHeight="320" ChartOptions="ColumnDatalabelsChartOptions" Series="ColumnDatalabelschartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Stacked Column Chart</div>
                </div>
                <div class="card-body">
                    <div id="column-stacked">
                        <SpkApex TItem="ColumnStackedchart" Items="ColumnStackedcharts" XAxisType="XAxisType.Datetime" ApexHeight="320" ChartOptions="ColumnStackedChartOptions" Series="ColumnStackedchartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">100% Stacked Column Chart</div>
                </div>
                <div class="card-body">
                    <div id="column-stacked-full">
                        <SpkApex TItem="ColumnFullStackedchart" Items="ColumnFullStackedcharts" ApexHeight="320" ChartOptions="ColumnFullStackedChartOptions" Series="ColumnFullStackedchartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Column Chart With Markers</div>
                </div>
                <div class="card-body">
                    <div id="column-markers">
                        <SpkApex TItem="ColumnMarkerschart" Items="ColumnMarkerscharts" ApexHeight="320" ChartOptions="MarkersColumnChartOptions" Series="ColumnMarkerschartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Column Chart With Rotated Labels</div>
                </div>
                <div class="card-body">
                    <div id="column-rotated-labels">
                        <SpkApex TItem="ColumnRotatedchart" Items="ColumnRotatedcharts" ApexHeight="320" ChartOptions="RotatedColumnChartOptions" Series="ColumnRotatedchartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Column Chart With Negative Values</div>
                </div>
                <div class="card-body">
                    <div id="column-negative">
                        <SpkApex TItem="ColumnNegativechart" Items="ColumnNegativecharts" XAxisType="XAxisType.Datetime" ApexHeight="320" ChartOptions="NegativeColumnChartOptions" Series="ColumnNegativechartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Range Column Chart</div>
                </div>
                <div class="card-body">
                    <div id="column-range">
                        <ApexChart TItem="Activity" Height="320" Options=MultiseriesTImelineoptions>
                            @foreach (var TeamGroup in activities.GroupBy(e => e.Team))
                            {
                                <ApexRangeSeries TItem="Activity" Items="TeamGroup" XValue="@(e=> e.Name)" YMinValue="@(e => e.StartValue)" YMaxValue="@(e => e.EndValue)" Name="@TeamGroup.Key" ShowDataLabels />
                            }
                        </ApexChart>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card custom-card">
                <div class="card-header">
                    <div class="card-title">Distributed Columns Chart</div>
                </div>
                <div class="card-body">
                    <div id="columns-distributed">
                        <SpkApex TItem="ColumnDistributedchart" Items="ColumnDistributedcharts" ApexHeight="320" ChartOptions="ColumnDistributedChartOptions" Series="ColumnDistributedchartSeriesConfig"></SpkApex>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->


