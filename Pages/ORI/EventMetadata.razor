@page "/EventMetadata"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Sandbox._Spk
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService

<!-- Start: row-1 -->
<div class="row mt-4 mb-4">

	<h3>Event Metadata</h3>

	<div class="card shadow-sm border-0">
		<div class="position-relative">
			<table class="table table-striped">
				<thead>
					<tr>
						<th>
							Event Code
							<input class="form-control form-control-sm" placeholder="Filter Event Code..." value="@FilterEventCode" @oninput="e => OnEventCodeChanged(e.Value?.ToString())" />
						</th>
						<th>Start Date
							<input class="form-control form-control-sm" placeholder="Filter Start Date..." value="@FilterEventCode" @oninput="e => OnEventStartDateChanged(e.Value?.ToString())" />
						</th>
						<th>
							Peril
							<input class="form-control form-control-sm" placeholder="Filter Peril..." value="@FilterPeril" @oninput="e => OnPerilChanged(e.Value?.ToString())" />
						</th>
						<th>
							Region
							<input class="form-control form-control-sm" placeholder="Filter Region..." value="@FilterRegion" @oninput="e => OnRegionChanged(e.Value?.ToString())" />
						</th>
						<th>
							Description
							<input class="form-control form-control-sm" placeholder="Filter Description..." value="@FilterDescription" @oninput="e => OnDescriptionChanged(e.Value?.ToString())" />
						</th>
						<th class="text-end">Number of Claims</th>
						<th class="text-end">Incurred USD Qtr</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@if (IsLoading)
					{
						<tr>
							<td colspan="7" class="text-center">
								<div class="spinner-border text-secondary" role="status"></div>
							</td>
						</tr>
					}
					else
					{
						@foreach (var ev in CurrentPageEvents)
						{
							<tr>
								<td>@ev.EventCode</td>
								<td>@ev.EventStartDate</td>
								<td>@ev.Peril</td>
								<td>@ev.PerilRegion</td>
								<td>@ev.EventDescription</td>
								<td class="text-end">@ev.NumClaims</td>
								<td class="text-end">@ev.IncurredUSDQtr.ToString("N2")</td>
								<td>
									<button class="btn btn-sm btn-outline-primary"
									@onclick='() => NavigationManager.NavigateTo($"ViewEventMetadata/{ev.EventCode}")'>
										View
									</button>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>

		<div class="d-flex justify-content-between align-items-center">
			<select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
				@foreach (var size in PageSizeOptions)
				{
					<option value="@size" selected="@(PageSize == size)">@size per page</option>
				}
			</select>

			<nav>
				<ul class="pagination mb-0">
					<li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
						<button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
					</li>

					@if (StartPage > 1)
					{
						<li class="page-item">
							<button class="page-link" @onclick="() => ShiftPageWindow(-1)">...</button>
						</li>
					}

					@for (int i = StartPage; i <= EndPage; i++)
					{
						<li class="page-item @(CurrentPage == i ? "active" : "")">
							<button class="page-link" @onclick="() => GoToPage(i)">@i</button>
						</li>
					}

					@if (EndPage < TotalPages)
					{
						<li class="page-item">
							<button class="page-link" @onclick="() => ShiftPageWindow(1)">...</button>
						</li>
					}

					<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
						<button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
					</li>
				</ul>
			</nav>
		</div>
	</div>
</div>

@code {
	private List<EventMetadataListModel> AllEvents = new();
	private List<EventMetadataListModel> CurrentPageEvents = new();
	private int CurrentPage = 1;
	private int PageSize = 50;
	private int TotalRecords = 0;

	private bool IsLoading = false;
	private List<int> PageSizeOptions = new() { 10, 20, 50, 100 };

	private string FilterEventCode = "";
	private string FilterEventStartDate = "";
	private string FilterPeril = "";
	private string FilterRegion = "";
	private string FilterDescription = "";

	private const int MaxVisiblePages = 10;
	private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalRecords / PageSize));
	private int StartPage => Math.Max(1, ((CurrentPage - 1) / MaxVisiblePages) * MaxVisiblePages + 1);
	private int EndPage => Math.Min(StartPage + MaxVisiblePages - 1, TotalPages);

	protected override async Task OnInitializedAsync()
	{
		await LoadEvents();
	}

	private async Task LoadEvents()
	{
		IsLoading = true;
		AllEvents = (await ORIService.GetEventMetadataList()).ToList();
		IsLoading = false;
		await ApplyFilters();
	}

	private async Task ApplyFilters()
	{
		var filtered = AllEvents.Where(ev =>
			(string.IsNullOrWhiteSpace(FilterEventCode) || ev.EventCode?.Contains(FilterEventCode, StringComparison.OrdinalIgnoreCase) == true) &&
			(string.IsNullOrWhiteSpace(FilterEventCode) || ev.EventStartDate?.Contains(FilterEventStartDate, StringComparison.OrdinalIgnoreCase) == true) &&
			(string.IsNullOrWhiteSpace(FilterPeril) || ev.Peril?.Contains(FilterPeril, StringComparison.OrdinalIgnoreCase) == true) &&
			(string.IsNullOrWhiteSpace(FilterRegion) || ev.PerilRegion?.Contains(FilterRegion, StringComparison.OrdinalIgnoreCase) == true) &&
			(string.IsNullOrWhiteSpace(FilterDescription) || ev.EventDescription?.Contains(FilterDescription, StringComparison.OrdinalIgnoreCase) == true)
		);

		TotalRecords = filtered.Count();
		CurrentPageEvents = filtered.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();
	}

	private async Task GoToPage(int page)
	{
		if (page >= 1 && page <= TotalPages)
		{
			CurrentPage = page;
			await ApplyFilters();
		}
	}

	private async Task ShiftPageWindow(int direction)
	{
		int newPage = direction > 0
			? Math.Min(StartPage + MaxVisiblePages, TotalPages)
			: Math.Max(StartPage - MaxVisiblePages, 1);

		await GoToPage(newPage);
	}

	private async Task OnPageSizeChange(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int newSize))
		{
			PageSize = newSize;
			CurrentPage = 1;
			await ApplyFilters();
		}
	}

	private async Task OnEventCodeChanged(string value)
	{
		FilterEventCode = value;
		CurrentPage = 1;
		await ApplyFilters();
	}

	private async Task OnEventStartDateChanged(string value)
	{
		FilterEventStartDate = value;
		CurrentPage = 1;
		await ApplyFilters();
	}

	private async Task OnPerilChanged(string value)
	{
		FilterPeril = value;
		CurrentPage = 1;
		await ApplyFilters();
	}

	private async Task OnRegionChanged(string value)
	{
		FilterRegion = value;
		CurrentPage = 1;
		await ApplyFilters();
	}

	private async Task OnDescriptionChanged(string value)
	{
		FilterDescription = value;
		CurrentPage = 1;
		await ApplyFilters();
	}
}
