@page "/EditORIPolicy/{ORIPolicyReference}"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@using Sandbox._Spk
@using CardModel
@using FlatpickrBlazor
@using FlatpickrBlazor.Components
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService

<!-- Flatpickr Css -->
<link href="@($"{NavigationManager.BaseUri}_content/FlatpickrBlazor/flatpickr.min.css")" rel="stylesheet" />
<link href="@($"{NavigationManager.BaseUri}_content/FlatpickrBlazor/plugins/monthSelect/style.css")" rel="stylesheet" />

@if (IsLoading)
{
	<p>Loading policy details...</p>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
	<p class="text-danger">@ErrorMessage</p>
}
else if (PolicyDetails != null)
{
	<nav aria-label="breadcrumb">
		<ol class="breadcrumb">
			<li class="breadcrumb-item"><a href="/ORIPolicies">ORI POLICIES</a></li>
			<li class="breadcrumb-item"><a href="/ViewORIPolicy/@PolicyDetails.ORIPolicyReference">VIEW ORI POLICY</a></li>
			<li class="breadcrumb-item active" aria-current="page">EDIT ORI POLICY</li>
		</ol>
	</nav>

	<h1>Editing ORI Policy Reference: @PolicyDetails.ORIPolicyReference</h1>
	<div class="card mb-3">
		<div class="card-header">Copy Terms from Another ORI Policy</div>
		<div class="card-body">
			<div class="row g-2 align-items-start">
				<div class="col-md-10">
					<input class="form-control"
						   placeholder="Type to search ORI policies..."
						   value="@PolicySearchTerm"
						   @oninput="@(e => { PolicySearchTerm = e.Value?.ToString(); FilterPolicies(); })" />


					@if (FilteredPolicies.Any())
					{
						<ul class="list-group mt-1 shadow-sm" style="max-height: 220px; overflow-y: auto; border: 1px solid #dee2e6;">
							@foreach (var p in FilteredPolicies)
							{
								<li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
									style="cursor:pointer"
									@onclick="@(() => SelectPolicy(p.ORIPolicyReference))">
									<span><strong>@p.ORIPolicyReference</strong> – @p.PolicyDescription</span>
									<i class="ri-arrow-right-line text-secondary"></i>
								</li>
							}
						</ul>
					}
					else if (!string.IsNullOrWhiteSpace(PolicySearchTerm))
					{
						<p class="text-muted mt-1">No matching policies found.</p>
					}
				</div>
				<div class="col-md-2 text-end">
					<button class="btn btn-outline-primary w-100"
							@onclick="CopyFromAnotherPolicy"
							disabled="@string.IsNullOrWhiteSpace(SelectedPolicyToCopyFrom)">
						Copy
					</button>
				</div>
			</div>
		</div>
	</div>



	<EditForm Model="PolicyDetails" OnValidSubmit="HandleValidSubmit">
		<DataAnnotationsValidator />
		<ValidationSummary />

		<div class="card mb-4">
			<div class="card-header">Policy Inclusions/Exclusions</div>
			<div class="card-body">
				<blockquote class="blockquote custom-blockquote primary mb-0">
					<h6>The terms below are used to determine which policies, premiums and claims are applicable to the reinsurance contract.</h6>
					<ul>
						<li>"Excluded" means that the particular business item will not be applicable. </li>
						<li>"Included" means that <strong>only those stated business values will</strong> be applicable (and any other value for that "item" will be excluded).</li>
						<li>Outside of the terms below, the only other data point used to determine applicability of this ORI Contact to Inwards Policies/Claims is the "risk basis"(e.g.RAD, LOD) and inception/ expiry date.</li>
					</ul>
					<span class="quote-icon"><i class="ri-information-line"></i></span>
				</blockquote>
				<table class="table table-striped">
					<thead>
						<tr>
							<th>Type</th>
							<th>Item</th>
							<th>Value</th>
							<th>Note</th>
							<th>Last Updated</th>
							<th>Updated By</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var filter in PolicyDetails.Filters)
						{
							<tr>
								<td>
									<span class="btn btn-@(filter.InclusionExclusion == "Inclusion" ? "success" : "danger")-gradient rounded-pill btn-wave">
										@filter.InclusionExclusion
									</span>
								</td>
								<td>
									<button type="button" class="btn btn-@GetGhostButtonClass(filter.IncludedOrExcludedItem) btn-wave">
										@filter.IncludedOrExcludedItem
									</button>
								</td>
								<td>
									<InputText class="form-control" @bind-Value="filter.IncludedOrExcludedValue" />
								</td>
								<td><InputText class="form-control" @bind-Value="filter.Note" /></td>
								<td>@filter.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
								<td>@filter.LastUpdatedBy</td>
								<td>
									<button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveFilter(filter)">Remove</button>
								</td>
							</tr>
						}

						<tr>
							<td>
								<InputSelect class="form-control" @bind-Value="newFilter.InclusionExclusion">
									<option value="Inclusion">Inclusion</option>
									<option value="Exclusion">Exclusion</option>
								</InputSelect>
							</td>
							<td>

								<InputSelect class="form-control"
											 Value="@newFilter.IncludedOrExcludedItem"
											 ValueChanged="HandleItemChanged"
											 ValueExpression="() => newFilter.IncludedOrExcludedItem"
											 TValue="string">
									<option value="">Select a filter type</option>
									@foreach (var item in FilterItemsList)
									{
										<option value="@item.Code">@item.DisplayName</option>
									}
								</InputSelect>


							</td>
							<td>
								@if (KnownDropdownTypes.Contains(newFilter.IncludedOrExcludedItem))
								{
									if (IsLoadingDropdown)
									{
										@if (IsLoadingDropdown)
										{
											<select class="form-control" disabled>
												<option>Fetching options...</option>
											</select>
										}
									}
									else
									{
										<InputSelect class="form-control"
													 Value="@newFilter.IncludedOrExcludedValue"
													 ValueChanged="v => newFilter.IncludedOrExcludedValue = v"
													 ValueExpression="() => newFilter.IncludedOrExcludedValue"
													 TValue="string">
											<option value="">Select an option</option>
											@foreach (var item in DropdownValues.GetValueOrDefault(newFilter.IncludedOrExcludedItem, new()))
											{
												<option value="@item.Code">@item.Name</option>
											}
										</InputSelect>
									}
								}
								else
								{
									<InputText class="form-control" @bind-Value="newFilter.IncludedOrExcludedValue" placeholder="Enter value" />
								}
							</td>


							<td>
								<InputText class="form-control" @bind-Value="newFilter.Note" placeholder="Note (optional)" />
							</td>
							<td colspan="2"></td>
							<td>
								<button type="button" class="btn btn-primary btn-sm" @onclick="AddFilter">Add</button>
							</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<div class="row">
			<div class="col-md-6">
				<div class="card mb-4">
					<div class="card-header">Policy Details</div>
					<div class="card-body">
						<table class="table table-bordered">
							<tbody>
								<tr>
									<th>FX Rate Application Date</th>
									<td>
										<InputText @bind-Value="PolicyDetails.FXRateApplicationDate" class="form-control" readonly />

										@* <div class="form-group">
											<div class="input-group">
												<div class="input-group-text text-muted"> <i class="ri-calendar-line"></i> </div>
												<Flatpickr id="fxRateApplicationDatePickr" class="form-control" @ref="fxRateApplicationDatePickr" Value="@selectedFXRateApplicationDate" ValueChanged="OnFXRateDateChanged" DateFormat="Y-m-d" placeholder="Choose date" />
											</div>
										</div> *@
									</td>
								</tr>
								<tr>
									<th>FX Treatment</th>
									<td>
										<InputSelect class="form-control" @bind-Value=PolicyDetails.FXTreatment TValue="string">
											<option value="">Select an FX Treatment</option>
											@if (FXTreatments != null)
											{
												@foreach (var item in FXTreatments)
												{
													<option value="@item.FXTreatment">@item.FXTreatment</option>
												}
											}
										</InputSelect>
									</td>
								</tr>
								<tr>
									<th>Inuring Priority</th>
									<td>
										<InputNumber @bind-Value="PolicyDetails.InuringPriority" class="form-control" />
									</td>
								</tr>
								<tr>
									<th>Ceded Premium Calculation</th>
									<td>
										<InputSelect class="form-control" @bind-Value=PolicyDetails.CededPremiumCalculation TValue="string">
											<option value="">Select a Ceded Premium Calculation...</option>
											<option value="GrossGross" class="form-control">Gross Gross</option>
											<option value="GrossNet" class="form-control">Gross Net</option>
										</InputSelect>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
			<div class="col-md-6">
				<div class="card mb-4">
					<div class="card-header">Policy Allocations by Class</div>
					<div class="card-body">
						@if (PolicyDetails.PolicyAllocationsClass != null && PolicyDetails.PolicyAllocationsClass.Any())
						{
							<table class="table table-striped">
								<thead>
									<tr>
										<th>Class</th>
										<th>Allocation</th>
										<th>Last Updated</th>
										<th>Updated By</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var allocation in PolicyDetails.PolicyAllocationsClass)
									{
										<tr>
											<td>
												<InputText @bind-Value="allocation.Class" class="form-control" readonly />
											</td>
											<td>
												<InputNumber @bind-Value="allocation.Allocation" class="form-control" readonly />
											</td>
											<td>@allocation.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
											<td>@allocation.LastUpdatedBy</td>
											<td>
												<button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveClassAllocation(allocation)">
													Remove
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
						else
						{
							<p class="text-muted">No class allocations defined for this policy.</p>
						}
						<div class="mt-3">
							<h5>Add New Class Allocation</h5>
							<div class="row g-3">
								<div class="col-md-4">
									<label class="form-label">Class</label>
									<InputText @bind-Value="newClassAllocation.Class" class="form-control" />
								</div>
								<div class="col-md-4">
									<label class="form-label">Allocation</label>
									<InputNumber @bind-Value="newClassAllocation.Allocation" class="form-control" />
								</div>
								<div class="col-md-4">
									<button type="button" class="btn btn-primary" @onclick="AddClassAllocation">Add Class Allocation</button>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="card mb-4">
					<div class="card-header">Policy Allocations by Year of Account</div>
					<div class="card-body">
						@if (PolicyDetails.PolicyAllocationsYOA != null && PolicyDetails.PolicyAllocationsYOA.Any())
						{
							<table class="table table-striped">
								<thead>
									<tr>
										<th>Year of Account</th>
										<th>Allocation</th>
										<th>Last Updated</th>
										<th>Updated By</th>
										<th>Actions</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var allocation in PolicyDetails.PolicyAllocationsYOA)
									{
										<tr>
											<td>
												<InputNumber @bind-Value="allocation.YearOfAccount" class="form-control" readonly />
											</td>
											<td>
												<InputNumber @bind-Value="allocation.Allocation" class="form-control" readonly />
											</td>
											<td>@allocation.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
											<td>@allocation.LastUpdatedBy</td>
											<td>
												<button type="button" class="btn btn-danger btn-sm" @onclick="() => RemoveYOAAllocation(allocation)">
													Remove
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						}
						else
						{
							<p class="text-muted">No year of account allocations defined for this policy.</p>
						}
						<div class="mt-3">
							<h5>Add New YOA Allocation</h5>
							<div class="row g-3">
								<div class="col-md-4">
									<label class="form-label">Year of Account</label>
									<InputNumber @bind-Value="newYOAAllocation.YearOfAccount" class="form-control" />
								</div>
								<div class="col-md-4">
									<label class="form-label">Allocation</label>
									<InputNumber @bind-Value="newYOAAllocation.Allocation" class="form-control" />
								</div>
								<div class="col-md-4">
									<button type="button" class="btn btn-primary" @onclick="AddYOAAllocation">Add YOA Allocation</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>


		<div class="text-right">
			<button type="submit" class="btn btn-success">Save Changes</button>
			<button type="button" class="btn btn-secondary" @onclick="NavigateBack">Cancel</button>
		</div>
	</EditForm>
}

@code {
	[Inject] private NavigationManager Navigation { get; set; }
	[Parameter] public required string ORIPolicyReference { get; set; }

	// Basic Date picker //
	public Flatpickr? fxRateApplicationDatePickr;

	private Dictionary<string, List<DropdownItem>> DropdownValues = new();
	private ORIPolicyModel PolicyDetails { get; set; }
	private List<FXTreatmentModel> FXTreatments { get; set; }
	private bool IsLoading = true;


	private DateTime selectedFXRateApplicationDate
	{
		get
		{
			if (DateTime.TryParseExact(PolicyDetails.FXRateApplicationDate, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.None, out var dt))
			{
				return dt.Date;
			}
			else
			{
				var defaultDate = PolicyDetails.Inception;
				return defaultDate.Date;
			}
		}
		set
		{
			PolicyDetails.FXRateApplicationDate = value.ToString("yyyy-MM-dd");
		}
	}


	private string ErrorMessage;
	private ORIFilterItem newFilter = new ORIFilterItem
		{
			InclusionExclusion = "Inclusion", // Default value
			IncludedOrExcludedItem = null,         // Use object, not a string
			IncludedOrExcludedValue = "",
			Note = ""
		};

	// New allocation properties
	private ORIPolicyAllocationClass newClassAllocation = new ORIPolicyAllocationClass();
	private ORIPolicyAllocationYOA newYOAAllocation = new ORIPolicyAllocationYOA();

	private List<ORIFilterItemDefinition> FilterItemsList = new();
	protected override async Task OnInitializedAsync()
	{
		if (string.IsNullOrWhiteSpace(ORIPolicyReference))
		{
			ErrorMessage = "Policy reference is required.";
			IsLoading = false;
			return;
		}

		try
		{
			// Get All Policies for filtering
			FilterItemsList = await ORIService.GetIncludedOrExcludedItems();
			await LoadAllPolicies();
			FilteredPolicies = AllPolicies;


			// Get Policy Details
			PolicyDetails = await ORIService.GetORIPolicyDetails(ORIPolicyReference);
			if (PolicyDetails != null)
			{
				FilterItemsList = await ORIService.GetIncludedOrExcludedItems();
				FXTreatments = await ORIService.GetFXTreatments();
			}
			else
			{
				ErrorMessage = $"No policy details found for reference: {ORIPolicyReference}";
			}
		}
		catch (Exception)
		{
			ErrorMessage = "An error occurred while fetching policy details.";
		}
		finally
		{
			IsLoading = false;
		}
		Console.WriteLine("pageloaded");
	}

	private void OnFXRateDateChanged(DateTime date)
	{
		selectedFXRateApplicationDate = date;
	}


	private async Task HandleValidSubmit()
	{
		IsLoading = true;
		try
		{
			await ORIService.SaveORIPolicyMetadata(PolicyDetails);
			Navigation.NavigateTo($"ViewORIPolicy/{PolicyDetails.ORIPolicyReference}", forceLoad: true);
		}
		catch (Exception ex)
		{
			ErrorMessage = ex.Message;
		}
		finally
		{
			IsLoading = false;
		}
	}

	private async Task NavigateBack()
	{
		Navigation.NavigateTo($"ViewORIPolicy/{PolicyDetails.ORIPolicyReference}", forceLoad: true);
	}


	private void AddFilter()
	{
		if (newFilter.IncludedOrExcludedItem == null ||
			string.IsNullOrWhiteSpace(newFilter.IncludedOrExcludedValue))
		{
			Console.WriteLine("Cannot add a filter without a valid type and value.");
			return;
		}

		// Ensure PolicyDetails.Filters is not null
		if (PolicyDetails.Filters == null)
		{
			PolicyDetails.Filters = new List<ORIFilterItem>();
		}

		// Add the filter to the policy
		PolicyDetails.Filters.Add(new ORIFilterItem
			{
				InclusionExclusion = newFilter.InclusionExclusion,
				IncludedOrExcludedItem = newFilter.IncludedOrExcludedItem, // Object reference
				IncludedOrExcludedValue = newFilter.IncludedOrExcludedValue,
				Note = newFilter.Note
			});

		Console.WriteLine($"Added Filter: {newFilter.InclusionExclusion} - {newFilter.IncludedOrExcludedItem} - {newFilter.IncludedOrExcludedValue}");

		// Reset the input fields
		newFilter = new ORIFilterItem
			{
				InclusionExclusion = "Inclusion",
				IncludedOrExcludedItem = null,         // Use object, not a string
				IncludedOrExcludedValue = "",
				Note = ""
			};

		// Force UI update
		StateHasChanged();
	}
	private void RemoveFilter(ORIFilterItem filter)
	{
		if (PolicyDetails.Filters.Contains(filter))
		{
			PolicyDetails.Filters.Remove(filter);
			if (PolicyDetails.RemovedFilters == null)
			{
				PolicyDetails.RemovedFilters = new List<ORIFilterItem>();
			}
			PolicyDetails.RemovedFilters.Add(filter); // Track deleted filters
		}
	}


	private string GetGhostButtonClass(string item)
	{
		return item switch
		{
			"DomicileCountry" => "primary-ghost",
			"InwardPolicyReference" => "secondary-ghost",
			"Peril" => "success-ghost",
			"PlacementUMR" => "danger-ghost",
			"RiskCode" => "warning-ghost",
			"ReservingClass" => "info-ghost",
			"StatCode1" => "purple-ghost",
			"StatCode2" => "teal-ghost",
			_ => "orange-ghost"
		};
	}

	private HashSet<string> KnownDropdownTypes = new()
	{
		"Class",
		"DomicileCountry",
		"Peril",
		"RiskCode",
		"ReservingClass",
		"StatCode1",
		"StatCode2"
	};

	private bool IsLoadingDropdown = false;

	private async Task HandleItemChanged(string selected)
	{
		Console.WriteLine("triggered HIC");
		newFilter.IncludedOrExcludedItem = selected;
		newFilter.IncludedOrExcludedValue = "";

		if (!string.IsNullOrWhiteSpace(selected) && KnownDropdownTypes.Contains(selected))
		{
			Console.WriteLine("into if on line 325");

			IsLoadingDropdown = true;
			StateHasChanged();

			await Task.Delay(2000); // Simulate DB latency

			if (!DropdownValues.ContainsKey(selected))
			{
				Console.WriteLine("going to db");
				DropdownValues[selected] = await ORIService.GetDropdownValues(selected);
				Console.WriteLine("coming from db");
			}

			IsLoadingDropdown = false;
			StateHasChanged();
		}
	}


	private string SelectedPolicyToCopyFrom;
	private string PolicySearchTerm;
	private async Task LoadAllPolicies()
	{
		AllPolicies = (await ORIService.GetORIPolicies()).ToList();
	}

	private async Task CopyFromAnotherPolicy()
	{
		if (string.IsNullOrWhiteSpace(SelectedPolicyToCopyFrom)) return;

		var sourcePolicy = await ORIService.GetORIPolicyDetails(SelectedPolicyToCopyFrom);
		if (sourcePolicy != null)
		{
			PolicyDetails.Filters = sourcePolicy.Filters
				.Select(f => new ORIFilterItem
					{
						InclusionExclusion = f.InclusionExclusion,
						IncludedOrExcludedItem = f.IncludedOrExcludedItem,
						IncludedOrExcludedValue = f.IncludedOrExcludedValue,
						Note = $"Copied from reference {SelectedPolicyToCopyFrom}"
					})
				.ToList();

			StateHasChanged();
		}
	}


	private List<ORIPolicyListModel> AllPolicies = new();
	private List<ORIPolicyListModel> FilteredPolicies = new();

	private void FilterPolicies()
	{
		FilteredPolicies = string.IsNullOrWhiteSpace(PolicySearchTerm)
			? AllPolicies
			: AllPolicies
				.Where(p =>
					p.ORIPolicyReference.Contains(PolicySearchTerm, StringComparison.OrdinalIgnoreCase) ||
					(p.PolicyDescription?.Contains(PolicySearchTerm, StringComparison.OrdinalIgnoreCase) ?? false))
				.ToList();
	}


	private void SelectPolicy(string policyRef)
	{
		SelectedPolicyToCopyFrom = policyRef;
		PolicySearchTerm = policyRef;
	}

	// Methods for adding and removing allocations
	private void AddClassAllocation()
	{
		if (newClassAllocation.Class != null && newClassAllocation.Allocation != 0)
		{
			if (PolicyDetails.PolicyAllocationsClass == null)
			{
				PolicyDetails.PolicyAllocationsClass = new List<ORIPolicyAllocationClass>();
			}
			newClassAllocation.LastUpdated = DateTime.Now;
			newClassAllocation.LastUpdatedBy = "CurrentUser"; // Replace with actual user
			PolicyDetails.PolicyAllocationsClass.Add(newClassAllocation);
			newClassAllocation = new ORIPolicyAllocationClass(); // Reset
			StateHasChanged();
		}
	}

	private void RemoveClassAllocation(ORIPolicyAllocationClass allocation)
	{
		if (PolicyDetails.PolicyAllocationsClass.Contains(allocation))
		{
			PolicyDetails.PolicyAllocationsClass.Remove(allocation);
			if (PolicyDetails.RemovedPolicyAllocationsClass == null)
			{
				PolicyDetails.RemovedPolicyAllocationsClass = new List<ORIPolicyAllocationClass>();
			}
			PolicyDetails.RemovedPolicyAllocationsClass.Add(allocation);
			StateHasChanged();
		}
	}

	private void AddYOAAllocation()
	{
		if (newYOAAllocation.YearOfAccount != 0 && newYOAAllocation.Allocation != 0)
		{
			if (PolicyDetails.PolicyAllocationsYOA == null)
			{
				PolicyDetails.PolicyAllocationsYOA = new List<ORIPolicyAllocationYOA>();
			}
			newYOAAllocation.LastUpdated = DateTime.Now;
			newYOAAllocation.LastUpdatedBy = "CurrentUser"; // Replace with actual user
			PolicyDetails.PolicyAllocationsYOA.Add(newYOAAllocation);
			newYOAAllocation = new ORIPolicyAllocationYOA(); // Reset
			StateHasChanged();
		}
	}

	private void RemoveYOAAllocation(ORIPolicyAllocationYOA allocation)
	{
		if (PolicyDetails.PolicyAllocationsYOA.Contains(allocation))
		{
			PolicyDetails.PolicyAllocationsYOA.Remove(allocation);
			if (PolicyDetails.RemovedPolicyAllocationsYOA == null)
			{
				PolicyDetails.RemovedPolicyAllocationsYOA = new List<ORIPolicyAllocationYOA>();
			}
			PolicyDetails.RemovedPolicyAllocationsYOA.Add(allocation);
			StateHasChanged();
		}
	}
}

