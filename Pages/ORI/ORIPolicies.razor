@page "/"
@page "/ORIPolicies"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using CardModel
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI  
@using Sandbox.Services 
@inject ORIService ORIService 
@using DataTablesData
@inject DataTablesService DataTablesService

<!-- DataTables CSS -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">

<style>
	#oripols th,
	#oripols td {
		padding: 0.25rem !important; /* override Bootstrap default */
	}

	#oripols tfoot th {
		padding: 0 !important;
	}

		#oripols tfoot th input {
			width: 100%;
			font-size: 0.75rem;
			padding: 2px 4px;
		}

</style>

@if (policies != null)
{
	<div class="row mb-4">
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Total ORI Policies</h5>
					<p class="fs-4 fw-bold mb-0">@policies.Count()</p>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Outstanding Filters</h5>
					<p class="fs-4 fw-bold text-danger mb-0">
						@policies.Count(p => p.FiltersStatus == "Outstanding")
					</p>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Not Fully Allocated</h5>
					<p class="fs-4 fw-bold text-warning mb-0">
						@policies.Count(p => p.ClassAllocations != 100 || p.YOAAllocations != 100)
					</p>
				</div>
			</div>
		</div>
	</div>
}

<!-- Start::page-header -->
<SpkPageHeader PageItems="PageItems" />
<!-- End::page-header -->
<!-- Start: row-1 -->
<div class="row">
	<!-- End:: row-1 -->

	<h3>ORI Policies</h3>

	@if (policies == null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<table class="table dataTable" id="oripols">
			<thead>
				<tr>
					<th>ORI Policy Reference</th>
					<th>Inception Date</th>
					<th>Expiry Date</th>
					<th>Limit</th>
					<th>Retention</th>
					<th>Description</th>
					<th>Policy Type</th>
					<th>Broker</th>
					<th>Status</th>
					<th>Filters Status</th>
					<th>YOA Allocation %</th>
					<th>Class Allocation %</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var policy in policies)
				{
					<tr>
						<td>
							<button class="btn btn-link text-decoration-underline"
									@onclick="@(() => NavigationManager.NavigateTo($"ViewORIPolicy/{policy.ORIPolicyReference}"))">
								@policy.ORIPolicyReference
							</button>
						</td>
						<td>@policy.InceptionDate?.ToString("yyyy-MM-dd")</td>
						<td>@policy.ExpiryDate?.ToString("yyyy-MM-dd")</td>
						<td>@(policy.Limit ?? 0)</td>
						<td>@(policy.Retention ?? 0)</td>
						<td>@policy.PolicyDescription</td>
						<td>@policy.PolicyType</td>
						<td>@policy.Broker</td>
						<td>@policy.Status</td>
						<td>
							<span class="@($"badge {(policy.FiltersStatus == "Entered" ? "bg-outline-primary" : "bg-danger")}")">
								@policy.FiltersStatus
							</span>
						</td>
						<td>@($"{policy.YOAAllocations/100.0:P0}")</td>
						<td>@($"{policy.ClassAllocations / 100.0:P0}")</td>
					</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th>ORI Policy Reference</th>
					<th>Inception Date</th>
					<th>Expiry Date</th>
					<th>Limit</th>
					<th>Retention</th>
					<th>Description</th>
					<th>Policy Type</th>
					<th>Broker</th>
					<th>Status</th>
					<th>Filters Status</th>
					<th>YOA Allocation %</th>
					<th>Class Allocation %</th>
				</tr>
			</tfoot>
		</table>
	}
</div>


<!-- jquery Cdn -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- Datatables Cdn -->
<script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/responsive/2.3.0/js/dataTables.responsive.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
<script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

<!-- Internal Datatables JS -->
<script src="@($"{NavigationManager.BaseUri}assets/js/datatables.js")"></script>

<script>
	var options = {
		paging: true,
		pageLength: 10, // Set the default number of rows visible
		fixedHeader: true, // Keep the header fixed
		lengthChange: false, // Disable the length change dropdown
		order: [], // No default ordering
		columnDefs: [], // Customize columns if needed
		buttons: [], // Add buttons if required
		initComplete: function () {
		// Ensure footer exists and add search boxes for each column
		this.api()
			.columns()
				.every(function () {
					let column = this;
					let title = column.footer().textContent;

					// Create input element
					let input = document.createElement('input');
					input.placeholder = title;
					column.footer().replaceChildren(input);

					// Event listener for user input
					input.addEventListener('keyup', () => {
						if (column.search() !== this.value) {
							column.search(input.value).draw();
					}
				});
			});
		}
	};
	window.initializeDataTables = function () {
		console.log("Initializing DataTables..."); // Debug log
		setTimeout(() => {
			if ($('#oripols').length) {
				$('#oripols').DataTable(options);
				console.log("DataTable initialized successfully.");
			} else {
				console.log("Table not found!");
			}
		}, 500);
	};
</script>

@code {
	private IEnumerable<ORIPolicyListModel> policies;
	private bool isDataLoaded = false; // Flag to track when data is loaded

	protected override async Task OnInitializedAsync()
	{
		policies = await ORIService.GetORIPolicies();

		isDataLoaded = true; // Mark data as loaded
		StateHasChanged(); // Trigger UI refresh
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JSRuntime.InvokeVoidAsync("window.interop.initializeTooltips");
		}
		// Ensure DataTables is initialized only after data is loaded and page renders
		if (isDataLoaded)
		{
			isDataLoaded = false; // Prevent multiple calls
			await JSRuntime.InvokeVoidAsync("initializeDataTables");
		}
	}
}


