@page "/"
@page "/ORIPolicies"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using CardModel
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService

<div class="row mt-4 mb-4">
	<h3>ORI Policies</h3>
</div>
@if (AllPolicies != null)
{
	<div class="row mb-4">
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Total ORI Policies</h5>
					<p class="fs-4 fw-bold mb-0">@AllPolicies.Count()</p>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Outstanding Filters</h5>
					<p class="fs-4 fw-bold text-danger mb-0">
						@AllPolicies.Count(p => p.FiltersStatus == "Outstanding")
					</p>
				</div>
			</div>
		</div>
		<div class="col-md-4">
			<div class="card shadow-sm border-0">
				<div class="card-body">
					<h5 class="card-title mb-1">Not Fully Allocated</h5>
					<p class="fs-4 fw-bold text-warning mb-0">
						@AllPolicies.Count(p => p.ClassAllocations != 100 || p.YOAAllocations != 100)
					</p>
				</div>
			</div>
		</div>
	</div>
}

<div class="row">

	@if (AllPolicies == null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<div class="card shadow-sm border-0">
			<table class="table table-striped">
				<thead>
					<tr>
						<th class="align-top">
							ORI Policy Reference
							<input class="form-control form-control-sm" placeholder="Filter ORI Policy Reference..." value="@FilterReference" @oninput="e => OnReferenceChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Inception Date
							<input class="form-control form-control-sm" placeholder="Filter Inception Date..." value="@FilterReference" @oninput="e => OnInceptionChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Expiry Date
							<input class="form-control form-control-sm" placeholder="Filter Expiry Date.." value="@FilterReference" @oninput="e => OnExpiryChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Limit
							<input class="form-control form-control-sm" placeholder="Filter Limit..." value="@FilterReference" @oninput="e => OnLimitChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Retention
							<input class="form-control form-control-sm" placeholder="Filter Retention..." value="@FilterReference" @oninput="e => OnRetentionChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Description
							<input class="form-control form-control-sm" placeholder="Filter Description..." value="@FilterReference" @oninput="e => OnDescriptionChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Policy Type
							<input class="form-control form-control-sm" placeholder="Filter Policy Type..." value="@FilterReference" @oninput="e => OnPolicyTypeChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Broker
							<input class="form-control form-control-sm" placeholder="Filter Broker..." value="@FilterBroker" @oninput="e => OnBrokerChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Status
							<input class="form-control form-control-sm" placeholder="Filter Status..." value="@FilterStatus" @oninput="e => OnStatusChanged(e.Value?.ToString())" />
						</th>
						<th class="align-top">
							Status
						</th>
						<th class="text-end align-top">YOA Allocation %</th>
						<th class="text-end align-top">Class Allocation %</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var policy in PagedPolicies)
					{
						<tr>
							<td>@policy.ORIPolicyReference</td>
							<td>@policy.InceptionDate?.ToString("yyyy-MM-dd")</td>
							<td>@policy.ExpiryDate?.ToString("yyyy-MM-dd")</td>
							<td>@(policy.Limit ?? 0)</td>
							<td>@(policy.Retention ?? 0)</td>
							<td>@policy.PolicyDescription</td>
							<td>@policy.PolicyType</td>
							<td>@policy.Broker</td>
							<td>@policy.Status</td>
							<td>
								<span class="@($"badge {(policy.FiltersStatus == "Entered" ? "bg-outline-primary" : "bg-danger")}")">
									@policy.FiltersStatus
								</span>
							</td>
							<td class="text-end">@($"{policy.YOAAllocations / 100.0:P0}")</td>
							<td class="text-end">@($"{policy.ClassAllocations / 100.0:P0}")</td>
							<td>
								<button class="btn btn-sm btn-outline-primary"
										@onclick='() => NavigationManager.NavigateTo($"ViewORIPolicy/{policy.ORIPolicyReference}")'>
									View
								</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="d-flex justify-content-between align-items-center mt-3">
			<select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
				@foreach (var size in PageSizeOptions)
				{
					<option value="@size" selected="@(PageSize == size)">
						@size per page
					</option>
				}
			</select>

			<nav>
				<ul class="pagination mb-0">
					<li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
						<button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Previous</button>
					</li>

					@for (int i = 1; i <= TotalPages; i++)
					{
						<li class="page-item @(CurrentPage == i ? "active" : "")">
							<button class="page-link" @onclick="() => ChangePage(i)">@i</button>
						</li>
					}

					<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
						<button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Next</button>
					</li>
				</ul>
			</nav>
		</div>

	}
</div>

@code {
	private List<ORIPolicyListModel> AllPolicies = new();
	private List<ORIPolicyListModel> PagedPolicies = new();
	private int CurrentPage = 1;
	private int PageSize = 50;
	private List<int> PageSizeOptions = new() { 10, 20, 50, 100 };

	private string FilterReference = "";
	private string FilterInception = "";
	private string FilterExpiry = "";
	private string FilterLimit = "";
	private string FilterRetention = "";
	private string FilterDescription = "";
	private string FilterPolicyType = "";
	private string FilterBroker = "";
	private string FilterStatus = "";

	private IEnumerable<ORIPolicyListModel> FilteredPolicies => AllPolicies.Where(p =>
		(string.IsNullOrWhiteSpace(FilterReference) || p.ORIPolicyReference?.Contains(FilterReference, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterInception) || p.InceptionDate?.ToString("yyyy-MM-dd").Contains(FilterInception) == true) &&
		(string.IsNullOrWhiteSpace(FilterExpiry) || p.ExpiryDate?.ToString("yyyy-MM-dd").Contains(FilterExpiry) == true) &&
		(string.IsNullOrWhiteSpace(FilterLimit) || p.Limit?.ToString().Contains(FilterLimit) == true) &&
		(string.IsNullOrWhiteSpace(FilterRetention) || p.Retention?.ToString().Contains(FilterRetention) == true) &&
		(string.IsNullOrWhiteSpace(FilterDescription) || p.PolicyDescription?.Contains(FilterDescription, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterPolicyType) || p.PolicyType?.Contains(FilterPolicyType, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterBroker) || p.Broker?.Contains(FilterBroker, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterStatus) || p.Status?.Contains(FilterStatus, StringComparison.OrdinalIgnoreCase) == true));

	private int TotalPages => (int)Math.Ceiling((double)FilteredPolicies.Count() / PageSize);

	protected override async Task OnInitializedAsync()
	{
		AllPolicies = (await ORIService.GetORIPolicies()).ToList();
		ApplyPagination();
	}

	private void ApplyPagination()
	{
		PagedPolicies = FilteredPolicies
			.Skip((CurrentPage - 1) * PageSize)
			.Take(PageSize)
			.ToList();
	}

	private void ChangePage(int newPage)
	{
		if (newPage >= 1 && newPage <= TotalPages)
		{
			CurrentPage = newPage;
			ApplyPagination();
		}
	}

	private async Task OnFilterChanged(ChangeEventArgs e)
	{
		CurrentPage = 1;
		ApplyPagination();
	}

	private async Task OnPageSizeChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int newSize))
		{
			PageSize = newSize;
			CurrentPage = 1;
			ApplyPagination();
		}
	}

	// Re-apply filters when any filter is changed
	private void OnReferenceChanged(string value) { FilterReference = value; CurrentPage = 1; ApplyPagination(); }
	private void OnInceptionChanged(string value) { FilterInception = value; CurrentPage = 1; ApplyPagination(); }
	private void OnExpiryChanged(string value) { FilterExpiry = value; CurrentPage = 1; ApplyPagination(); }
	private void OnLimitChanged(string value) { FilterLimit = value; CurrentPage = 1; ApplyPagination(); }
	private void OnRetentionChanged(string value) { FilterRetention = value; CurrentPage = 1; ApplyPagination(); }
	private void OnDescriptionChanged(string value) { FilterDescription = value; CurrentPage = 1; ApplyPagination(); }
	private void OnPolicyTypeChanged(string value) { FilterPolicyType = value; CurrentPage = 1; ApplyPagination(); }
	private void OnBrokerChanged(string value) { FilterBroker = value; CurrentPage = 1; ApplyPagination(); }
	private void OnStatusChanged(string value) { FilterStatus = value; CurrentPage = 1; ApplyPagination(); }
}