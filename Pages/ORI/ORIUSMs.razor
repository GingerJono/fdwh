@page "/ORIUSMs"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService
@using System.Text.Json

<h3>ORI USMs</h3>

@if (usmList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table dataTable">
        <thead>
            <tr>
                <th>USM ID</th>
                <th>ORI Policy Reference</th>
                <th>LPSO No</th>
                <th>LPSO Date</th>
                <th>LPSO Version</th>
                <th>User Sequence No</th>
                <th>Syndicate No</th>
                <th>Instalment No</th>
                <th>Treaty Section</th>
                <th>Syndicate Line No</th>
                <th>USM CA Category Desc</th>
                <th>Closing Currency</th>
                <th>Settlement Currency</th>
                <th>Line Amount (SCC)</th>
                <th>Total YOA Allocation</th>
                <th>Total COB Allocation</th>
                <th>Total Security Allocation</th>
                <th>Total Event Allocation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usm in PaginatedList)
            {
                <tr>
                    <td>
                        <button class="btn btn-link text-decoration-underline"
                                @onclick="@(() => NavigationManager.NavigateTo($"/ViewORIUSM/{usm.USMID}"))">
                            @usm.USMID
                        </button>
                    </td>
                    
                    <td>@usm.ORIPolicyReference</td>
                    <td>@(usm.LPSONo?.ToString() ?? "-")</td>
                    <td>@usm.LPSODate?.ToString("yyyy-MM-dd")</td>
                    <td>@(usm.LPSOVersionNo?.ToString() ?? "-")</td>
                    <td>@(usm.UserSequenceNo?.ToString() ?? "-")</td>
                    <td>@(usm.InstalmentNo?.ToString() ?? "-")</td>
                    <td>@(usm.SyndicateLineNo?.ToString() ?? "-")</td>
                    <td>@(usm.TreatySection?.ToString() ?? "-")</td>
                    <td>@(usm.SyndicateLineNo?.ToString() ?? "-")</td>
                    <td>@usm.USMCaCategoryDesc</td>
                    <td>@(usm.ClosingCcy ?? "-")</td>
                    <td>@(usm.SettCcy ?? "-")</td>
                    <!-- Numeric Fields with Null Handling -->
                    <td>@(usm.LineAmountSCC?.ToString("N2") ?? "0.00")</td>
                    <td>@(usm.TotalYOAAllocation.ToString("N2"))</td>
                    <td>@(usm.TotalCOBAllocation.ToString("N2"))</td>
                    <td>@(usm.TotalSecurityAllocation.ToString("N2"))</td>
                    <td>@(usm.TotalEventAllocation.ToString("N2"))</td>
                    

                    <td>
                        <button class="btn btn-primary btn-sm"
                                @onclick="@(() => NavigationManager.NavigateTo($"/ViewORIUSM/{usm.USMID}"))">
                            View
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot class="sticky-bottom bg-white">
            <tr>
                <th><input class="form-control" @bind="searchUSMID" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchORIPolicyReference" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchLPSONo" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchLPSODate" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchLPSOVersion" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchUserSequence" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchSyndicateNo" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchInstalmentNo" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchTreatySection" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchSyndicateLineNo" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchCategoryDesc" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchClosingCcy" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchSettlementCcy" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchLineAmountSCC" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchTotalYOA" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchTotalCOB" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchTotalSecurity" @oninput="FilterTable" /></th>
                <th><input class="form-control" @bind="searchTotalEvent" @oninput="FilterTable" /></th>
                <th></th> <!-- Empty for Actions column -->
            </tr>
        </tfoot>



    </table>

    <!-- Pagination Controls -->
    <div class="d-flex justify-content-between mt-3 sticky-bottom-pagination">
        <button class="btn btn-secondary" @onclick="PreviousPage" disabled="@(!HasPreviousPage)">Previous</button>
        <span>Page @CurrentPage of @TotalPages</span>
        <button class="btn btn-secondary" @onclick="NextPage" disabled="@(!HasNextPage)">Next</button>
    </div>


}
@code {
    private string searchUSMID = "";
    private string searchORIPolicyReference = "";
    private string searchLPSONo = "";
    private string searchLPSODate = "";
    private string searchLPSOVersion = "";
    private string searchUserSequence = "";
    private string searchSyndicateNo = "";
    private string searchInstalmentNo = "";
    private string searchTreatySection = "";
    private string searchSyndicateLineNo = "";
    private string searchCategoryDesc = "";
    private string searchClosingCcy = "";
    private string searchSettlementCcy = "";
    private string searchLineAmountSCC = "";
    private string searchTotalYOA = "";
    private string searchTotalCOB = "";
    private string searchTotalSecurity = "";
    private string searchTotalEvent = "";

    private List<ORIUSMListModel> usmList = new();
    private List<ORIUSMListModel> PaginatedList = new();
    private int CurrentPage = 1;
    private int PageSize = 20;
    private int TotalPages;

    protected override async Task OnInitializedAsync()
    {
        var data = await ORIService.GetORIUSMs();

        usmList = data.ToList();
        TotalPages = (int)Math.Ceiling((double)usmList.Count / PageSize);
        Paginate();
    }

    private void Paginate()
    {
        PaginatedList = usmList
            .Where(usm =>
                (string.IsNullOrEmpty(searchUSMID) || usm.USMID.Contains(searchUSMID, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchORIPolicyReference) || usm.ORIPolicyReference.Contains(searchORIPolicyReference, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchLPSONo) || (usm.LPSONo?.ToString().Contains(searchLPSONo) ?? false)) &&
                (string.IsNullOrEmpty(searchLPSODate) || (usm.LPSODate?.ToString("yyyy-MM-dd").Contains(searchLPSODate) ?? false)) &&
                (string.IsNullOrEmpty(searchLPSOVersion) || (usm.LPSOVersionNo?.ToString().Contains(searchLPSOVersion) ?? false)) &&
                (string.IsNullOrEmpty(searchUserSequence) || (usm.UserSequenceNo?.ToString().Contains(searchUserSequence) ?? false)) &&
                (string.IsNullOrEmpty(searchSyndicateNo) || (usm.SyndicateNo?.ToString().Contains(searchSyndicateNo) ?? false)) &&
                (string.IsNullOrEmpty(searchInstalmentNo) || (usm.InstalmentNo?.ToString().Contains(searchInstalmentNo) ?? false)) &&
                (string.IsNullOrEmpty(searchTreatySection) || usm.TreatySection.Contains(searchTreatySection, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchSyndicateLineNo) || (usm.SyndicateLineNo?.ToString().Contains(searchSyndicateLineNo) ?? false)) &&
                (string.IsNullOrEmpty(searchCategoryDesc) || usm.USMCaCategoryDesc.Contains(searchCategoryDesc, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchClosingCcy) || usm.ClosingCcy.Contains(searchClosingCcy, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchSettlementCcy) || usm.SettCcy.Contains(searchSettlementCcy, StringComparison.OrdinalIgnoreCase)) &&
                (string.IsNullOrEmpty(searchLineAmountSCC) || (usm.LineAmountSCC?.ToString("N2").Contains(searchLineAmountSCC) ?? false)) &&
                (string.IsNullOrEmpty(searchTotalYOA) || usm.TotalYOAAllocation.ToString("N2").Contains(searchTotalYOA)) &&
                (string.IsNullOrEmpty(searchTotalCOB) || usm.TotalCOBAllocation.ToString("N2").Contains(searchTotalCOB)) &&
                (string.IsNullOrEmpty(searchTotalSecurity) || usm.TotalSecurityAllocation.ToString("N2").Contains(searchTotalSecurity)) &&
                (string.IsNullOrEmpty(searchTotalEvent) || usm.TotalEventAllocation.ToString("N2").Contains(searchTotalEvent))
            )
            .Skip((CurrentPage - 1) * PageSize)
            .Take(PageSize)
            .ToList();
    }

    private void FilterTable(ChangeEventArgs e)
    {
        CurrentPage = 1;
        Paginate();
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
            Paginate();
        }
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
            Paginate();
        }
    }

    private bool HasPreviousPage => CurrentPage > 1;
    private bool HasNextPage => CurrentPage < TotalPages;
}
