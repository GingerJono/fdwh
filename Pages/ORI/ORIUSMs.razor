@page "/ORIUSMs"
@page "/ORIUSMs/PolicyYOA/{PolicyYOA:int?}"
@page "/ORIUSMs/USMYear/{USMYear:int?}"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService
@using System.Text.Json

<style>
    #oriusms tfoot th {
        padding: 0 !important;
    }

        #oriusms tfoot th input {
            width: 100%;
            padding: 2px 4px;
            font-size: 0.75rem;
            box-sizing: border-box;
        }

</style>

<h3>ORI USMs</h3>

<h4 class="mb-2">Filter by Policy YOA</h4>
<div class="btn-group mb-3" role="group">
    @foreach (var year in YearRange)
    {
        <a class="btn @(PolicyYOA == year ? "btn-secondary" : "btn-outline-secondary")"
           href="@($"/ORIUSMs/PolicyYOA/{year}")">@year</a>
    }
</div>

<h4 class="mb-2">Filter by USM Year</h4>
<div class="btn-group mb-4" role="group">
    @foreach (var year in YearRange)
    {
        <a class="btn @(USMYear == year ? "btn-primary" : "btn-outline-primary")"
           href="@($"/ORIUSMs/USMYear/{year}")">@year</a>
    }
</div>

@if (PolicyYOA is not null || USMYear is not null)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="alert">
        <i class="ri-filter-line fs-5"></i>
        <strong>Filtering by:</strong>
        @if (PolicyYOA is not null)
        {
            <span>Policy YOA: <span class="badge bg-secondary">@PolicyYOA</span></span>
        }
        @if (USMYear is not null)
        {
            <span>USM Year: <span class="badge bg-primary">@USMYear</span></span>
        }
    </div>
}


@if (usmList == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table dataTable" id="oriusms">
        <thead>
            <tr>
                <th>USM ID</th>
                <th>ORI Policy Reference</th>
                <th>LPSO No</th>
                <th>LPSO Date</th>
                <th>LPSO Version</th>
                <th>User Sequence No</th>
                <th>Syndicate No</th>
                <th>Instalment No</th>
                <th>Treaty Section</th>
                <th>Syndicate Line No</th>
                <th>USM CA Category Desc</th>
                <th>Closing Currency</th>
                <th>Settlement Currency</th>
                <th>Line Amount (SCC)</th>
                <th>Total YOA Allocation</th>
                <th>Total COB Allocation</th>
                <th>Total Security Allocation</th>
                <th>Total Event Allocation</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usm in usmList)
            {
                <tr>
                    <td>
                        <button class="btn btn-link text-decoration-underline"
                                @onclick="@(() => NavigationManager.NavigateTo($"ViewORIUSM/{usm.USMID}"))">
                            @usm.USMID
                        </button>
                    </td>
                    <td>@usm.ORIPolicyReference</td>
                    <td>@usm.LPSONo</td>
                    <td>@usm.LPSODate?.ToString("yyyy-MM-dd")</td>
                    <td>@usm.LPSOVersionNo</td>
                    <td>@usm.UserSequenceNo</td>
                    <td>@usm.SyndicateNo</td>
                    <td>@usm.InstalmentNo</td>
                    <td>@usm.TreatySection</td>
                    <td>@usm.SyndicateLineNo</td>
                    <td>@usm.USMCaCategoryDesc</td>
                    <td>@usm.ClosingCcy</td>
                    <td>@usm.SettCcy</td>
                    <td>@(usm.LineAmountSCC?.ToString("N2") ?? "0.00")</td>
                    <td>@usm.TotalYOAAllocation.ToString("N2")</td>
                    <td>@usm.TotalCOBAllocation.ToString("N2")</td>
                    <td>@usm.TotalSecurityAllocation.ToString("N2")</td>
                    <td>@usm.TotalEventAllocation.ToString("N2")</td>
                    <td>
                        <button class="btn btn-primary btn-sm"
                                @onclick="@(() => NavigationManager.NavigateTo($"ViewORIUSM/{usm.USMID}"))">
                            View
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th>USM ID</th>
                <th>ORI Policy Reference</th>
                <th>LPSO No</th>
                <th>LPSO Date</th>
                <th>LPSO Version</th>
                <th>User Sequence No</th>
                <th>Syndicate No</th>
                <th>Instalment No</th>
                <th>Treaty Section</th>
                <th>Syndicate Line No</th>
                <th>USM CA Category Desc</th>
                <th>Closing Currency</th>
                <th>Settlement Currency</th>
                <th>Line Amount (SCC)</th>
                <th>Total YOA Allocation</th>
                <th>Total COB Allocation</th>
                <th>Total Security Allocation</th>
                <th>Total Event Allocation</th>
                <th>Actions</th>
            </tr>
        </tfoot>
    </table>


    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.3.0/css/responsive.bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.3/css/buttons.bootstrap5.min.css">

    <!-- jQuery + DataTables JS -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.3.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.6/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.3/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script>
                window.initializeDataTables = function () {
            requestAnimationFrame(() => {
                const $table = $('#oriusms');
                if ($table.length === 0) {
                    console.warn("DataTables init aborted: table not found.");
                    return;
                }

                if ($.fn.DataTable.isDataTable($table)) {
                    $table.DataTable().clear().destroy();
                }

                $table.DataTable({
                    paging: true,
                    pageLength: 10,
                    lengthChange: false,
                    ordering: true,
                    order: [],
                    fixedHeader: true,
                    initComplete: function () {
                        this.api().columns().every(function () {
                            const column = this;
                            const title = column.footer().textContent;
                            const input = document.createElement('input');
                            input.placeholder = title;
                            column.footer().replaceChildren(input);
                            input.addEventListener('keyup', function () {
                                if (column.search() !== this.value) {
                                    column.search(this.value).draw();
                                }
                            });
                        });
                    }
                });
            });
        };

    </script>

    <style>
        .btn-group h4 {
            margin-bottom: 0.5rem;
        }

        .btn-group a {
            font-size: 0.875rem;
        }
    </style>


}
@code {
    [Parameter] public int? PolicyYOA { get; set; }
    [Parameter] public int? USMYear { get; set; }

    private List<ORIUSMListModel> usmList = new();
 
    private bool shouldInitDataTables = false;
    private List<int> YearRange = Enumerable.Range(2014, DateTime.UtcNow.Year - 2014 + 1).Reverse().ToList();

    protected override async Task OnInitializedAsync()
    {
        int? effectiveUSMYear = USMYear ?? (PolicyYOA is null ? DateTime.UtcNow.Year : null);
        usmList = (await ORIService.GetORIUSMs(PolicyYOA, effectiveUSMYear)).ToList();

        shouldInitDataTables = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldInitDataTables)
        {
            shouldInitDataTables = false;

            try
            {
                await JSRuntime.InvokeVoidAsync("initializeDataTables");
            }
            catch (JSDisconnectedException)
            {
                Console.WriteLine("[WARN] JS interop called after circuit disconnected.");
            }
            catch (JSException jsEx)
            {
                Console.WriteLine($"[ERROR] JS init failed: {jsEx.Message}");
            }
        }
    }



    public override async Task SetParametersAsync(ParameterView parameters)
    {
        // Store current values before they are potentially updated
        int? previousPolicyYOA = PolicyYOA;
        int? previousUSMYear = USMYear;

        // Apply new parameters (this sets PolicyYOA and USMYear)
        await base.SetParametersAsync(parameters);

        // Only re-fetch if the parameters actually changed
        bool paramsChanged = previousPolicyYOA != PolicyYOA || previousUSMYear != USMYear;

        if (paramsChanged)
        {
            int? effectiveUSMYear = USMYear ?? (PolicyYOA is null ? DateTime.UtcNow.Year : null);
            usmList = (await ORIService.GetORIUSMs(PolicyYOA, effectiveUSMYear)).ToList();

            shouldInitDataTables = true;
        }
    }


}
