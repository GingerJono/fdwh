@page "/LORSList"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using CardModel
@inject IJSRuntime JSRuntime
@using Sandbox.Models.ORI
@using Sandbox.Services
@inject ORIService ORIService

<div class="row mt-4 mb-4">
	<h3>ORI LORS Files</h3>
</div>


<div class="row mb-4">
	@if (AllLORS == null)
	{
		<p><em>Loading...</em></p>
	}
	else
	{
		<div class="card shadow mb-4 border">
			<div class="table-responsive">
				<table class="table table-striped table-fixed text-nowrap">
					<thead>
						<tr>
							<th class="align-top">
								File Name
								<input class="form-control form-control-sm" placeholder="Filter File Name..." value="@FilterFileName" @oninput="e => OnFilenameChanged(e.Value?.ToString())" />
							</th>
							<th class="align-top">
								ORI Policy Reference
								<input class="form-control form-control-sm" placeholder="Filter ORI Policy Reference..." value="@FilterORIPolicyReference" @oninput="e => OnORIPolicyReferenceChange(e.Value?.ToString())" />
							</th>
							<th class="align-top">Policy Sequence</th>
							<th class="align-top">
								Processed Date
								<input class="form-control form-control-sm" placeholder="Filter Processed Date..." value="@FilterProcessedDate" @oninput="e => OnProcessedDateChanged(e.Value?.ToString())" />
							</th>
							<th class="align-top">Processed Time</th>
							<th class="align-top">Amount</th>
							<th class="align-top text-end">Actions</th>
						</tr>
					</thead>
					<tbody>
						@foreach (var item in PagedLORS)
						{
							<tr>
								<td>@item.FileName</td>
								<td>@item.ORIPolicyReference</td>
								<td>@item.PolicySequence</td>
								<td>@item.ProcessedDate</td>
								<td>@item.ProcessedTime</td>
								<td class="text-end">@item.Amount.ToString("N2")</td>
								<td>
									<button class="btn btn-outline-primary btn-sm"
											@onclick="@(() => NavigationManager.NavigateTo($"ViewLORS/{item.FileName}/{item.PolicySequence}"))">
										View
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="px-3 pb-3">
				<div class="d-flex justify-content-between align-items-center mt-3">
					<select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
						@foreach (var size in PageSizeOptions)
						{
							<option value="@size" selected="@(PageSize == size)">
								@size per page
							</option>
						}
					</select>

					<nav>
						<ul class="pagination mb-0">
							<li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
								<button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
							</li>

							@if (StartPage > 1)
							{
								<li class="page-item">
									<button class="page-link" @onclick="() => ShiftPageWindow(-1)">...</button>
								</li>
							}

							@for (int i = StartPage; i <= EndPage && i <= TotalPages; i++)
							{
								var pageNumber = i;  // capture value
								<li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
									<button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
								</li>
							}

							@if (EndPage < TotalPages)
							{
								<li class="page-item">
									<button class="page-link" @onclick="() => ShiftPageWindow(1)">...</button>
								</li>
							}

							<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
								<button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
							</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	}

</div>

@code {
	private List<LORSListModel> AllLORS = new();
	private List<LORSListModel> PagedLORS = new();
	private int CurrentPage = 1;
	private int PageSize = 10;
	private int TotalRecords = 0;
	private List<int> PageSizeOptions = new() { 10, 20, 50, 100 };

	private string FilterFileName = "";
	private string FilterORIPolicyReference = "";
	private string FilterProcessedDate = "";

	private const int MaxVisiblePages = 10;
	private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalRecords / PageSize));
	private int StartPage => Math.Max(1, ((CurrentPage - 1) / MaxVisiblePages) * MaxVisiblePages + 1);
	private int EndPage => Math.Min(StartPage + MaxVisiblePages - 1, TotalPages);

	private IEnumerable<LORSListModel> FilteredLORS => AllLORS.Where(lors =>
		(string.IsNullOrWhiteSpace(FilterFileName) || lors.FileName?.Contains(FilterORIPolicyReference, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterORIPolicyReference) || lors.ORIPolicyReference?.Contains(FilterORIPolicyReference, StringComparison.OrdinalIgnoreCase) == true) &&
		(string.IsNullOrWhiteSpace(FilterProcessedDate) || lors.ProcessedDate?.Contains(FilterORIPolicyReference, StringComparison.OrdinalIgnoreCase) == true)
	);

	protected override async Task OnInitializedAsync()
	{
		AllLORS = (await ORIService.GetLORSList()).ToList();
		await ApplyFilters();
	}

	private void ApplyPagination()
	{
		PagedLORS = FilteredLORS
			.Skip((CurrentPage - 1) * PageSize)
			.Take(PageSize)
			.ToList();
	}

	private async Task ApplyFilters()
	{
		TotalRecords = FilteredLORS.Count();
		ApplyPagination();

		await InvokeAsync(StateHasChanged); // ensures the UI updates correctly
	}

	private async Task GoToPage(int page)
	{
		if (page >= 1 && page <= TotalPages)
		{
			CurrentPage = page;
			await ApplyFilters();
		}
	}

	private async Task ShiftPageWindow(int direction)
	{
		int newPage = direction > 0
			? Math.Min(EndPage + 1, TotalPages) // shift to the first page of the next window
			: Math.Max(StartPage - MaxVisiblePages, 1); // shift to the first page of the previous window

		await GoToPage(newPage);
	}

	private async Task OnPageSizeChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int newSize))
		{
			PageSize = newSize;
			CurrentPage = 1;
			await ApplyFilters();
		}
	}

	private async Task OnFilenameChanged(string value) { FilterFileName = value; await ApplyFilters(); }
	private async Task OnORIPolicyReferenceChange(string value) { FilterORIPolicyReference = value; await ApplyFilters(); }
	private async Task OnProcessedDateChanged(string value) { FilterProcessedDate = value; await ApplyFilters(); }

}
