@page "/prismadjustments"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using Sandbox.Services
@using Sandbox.Models.ORI
@inject PrismService PrismService
@inject AuthenticationStateProvider AuthProvider

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
    <h3 class="page-header m-0">Prism Adjustments</h3>
    <div class="d-flex gap-2 ms-auto">
        <a class="btn btn-primary" href="templates/PrismAdjustmentsTemplate.xlsx" title="Download Adjustment Template" download>
            <i class="bi bi-download me-1"></i>
        </a>
    </div>
</div>

<div class="card p-4 shadow-sm">
    <div class="card-header">Upload Adjustments</div>
    <div class="card-body">
        <div class="mb-3 d-flex align-items-center gap-3">
            @* <label class="btn btn-primary m-0">
                Choose File
                <InputFile OnChange="HandleFileSelected" accept=".xlsx" class="d-none" />
            </label> *@
            <button class="btn btn-primary" @onclick="OpenUploadModal">Choose File</button>
            @if (!string.IsNullOrEmpty(selectedFileName))
            {
                <span>@selectedFileName</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(selectedFileName))
        {
            <p><strong>Selected:</strong> @selectedFileName</p>
        }

        @if (!string.IsNullOrEmpty(uploadMessage))
        {
            <div class="alert @(uploadSuccess ? "alert-success" : "alert-danger") mt-3" role="alert">
                @uploadMessage
            </div>
        }

        @if (isUploading)
        {
            <div class="position-fixed top-0 bottom-0 start-0 end-0 d-flex justify-content-center align-items-center bg-light bg-opacity-75" style="z-index: 1050;">
                <div class="spinner-border text-primary" role="status" style="width: 4rem; height: 4rem;">
                    <span class="visually-hidden">Uploading...</span>
                </div>
            </div>
        }
    </div>
</div>
<div class="card shadow mb-4 border">
    <div class="card-header">Adjustment History</div>
    <div class="table-responsive">
        <table class="table table-striped table-fixed text-nowrap">
            <colgroup>
                <col style="width: 10%" />
                <col style="width: 20%" />
                <col style="width: 30%" />
                <col style="width: 20%" />
                <col style="width: 20%" />
            </colgroup>
            <thead>
                <tr>
                    <th>Adjustment ID</th>
                    <th>Uploaded By</th>
                    <th>Upload Date</th>
                    <th>Original Filename</th>
                    <th>Download</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var adj in uploads)
                {
                    <tr>
                        <td>@adj.AdjustmentID</td>
                        <td>@adj.UploadedBy</td>
                        <td>@adj.UploadedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@adj.AdjustmentFileName</td>
                        <td>
                            <a class="btn btn-sm btn-outline-primary"
                               href="@($"/uploads/prismadjustments/{adj.AdjustmentID}_{adj.AdjustmentFileName}")"
                               target="_blank"
                               download>
                                Download
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<div class="card p-4 shadow-sm">

    <div class="card-body">
    </div>
</div>

@* Upload Modal *@
@if (showUploadModal)
{
    <div class="modal fade show" style="display:block;" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content shadow">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Adjustments</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseUploadModal"></button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Processing Month (YYYYMM)</label>
                        <select class="form-select" @bind="selectedProcessingMonth">
                            <option value="">-- Select Processing Month --</option>
                            @foreach (var pm in processingMonths)
                            {
                                <option value="@pm">@pm</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Excel File (.xlsx)</label>
                        <InputFile OnChange="OnFileSelected" accept=".xlsx,.xls" />
                        @if (!string.IsNullOrWhiteSpace(selectedFileName))
                        {
                            <div class="form-text">Selected: @selectedFileName</div>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(modalError))
                    {
                        <div class="alert alert-warning" role="alert">@modalError</div>
                    }
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseUploadModal" disabled="@isUploading">Cancel</button>
                    <button class="btn btn-primary" @onclick="UploadAsync" disabled="@(!canUpload || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">Uploading…</span>
                        }
                        else
                        {
                            <span>Upload</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}


@code {
    private IBrowserFile? uploadedFile;
    private string? selectedFileName;
    private string? uploadMessage;
    private bool isUploading = false;
    private bool uploadSuccess = false;

    private bool showUploadModal = false;
    private List<string> processingMonths = new();
    private string? selectedProcessingMonth;
    private string? modalError;

    private List<ORIAdjustmentUploadModel> uploads = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            uploads = await PrismService.GetORIAdjustmentUploads();
            processingMonths = await PrismService.GetProcessingMonths();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Failed to load uploads: {ex.Message}");
        }
    }

    private void OpenUploadModal()
    {
        modalError = null;
        selectedProcessingMonth = null;
        uploadedFile = null;
        selectedFileName = null;
        showUploadModal = true;
    }

    private void CloseUploadModal()
    {
        if (!isUploading)
        {
            showUploadModal = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        uploadedFile = e.File;
        selectedFileName = uploadedFile?.Name;
    }

    private bool canUpload =>
        !string.IsNullOrWhiteSpace(selectedProcessingMonth) &&
        uploadedFile is not null;

    private async Task UploadAsync()
    {
        modalError = null;
        uploadMessage = null;

        if (string.IsNullOrWhiteSpace(selectedProcessingMonth))
        {
            modalError = "Please select a processing month.";
            return;
        }
        if (uploadedFile is null)
        {
            modalError = "Please choose a file.";
            return;
        }

        try
        {
            isUploading = true;

            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userName = auth.User?.Identity?.Name ?? "unknown";

            using var memoryStream = new MemoryStream();
            await uploadedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(memoryStream);
            memoryStream.Position = 0;

            var adjustmentId = await PrismService.UploadAdjustmentsAsync(memoryStream, userName, selectedFileName, selectedProcessingMonth);

            uploadMessage = $"Upload completed. Adjustment ID: {adjustmentId}";
            uploadSuccess = true;

            // Close modal
            showUploadModal = false;

            uploads = await PrismService.GetORIAdjustmentUploads();
            StateHasChanged(); ;
        }
        catch (Exception ex)
        {
            modalError = $"Upload failed: {ex.Message}";
            uploadSuccess = false;
        }
        finally
        {
            isUploading = false;
        }
    }
}
}
