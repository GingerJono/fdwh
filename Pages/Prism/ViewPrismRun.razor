        </div>

        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Actual RIPs (@Run?.ORIActualRIPs?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => FileExportHelper.ExportToCsvAsync(Run.ORIActualRIPs, $"ORIActualRIPs_{Run.RunID}.csv", JS))">
