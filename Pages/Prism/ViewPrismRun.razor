@page "/ViewPrismRun/{RunID}"
@using Sandbox.Models.Prism
@using Sandbox.Services
@using CardModel
@using System.Text
@using System.IO.Compression;
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager
@inject PrismService PrismService
@inject IJSRuntime JS


<style>
    .table thead th {
        background-color: #002855; /* dark navy blue */
        color: white;
        border-color: #dee2e6;
    }

    .card h2, .card h3 {
        margin-bottom: 0.25rem;
    }

</style>

@if (IsLoading)
{
    <p>Loading Run details...</p>
}
else if (!string.IsNullOrEmpty(ErrorMessage))
{
    <p class="text-danger">@ErrorMessage</p>
}
else
{
    <div class="row">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-header m-0">
                Prism Run @(Run?.RunID.ToString() ?? "[Not Found]")
            </h1>
        </div>
    </div>
    <div class="row">
        <div class="card shadow mb-4 border border-dark">
            <div class="card-body">
                <div class="row">
                    @if (Run != null)
                    {
                        <div class="col-md-2"><strong>Processing Month</strong><div class="fs-4 text">@Run.ProcessingMonth</div></div>
                        <div class="col-md-2"><strong>Start Time</strong><div class="fs-4 text">@Run.StartTime.ToString("yyyy-MM-dd HH:mm")</div></div>
                        <div class="col-md-2"><strong>End Time</strong><div class="fs-4 text">@Run.EndTime?.ToString("yyyy-MM-dd HH:mm")</div></div>
                        <div class="col-md-2"><strong>Duration (Minutes)</strong><div class="fs-4 text">@Run.DurationMinutes</div></div>
                        <div class="col-md-1"><strong>Version</strong><div class="fs-4 text">@Run.PrismVersion</div></div>
                        <div class="col-md-1"><strong>Run By</strong><div class="fs-4 text">@Run.RunUser</div></div>
                        <div class="col-md-2"><strong>Status</strong><div class="fs-4 text">@Run.Status</div></div>
                    }
                    else
                    {
                        <p><em>No Run details found.</em></p>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Run?.Notes))
                {
                    <div class="row">
                        <div class="col-md-4"><strong>Notes</strong><div class="fs-4 text">@Run.Notes</div></div>
                        @if (!string.IsNullOrEmpty(Run.ErrorMessage))
                        {
                            <div class="col-md-4"><strong>Error</strong><div class="fs-4 text">@Run.ErrorMessage</div></div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="row">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Reporting</h3>
            <button class="btn btn-primary btn-sm" @onclick="() => ExportAllCsvsAsZip(Run, JS)">
                <i class="bi bi-file-zip me-1"></i>
            </button>
        </div>
    </div>

    <div class="row">       
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Allocated Premium Signed (@Run?.AllocatedPremiumSigned?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.AllocatedPremiumSigned, $"AllocatedPremiumSigned_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.AllocatedPremiumSigned == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Allocated Premium Written (@Run?.AllocatedPremiumWritten?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.AllocatedPremiumWritten, $"AllocatedPremiumWritten_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.AllocatedPremiumWritten == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Allocated Recoveries and RIPS (@Run?.AllocatedRecoveriesAndRIPs?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.AllocatedRecoveriesAndRIPs, $"AllocatedRecoveriesAndRIPs_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.AllocatedRecoveriesAndRIPs == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>Analytics</h3>           
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Incurred Claims By Event (@Run?.ORIPolicyIncurredClaimsByEvent?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicyIncurredClaimsByEvent, $"ORIPolicyIncurredClaimsByEvent_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicyIncurredClaimsByEvent == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Ultimate Claims By Event (@Run?.ORIPolicyUltimateClaimsByEvent?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicyUltimateClaimsByEvent, $"ORIPolicyUltimateClaimsByEvent_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicyUltimateClaimsByEvent == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Actual Recoveries (@Run?.ORIActualRecoveries?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIActualRecoveries, $"ORIActualRecoveries_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIActualRecoveries == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Actual RIPs (@Run?.ORIActualRIPs?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIActualRIPs, $"ORIActualRIPs_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIActualRIPs == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Policies (@Run?.ORIPolicies?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicies, $"ORIPolicies_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicies == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Policy to Inward Policy Mapping (@Run?.ORIPolicyToInwardPolicyMapping?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicyToInwardPolicyMapping, $"ORIPolicyToInwardPolicyMapping_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicyToInwardPolicyMapping == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>

    </div>

    <div class="row">
         <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Policy to Incurred Claims Mapping (@Run?.ORIPolicyToIncurredClaimsMapping?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicyToIncurredClaimsMapping, $"ORIPolicyToIncurredClaimsMapping_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicyToIncurredClaimsMapping == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Policy to Ultimate Claims Mapping (@Run?.ORIPolicyToUltimateClaimsMapping?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.ORIPolicyToUltimateClaimsMapping, $"ORIPolicyToUltimateClaimsMapping_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicyToUltimateClaimsMapping == null)
                    {
                        <p><em>No data found</em></p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow mb-4 border">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Logs (@Run?.Logs.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => ExportToCsv(Run.Logs, $"PrismLogs_{Run.RunID}.csv"))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (!Run.Logs.Any())
                    {
                        <p><em>No logs found</em></p>
                    }
                    else
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Level</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var log in PaginatedLogs)
                                {
                                    <tr>
                                        <td class="text-nowrap">@log.LogTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@log.LogLevel</td>
                                        <td>@log.Message</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="d-flex justify-content-between align-items-center">
                            <select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChange">
                                @foreach (var size in PageSizeOptions)
                                {
                                    <option value="@size" selected="@(PageSize == size)">
                                        @size per page
                                    </option>
                                }
                            </select>

                            <nav>
                                <ul class="pagination mb-0">
                                    <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
                                    </li>

                                    @if (StartPage > 1)
                                    {
                                        <li class="page-item">
                                            <button class="page-link" @onclick="() => ShiftPageWindow(-1)">...</button>
                                        </li>
                                    }

                                    @for (int i = StartPage; i <= EndPage; i++)
                                    {
                                        <li class="page-item @(CurrentPage == i ? "active" : "")">
                                            <button class="page-link" @onclick="() => GoToPage(i)">@i</button>
                                        </li>
                                    }

                                    @if (EndPage < TotalPages)
                                    {
                                        <li class="page-item">
                                            <button class="page-link" @onclick="() => ShiftPageWindow(1)">...</button>
                                        </li>
                                    }

                                    <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
                                    </li>
                                </ul>
                            </nav>

                        </div>

                    }
                </div>
            </div>
        </div>
    </div>
}
@code {
    [Parameter] public string RunID { get; set; }

    private RunModel Run { get; set; }
    private bool IsLoading { get; set; } = true;
    private string ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(RunID))
        {
            ErrorMessage = "Run ID is required.";
            IsLoading = false;
            return;
        }

        try
        {
            int runLogNumber = int.Parse(RunID);
            Run = await PrismService.GetRun(runLogNumber);

            if (Run == null)
            {
                ErrorMessage = $"No details found for run with ID: {RunID}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while fetch Run Logs";
            Console.WriteLine($"[ERROR] Failed to fetch Run Logs: {ex}");
        }
        finally
        {
            IsLoading = false;
            Console.WriteLine($"[INFO] Data loading complete for {RunID}");
        }
    }

    private async Task ExportToCsv<T>(List<T> data, string filename)
    {
        if (data == null || !data.Any())
        {
            Console.WriteLine($"[ExportToCsv] No data found for export: {filename}");
            return;
        }

        var csv = CsvExportService.ToCsv(data);
        var bytes = Encoding.UTF8.GetBytes(csv);
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);

        await JS.InvokeVoidAsync("downloadFileFromStream", filename, streamRef);
    }

    public async Task ExportAllCsvsAsZip(RunModel run, IJSRuntime js)
    {
        using var zipStream = new MemoryStream();

        using (var archive = new ZipArchive(zipStream, ZipArchiveMode.Create, leaveOpen: true))
        {
            void AddCsv<T>(List<T> data, string filename)
            {
                if (data != null && data.Any())
                {
                    var csv = CsvExportService.ToCsv(data);
                    var entry = archive.CreateEntry(filename);
                    using var entryStream = entry.Open();
                    using var writer = new StreamWriter(entryStream);
                    writer.Write(csv);
                }
            }

            AddCsv(run.AllocatedPremiumSigned, $"AllocatedPremiumSigned_{Run.RunID}.csv");
            AddCsv(run.AllocatedPremiumWritten, $"AllocatedPremiumWritten_{Run.RunID}.csv");
            AddCsv(run.AllocatedRecoveriesAndRIPs, $"AllocatedRecoveriesAndRIPs_{Run.RunID}.csv");
            AddCsv(run.ORIPolicyIncurredClaimsByEvent, $"ORIPolicyIncurredClaimsByEvent_{Run.RunID}.csv");
            AddCsv(run.ORIPolicyUltimateClaimsByEvent, $"ORIPolicyUltimateClaimsByEvent_{Run.RunID}.csv");
            AddCsv(run.ORIActualRecoveries, $"ORIActualRecoveries_{run.RunID}.csv");
            AddCsv(run.ORIActualRIPs, $"ORIActualRIPs_{run.RunID}.csv");
            AddCsv(run.ORIPolicies, $"ORIPolicies_{run.RunID}.csv");
            AddCsv(run.ORIPolicyToIncurredClaimsMapping, $"ORIPolicyToIncurredClaimsMapping_{run.RunID}.csv");
            AddCsv(run.ORIPolicyToUltimateClaimsMapping, $"ORIPolicyToUltimateClaimsMapping_{run.RunID}.csv");
            AddCsv(run.ORIPolicyToInwardPolicyMapping, $"ORIPolicyToInwardPolicyMapping_{run.RunID}.csv");
            AddCsv(run.ORIPolicyToUltimateClaimsMapping, $"ORIPolicyToUltimateClaimsMapping_{run.RunID}.csv");
        }

        zipStream.Position = 0;

        using var streamRef = new DotNetStreamReference(zipStream);
        await js.InvokeVoidAsync("downloadFileFromStream", $"Prism_Export_Run_{run.RunID}.zip", streamRef);
    }

    // Paginated Log table code
    private int CurrentPage = 1;
    private int PageSize = 25;
    private List<int> PageSizeOptions = new() { 10, 25, 50, 100 };
    private List<RunLogModel> AllLogs => Run?.Logs ?? new List<RunLogModel>();
    private int TotalPages => (int)Math.Ceiling((double)AllLogs.Count / PageSize);
    private const int MaxVisiblePages = 10;

    private IEnumerable<RunLogModel> PaginatedLogs =>
    AllLogs
    .Skip((CurrentPage - 1) * PageSize)
    .Take(PageSize);

    // Paging window start and end
    private int StartPage => Math.Max(1, ((CurrentPage - 1) / MaxVisiblePages) * MaxVisiblePages + 1);
    private int EndPage => Math.Min(StartPage + MaxVisiblePages - 1, TotalPages);

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OnPageSizeChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private void ShiftPageWindow(int direction)
    {
        int newPage = direction > 0
        ? Math.Min(StartPage + MaxVisiblePages, TotalPages)
        : Math.Max(StartPage - MaxVisiblePages, 1);

        GoToPage(newPage);
    }

}
