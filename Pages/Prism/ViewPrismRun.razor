                    <span>ORI Actual Recoveries (@Run?.ORIActualRecoveries?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => FileExportHelper.ExportToCsvAsync(Run.ORIActualRecoveries, $"ORIActualRecoveries_{Run.RunID}.csv", JS))">
