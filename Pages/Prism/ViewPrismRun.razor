                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>ORI Policies (@Run?.ORIPolicies?.Count())</span>
                    <button class="btn btn-primary" @onclick="@(() => FileExportHelper.ExportToCsvAsync(Run.ORIPolicies, $"ORIPolicies_{Run.RunID}.csv", JS))">
                        <i class="bi bi-download me-1"></i>
                    </button>
                </div>
                <div class="card-body">
                    @if (Run?.ORIPolicies == null)
