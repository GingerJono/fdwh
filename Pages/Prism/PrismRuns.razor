@page "/PrismRuns"
@using Sandbox.Models.Prism
@using Sandbox.Services
@using Sandbox._Spk
@using CardModel
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@inject PrismService PrismService

<!-- Modal -->
@if (showModal)
{
	<div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Start New Prism Run</h5>
					<button type="button" class="btn-close" @onclick="CloseModal"></button>
				</div>
				<div class="modal-body">
					<label>Processing Month</label>
					<select class="form-control" @bind="selectedProcessingMonth">
						@foreach (var month in ProcessingMonths)
						{
							<option value="@month">@month</option>
						}
					</select>

					<label class="mt-3">Notes</label>
					<textarea class="form-control" @bind="runNotes" placeholder="Add note..."></textarea>
				</div>
				<div class="modal-footer">					
					@if (IsLoadingRuns)
					{
						<div class="d-flex align-items-center">
							<div class="spinner-border text-primary me-2" role="status">
								<span class="visually-hidden">Loading...</span>
							</div>
							<span>Starting Prism run...</span>
						</div>
					}
					else
					{
						<button class="btn btn-danger" @onclick="CloseModal">Cancel</button>
						<button class="btn btn-success" @onclick="ExecutePrismRun">Run</button>
					}
				</div>
			</div>
		</div>
	</div>
}

<div class="d-flex justify-content-between align-items-center mt-4 mb-4">
	<h3 class="mb-0">Prism Run Manager</h3>
	<button class="btn btn-primary" @onclick="ShowRunModal">New Run</button>
</div>

<div class="row mb-4">
	<div class="card shadow mb-4 border">
		<div class="card-header">Run History</div>
		<div class="card-body">
			@if (AllRuns == null)
			{
				<p><em>Loading...</em></p>
			}
			else
			{
				<div class="table-responsive">
					<table class="table table-striped  table-fixed text-nowrap">
						<colgroup>
							<col style="width: 5%">
							<col style="width: 10%">
							<col style="width: 10%">
							<col style="width: 10%">
							<col style="width: 20%">
							<col style="width: 10%">
							<col style="width: 10%">
							<col style="width: 10%">
							<col style="width: 10%">
							<col style="width: 5%">
						</colgroup>
						<thead>
							<tr>
								<th class="align-top">ID</th>
								<th class="align-top">User</th>
								<th class="align-top">Status</th>
								<th class="align-top">Version</th>
								<th class="align-top">Notes</th>
								<th class="align-top">Processing Month</th>
								<th class="align-top">Start Time</th>
								<th class="align-top">End Time</th>
								<th class="align-top text-end">Duration (Minutes)</th>
								<th class="align-top">Actions</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var run in PagedRuns)
							{
								<tr>
									<td>@run.RunID</td>
									<td>@run.RunUser</td>
									<td>@run.Status</td>
									<td>@run.PrismVersion</td>
									<td>@run.Notes</td>
									<td>@run.ProcessingMonth</td>
									<td>@run.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
									<td>@(run.EndTime?.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
									<td class="text-end">@(run.DurationMinutes.ToString() ?? "")</td>
									<td>
										<button class="btn btn-sm btn-outline-primary"
										@onclick="@(() => NavigationManager.NavigateTo($"ViewPrismRun/{run.RunID}"))">
											View
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				<div class="px-3 pb-3">
					<div class="d-flex justify-content-between align-items-center mt-3">
						<select class="form-select form-select-sm w-auto" @onchange="OnPageSizeChanged">
							@foreach (var size in PageSizeOptions)
							{
								<option value="@size" selected="@(PageSize == size)">
									@size per page
								</option>
							}
						</select>

						<nav>
							<ul class="pagination mb-0">
								<li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
									<button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">Previous</button>
								</li>

								@if (StartPage > 1)
								{
									<li class="page-item">
										<button class="page-link" @onclick="() => ShiftPageWindow(-1)">...</button>
									</li>
								}

								@for (int i = StartPage; i <= EndPage && i <= TotalPages; i++)
								{
									var pageNumber = i;  // capture value
									<li class="page-item @(CurrentPage == pageNumber ? "active" : "")">
										<button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
									</li>
								}

								@if (EndPage < TotalPages)
								{
									<li class="page-item">
										<button class="page-link" @onclick="() => ShiftPageWindow(1)">...</button>
									</li>
								}

								<li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
									<button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">Next</button>
								</li>
							</ul>
						</nav>
					</div>
				</div>
			}
		</div>
	</div>
</div>

@code {
	private List<RunModel> AllRuns = new();
	private List<RunModel> PagedRuns = new();
	private int CurrentPage = 1;
	private int PageSize = 10;
	private int TotalRecords = 0;
	private List<int> PageSizeOptions = new() { 10, 20, 50, 100 };

	private const int MaxVisiblePages = 10;
	private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalRecords / PageSize));
	private int StartPage => Math.Max(1, ((CurrentPage - 1) / MaxVisiblePages) * MaxVisiblePages + 1);
	private int EndPage => Math.Min(StartPage + MaxVisiblePages - 1, TotalPages);

	private bool showModal = false;
	private List<string> ProcessingMonths = new();
	private string selectedProcessingMonth = string.Empty;
	private string runNotes = string.Empty;
	private bool IsLoadingRuns = false;

	protected override async Task OnInitializedAsync()
	{
		ProcessingMonths = await PrismService.GetProcessingMonths();
		AllRuns = await PrismService.GetRuns();
		ApplyPagination();
	}

	private void ApplyPagination()
	{
		TotalRecords = AllRuns.Count;
		PagedRuns = AllRuns
			.Skip((CurrentPage - 1) * PageSize)
			.Take(PageSize)
			.ToList();
	}	

	private async Task GoToPage(int page)
	{
		if (page >= 1 && page <= TotalPages)
		{
			CurrentPage = page;
			ApplyPagination();
		}
	}

	private async Task ShiftPageWindow(int direction)
	{
		int newPage = direction > 0
			? Math.Min(EndPage + 1, TotalPages) // shift to the first page of the next window
			: Math.Max(StartPage - MaxVisiblePages, 1); // shift to the first page of the previous window

		await GoToPage(newPage);
	}

	private async Task OnPageSizeChanged(ChangeEventArgs e)
	{
		if (int.TryParse(e.Value?.ToString(), out int newSize))
		{
			PageSize = newSize;
			CurrentPage = 1;
			ApplyPagination();
		}
	}

	private void ShowRunModal()
	{
		showModal = true;
	}

	private void CloseModal()
	{
		showModal = false;
		selectedProcessingMonth = string.Empty;
		runNotes = string.Empty;
	}

	private async Task ExecutePrismRun()
	{
		IsLoadingRuns = true;

		_ = PrismService.StartRun(selectedProcessingMonth, runNotes)
		.ContinueWith(task =>
		{
			if (task.Exception != null)
			{
				Console.WriteLine("Prism run failed: " + task.Exception.InnerException?.Message);
				// Optionally log or show a toast
			}			
		});	
		
		await Task.Delay(TimeSpan.FromSeconds(30));

		// Refresh the list of runs
		AllRuns = await PrismService.GetRuns();

		IsLoadingRuns = false;
		StateHasChanged(); // Refresh UI

		CloseModal();
	}

	public class PrismRunInput
	{
		public string ProcessingMonth { get; set; } = string.Empty;
		public string Notes { get; set; } = string.Empty;
	}
}