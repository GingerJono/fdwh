@page "/Ultimates/Watchlist"
@inject sandboxapp.Services.UltimatesService UltimatesService
@inject IHttpContextAccessor HttpContextAccessor
@using sandboxapp.Models.Ultimates

<div class="row mt-4 mb-4">
	<h3>Watchlist</h3>
	<p class="text-muted">Latest update per watchlist item</p>
</div>

@if (isLoading)
{
	<div class="d-flex align-items-center">
		<div class="spinner-border text-primary me-2" role="status"></div>
		<span>Loading watchlist...</span>
	</div>
}
else if (WatchlistRows?.Any() == true)
{
	<div class="row mb-4">
		<div class="col-lg-3 col-md-6 mb-3">
			<div class="card h-100 border-0 shadow-sm">
				<div class="card-body">
					<h6 class="text-muted">Active Watchlist Items</h6>
					<h3 class="mb-0">@ActiveItemCount</h3>
				</div>
			</div>
		</div>
		<div class="col-lg-3 col-md-6 mb-3">
			<div class="card h-100 border-0 shadow-sm">
				<div class="card-body">
					<h6 class="text-muted">Total Ultimate (USD)</h6>
					<h3 class="mb-0">@TotalUltimate.ToString("N0")</h3>
				</div>
			</div>
		</div>
	</div>

	<div class="card mb-3">
		<div class="card-body">
			<div class="row">
				<div class="col-md-6 mb-3">
					<h6 class="mb-2"><i class="bi bi-funnel"></i> Filter by Class</h6>
					<div class="d-flex flex-wrap gap-2">
						<button type="button"
								class="btn btn-sm @(selectedClass == null ? "btn-primary" : "btn-outline-primary")"
								@onclick="() => FilterByClass(null)">
							All
						</button>
						@foreach (var className in distinctClasses)
						{
							<button type="button"
									class="btn btn-sm @(selectedClass == className ? "btn-primary" : "btn-outline-primary")"
									@onclick="() => FilterByClass(className)">
								@className
							</button>
						}
					</div>
				</div>

				<div class="col-md-6 mb-3">
					<h6 class="mb-2"><i class="bi bi-funnel"></i> Filter by YOA</h6>
					<div class="d-flex flex-wrap gap-2">
						<button type="button"
								class="btn btn-sm @(selectedYOA == null ? "btn-primary" : "btn-outline-primary")"
								@onclick="() => FilterByYOA(null)">
							All
						</button>
						@foreach (var yoa in distinctYOAs.OrderByDescending(y => y))
						{
							<button type="button"
									class="btn btn-sm @(selectedYOA == yoa ? "btn-primary" : "btn-outline-primary")"
									@onclick="() => FilterByYOA(yoa)">
								@yoa
							</button>
						}
					</div>
				</div>
			</div>

			<div class="row align-items-center">
				<div class="col-md-6">
					<div class="form-check form-switch">
						<input class="form-check-input" type="checkbox" id="showInactive" @bind="showInactive" />
						<label class="form-check-label" for="showInactive">Show inactive items</label>
					</div>
				</div>
				@if (selectedClass != null || selectedYOA != null)
				{
					<div class="col-md-6 text-md-end mt-2 mt-md-0">
						<small class="text-muted">
							Showing @FilteredRows.Count() of @WatchlistRows.Count records
							@if (selectedClass != null) { <text> | Class: <strong>@selectedClass</strong></text> }
							@if (selectedYOA != null) { <text> | YOA: <strong>@selectedYOA</strong></text> }
						</small>
					</div>
				}
			</div>
		</div>
	</div>

	<div class="card shadow mb-4 border">
		<div class="table-responsive">
			<table class="table table-striped table-hover text-nowrap align-middle">
				<thead class="table-dark">
					<tr>
						<th>ID</th>
						<th>View</th>
						<th>Type</th>
						<th>Policy Ref</th>
						<th>Assured</th>
						<th>Class</th>
						<th>Reserving Class</th>
						<th>YOA</th>
						<th>Claimant</th>
						<th>Loss Description</th>
						<th>Current Reserve</th>
						<th>Ultimate (USD)</th>
						<th>Updates</th>
						<th>Latest Update</th>
						<th>Confidence</th>
						<th>Probability %</th>
						<th>Domicile</th>
						<th>Leader</th>
						<th>Currency</th>
						<th>Limit</th>
						<th>XS</th>
						<th>Dale Line</th>
						<th>Dale Limit USD</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var row in FilteredRows)
					{
						var item = row.Item;
						<tr>
							<td>@item.WatchlistID</td>
							<td>
								<button class="btn btn-sm btn-primary" @onclick="() => ShowDetailModal(item)">
									View
								</button>
							</td>
							<td>@item.WatchlistType</td>
							<td>@item.PolicyReference</td>
							<td>@item.AssuredName</td>
							<td>@item.Class</td>
							<td>@item.ReservingClass</td>
							<td>@item.YOA</td>
							<td>@item.Claimant</td>
							<td class="text-wrap" style="max-width: 240px;">@item.WatchlistDescription</td>
							<td>@(item.IncurredUSDAtQtrFX?.ToString("N0") ?? "-")</td>
							<td>@(item.DaleShareUltimateUSD?.ToString("N0") ?? "-")</td>
							<td>@row.UpdateCount</td>
							<td>
								@if (!string.IsNullOrWhiteSpace(item.UpdateNarrative))
								{
									<span class="text-decoration-underline" title="@item.UpdateNarrative">Hover to view</span>
								}
								else
								{
									<span>-</span>
								}
							</td>
							<td>
								@if (!string.IsNullOrWhiteSpace(item.ReservingConfidenceRating))
								{
									<span class="badge @GetConfidenceBadgeClass(item.ReservingConfidenceRating)">
										@item.ReservingConfidenceRating
									</span>
								}
								else
								{
									<span>-</span>
								}
							</td>
							<td>@(item.Probability?.ToString("N1") ?? "-")</td>
							<td>@item.DomicileCountry</td>
							<td>@item.Leader</td>
							<td>@item.Currency</td>
							<td>@(item.Limit?.ToString("N0") ?? "-")</td>
							<td>@(item.XS?.ToString("N0") ?? "-")</td>
							<td>@(item.DaleLine?.ToString("N2") ?? "-")</td>
							<td>@(item.DaleLimitUSDatQtrFX?.ToString("N0") ?? "-")</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
else
{
	<div class="alert alert-info">
		<strong>No watchlist items found.</strong>
	</div>
}

@code {
	private List<WatchlistRow> WatchlistRows = new();
	private List<WatchlistUpdate> selectedUpdates = new();
	private WatchlistWithLatestUpdate selectedItem;
	private bool isLoading = true;
	private bool showInactive = false;
	private bool showDetailModal = false;
	private bool showNewUpdateModal = false;
	private bool isLoadingUpdates = false;
	private bool isSubmittingUpdate = false;
	private string updateType = "Update";
	private string ibnrRecommendedSelection = "";
	private string riApplicableSelection = "";
	private WatchlistUpdate newUpdate = new();
	private List<string> distinctClasses = new();
	private List<int> distinctYOAs = new();
	private string selectedClass;
	private int? selectedYOA;

	private int ActiveItemCount => WatchlistRows.Count(row => row.Item.IsActive == 1);
	private decimal TotalUltimate => WatchlistRows
		.Where(row => row.Item.IsActive == 1 && row.Item.DaleShareUltimateUSD.HasValue)
		.Sum(row => row.Item.DaleShareUltimateUSD ?? 0);

	private IEnumerable<WatchlistRow> FilteredRows =>
		ApplyFilters();

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var items = (await UltimatesService.GetWatchlistWithLatestUpdateAsync())?.ToList() ?? new();
			var countTasks = items.Select(async item =>
			{
				var updates = await UltimatesService.GetWatchlistUpdatesByIdAsync(item.WatchlistID);
				return new WatchlistRow
				{
					Item = item,
					UpdateCount = updates?.Count() ?? 0
				};
			});

			WatchlistRows = (await Task.WhenAll(countTasks)).ToList();
			SetDistinctFilters();
		}
		finally
		{
			isLoading = false;
		}
	}

	private IEnumerable<WatchlistRow> ApplyFilters()
	{
		var filtered = showInactive
			? WatchlistRows
			: WatchlistRows.Where(row => row.Item.IsActive == 1);

		if (!string.IsNullOrWhiteSpace(selectedClass))
		{
			filtered = filtered.Where(row => row.Item.Class == selectedClass);
		}

		if (selectedYOA.HasValue)
		{
			filtered = filtered.Where(row => row.Item.YOA == selectedYOA);
		}

		return filtered;
	}

	private void SetDistinctFilters()
	{
		distinctClasses = WatchlistRows
			.Select(row => row.Item.Class)
			.Where(value => !string.IsNullOrWhiteSpace(value))
			.Distinct()
			.OrderBy(value => value)
			.ToList();

		distinctYOAs = WatchlistRows
			.Select(row => row.Item.YOA)
			.Where(value => value.HasValue)
			.Select(value => value.Value)
			.Distinct()
			.OrderByDescending(value => value)
			.ToList();
	}

	private void FilterByClass(string className)
	{
		selectedClass = className;
	}

	private void FilterByYOA(int? yoa)
	{
		selectedYOA = yoa;
	}

	private async Task ShowDetailModal(WatchlistWithLatestUpdate item)
	{
		selectedItem = item;
		showDetailModal = true;
		await LoadUpdates();
	}

	private async Task LoadUpdates()
	{
		if (selectedItem == null)
		{
			return;
		}

		isLoadingUpdates = true;
		try
		{
			selectedUpdates = (await UltimatesService.GetWatchlistUpdatesByIdAsync(selectedItem.WatchlistID))?.ToList() ?? new();
		}
		finally
		{
			isLoadingUpdates = false;
		}
	}

	private void CloseDetailModal()
	{
		showDetailModal = false;
		selectedItem = null;
		selectedUpdates = new();
	}

	private void ShowNewUpdateModal()
	{
		if (selectedItem == null)
		{
			return;
		}

		var username = HttpContextAccessor.HttpContext?.User?.Identity?.Name ?? "Unknown";
		newUpdate = new WatchlistUpdate
		{
			WatchlistID = selectedItem.WatchlistID,
			UpdateDate = DateTime.Today,
			UpdatedBy = username,
			ReservingConfidenceRating = selectedItem.ReservingConfidenceRating,
			IBNRRecommended = selectedItem.IBNRRecommended,
			DaleShareUltimateUSD = selectedItem.DaleShareUltimateUSD,
			RIApplicable = selectedItem.RIApplicable,
			Probability = selectedItem.Probability
		};
		updateType = "Update";
		ibnrRecommendedSelection = selectedItem.IBNRRecommended switch
		{
			true => "true",
			false => "false",
			_ => ""
		};
		riApplicableSelection = selectedItem.RIApplicable;
		showNewUpdateModal = true;
	}

	private void CloseNewUpdateModal()
	{
		showNewUpdateModal = false;
	}

	private async Task SubmitNewUpdate()
	{
		if (selectedItem == null)
		{
			return;
		}

		isSubmittingUpdate = true;
		try
		{
			newUpdate.IBNRRecommended = ibnrRecommendedSelection switch
			{
				"true" => true,
				"false" => false,
				_ => null
			};
			newUpdate.RIApplicable = riApplicableSelection;
			ApplyUpdateType();
			await UltimatesService.AddWatchlistUpdateAsync(newUpdate);
			await LoadUpdates();

			var row = WatchlistRows.FirstOrDefault(r => r.Item.WatchlistID == selectedItem.WatchlistID);
			if (row != null)
			{
				row.UpdateCount = selectedUpdates.Count;
				row.Item.DaleShareUltimateUSD = newUpdate.DaleShareUltimateUSD;
				row.Item.IBNRRecommended = newUpdate.IBNRRecommended;
				row.Item.ReservingConfidenceRating = newUpdate.ReservingConfidenceRating;
				row.Item.UpdateNarrative = newUpdate.UpdateNarrative;
				row.Item.UpdateDate = newUpdate.UpdateDate;
				row.Item.UpdatedBy = newUpdate.UpdatedBy;
				row.Item.IsUpdate = newUpdate.IsUpdate;
				row.Item.IsChaser = newUpdate.IsChaser;
				row.Item.Probability = newUpdate.Probability;
				row.Item.RIApplicable = newUpdate.RIApplicable;
			}
			showNewUpdateModal = false;
		}
		finally
		{
			isSubmittingUpdate = false;
		}
	}

	private void ApplyUpdateType()
	{
		switch (updateType)
		{
			case "Chaser":
				newUpdate.IsChaser = 1;
				newUpdate.IsUpdate = 0;
				break;
			case "Note":
				newUpdate.IsChaser = 0;
				newUpdate.IsUpdate = 0;
				break;
			default:
				newUpdate.IsChaser = 0;
				newUpdate.IsUpdate = 1;
				break;
		}
	}

	private static string GetConfidenceBadgeClass(string rating)
	{
		return rating?.Trim().ToLowerInvariant() switch
		{
			"green" => "bg-success",
			"amber" => "bg-warning text-dark",
			"red" => "bg-danger",
			_ => "bg-secondary"
		};
	}

	private static string GetUpdateTypeLabel(WatchlistUpdate update)
	{
		if (update.IsChaser == 1 && update.IsUpdate == 1)
		{
			return "Update + Chaser";
		}

		if (update.IsChaser == 1)
		{
			return "Chaser";
		}

		if (update.IsUpdate == 1)
		{
			return "Update";
		}

		return "Note";
	}

	private class WatchlistRow
	{
		public WatchlistWithLatestUpdate Item { get; set; }
		public int UpdateCount { get; set; }
	}
}

@if (showDetailModal)
{
	<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog modal-xl modal-dialog-scrollable">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">Watchlist Item @selectedItem?.WatchlistID</h5>
					<button type="button" class="btn-close" @onclick="CloseDetailModal"></button>
				</div>
				<div class="modal-body">
					@if (selectedItem != null)
					{
						<div class="table-responsive mb-4">
							<table class="table table-bordered table-sm align-middle">
								<tbody>
									<tr>
										<th class="bg-light">Team Member</th>
										<td>@selectedItem.TeamMember</td>
										<th class="bg-light">Watchlist Type</th>
										<td>@selectedItem.WatchlistType</td>
									</tr>
									<tr>
										<th class="bg-light">Policy Reference</th>
										<td>@selectedItem.PolicyReference</td>
										<th class="bg-light">Assured Name</th>
										<td>@selectedItem.AssuredName</td>
									</tr>
									<tr>
										<th class="bg-light">Class</th>
										<td>@selectedItem.Class</td>
										<th class="bg-light">Reserving Class</th>
										<td>@selectedItem.ReservingClass</td>
									</tr>
									<tr>
										<th class="bg-light">YOA</th>
										<td>@selectedItem.YOA</td>
										<th class="bg-light">Domicile</th>
										<td>@selectedItem.DomicileCountry</td>
									</tr>
									<tr>
										<th class="bg-light">Leader</th>
										<td>@selectedItem.Leader</td>
										<th class="bg-light">Currency</th>
										<td>@selectedItem.Currency</td>
									</tr>
									<tr>
										<th class="bg-light">Limit</th>
										<td>@selectedItem.Limit?.ToString("N0")</td>
										<th class="bg-light">XS</th>
										<td>@selectedItem.XS?.ToString("N0")</td>
									</tr>
									<tr>
										<th class="bg-light">Dale Line</th>
										<td>@selectedItem.DaleLine?.ToString("N2")</td>
										<th class="bg-light">Dale Limit USD</th>
										<td>@selectedItem.DaleLimitUSDatQtrFX?.ToString("N0")</td>
									</tr>
									<tr>
										<th class="bg-light">UCR</th>
										<td>@selectedItem.UCR</td>
										<th class="bg-light">COR</th>
										<td>@selectedItem.COR</td>
									</tr>
									<tr>
										<th class="bg-light">DOL</th>
										<td>@selectedItem.DOL</td>
										<th class="bg-light">WL Code</th>
										<td>@selectedItem.WLCode</td>
									</tr>
									<tr>
										<th class="bg-light">Claimant</th>
										<td>@selectedItem.Claimant</td>
										<th class="bg-light">Loss Type</th>
										<td>@selectedItem.LossType</td>
									</tr>
									<tr>
										<th class="bg-light">Description</th>
										<td>@selectedItem.WatchlistDescription</td>
										<th class="bg-light">Litigation</th>
										<td>@(selectedItem.InLitigation == 1 ? "Yes" : "No")</td>
									</tr>
									<tr>
										<th class="bg-light">Jurisdiction</th>
										<td>@selectedItem.Jurisdiction</td>
										<th class="bg-light">Active</th>
										<td>@(selectedItem.IsActive == 1 ? "Yes" : "No")</td>
									</tr>
									<tr>
										<th class="bg-light">Current Reserve</th>
										<td>@selectedItem.IncurredUSDAtQtrFX?.ToString("N0")</td>
										<th class="bg-light">Ultimate (USD)</th>
										<td>@selectedItem.DaleShareUltimateUSD?.ToString("N0")</td>
									</tr>
									<tr>
										<th class="bg-light">Confidence</th>
										<td>@selectedItem.ReservingConfidenceRating</td>
										<th class="bg-light">Probability %</th>
										<td>@selectedItem.Probability?.ToString("N1")</td>
									</tr>
								</tbody>
							</table>
						</div>

						<div class="d-flex justify-content-between align-items-center mb-3">
							<h6 class="mb-0">Update History</h6>
							<button class="btn btn-sm btn-success" @onclick="ShowNewUpdateModal">New Update</button>
						</div>

						@if (isLoadingUpdates)
						{
							<div class="d-flex align-items-center">
								<div class="spinner-border text-primary me-2" role="status"></div>
								<span>Loading updates...</span>
							</div>
						}
						else if (selectedUpdates.Any())
						{
							<div class="table-responsive">
								<table class="table table-sm table-striped align-middle">
									<thead class="table-light">
										<tr>
											<th>#</th>
											<th>Date</th>
											<th>Updated By</th>
											<th>Type</th>
											<th>Ultimate (USD)</th>
											<th>Confidence</th>
											<th>Probability %</th>
											<th>Narrative</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var update in selectedUpdates)
										{
											<tr>
												<td>@update.NthUpdate</td>
												<td>@update.UpdateDate.ToString("dd/MM/yyyy")</td>
												<td>@update.UpdatedBy</td>
												<td>@GetUpdateTypeLabel(update)</td>
												<td>@(update.DaleShareUltimateUSD?.ToString("N0") ?? "-")</td>
												<td>
													@if (!string.IsNullOrWhiteSpace(update.ReservingConfidenceRating))
													{
														<span class="badge @GetConfidenceBadgeClass(update.ReservingConfidenceRating)">
															@update.ReservingConfidenceRating
														</span>
													}
													else
													{
														<span>-</span>
													}
												</td>
												<td>@(update.Probability?.ToString("N1") ?? "-")</td>
												<td class="text-wrap" style="max-width: 360px;">@update.UpdateNarrative</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						}
						else
						{
							<div class="alert alert-info">No updates found.</div>
						}
					}
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" @onclick="CloseDetailModal">Close</button>
				</div>
			</div>
		</div>
	</div>
}

@if (showNewUpdateModal)
{
	<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
		<div class="modal-dialog modal-lg">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">New Update</h5>
					<button type="button" class="btn-close" @onclick="CloseNewUpdateModal"></button>
				</div>
				<div class="modal-body">
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">Updated By</label>
							<div class="form-control-plaintext">@newUpdate.UpdatedBy</div>
						</div>
						<div class="col-md-6">
							<label class="form-label">Update Date</label>
							<div class="form-control-plaintext">@newUpdate.UpdateDate.ToString("dd/MM/yyyy")</div>
						</div>
					</div>
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">Update Type</label>
							<select class="form-select" @bind="updateType">
								<option>Update</option>
								<option>Chaser</option>
								<option>Note</option>
							</select>
						</div>
						<div class="col-md-6">
							<label class="form-label">Confidence Rating</label>
							<select class="form-select" @bind="newUpdate.ReservingConfidenceRating">
								<option value="">Select...</option>
								<option>Green</option>
								<option>Amber</option>
								<option>Red</option>
								<option>Other</option>
							</select>
						</div>
					</div>
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">Ultimate (USD)</label>
							<input class="form-control" type="number" step="0.01" @bind="newUpdate.DaleShareUltimateUSD" />
						</div>
						<div class="col-md-6">
							<label class="form-label">Probability %</label>
							<input class="form-control" type="number" step="0.01" @bind="newUpdate.Probability" />
						</div>
					</div>
					<div class="row mb-3">
						<div class="col-md-6">
							<label class="form-label">IBNR Recommended</label>
							<select class="form-select" @bind="ibnrRecommendedSelection">
								<option value="">Select...</option>
								<option value="true">Yes</option>
								<option value="false">No</option>
							</select>
						</div>
						<div class="col-md-6">
							<label class="form-label">RI Applicable</label>
							<select class="form-select" @bind="riApplicableSelection">
								<option value="">Select...</option>
								<option value="1">Yes</option>
								<option value="0">No</option>
								<option value="2">Potential</option>
							</select>
						</div>
					</div>
					<div class="mb-3">
						<label class="form-label">Narrative</label>
						<textarea class="form-control" rows="4" @bind="newUpdate.UpdateNarrative"></textarea>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" @onclick="CloseNewUpdateModal">Cancel</button>
					<button type="button" class="btn btn-primary" disabled="@isSubmittingUpdate" @onclick="SubmitNewUpdate">
						@(isSubmittingUpdate ? "Saving..." : "Save Update")
					</button>
				</div>
			</div>
		</div>
	</div>
}
