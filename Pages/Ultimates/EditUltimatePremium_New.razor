@page "/Ultimates/Premium/Edit/{Class}/{YOA:int}"
@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@using sandboxapp.Utilities
@inject UltimatesService UltimatesService
@inject FxConversionService FxConversion
@inject CurrencySettingsService CurrencySettings
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<EditUltimatePremium_New> Logger

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">ULTIMATES</a></li>
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">PREMIUM</a></li>
        <li class="breadcrumb-item active" aria-current="page">EDIT @Class / @YOA</li>
    </ol>
</nav>

<!-- Currency Settings Component -->
<UltimateCurrencySettings OnSettingsChanged="OnCurrencySettingsChanged" />

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading Ultimate Premium data...</p>
    </div>
}
else if (gridData != null)
{
    <div class="row mb-3">
        <div class="col">
            <h1>Edit Ultimate Premium: @Class / @YOA</h1>
            @if (lastUpdateDate.HasValue)
            {
                <p class="text-muted">
                    Last updated: @lastUpdateDate.Value.ToString("yyyy-MM-dd HH:mm")
                    by @lastUpdatedBy
                </p>
            }
        </div>
    </div>

    <EditForm Model="gridData" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Tabs for Metrics -->
        <ul class="nav nav-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "GrossPremium" ? "active" : "")"
                        type="button"
                        @onclick='() => SwitchTab("GrossPremium")'>
                    Ultimate Gross Premium
                    @if (IsTabModified("GrossPremium"))
                    {
                        <span class="badge bg-warning ms-2">●</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "NetPremium" ? "active" : "")"
                        type="button"
                        @onclick='() => SwitchTab("NetPremium")'>
                    Ultimate Net Premium
                    @if (IsTabModified("NetPremium"))
                    {
                        <span class="badge bg-warning ms-2">●</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "RIPs" ? "active" : "")"
                        type="button"
                        @onclick='() => SwitchTab("RIPs")'>
                    Ultimate RIPs
                    @if (IsTabModified("RIPs"))
                    {
                        <span class="badge bg-warning ms-2">●</span>
                    }
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "PC" ? "active" : "")"
                        type="button"
                        @onclick='() => SwitchTab("PC")'>
                    Ultimate PC
                    @if (IsTabModified("PC"))
                    {
                        <span class="badge bg-warning ms-2">●</span>
                    }
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <div class="card">
                <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">@GetMetricName(activeTab) - Currency Breakdown</h5>
                    <button type="button" class="btn btn-sm btn-light" @onclick="AddNewRow">
                        <i class="bi bi-plus-circle"></i> Add Row
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th style="width: 200px;">Reserving Class</th>
                                    <th style="width: 120px;">Dist. Channel</th>
                                    @foreach (var currency in currencies)
                                    {
                                        <th class="text-center" style="min-width: 180px;">
                                            <FlagIcon CurrencyCode="@currency" ShowCode="true" />
                                        </th>
                                    }
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in gridData.Rows)
                                {
                                    var isNewRow = string.IsNullOrEmpty(row.ReservingClass);
                                    var isModifiedRow = row.Cells.Any(c => c.Value.IsModified);
                                    <tr class="@(isNewRow ? "table-success" : isModifiedRow ? "table-warning" : "")">
                                        <td>
                                            @if (isNewRow)
                                            {
                                                <input type="text" class="form-control form-control-sm"
                                                       @bind="row.ReservingClass"
                                                       placeholder="Enter class..." />
                                            }
                                            else
                                            {
                                                <span>@row.ReservingClass</span>
                                            }
                                        </td>
                                        <td>
                                            @if (isNewRow)
                                            {
                                                <select class="form-select form-select-sm" @bind="row.DistributionChannel">
                                                    <option value="">Select...</option>
                                                    <option value="EU">EU</option>
                                                    <option value="LNDN">LNDN</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <span>@row.DistributionChannel</span>
                                            }
                                        </td>
                                        @foreach (var currency in currencies)
                                        {
                                            var cell = row.GetCell(currency);
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    <select class="form-select form-select-sm"
                                                            @bind="cell.ValueType"
                                                            @onchange="() => OnCellValueTypeChanged(cell)">
                                                        <option value="Written">Written</option>
                                                        <option value="Signed">Signed</option>
                                                        <option value="Plan">Plan</option>
                                                        <option value="Value">Value</option>
                                                    </select>
                                                    <input type="number"
                                                           class="form-control form-control-sm text-end"
                                                           @bind="cell.GetValue(activeTab)"
                                                           @oninput="() => OnCellModified(cell)"
                                                           disabled="@(cell.ValueType != "Value")"
                                                           step="0.01" />
                                                </div>
                                            </td>
                                        }
                                        <td class="text-center">
                                            @if (isNewRow)
                                            {
                                                <button type="button" class="btn btn-danger btn-sm"
                                                        @onclick="() => RemoveRow(row)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (gridData.Rows.Count == 0)
                                {
                                    <tr>
                                        <td colspan="@(2 + currencies.Count + 1)" class="text-center text-muted py-4">
                                            No records found. Click "Add Row" to create the first record.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row my-4">
            <div class="col">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <button type="button" class="btn btn-secondary btn-lg ms-2" @onclick="NavigateBack">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                @if (saveMessage != null)
                {
                    <span class="ms-3 text-success fw-bold">@saveMessage</span>
                }
                @if (errorMessage != null)
                {
                    <span class="ms-3 text-danger fw-bold">@errorMessage</span>
                }
            </div>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public int YOA { get; set; }

    private GridDataModel? gridData;
    private DateTime? lastUpdateDate;
    private string? lastUpdatedBy;
    private bool isLoading = true;
    private string? saveMessage;
    private string? errorMessage;

    private string activeTab = "GrossPremium";
    private List<string> currencies = new() { "GBP", "USD", "CAD", "EUR", "JPY" };

    // Grid data model
    private class GridDataModel
    {
        public List<GridRow> Rows { get; set; } = new();
    }

    private class GridRow
    {
        public string ReservingClass { get; set; } = string.Empty;
        public string DistributionChannel { get; set; } = string.Empty;
        public Dictionary<string, CurrencyCell> Cells { get; set; } = new();
        public bool IsNew { get; set; }

        public CurrencyCell GetCell(string currency)
        {
            if (!Cells.ContainsKey(currency))
            {
                Cells[currency] = new CurrencyCell { Currency = currency };
            }
            return Cells[currency];
        }
    }

    private class CurrencyCell
    {
        public string Currency { get; set; } = string.Empty;
        public string ValueType { get; set; } = "Value";
        public decimal? GrossPremium { get; set; }
        public decimal? NetPremium { get; set; }
        public decimal? RIPs { get; set; }
        public decimal? PC { get; set; }
        public bool IsModified { get; set; }

        public decimal? GetValue(string metric)
        {
            return metric switch
            {
                "GrossPremium" => GrossPremium,
                "NetPremium" => NetPremium,
                "RIPs" => RIPs,
                "PC" => PC,
                _ => null
            };
        }

        public void SetValue(string metric, decimal? value)
        {
            switch (metric)
            {
                case "GrossPremium": GrossPremium = value; break;
                case "NetPremium": NetPremium = value; break;
                case "RIPs": RIPs = value; break;
                case "PC": PC = value; break;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await InitializeServices();
        await LoadData();
    }

    private async Task InitializeServices()
    {
        try
        {
            await CurrencySettings.InitializeAsync();
            await FxConversion.LoadRatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing services");
        }
    }

    private async Task OnCurrencySettingsChanged()
    {
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var model = await UltimatesService.GetUltimatePremiumByClassYOA(Class, YOA);

            // Transform data into grid structure
            gridData = new GridDataModel();

            var grouped = model.Records
                .GroupBy(r => new { r.ReservingClass, r.DistributionChannel })
                .ToList();

            foreach (var group in grouped)
            {
                var row = new GridRow
                {
                    ReservingClass = group.Key.ReservingClass,
                    DistributionChannel = group.Key.ReservingClass,
                    IsNew = false
                };

                foreach (var record in group)
                {
                    var cell = row.GetCell(record.Currency);
                    cell.ValueType = record.ValueType;
                    cell.GrossPremium = record.UltimateGrossPremium;
                    cell.NetPremium = record.UltimateNetPremium;
                    cell.RIPs = record.UltimateRIPs;
                    cell.PC = record.UltimatePC;
                }

                gridData.Rows.Add(row);
            }

            lastUpdateDate = model.UpdateDate;
            lastUpdatedBy = model.UpdatedBy;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            errorMessage = $"Error loading data: {ex.Message}";
            gridData = new GridDataModel();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
    }

    private string GetMetricName(string metric)
    {
        return metric switch
        {
            "GrossPremium" => "Ultimate Gross Premium",
            "NetPremium" => "Ultimate Net Premium",
            "RIPs" => "Ultimate RIPs",
            "PC" => "Ultimate PC",
            _ => metric
        };
    }

    private bool IsTabModified(string tab)
    {
        if (gridData == null) return false;

        return gridData.Rows.Any(row => row.Cells.Values.Any(cell =>
        {
            if (!cell.IsModified) return false;
            return cell.GetValue(tab).HasValue;
        }));
    }

    private void OnCellValueTypeChanged(CurrencyCell cell)
    {
        cell.IsModified = true;

        // Clear values when switching away from "Value"
        if (cell.ValueType != "Value")
        {
            cell.GrossPremium = null;
            cell.NetPremium = null;
            cell.RIPs = null;
            cell.PC = null;
        }

        StateHasChanged();
    }

    private void OnCellModified(CurrencyCell cell)
    {
        cell.IsModified = true;
    }

    private void AddNewRow()
    {
        if (gridData == null) return;

        gridData.Rows.Add(new GridRow { IsNew = true });
    }

    private void RemoveRow(GridRow row)
    {
        if (gridData == null || !row.IsNew) return;

        gridData.Rows.Remove(row);
    }

    private async Task HandleValidSubmit()
    {
        saveMessage = null;
        errorMessage = null;

        try
        {
            // TODO: Convert grid data back to record models and save
            saveMessage = "Changes saved successfully!";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving changes: {ex.Message}";
            Logger.LogError(ex, "Error saving");
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/Ultimates/Premium");
    }
}
