@page "/Ultimates/UltimatePremium"
@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@inject UltimatesService UltimatesService
@inject NavigationManager NavigationManager
@inject ILogger<UltimatePremiumList> Logger

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Ultimates/UltimatePremium">ULTIMATES</a></li>
        <li class="breadcrumb-item active" aria-current="page">PREMIUM</li>
    </ol>
</nav>

<div class="row mb-2">
    <div class="col">
        <h1>Ultimate Premium Tracking</h1>
        <p class="text-muted">View and edit ultimate premium selections by Class, Reserving Class, and YOA</p>
    </div>
    <div class="col-auto">
        <button type="button" class="btn btn-primary" @onclick="OpenCreateModal">
            <i class="bi bi-plus-circle"></i> Create New
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading Premium data...</p>
    </div>
}
else if (premiumRecords != null && premiumRecords.Any())
{
    <!-- Data Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Premium Selections</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Reserving Class</th>
                            <th>YOA</th>
                            <th>Version</th>
                            <th>Selection</th>
                            <th>Gross/Net</th>
                            <th>Last Updated</th>
                            <th>Updated By</th>
                            <th>Comments</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in premiumRecords.OrderBy(r => r.Class).ThenBy(r => r.ReservingClass).ThenByDescending(r => r.YOA))
                        {
                            <tr>
                                <td><strong>@record.Class</strong></td>
                                <td><strong>@record.ReservingClass</strong></td>
                                <td><strong>@record.YOA</strong></td>
                                <td><span class="badge bg-info">@record.Version</span></td>
                                <td><span class="badge bg-@GetSelectionBadgeColor(record.Selection)">@record.Selection</span></td>
                                <td><span class="badge bg-secondary">@record.GrossNetEntry</span></td>
                                <td>@FormatDate(record.DateUpdated)</td>
                                <td>@record.UpdatedBy</td>
                                <td>@(record.UpdateComments ?? "-")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => OpenEditModal(record)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No Premium Data Found</h5>
        <p>No Premium data has been entered yet. Click "Create New" to add your first record.</p>
    </div>
}

<!-- Edit Modal Component -->
@if (showEditModal)
{
    <PremiumEditModal
        Premium="@selectedPremium"
        IsNew="@isNewRecord"
        OnClose="CloseEditModal"
        OnSave="HandleSave" />
}

@code {
    private List<PremiumListItemModel>? premiumRecords;
    private bool isLoading = true;
    private bool showEditModal = false;
    private bool isNewRecord = false;
    private PremiumModel? selectedPremium;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var data = await UltimatesService.GetLatestPremiumList();
            premiumRecords = data.ToList();

            Logger.LogInformation("Loaded {RecordCount} Premium records", premiumRecords.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Premium list");
            premiumRecords = new List<PremiumListItemModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        selectedPremium = new PremiumModel();
        isNewRecord = true;
        showEditModal = true;
    }

    private void OpenEditModal(PremiumListItemModel record)
    {
        // Convert list item to full model for editing
        selectedPremium = new PremiumModel
        {
            Class = record.Class,
            ReservingClass = record.ReservingClass,
            YOA = record.YOA,
            Version = record.Version,
            Selection = record.Selection,
            GrossNetEntry = record.GrossNetEntry,
            DateUpdated = record.DateUpdated,
            UpdatedBy = record.UpdatedBy,
            UpdateComments = record.UpdateComments
        };
        isNewRecord = false;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        selectedPremium = null;
    }

    private async Task HandleSave()
    {
        showEditModal = false;
        await LoadData();
    }

    private string GetSelectionBadgeColor(string selection) => selection switch
    {
        "Plan" => "primary",
        "Written" => "success",
        "Signed" => "warning",
        "Manual" => "secondary",
        _ => "secondary"
    };

    private string FormatDate(DateTime date)
    {
        return date.ToString("yyyy-MM-dd HH:mm");
    }
}

<script>
    // Initialize tooltips when the page loads
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
