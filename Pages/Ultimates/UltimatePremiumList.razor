@page "/Ultimates/UltimatePremium"
@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@inject UltimatesService UltimatesService
@inject NavigationManager NavigationManager
@inject ILogger<UltimatePremiumList> Logger
@inject IJSRuntime JSRuntime

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Ultimates/UltimatePremium">ULTIMATES</a></li>
        <li class="breadcrumb-item active" aria-current="page">PREMIUM</li>
    </ol>
</nav>

<div class="row mb-3">
    <div class="col">
        <h1>Ultimate Premium Tracking</h1>
        <p class="text-muted">View and edit ultimate premium selections by Class, Reserving Class, and YOA</p>
    </div>
    <div class="col-auto">
        @if (availableFxRateSets != null && availableFxRateSets.Any())
        {
            <label class="form-label mb-1"><small>FX Rate Set (Display Only)</small></label>
            <select class="form-select form-select-sm" style="width: 250px;" @bind="selectedFxRateSetId" @bind:after="OnFxRateSetChanged">
                @foreach (var rateSet in availableFxRateSets.OrderByDescending(rs => rs.EffectiveDate))
                {
                    <option value="@rateSet.FxRateSetID">
                        @rateSet.RateSetName @(rateSet.EffectiveDate.HasValue ? $"({rateSet.EffectiveDate.Value:yyyy-MM-dd})" : "")
                    </option>
                }
            </select>
        }
    </div>
</div>

@if (premiumRecords != null && premiumRecords.Any())
{
    <!-- Filters Section -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row">
                <!-- Class Filter -->
                <div class="col-md-6 mb-3">
                    <h6 class="mb-2"><i class="bi bi-funnel"></i> Filter by Class</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-sm @(selectedClass == null ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => FilterByClass(null)">
                            All
                        </button>
                        @foreach (var className in distinctClasses)
                        {
                            <button type="button"
                                    class="btn btn-sm @(selectedClass == className ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => FilterByClass(className)">
                                @className
                            </button>
                        }
                    </div>
                </div>

                <!-- YOA Filter -->
                <div class="col-md-6 mb-3">
                    <h6 class="mb-2"><i class="bi bi-funnel"></i> Filter by YOA</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button"
                                class="btn btn-sm @(selectedYOA == null ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => FilterByYOA(null)">
                            All
                        </button>
                        @foreach (var yoa in distinctYOAs.OrderByDescending(y => y))
                        {
                            <button type="button"
                                    class="btn btn-sm @(selectedYOA == yoa ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => FilterByYOA(yoa)">
                                @yoa
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (selectedClass != null || selectedYOA != null)
            {
                <div class="row">
                    <div class="col-12">
                        <small class="text-muted">
                            Showing @filteredRecords.Count() of @premiumRecords.Count records
                            @if (selectedClass != null) { <text> | Class: <strong>@selectedClass</strong></text> }
                            @if (selectedYOA != null) { <text> | YOA: <strong>@selectedYOA</strong></text> }
                        </small>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading Premium data...</p>
    </div>
}
else if (filteredRecords != null && filteredRecords.Any())
{
    <!-- Data Table -->
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Premium Selections</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Reserving Class</th>
                            <th>YOA</th>
                            <th>Version</th>
                            <th>Selection</th>
                            <th>Gross/Net</th>
                            <th class="text-end">GGWP USD</th>
                            <th>Last Updated</th>
                            <th>Updated By</th>
                            <th>Comments</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in filteredRecords.OrderBy(r => r.Class).ThenBy(r => r.ReservingClass).ThenByDescending(r => r.YOA))
                        {
                            <tr>
                                <td><strong>@record.Class</strong></td>
                                <td><strong>@record.ReservingClass</strong></td>
                                <td><strong>@record.YOA</strong></td>
                                <td><span class="badge bg-info">@record.Version</span></td>
                                <td><span class="badge bg-@GetSelectionBadgeColor(record.Selection)">@record.Selection</span></td>
                                <td><span class="badge bg-secondary">@record.GrossNetEntry</span></td>
                                <td class="text-end"><strong>@FormatCurrency(GetGGWPUSD(record))</strong></td>
                                <td>@FormatDate(record.DateUpdated)</td>
                                <td>@record.UpdatedBy</td>
                                <td>@(record.UpdateComments ?? "-")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-primary" @onclick="async () => await OpenEditModal(record)">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        <h5>No Matching Records</h5>
        <p>No Premium records match the selected filters.</p>
    </div>
}
<!-- Edit Modal (Inline) -->
@if (showEditModal && selectedPremium != null)
{
    <!-- Full-screen modal overlay -->
    <div class="modal-overlay" @onclick="HandleOverlayClick" @onkeydown="HandleKeyDown" tabindex="-1">
        <div class="modal-container" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h3>Edit Premium: @selectedPremium.Class / @selectedPremium.ReservingClass / @selectedPremium.YOA</h3>
                <button type="button" class="btn-close btn-close-white" @onclick="CloseEditModal"></button>
            </div>

            <div class="modal-body-custom">
                <div class="container-fluid">
                    <!-- Selection Fields -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Selection <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="selectedPremium.Selection" @bind:after="OnSelectionChanged" required>
                                <option value="Plan">Plan</option>
                                <option value="Written">Written</option>
                                <option value="Signed">Signed</option>
                                <option value="Manual">Manual</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Gross/Net Entry <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="selectedPremium.GrossNetEntry" @bind:after="OnGrossNetChanged" required>
                                <option value="Gross">Gross</option>
                                <option value="Net">Net</option>
                            </select>
                        </div>
                    </div>

                    <!-- Premium Currency Data -->
                    @if (premiumCcyRecords != null && premiumCcyRecords.Any())
                    {
                        <!-- Summary Banner -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="card bg-light">
                                    <div class="card-body py-2">
                                        <div class="row text-center">
                                            <div class="col-3">
                                                <small class="text-muted d-block">GGWP USD</small>
                                                <h5 class="mb-0">@FormatCurrency(CalculateTotalGGWP("USD"))</h5>
                                            </div>
                                            <div class="col-3">
                                                <small class="text-muted d-block">GGWP GBP</small>
                                                <h5 class="mb-0">@FormatCurrency(CalculateTotalGGWP("GBP"))</h5>
                                            </div>
                                            <div class="col-3">
                                                <small class="text-muted d-block">GNWP USD</small>
                                                <h5 class="mb-0">@FormatCurrency(CalculateTotalGNWP("USD"))</h5>
                                            </div>
                                            <div class="col-3">
                                                <small class="text-muted d-block">GNWP GBP</small>
                                                <h5 class="mb-0">@FormatCurrency(CalculateTotalGNWP("GBP"))</h5>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabbed Matrices -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <ul class="nav nav-tabs" role="tablist">
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "ggwp" ? "active" : "")" @onclick="@(() => SetActiveTab("ggwp"))" type="button">
                                            GGWP by Currency
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "deductions" ? "active" : "")" @onclick="@(() => SetActiveTab("deductions"))" type="button">
                                            Deductions by Currency
                                        </button>
                                    </li>
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link @(activeTab == "gnwp" ? "active" : "")" @onclick="@(() => SetActiveTab("gnwp"))" type="button">
                                            GNWP by Currency
                                        </button>
                                    </li>
                                </ul>

                                <div class="tab-content border border-top-0 p-0">
                                    <!-- GGWP Tab -->
                                    @if (activeTab == "ggwp")
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Currency</th>
                                                        <th class="text-end">Selected</th>
                                                        <th class="text-end">Plan</th>
                                                        <th class="text-end">Written</th>
                                                        <th class="text-end">Signed</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ccy in premiumCcyRecords.OrderBy(c => c.Currency))
                                                    {
                                                        <tr>
                                                            <td><strong>@ccy.Currency</strong></td>
                                                            <td class="text-end"><strong>@FormatCurrency(GetSelectedValue(ccy, "GGWP"))</strong></td>
                                                            <td class="text-end">@FormatCurrency(ccy.PlanGGWP)</td>
                                                            <td class="text-end">@FormatCurrency(ccy.WrittenGGWP)</td>
                                                            <td class="text-end">@FormatCurrency(ccy.SignedGGWP)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- Deductions Tab -->
                                    @if (activeTab == "deductions")
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Currency</th>
                                                        <th class="text-end">Selected</th>
                                                        <th class="text-end">Plan</th>
                                                        <th class="text-end">Written</th>
                                                        <th class="text-end">Signed</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ccy in premiumCcyRecords.OrderBy(c => c.Currency))
                                                    {
                                                        <tr>
                                                            <td><strong>@ccy.Currency</strong></td>
                                                            <td class="text-end"><strong>@FormatPercentage(GetSelectedValue(ccy, "Deductions"))</strong></td>
                                                            <td class="text-end">@FormatPercentage(ccy.PlanDeductions)</td>
                                                            <td class="text-end">@FormatPercentage(ccy.WrittenDeductions)</td>
                                                            <td class="text-end">@FormatPercentage(ccy.SignedDeductions)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }

                                    <!-- GNWP Tab -->
                                    @if (activeTab == "gnwp")
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-bordered mb-0">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Currency</th>
                                                        <th class="text-end">Selected</th>
                                                        <th class="text-end">Plan</th>
                                                        <th class="text-end">Written</th>
                                                        <th class="text-end">Signed</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ccy in premiumCcyRecords.OrderBy(c => c.Currency))
                                                    {
                                                        <tr>
                                                            <td><strong>@ccy.Currency</strong></td>
                                                            <td class="text-end"><strong>@FormatCurrency(GetSelectedValue(ccy, "GNWP"))</strong></td>
                                                            <td class="text-end">@FormatCurrency(ccy.PlanGNWP)</td>
                                                            <td class="text-end">@FormatCurrency(ccy.WrittenGNWP)</td>
                                                            <td class="text-end">@FormatCurrency(ccy.SignedGNWP)</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Comments -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Update Comments</label>
                            <textarea class="form-control" rows="3" @bind="selectedPremium.UpdateComments" @bind:event="oninput" @bind:after="OnFormChanged"
                                      placeholder="Enter any comments about this update..."></textarea>
                        </div>
                    </div>

                    <!-- Audit Info -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <h6 class="text-muted mb-2">Audit Information</h6>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Version</label>
                            <div class="form-control-plaintext"><span class="badge bg-info">v@(selectedPremium.Version)</span></div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Last Updated</label>
                            <div class="form-control-plaintext">@selectedPremium.DateUpdated.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Updated By</label>
                            <div class="form-control-plaintext">@selectedPremium.UpdatedBy</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(priorComments))
                    {
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Prior Comments</label>
                                <div class="alert alert-secondary py-2">@priorComments</div>
                            </div>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(modalErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@modalErrorMessage
                        </div>
                    }

                    <!-- Success Message -->
                    @if (!string.IsNullOrEmpty(modalSuccessMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@modalSuccessMessage
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" @onclick="CloseEditModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SavePremium" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    }
                    <i class="bi bi-save me-2"></i>Save
                </button>
            </div>
        </div>
    </div>

    <style>
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            z-index: 1050;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-container {
            background: white;
            border-radius: 8px;
            width: calc(100vw - 80px);
            max-width: 1400px;
            height: calc(100vh - 80px);
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
        }

        .modal-header-custom {
            padding: 1rem 1.5rem;
            background: #2c3e50;
            color: white;
            border-radius: 8px 8px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header-custom h3 {
            margin: 0;
            font-size: 1.25rem;
            font-weight: 500;
            color: white;
        }

        .modal-header-custom .btn-close {
            font-size: 1.5rem;
            opacity: 1;
            width: 2rem;
            height: 2rem;
        }

        .modal-body-custom {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
        }

        .modal-footer-custom {
            padding: 1rem 1.5rem;
            border-top: 1px solid #dee2e6;
            display: flex;
            justify-content: flex-end;
            gap: 0.5rem;
        }

        .form-control-plaintext {
            padding: 0.375rem 0;
            font-size: 0.95rem;
        }
    </style>
}

@code {
    private List<PremiumListItemModel>? premiumRecords;
    private IEnumerable<PremiumListItemModel> filteredRecords => ApplyFilters();
    private List<string> distinctClasses = new();
    private List<int> distinctYOAs = new();
    private string? selectedClass = null;
    private int? selectedYOA = null;
    private bool isLoading = true;
    private bool showEditModal = false;
    private PremiumModel? selectedPremium;
    private PremiumModel? originalPremium;
    private string? priorComments;
    private bool isSaving = false;
    private string? modalErrorMessage;
    private string? modalSuccessMessage;
    private bool isFormDirty = false;

    // FX Rate Set management
    private List<FxRateSetModel>? availableFxRateSets;
    private int selectedFxRateSetId;
    private Dictionary<string, decimal> fxRates = new();

    // Premium Currency data
    private List<PremiumCcyModel>? premiumCcyRecords;
    private string activeTab = "ggwp";

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await LoadFxRateSets();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var data = await UltimatesService.GetLatestPremiumList();
            premiumRecords = data.ToList();

            // Extract distinct values for filters
            if (premiumRecords.Any())
            {
                distinctClasses = premiumRecords
                    .Select(r => r.Class)
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();

                distinctYOAs = premiumRecords
                    .Select(r => r.YOA)
                    .Distinct()
                    .OrderByDescending(y => y)
                    .ToList();

                // Pre-calculate GGWP USD for all records
                await CalculateGGWPUSD();
            }

            Logger.LogInformation("Loaded {RecordCount} Premium records", premiumRecords.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Premium list");
            premiumRecords = new List<PremiumListItemModel>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CalculateGGWPUSD()
    {
        ggwpUsdCache.Clear();

        foreach (var record in premiumRecords ?? Enumerable.Empty<PremiumListItemModel>())
        {
            var value = await GetGGWPUSDAsync(record);
            var key = $"{record.Class}_{record.ReservingClass}_{record.YOA}_{record.Version}";
            ggwpUsdCache[key] = value;
        }
    }

    private async Task LoadFxRateSets()
    {
        try
        {
            var rateSets = await UltimatesService.GetFxRateSets();
            availableFxRateSets = rateSets.ToList();

            if (availableFxRateSets.Any())
            {
                // Select the most recent active rate set, or the most recent overall
                var defaultRateSet = availableFxRateSets
                    .Where(rs => rs.IsActive)
                    .OrderByDescending(rs => rs.EffectiveDate)
                    .FirstOrDefault() ?? availableFxRateSets.OrderByDescending(rs => rs.EffectiveDate).First();

                selectedFxRateSetId = defaultRateSet.FxRateSetID;
                await LoadFxRates();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading FX rate sets");
        }
    }

    private async Task LoadFxRates()
    {
        try
        {
            var rates = await UltimatesService.GetFxRates(selectedFxRateSetId);
            fxRates = rates.ToDictionary(r => $"{r.FromCurrency}_{r.ToCurrency}", r => r.Rate);
            Logger.LogInformation("Loaded {RateCount} FX rates for rate set {RateSetId}", fxRates.Count, selectedFxRateSetId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading FX rates");
            fxRates = new Dictionary<string, decimal>();
        }
    }

    private async Task OnFxRateSetChanged()
    {
        await LoadFxRates();
        StateHasChanged();
    }

    private async Task<decimal?> GetGGWPUSDAsync(PremiumListItemModel record)
    {
        try
        {
            // Fetch PremiumCcy records for this Premium record
            var ccyRecords = await UltimatesService.GetPremiumCcy(record.Class, record.ReservingClass, record.YOA, record.Version);

            if (!ccyRecords.Any() || !fxRates.Any())
                return null;

            decimal total = 0;

            foreach (var ccy in ccyRecords)
            {
                // Get the GGWP value based on Selection
                decimal? ggwpValue = record.Selection switch
                {
                    "Plan" => ccy.PlanGGWP,
                    "Written" => ccy.WrittenGGWP,
                    "Signed" => ccy.SignedGGWP,
                    "Manual" => ccy.ManualGGWP,
                    _ => ccy.SelectedGGWP
                };

                if (!ggwpValue.HasValue || ggwpValue.Value == 0)
                    continue;

                // Convert to USD if not already USD
                if (ccy.Currency.Equals("USD", StringComparison.OrdinalIgnoreCase))
                {
                    total += ggwpValue.Value;
                }
                else
                {
                    // Look up the FX rate
                    var rateKey = $"{ccy.Currency}_USD";
                    if (fxRates.TryGetValue(rateKey, out var rate))
                    {
                        total += ggwpValue.Value * rate;
                    }
                    else
                    {
                        // If no direct rate, try inverse
                        var inverseKey = $"USD_{ccy.Currency}";
                        if (fxRates.TryGetValue(inverseKey, out var inverseRate) && inverseRate != 0)
                        {
                            total += ggwpValue.Value / inverseRate;
                        }
                    }
                }
            }

            return total > 0 ? total : null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error calculating GGWP USD for record");
            return null;
        }
    }

    // Synchronous wrapper for display - caches the result
    private Dictionary<string, decimal?> ggwpUsdCache = new();

    private decimal? GetGGWPUSD(PremiumListItemModel record)
    {
        var key = $"{record.Class}_{record.ReservingClass}_{record.YOA}_{record.Version}";
        if (!ggwpUsdCache.ContainsKey(key))
        {
            // This will be calculated async on page load, for now return null
            return null;
        }
        return ggwpUsdCache[key];
    }

    private string FormatCurrency(decimal? value)
    {
        if (!value.HasValue) return "-";
        return value.Value.ToString("N0");
    }

    private string FormatPercentage(decimal? value)
    {
        if (!value.HasValue) return "-";
        return value.Value.ToString("0.00") + "%";
    }

    private decimal? GetSelectedValue(PremiumCcyModel ccy, string fieldType)
    {
        if (selectedPremium == null) return null;

        return selectedPremium.Selection switch
        {
            "Plan" => fieldType switch
            {
                "GGWP" => ccy.PlanGGWP,
                "Deductions" => ccy.PlanDeductions,
                "GNWP" => ccy.PlanGNWP,
                _ => null
            },
            "Written" => fieldType switch
            {
                "GGWP" => ccy.WrittenGGWP,
                "Deductions" => ccy.WrittenDeductions,
                "GNWP" => ccy.WrittenGNWP,
                _ => null
            },
            "Signed" => fieldType switch
            {
                "GGWP" => ccy.SignedGGWP,
                "Deductions" => ccy.SignedDeductions,
                "GNWP" => ccy.SignedGNWP,
                _ => null
            },
            "Manual" => fieldType switch
            {
                "GGWP" => ccy.ManualGGWP,
                "Deductions" => ccy.ManualDeductions,
                "GNWP" => ccy.ManualGNWP,
                _ => null
            },
            _ => fieldType switch
            {
                "GGWP" => ccy.SelectedGGWP,
                "Deductions" => ccy.SelectedDeductions,
                "GNWP" => ccy.SelectedGNWP,
                _ => null
            }
        };
    }

    private IEnumerable<PremiumListItemModel> ApplyFilters()
    {
        if (premiumRecords == null)
            return Enumerable.Empty<PremiumListItemModel>();

        var filtered = premiumRecords.AsEnumerable();

        if (selectedClass != null)
        {
            filtered = filtered.Where(r => r.Class == selectedClass);
        }

        if (selectedYOA != null)
        {
            filtered = filtered.Where(r => r.YOA == selectedYOA);
        }

        return filtered;
    }

    private void FilterByClass(string? className)
    {
        selectedClass = className;
        StateHasChanged();
    }

    private void FilterByYOA(int? yoa)
    {
        selectedYOA = yoa;
        StateHasChanged();
    }

    private async Task OpenEditModal(PremiumListItemModel record)
    {
        // Store prior comments
        priorComments = record.UpdateComments;

        // Convert list item to full model for editing
        selectedPremium = new PremiumModel
        {
            Class = record.Class,
            ReservingClass = record.ReservingClass,
            YOA = record.YOA,
            Version = record.Version,
            Selection = record.Selection,
            GrossNetEntry = record.GrossNetEntry,
            DateUpdated = record.DateUpdated,
            UpdatedBy = record.UpdatedBy,
            UpdateComments = null  // Don't pre-populate comments
        };

        // Store original values for dirty checking
        originalPremium = new PremiumModel
        {
            Selection = record.Selection,
            GrossNetEntry = record.GrossNetEntry,
            UpdateComments = null
        };

        // Load PremiumCcy data
        await LoadPremiumCcyData(record.Class, record.ReservingClass, record.YOA, record.Version);

        isFormDirty = false;
        showEditModal = true;
        StateHasChanged();
    }

    private async Task LoadPremiumCcyData(string className, string reservingClass, int yoa, int version)
    {
        try
        {
            var data = await UltimatesService.GetPremiumCcy(className, reservingClass, yoa, version);
            premiumCcyRecords = data.ToList();

            // Ensure Class, ReservingClass, YOA are set on each record (they should come from DB but just in case)
            foreach (var ccy in premiumCcyRecords)
            {
                ccy.Class = className;
                ccy.ReservingClass = reservingClass;
                ccy.YOA = yoa;
            }

            Logger.LogInformation("Loaded {RecordCount} PremiumCcy records", premiumCcyRecords.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading PremiumCcy data");
            premiumCcyRecords = new List<PremiumCcyModel>();
        }
    }

    private async Task CloseEditModal()
    {
        if (isFormDirty && !isSaving)
        {
            bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "You have unsaved changes. Are you sure you want to close without saving?");
            if (!confirmed)
            {
                return;
            }
        }

        showEditModal = false;
        selectedPremium = null;
        originalPremium = null;
        priorComments = null;
        modalErrorMessage = null;
        modalSuccessMessage = null;
        isSaving = false;
        isFormDirty = false;
        StateHasChanged();
    }

    private async Task HandleOverlayClick()
    {
        // Close modal when clicking outside (with confirmation if dirty)
        await CloseEditModal();
    }

    private void OnFormChanged()
    {
        if (selectedPremium == null || originalPremium == null) return;

        // Check if any field has changed
        isFormDirty = selectedPremium.Selection != originalPremium.Selection ||
                      selectedPremium.GrossNetEntry != originalPremium.GrossNetEntry ||
                      !string.IsNullOrWhiteSpace(selectedPremium.UpdateComments);
    }

    private void OnSelectionChanged()
    {
        OnFormChanged();
        // Force UI refresh to update SELECTED columns in matrices
        StateHasChanged();
    }

    private void OnGrossNetChanged()
    {
        OnFormChanged();
        // Force UI refresh to update premium column headers
        StateHasChanged();
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private decimal? CalculateTotalGGWP(string targetCurrency)
    {
        if (premiumCcyRecords == null || !premiumCcyRecords.Any() || !fxRates.Any())
            return null;

        decimal total = 0;

        foreach (var ccy in premiumCcyRecords)
        {
            var ggwpValue = GetSelectedValue(ccy, "GGWP");
            if (!ggwpValue.HasValue || ggwpValue.Value == 0)
                continue;

            // Convert to target currency
            var converted = ConvertCurrency(ggwpValue.Value, ccy.Currency, targetCurrency);
            if (converted.HasValue)
                total += converted.Value;
        }

        return total > 0 ? total : null;
    }

    private decimal? CalculateTotalGNWP(string targetCurrency)
    {
        if (premiumCcyRecords == null || !premiumCcyRecords.Any() || !fxRates.Any())
            return null;

        decimal total = 0;

        foreach (var ccy in premiumCcyRecords)
        {
            var gnwpValue = GetSelectedValue(ccy, "GNWP");
            if (!gnwpValue.HasValue || gnwpValue.Value == 0)
                continue;

            // Convert to target currency
            var converted = ConvertCurrency(gnwpValue.Value, ccy.Currency, targetCurrency);
            if (converted.HasValue)
                total += converted.Value;
        }

        return total > 0 ? total : null;
    }

    private decimal? ConvertCurrency(decimal amount, string fromCurrency, string toCurrency)
    {
        if (fromCurrency.Equals(toCurrency, StringComparison.OrdinalIgnoreCase))
            return amount;

        // Look up the FX rate
        var rateKey = $"{fromCurrency}_{toCurrency}";
        if (fxRates.TryGetValue(rateKey, out var rate))
        {
            return amount * rate;
        }

        // Try inverse rate
        var inverseKey = $"{toCurrency}_{fromCurrency}";
        if (fxRates.TryGetValue(inverseKey, out var inverseRate) && inverseRate != 0)
        {
            return amount / inverseRate;
        }

        return null;
    }

    private async Task SavePremium()
    {
        if (selectedPremium == null) return;

        modalErrorMessage = null;
        modalSuccessMessage = null;

        // Validation
        if (string.IsNullOrWhiteSpace(selectedPremium.Class))
        {
            modalErrorMessage = "Class is required";
            StateHasChanged();
            return;
        }

        if (string.IsNullOrWhiteSpace(selectedPremium.ReservingClass))
        {
            modalErrorMessage = "Reserving Class is required";
            StateHasChanged();
            return;
        }

        if (selectedPremium.YOA < 1900 || selectedPremium.YOA > 2100)
        {
            modalErrorMessage = "Year of Account must be between 1900 and 2100";
            StateHasChanged();
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            // Save Premium header and get new version number
            var newVersion = await UltimatesService.SavePremium(selectedPremium);

            // Update SELECTED fields in PremiumCcy records based on Selection dropdown
            if (premiumCcyRecords != null && premiumCcyRecords.Any())
            {
                foreach (var ccy in premiumCcyRecords)
                {
                    // Update version to new version
                    ccy.Version = newVersion;

                    // Update SELECTED fields based on Selection
                    switch (selectedPremium.Selection)
                    {
                        case "Plan":
                            ccy.SelectedGGWP = ccy.PlanGGWP;
                            ccy.SelectedDeductions = ccy.PlanDeductions;
                            ccy.SelectedGNWP = ccy.PlanGNWP;
                            ccy.SelectedEU = ccy.PlanEU;
                            break;
                        case "Written":
                            ccy.SelectedGGWP = ccy.WrittenGGWP;
                            ccy.SelectedDeductions = ccy.WrittenDeductions;
                            ccy.SelectedGNWP = ccy.WrittenGNWP;
                            ccy.SelectedEU = ccy.WrittenEU;
                            break;
                        case "Signed":
                            ccy.SelectedGGWP = ccy.SignedGGWP;
                            ccy.SelectedDeductions = ccy.SignedDeductions;
                            ccy.SelectedGNWP = ccy.SignedGNWP;
                            ccy.SelectedEU = ccy.SignedEU;
                            break;
                        case "Manual":
                            ccy.SelectedGGWP = ccy.ManualGGWP;
                            ccy.SelectedDeductions = ccy.ManualDeductions;
                            ccy.SelectedGNWP = ccy.ManualGNWP;
                            ccy.SelectedEU = ccy.ManualEU;
                            break;
                    }

                    // Save each currency record
                    await UltimatesService.SavePremiumCcy(ccy);
                }

                Logger.LogInformation("Saved {Count} PremiumCcy records with version {Version}", premiumCcyRecords.Count, newVersion);
            }

            // Wait a moment then show success
            await Task.Delay(500);

            modalSuccessMessage = "Premium saved successfully!";
            isFormDirty = false;  // Mark form as clean after successful save
            StateHasChanged();

            await Task.Delay(1000);

            showEditModal = false;
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving Premium");
            modalErrorMessage = $"Error saving: {ex.Message}";
            StateHasChanged();
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseEditModal();
        }
    }

