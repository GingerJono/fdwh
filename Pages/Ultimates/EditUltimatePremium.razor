@page "/Ultimates/Premium/Edit/{Class}/{YOA:int}"
@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@using sandboxapp.Utilities
@inject UltimatesService UltimatesService
@inject FxConversionService FxConversion
@inject CurrencySettingsService CurrencySettings
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<EditUltimatePremium> Logger

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">ULTIMATES</a></li>
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">PREMIUM</a></li>
        <li class="breadcrumb-item active" aria-current="page">EDIT @Class / @YOA</li>
    </ol>
</nav>

<!-- Currency Settings Component -->
<UltimateCurrencySettings OnSettingsChanged="OnCurrencySettingsChanged" />

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading Ultimate Premium data...</p>
    </div>
}
else if (model != null)
{
    <div class="row mb-3">
        <div class="col">
            <h1>Edit Ultimate Premium: @Class / @YOA</h1>
            @if (model.UpdateDate.HasValue)
            {
                <p class="text-muted">
                    Last updated: @model.UpdateDate.Value.ToString("yyyy-MM-dd HH:mm")
                    by @model.UpdatedBy
                </p>
            }
        </div>
    </div>

    <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <!-- Summary Card -->
        <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Summary Totals (Converted to @GetCurrencySymbol() @CurrencySettings.DisplayCurrency)</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <small class="text-muted">@GetCurrencySymbol() Total Gross Premium</small>
                            <h4 class="mb-0">@FormatConvertedCurrency(GetConvertedTotalGrossPremium())</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <small class="text-muted">@GetCurrencySymbol() Total Net Premium</small>
                            <h4 class="mb-0">@FormatConvertedCurrency(GetConvertedTotalNetPremium())</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <small class="text-muted">@GetCurrencySymbol() Total RIPs</small>
                            <h4 class="mb-0">@FormatConvertedCurrency(GetConvertedTotalRIPs())</h4>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-light rounded">
                            <small class="text-muted">@GetCurrencySymbol() Total PC</small>
                            <h4 class="mb-0">@FormatConvertedCurrency(GetConvertedTotalPC())</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Editable Grid -->
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Ultimate Premium Details</h5>
                <button type="button" class="btn btn-sm btn-light" @onclick="AddNewRecord">
                    <i class="bi bi-plus-circle"></i> Add Row
                </button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Reserving Class</th>
                                <th>Dist. Channel</th>
                                <th>Currency</th>
                                <th style="width: 130px;">Value Type</th>
                                <th class="text-end">Gross Premium</th>
                                <th class="text-end">Net Premium</th>
                                <th class="text-end">RIPs</th>
                                <th class="text-end">PC</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var record in model.Records)
                            {
                                <tr class="@(record.IsNew ? "table-success" : record.IsModified ? "table-warning" : "")">
                                    <td>
                                        @if (record.IsNew)
                                        {
                                            <InputText class="form-control form-control-sm"
                                                       @bind-Value="record.ReservingClass"
                                                       @oninput="() => MarkAsModified(record)" />
                                        }
                                        else
                                        {
                                            <span>@record.ReservingClass</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.IsNew)
                                        {
                                            <InputSelect class="form-select form-select-sm"
                                                         @bind-Value="record.DistributionChannel"
                                                         @oninput="() => MarkAsModified(record)">
                                                <option value="">Select...</option>
                                                <option value="EU">EU</option>
                                                <option value="LNDN">LNDN</option>
                                            </InputSelect>
                                        }
                                        else
                                        {
                                            <span>@record.DistributionChannel</span>
                                        }
                                    </td>
                                    <td>
                                        @if (record.IsNew)
                                        {
                                            <InputText class="form-control form-control-sm"
                                                       @bind-Value="record.Currency"
                                                       @oninput="() => MarkAsModified(record)"
                                                       placeholder="e.g., GBP, USD, EUR" />
                                        }
                                        else
                                        {
                                            <span>@CurrencyUtility.GetCurrencyWithFlag(record.Currency)</span>
                                        }
                                    </td>
                                    <td>
                                        <InputSelect class="form-select form-select-sm"
                                                     @bind-Value="record.ValueType"
                                                     @onchange="() => OnValueTypeChanged(record)">
                                            <option value="Written">Set to Written</option>
                                            <option value="Signed">Set to Signed</option>
                                            <option value="Plan">Set to Plan</option>
                                            <option value="Value">Set to Value</option>
                                        </InputSelect>
                                    </td>
                                    <td>
                                        <InputNumber class="form-control form-control-sm text-end"
                                                     @bind-Value="record.UltimateGrossPremium"
                                                     @oninput="() => MarkAsModified(record)"
                                                     disabled="@(record.ValueType != "Value")" />
                                    </td>
                                    <td>
                                        <InputNumber class="form-control form-control-sm text-end"
                                                     @bind-Value="record.UltimateNetPremium"
                                                     @oninput="() => MarkAsModified(record)"
                                                     disabled="@(record.ValueType != "Value")" />
                                    </td>
                                    <td>
                                        <InputNumber class="form-control form-control-sm text-end"
                                                     @bind-Value="record.UltimateRIPs"
                                                     @oninput="() => MarkAsModified(record)"
                                                     disabled="@(record.ValueType != "Value")" />
                                    </td>
                                    <td>
                                        <InputNumber class="form-control form-control-sm text-end"
                                                     @bind-Value="record.UltimatePC"
                                                     @oninput="() => MarkAsModified(record)"
                                                     disabled="@(record.ValueType != "Value")" />
                                    </td>
                                    <td class="text-center">
                                        @if (record.IsNew)
                                        {
                                            <button type="button" class="btn btn-danger btn-sm"
                                                    @onclick="() => RemoveNewRecord(record)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (model.Records.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">
                                        No records found. Click "Add Row" to create the first record.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="row mb-4">
            <div class="col">
                <button type="submit" class="btn btn-success btn-lg">
                    <i class="bi bi-save"></i> Save Changes
                </button>
                <button type="button" class="btn btn-secondary btn-lg ms-2" @onclick="NavigateBack">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
                @if (saveMessage != null)
                {
                    <span class="ms-3 text-success fw-bold">@saveMessage</span>
                }
                @if (errorMessage != null)
                {
                    <span class="ms-3 text-danger fw-bold">@errorMessage</span>
                }
            </div>
        </div>
    </EditForm>

    <!-- History Section -->
    <div class="card mb-4">
        <div class="card-header bg-info text-white">
            <h5 class="mb-0">Update History (Converted to @GetCurrencySymbol() @CurrencySettings.DisplayCurrency)</h5>
        </div>
        <div class="card-body">
            @if (historyLoading)
            {
                <p class="text-muted">Loading history...</p>
            }
            else if (historyList != null && historyList.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Update ID</th>
                                <th>Update Date</th>
                                <th>Updated By</th>
                                <th class="text-end"># Records</th>
                                <th class="text-end">@GetCurrencySymbol() Total Gross Premium</th>
                                <th class="text-end">@GetCurrencySymbol() Total Net Premium</th>
                                <th class="text-end">@GetCurrencySymbol() Total RIPs</th>
                                <th class="text-end">@GetCurrencySymbol() Total PC</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var history in GetConvertedHistory())
                            {
                                <tr>
                                    <td><strong>#@history.UpdateID</strong></td>
                                    <td>@FormatDate(history.UpdateDate)</td>
                                    <td>@history.UpdatedBy</td>
                                    <td class="text-end">@history.RecordCount</td>
                                    <td class="text-end">@FormatConvertedCurrency(history.TotalGrossPremium)</td>
                                    <td class="text-end">@FormatConvertedCurrency(history.TotalNetPremium)</td>
                                    <td class="text-end">@FormatConvertedCurrency(history.TotalRIPs)</td>
                                    <td class="text-end">@FormatConvertedCurrency(history.TotalPC)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No history available yet.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public int YOA { get; set; }

    private UltimatePremiumEditModel? model;
    private List<UltimatePremiumHistoryModel>? historyList;
    private bool isLoading = true;
    private bool historyLoading = true;
    private string? saveMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await InitializeServices();
        await LoadData();
        await LoadHistory();
    }

    private async Task InitializeServices()
    {
        try
        {
            // Initialize currency settings from localStorage
            await CurrencySettings.InitializeAsync();

            // Load FX rates for the selected rate set
            await FxConversion.LoadRatesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error initializing services");
        }
    }

    private async Task OnCurrencySettingsChanged()
    {
        // Reload FX rates if needed (FxConversion already handles this via event subscription)
        // Just trigger a re-render
        StateHasChanged();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            model = await UltimatesService.GetUltimatePremiumByClassYOA(Class, YOA);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading data: {ex.Message}";
            model = new UltimatePremiumEditModel { Class = Class, YOA = YOA };
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadHistory()
    {
        historyLoading = true;
        try
        {
            var history = await UltimatesService.GetUltimatePremiumHistory(Class, YOA);
            historyList = history.ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading history: {ex.Message}");
            historyList = new List<UltimatePremiumHistoryModel>();
        }
        finally
        {
            historyLoading = false;
        }
    }

    private void AddNewRecord()
    {
        var newRecord = new UltimatePremiumRecordModel
            {
                Class = Class,
                YOA = YOA,
                ReservingClass = string.Empty,
                DistributionChannel = string.Empty,
                Currency = string.Empty,
                ValueType = "Value", // Default to Value
                IsNew = true,
                IsModified = true
            };

        model?.Records.Add(newRecord);
    }

    private void RemoveNewRecord(UltimatePremiumRecordModel record)
    {
        if (record.IsNew)
        {
            model?.Records.Remove(record);
        }
    }

    private void MarkAsModified(UltimatePremiumRecordModel record)
    {
        record.IsModified = true;
    }

    private void OnValueTypeChanged(UltimatePremiumRecordModel record)
    {
        record.IsModified = true;

        // If changing away from "Value", clear the premium fields
        if (record.ValueType != "Value")
        {
            record.UltimateGrossPremium = null;
            record.UltimateNetPremium = null;
            record.UltimateRIPs = null;
            record.UltimatePC = null;
        }

        StateHasChanged();
    }

    private async Task HandleValidSubmit()
    {
        saveMessage = null;
        errorMessage = null;

        try
        {
            // Validate that all new records have required fields
            var invalidRecords = model?.Records.Where(r =>
                r.IsNew && (string.IsNullOrWhiteSpace(r.ReservingClass) ||
                           string.IsNullOrWhiteSpace(r.DistributionChannel) ||
                           string.IsNullOrWhiteSpace(r.Currency))).ToList();

            if (invalidRecords?.Any() == true)
            {
                errorMessage = "Please fill in all required fields for new records (Reserving Class, Distribution Channel, Currency).";
                return;
            }

            // Validate Distribution Channel
            var invalidChannels = model?.Records.Where(r =>
                !string.IsNullOrEmpty(r.DistributionChannel) &&
                r.DistributionChannel != "EU" &&
                r.DistributionChannel != "LNDN").ToList();

            if (invalidChannels?.Any() == true)
            {
                errorMessage = "Distribution Channel must be either 'EU' or 'LNDN'.";
                return;
            }

            if (model != null)
            {
                await UltimatesService.SaveUltimatePremium(model);
                saveMessage = "Changes saved successfully!";

                // Reload data to get updated values
                await Task.Delay(1000); // Brief delay to show save message
                await LoadData();
                await LoadHistory();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving changes: {ex.Message}";
        }
    }

    private void NavigateBack()
    {
        NavigationManager.NavigateTo("/Ultimates/Premium");
    }

    // Currency conversion methods
    private decimal? GetConvertedTotalGrossPremium()
    {
        if (model == null || model.Records == null) return 0;
        return model.Records.Sum(r => FxConversion.ConvertToDisplayCurrency(r.UltimateGrossPremium, r.Currency));
    }

    private decimal? GetConvertedTotalNetPremium()
    {
        if (model == null || model.Records == null) return 0;
        return model.Records.Sum(r => FxConversion.ConvertToDisplayCurrency(r.UltimateNetPremium, r.Currency));
    }

    private decimal? GetConvertedTotalRIPs()
    {
        if (model == null || model.Records == null) return 0;
        return model.Records.Sum(r => FxConversion.ConvertToDisplayCurrency(r.UltimateRIPs, r.Currency));
    }

    private decimal? GetConvertedTotalPC()
    {
        if (model == null || model.Records == null) return 0;
        return model.Records.Sum(r => FxConversion.ConvertToDisplayCurrency(r.UltimatePC, r.Currency));
    }

    // Converted history class
    private class ConvertedHistoryModel
    {
        public int UpdateID { get; set; }
        public DateTime? UpdateDate { get; set; }
        public string? UpdatedBy { get; set; }
        public int RecordCount { get; set; }
        public decimal? TotalGrossPremium { get; set; }
        public decimal? TotalNetPremium { get; set; }
        public decimal? TotalRIPs { get; set; }
        public decimal? TotalPC { get; set; }
    }

    private List<ConvertedHistoryModel> GetConvertedHistory()
    {
        if (historyList == null) return new List<ConvertedHistoryModel>();

        // Note: History shows aggregated totals from multiple currencies
        // For now, we'll just display the raw totals since we don't have individual record currencies in history
        // This is a known limitation - history aggregates lose currency information
        return historyList.Select(h => new ConvertedHistoryModel
        {
            UpdateID = h.UpdateID,
            UpdateDate = h.UpdateDate,
            UpdatedBy = h.UpdatedBy,
            RecordCount = h.RecordCount,
            TotalGrossPremium = h.TotalUltimateGrossPremium, // Can't convert without currency info
            TotalNetPremium = h.TotalUltimateNetPremium,
            TotalRIPs = h.TotalUltimateRIPs,
            TotalPC = h.TotalUltimatePC
        }).ToList();
    }

    private string GetCurrencySymbol()
    {
        return CurrencySettings.DisplayCurrency == "GBP" ? "£" : "$";
    }

    private string FormatConvertedCurrency(decimal? value)
    {
        if (!value.HasValue) return "-";
        return value.Value.ToString("N0");
    }

    private string FormatCurrency(decimal? value)
    {
        if (!value.HasValue) return "-";
        return value.Value.ToString("N0");
    }

    private string FormatDate(DateTime? date)
    {
        if (!date.HasValue) return "-";
        return date.Value.ToString("yyyy-MM-dd HH:mm");
    }
}
