@page "/Ultimates/Premium/Edit/{Class}/{YOA:int}"
@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@using sandboxapp.Utilities
@inject UltimatesService UltimatesService
@inject NavigationManager NavigationManager
@inject ILogger<EditUltimatePremium> Logger

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">ULTIMATES</a></li>
        <li class="breadcrumb-item"><a href="/Ultimates/Premium">PREMIUM</a></li>
        <li class="breadcrumb-item active" aria-current="page">EDIT @Class / @YOA</li>
    </ol>
</nav>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Loading...</p>
    </div>
}
else if (gridRows != null)
{
    <div class="row mb-3">
        <div class="col">
            <h1>Edit Ultimate Premium: @Class / @YOA</h1>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(activeTab == "GrossPremium" ? "active" : "")" type="button" @onclick="@(() => SwitchTab("GrossPremium"))">
                Gross Premium @if (IsTabModified("GrossPremium")) { <span class="badge bg-warning ms-1">●</span> }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "NetPremium" ? "active" : "")" type="button" @onclick="@(() => SwitchTab("NetPremium"))">
                Net Premium @if (IsTabModified("NetPremium")) { <span class="badge bg-warning ms-1">●</span> }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "RIPs" ? "active" : "")" type="button" @onclick="@(() => SwitchTab("RIPs"))">
                RIPs @if (IsTabModified("RIPs")) { <span class="badge bg-warning ms-1">●</span> }
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == "PC" ? "active" : "")" type="button" @onclick="@(() => SwitchTab("PC"))">
                PC @if (IsTabModified("PC")) { <span class="badge bg-warning ms-1">●</span> }
            </button>
        </li>
    </ul>

    <!-- Grid -->
    <div class="card">
        <div class="card-header bg-secondary text-white d-flex justify-content-between">
            <h5 class="mb-0">@GetTabTitle(activeTab)</h5>
            <button type="button" class="btn btn-sm btn-light" @onclick="AddRow">
                <i class="bi bi-plus-circle"></i> Add Row
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:200px;">Reserving Class</th>
                            <th style="width:120px;">Channel</th>
                            <th style="width:140px;">Value Type</th>
                            <th class="text-center bg-light" style="min-width:120px;">Plan<br/><small class="text-muted">(CNV CCY)</small></th>
                            <th class="text-center bg-light" style="min-width:120px;">Written<br/><small class="text-muted">(CNV CCY)</small></th>
                            <th class="text-center bg-light" style="min-width:120px;">Signed<br/><small class="text-muted">(CNV CCY)</small></th>
                            @foreach (var curr in currencies)
                            {
                                <th class="text-center" style="min-width:150px;">
                                    <span class="@CurrencyUtility.GetCurrencyFlagClass(curr)" style="width:1.33em;height:1em;display:inline-block;vertical-align:middle;"></span> @curr
                                </th>
                            }
                            <th class="text-center bg-info text-white" style="min-width:120px;">CNV Total</th>
                            <th style="width:80px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in gridRows)
                        {
                            <tr class="@(row.IsNew ? "table-success" : IsRowModifiedForTab(row) ? "table-warning" : "")">
                                <td>
                                    @if (row.IsNew)
                                    {
                                        <input type="text" class="form-control form-control-sm" @bind="row.ReservingClass" />
                                    }
                                    else
                                    {
                                        <span>@row.ReservingClass</span>
                                    }
                                </td>
                                <td>
                                    @if (row.IsNew)
                                    {
                                        <select class="form-select form-select-sm" @bind="row.DistributionChannel">
                                            <option value="">Select...</option>
                                            <option value="EU">EU</option>
                                            <option value="LNDN">LNDN</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <span>@row.DistributionChannel</span>
                                    }
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            value="@row.ValueType"
                                            @onchange="@(e => OnRowValueTypeChanged(row, e.Value?.ToString()))">
                                        <option value="Written">Written</option>
                                        <option value="Signed">Signed</option>
                                        <option value="Plan">Plan</option>
                                        <option value="Value">Value</option>
                                    </select>
                                </td>
                                <!-- DWH values (read-only) -->
                                <td class="text-end bg-light">
                                    <span class="text-muted">@GetPlanValue(row)?.ToString("N2")</span>
                                </td>
                                <td class="text-end bg-light">
                                    <span class="text-muted">@GetWrittenValue(row)?.ToString("N2")</span>
                                </td>
                                <td class="text-end bg-light">
                                    <span class="text-muted">@GetSignedValue(row)?.ToString("N2")</span>
                                </td>
                                @foreach (var curr in currencies)
                                {
                                    var cell = row.GetOrCreateCell(curr);
                                    <td>
                                        @if (activeTab == "GrossPremium")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   value="@cell.GrossPremium"
                                                   @onchange="@(e => OnValueChanged(row, cell, "GrossPremium", e.Value?.ToString()))"
                                                   disabled="@(row.ValueType != "Value")" step="0.01" />
                                        }
                                        else if (activeTab == "NetPremium")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   value="@cell.NetPremium"
                                                   @onchange="@(e => OnValueChanged(row, cell, "NetPremium", e.Value?.ToString()))"
                                                   disabled="@(row.ValueType != "Value")" step="0.01" />
                                        }
                                        else if (activeTab == "RIPs")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   value="@cell.RIPs"
                                                   @onchange="@(e => OnValueChanged(row, cell, "RIPs", e.Value?.ToString()))"
                                                   disabled="@(row.ValueType != "Value")" step="0.01" />
                                        }
                                        else if (activeTab == "PC")
                                        {
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   value="@cell.PC"
                                                   @onchange="@(e => OnValueChanged(row, cell, "PC", e.Value?.ToString()))"
                                                   disabled="@(row.ValueType != "Value")" step="0.01" />
                                        }
                                    </td>
                                }
                                <!-- CNV Total -->
                                <td class="text-end bg-info bg-opacity-10 fw-bold">
                                    @{
                                        var cnvTotal = GetCNVTotal(row);
                                        if (cnvTotal.HasValue)
                                        {
                                            <span>@cnvTotal.Value.ToString("N2")</span>
                                        }
                                    }
                                </td>
                                <td class="text-center">
                                    @if (row.IsNew)
                                    {
                                        <button type="button" class="btn btn-danger btn-sm" @onclick="@(() => RemoveRow(row))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="row my-4">
        <div class="col">
            <button type="button" class="btn btn-success btn-lg" @onclick="SaveChanges">
                <i class="bi bi-save"></i> Save Changes
            </button>
            <button type="button" class="btn btn-secondary btn-lg ms-2" @onclick="@(() => NavigationManager.NavigateTo("/Ultimates/Premium"))">
                <i class="bi bi-x-circle"></i> Cancel
            </button>
            @if (!string.IsNullOrEmpty(message))
            {
                <span class="ms-3 @(isError ? "text-danger" : "text-success") fw-bold">@message</span>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public int YOA { get; set; }

    private bool isLoading = true;
    private string activeTab = "GrossPremium";
    private List<string> currencies = new() { "GBP", "USD", "CAD", "EUR", "JPY" };
    private List<GridRow> gridRows = new();
    private string message = "";
    private bool isError = false;
    private List<FXRate> fxRates = new();

    private class GridRow
    {
        public string ReservingClass { get; set; } = "";
        public string DistributionChannel { get; set; } = "";
        public string ValueType { get; set; } = "Value"; // One ValueType per row
        public Dictionary<string, CurrencyCell> Cells { get; set; } = new();
        public bool IsNew { get; set; }
        public HashSet<string> ModifiedMetrics { get; set; } = new(); // Track which metrics were modified

        // DWH values in CNV CCY (placeholder - to be fetched from DWH)
        public decimal? PlanGrossPremium { get; set; }
        public decimal? WrittenGrossPremium { get; set; }
        public decimal? SignedGrossPremium { get; set; }

        public decimal? PlanNetPremium { get; set; }
        public decimal? WrittenNetPremium { get; set; }
        public decimal? SignedNetPremium { get; set; }

        public decimal? PlanRIPs { get; set; }
        public decimal? WrittenRIPs { get; set; }
        public decimal? SignedRIPs { get; set; }

        public decimal? PlanPC { get; set; }
        public decimal? WrittenPC { get; set; }
        public decimal? SignedPC { get; set; }

        public CurrencyCell GetOrCreateCell(string currency)
        {
            if (!Cells.ContainsKey(currency))
                Cells[currency] = new CurrencyCell { Currency = currency };
            return Cells[currency];
        }
    }

    private class CurrencyCell
    {
        public string Currency { get; set; } = "";
        public decimal? GrossPremium { get; set; }
        public decimal? NetPremium { get; set; }
        public decimal? RIPs { get; set; }
        public decimal? PC { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var model = await UltimatesService.GetUltimatePremiumByClassYOA(Class, YOA);
            fxRates = await UltimatesService.GetFXRates(YOA);

            gridRows.Clear();
            var grouped = model.Records.GroupBy(r => new { r.ReservingClass, r.DistributionChannel });

            foreach (var group in grouped)
            {
                var row = new GridRow
                {
                    ReservingClass = group.Key.ReservingClass,
                    DistributionChannel = group.Key.DistributionChannel,
                    ValueType = group.First().ValueType // Use ValueType from first record
                };

                foreach (var rec in group)
                {
                    var cell = row.GetOrCreateCell(rec.Currency);
                    cell.GrossPremium = rec.UltimateGrossPremium;
                    cell.NetPremium = rec.UltimateNetPremium;
                    cell.RIPs = rec.UltimateRIPs;
                    cell.PC = rec.UltimatePC;
                }

                // TODO: Fetch DWH values for this row
                await FetchDWHValuesForRow(row);

                gridRows.Add(row);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading data");
            message = $"Error: {ex.Message}";
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        StateHasChanged();
    }

    private void OnRowValueTypeChanged(GridRow row, string? newValueType)
    {
        if (newValueType == null) return;

        row.ValueType = newValueType;

        // Populate the 5 currency cells from the selected DWH value
        if (row.ValueType == "Plan")
        {
            PopulateCurrenciesFromDWH(row, "Plan");
        }
        else if (row.ValueType == "Written")
        {
            PopulateCurrenciesFromDWH(row, "Written");
        }
        else if (row.ValueType == "Signed")
        {
            PopulateCurrenciesFromDWH(row, "Signed");
        }
        else if (row.ValueType == "Value")
        {
            // Clear all currency values when switching to manual "Value" mode
            foreach (var cell in row.Cells.Values)
            {
                SetCellValue(cell, activeTab, null);
            }
        }

        // Mark the current metric as modified
        row.ModifiedMetrics.Add(activeTab);
        StateHasChanged();
    }

    private void PopulateCurrenciesFromDWH(GridRow row, string valueType)
    {
        // Get the DWH value for the current tab
        decimal? dwhValue = valueType switch
        {
            "Plan" => GetPlanValue(row),
            "Written" => GetWrittenValue(row),
            "Signed" => GetSignedValue(row),
            _ => null
        };

        if (!dwhValue.HasValue) return;

        // Populate all 5 currency cells with the DWH value
        // (The DWH value is already in CNV CCY, so we distribute it across currencies)
        foreach (var curr in currencies)
        {
            var cell = row.GetOrCreateCell(curr);
            SetCellValue(cell, activeTab, dwhValue);
        }
    }

    private void OnValueChanged(GridRow row, CurrencyCell cell, string metric, string? newValue)
    {
        if (string.IsNullOrEmpty(newValue))
        {
            SetCellValue(cell, metric, null);
        }
        else if (decimal.TryParse(newValue, out var decValue))
        {
            SetCellValue(cell, metric, decValue);
        }

        // Mark this specific metric as modified
        row.ModifiedMetrics.Add(metric);
    }

    private void SetCellValue(CurrencyCell cell, string metric, decimal? value)
    {
        switch (metric)
        {
            case "GrossPremium": cell.GrossPremium = value; break;
            case "NetPremium": cell.NetPremium = value; break;
            case "RIPs": cell.RIPs = value; break;
            case "PC": cell.PC = value; break;
        }
    }

    private void AddRow()
    {
        var newRow = new GridRow { IsNew = true };
        newRow.ModifiedMetrics.Add("GrossPremium");
        newRow.ModifiedMetrics.Add("NetPremium");
        newRow.ModifiedMetrics.Add("RIPs");
        newRow.ModifiedMetrics.Add("PC");
        gridRows.Add(newRow);
    }

    private void RemoveRow(GridRow row)
    {
        if (row.IsNew) gridRows.Remove(row);
    }

    private async Task SaveChanges()
    {
        message = "";
        isError = false;

        try
        {
            var editModel = new UltimatePremiumEditModel { Class = Class, YOA = YOA };

            foreach (var row in gridRows.Where(r => r.IsNew || r.ModifiedMetrics.Any()))
            {
                foreach (var cell in row.Cells.Values)
                {
                    // Only save if this row has modified metrics or is new
                    if (row.IsNew || row.ModifiedMetrics.Any())
                    {
                        editModel.Records.Add(new UltimatePremiumRecordModel
                        {
                            Class = Class,
                            YOA = YOA,
                            ReservingClass = row.ReservingClass,
                            DistributionChannel = row.DistributionChannel,
                            Currency = cell.Currency,
                            ValueType = row.ValueType,
                            UltimateGrossPremium = cell.GrossPremium,
                            UltimateNetPremium = cell.NetPremium,
                            UltimateRIPs = cell.RIPs,
                            UltimatePC = cell.PC,
                            IsModified = true
                        });
                    }
                }
            }

            await UltimatesService.SaveUltimatePremium(editModel);
            message = "✓ Saved successfully!";

            await Task.Delay(1500);
            await LoadData();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving");
            message = $"Error: {ex.Message}";
            isError = true;
        }
    }

    private string GetTabTitle(string tab) => tab switch
    {
        "GrossPremium" => "Ultimate Gross Premium",
        "NetPremium" => "Ultimate Net Premium",
        "RIPs" => "Ultimate RIPs",
        "PC" => "Ultimate PC",
        _ => tab
    };

    private bool IsTabModified(string tab)
    {
        // Only show badge if THIS specific metric was modified
        return gridRows.Any(r => r.ModifiedMetrics.Contains(tab));
    }

    private bool IsRowModifiedForTab(GridRow row)
    {
        // Only highlight row if the current active tab's metric was modified
        return row.ModifiedMetrics.Contains(activeTab);
    }

    // Helper methods to get DWH values for current tab
    private decimal? GetPlanValue(GridRow row) => activeTab switch
    {
        "GrossPremium" => row.PlanGrossPremium,
        "NetPremium" => row.PlanNetPremium,
        "RIPs" => row.PlanRIPs,
        "PC" => row.PlanPC,
        _ => null
    };

    private decimal? GetWrittenValue(GridRow row) => activeTab switch
    {
        "GrossPremium" => row.WrittenGrossPremium,
        "NetPremium" => row.WrittenNetPremium,
        "RIPs" => row.WrittenRIPs,
        "PC" => row.WrittenPC,
        _ => null
    };

    private decimal? GetSignedValue(GridRow row) => activeTab switch
    {
        "GrossPremium" => row.SignedGrossPremium,
        "NetPremium" => row.SignedNetPremium,
        "RIPs" => row.SignedRIPs,
        "PC" => row.SignedPC,
        _ => null
    };

    // TODO: Replace with actual DWH fetch logic
    private async Task FetchDWHValuesForRow(GridRow row)
    {
        // PLACEHOLDER: Replace this with actual DWH fetch logic
        // For now, just set some dummy values for testing
        row.PlanGrossPremium = 0m;
        row.WrittenGrossPremium = 0m;
        row.SignedGrossPremium = 0m;

        row.PlanNetPremium = 0m;
        row.WrittenNetPremium = 0m;
        row.SignedNetPremium = 0m;

        row.PlanRIPs = 0m;
        row.WrittenRIPs = 0m;
        row.SignedRIPs = 0m;

        row.PlanPC = 0m;
        row.WrittenPC = 0m;
        row.SignedPC = 0m;

        await Task.CompletedTask;
    }

    // Calculate CNV Total (sum of 5 currency cells converted to base currency)
    private decimal? GetCNVTotal(GridRow row)
    {
        decimal total = 0m;
        bool hasAnyValue = false;

        foreach (var curr in currencies)
        {
            var cell = row.GetOrCreateCell(curr);
            decimal? value = activeTab switch
            {
                "GrossPremium" => cell.GrossPremium,
                "NetPremium" => cell.NetPremium,
                "RIPs" => cell.RIPs,
                "PC" => cell.PC,
                _ => null
            };

            if (value.HasValue)
            {
                hasAnyValue = true;
                // Convert to base currency (GBP)
                var rate = fxRates.FirstOrDefault(r => r.Currency == curr);
                if (rate != null && rate.Rate > 0)
                {
                    total += value.Value / rate.Rate;
                }
            }
        }

        return hasAnyValue ? total : null;
    }
}
