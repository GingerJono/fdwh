@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Pages" },
        new SpkPageHeader.PageItem { PageTitle = "Chat" },
    };

    ChatList? ActiveUser { get; set; }
    string? chatUserDetailsRef = "";
    string? mainChartWrapperRef;
    protected override void OnInitialized()
    {
        ActiveUser = ChatService.GetActiveChatsData().FirstOrDefault();
    }
    private void ShowChat(ChatList Selected)
    {
       ActiveUser = Selected;
       mainChartWrapperRef = "responsive-chat-open";

    }    
    private void removeChat()
    {
        mainChartWrapperRef = "";
    }
    private void ShowChatUser()
    {
        chatUserDetailsRef = "open";
    }
    private void CloseChatUser()
    {
        chatUserDetailsRef = "";
    }
    
}
