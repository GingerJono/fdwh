    {
       
        if (e.Value is bool value)
        {
            isChecked = value;
        }
    }

}

@code {    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.interop.initializeTooltips");
        }
    }
}