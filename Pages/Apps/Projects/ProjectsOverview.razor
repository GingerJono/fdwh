@page "/projects-overview"
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using ProjectData
@inject ProjectService ProjectService

<!-- dragula css-->
<link rel="stylesheet" href="../assets/libs/dragula/dist/dragula.min.css">

    <!-- Page Header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- Page Header Close -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xxl-8">
            <div class="card custom-card">
                <div class="card-header justify-content-between">
                    <div class="card-title">
                        Project Details
                    </div> 
                    <div>
                        <SpkButtons Tag="a" href="/projects-create" ButtonClass="btn-primary" ButtonSize="btn-sm"><i class="ri-add-line align-middle me-1 fw-medium"></i>Create Project</SpkButtons>
                        <SpkButtons Tag="a" ButtonClass="btn-primary1" ButtonSize="btn-sm"><i class="ri-share-line align-middle me-1 fw-medium"></i>Share</SpkButtons>
                    </div>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4 gap-2 flex-wrap">
                        <span class="avatar avatar-lg me-1 bg-primary-gradient"><i class="ri-stack-line fs-24 lh-1"></i></span>
                        <div>
                            <h6 class="fw-medium mb-2 task-title">
                                    Customer Feedback Dashboard Development
                            </h6>
                            <SpkBadge BadgeClass="bg-success-transparent">In progress</SpkBadge>
                            <span class="text-muted fs-12"><i class="ri-circle-fill text-success mx-2 fs-9"></i>Last Updated 1 Day Ago</span>
                        </div>
                        <div class="ms-auto align-self-start">
                            <SpkDropdowns Tag="a" DropdownClass="btn btn-icon btn-primary-light btn-sm" DropdownText="<i class='fe fe-more-vertical'></i>" DropdownToggle=false>
                                <ChildContent2>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="ri-eye-line align-middle me-1 d-inline-block"></i>View</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="ri-edit-line align-middle me-1 d-inline-block"></i>Edit</a></li>
                                        <li><a class="dropdown-item" href="javascript:void(0);"><i class="ri-delete-bin-line me-1 align-middle d-inline-block"></i>Delete</a></li>
                                    </ul>
                                </ChildContent2>
                            </SpkDropdowns>
                        </div>
                    </div>
                    <div class="fs-15 fw-medium mb-2">Project Description :</div>
                    <p class="text-muted mb-4">The Customer Feedback Dashboard Development project aims to create a comprehensive dashboard that aggregates and visualizes customer feedback data. This will enable our team to gain actionable insights and improve customer satisfaction.</p>
                    <div class="d-flex gap-5 mb-4 flex-wrap">
                        <div class="d-flex align-items-center gap-2 me-3">
                            <span class="avatar avatar-md avatar-rounded me-1 bg-primary1-transparent"><i class="ri-calendar-event-line fs-18 lh-1 align-middle"></i></span>
                            <div>
                                <div class="fw-medium mb-0 task-title">
                                    Start Date
                                </div>
                                <span class="fs-12 text-muted">28 August, 2024</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 me-3">
                            <span class="avatar avatar-md avatar-rounded me-1 bg-primary2-transparent"><i class="ri-time-line fs-18 lh-1 align-middle"></i></span>
                            <div>
                                <div class="fw-medium mb-0 task-title">
                                    End Date
                                </div>
                                <span class="fs-12 text-muted">30 Oct, 2024</span>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="avatar avatar-md p-1 avatar-rounded me-1 bg-primary-transparent"><img src="../assets/images/faces/11.jpg" alt=""></span>
                            <div>
                                <span class="d-block fs-14 fw-medium">Amith Catzem</span>
                                <span class="fs-12 text-muted">Project Manager</span>
                            </div>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="fs-15 fw-medium mb-2">Key tasks :</div>
                                <ul class="task-details-key-tasks mb-0">
                                    <li>Design and implement a user-friendly dashboard interface.</li>
                                    <li>Integrate data sources and APIs to fetch customer feedback data.</li>
                                    <li>Develop interactive data visualizations for easy interpretation.</li>
                                    <li>Implement filters and sorting functionalities for data analysis.</li>
                                    <li>Create user authentication and access control features.</li>
                                    <li>Perform usability testing and iterate based on feedback.</li>
                                </ul>
                            </div>
                            <div class="col-xl-6">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="fs-15 fw-medium">Sub Tasks :</div>
                                    <SpkButtons Tag="a" ButtonClass="btn-primary-light" ButtonSize="btn-sm">See More</SpkButtons>
                                </div>
                                <ul class="list-group">
                                    <li class="list-group-item">
                                        <div class="d-flex align-items-center">
                                            <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                            <div class="fw-medium">Research latest web development trends.</div>
                                        </div>
                                    </li>
                                    <li class="list-group-item">
                                        <div class="d-flex align-items-center">
                                            <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                            <div class="fw-medium">Create technical specifications document.</div>
                                        </div>
                                    </li>
                                    <li class="list-group-item">
                                        <div class="d-flex align-items-center">
                                            <div class="me-2"><i class="ri-link fs-15 text-secondary lh-1 p-1 bg-secondary-transparent rounded-circle"></i></div>
                                            <div class="fw-medium">Optimize website for mobile responsiveness.</div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="fs-15 fw-medium mb-2">Skills :</div>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var tag in ProjectService.GetTagsData()){
                            <SpkBadge BadgeClass="bg-light text-default border">@tag.Tag</SpkBadge>
                        }
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <div class="d-flex gap-3 align-items-center">
                            <span class="fs-12">Assigned To :</span>
                            <div class="avatar-list-stacked">
                                @foreach(var team in ProjectService.GetAssigned()){
                                    <SpkTooltip Tag="span" TooltipClass="avatar avatar-sm avatar-rounded" TooltipCustomClass="tooltip-primary" TooltipTitle="@team.Title">
                                        <img src="@team.Img" alt="img">
                                    </SpkTooltip>
                                }
                            </div>
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <span class="fs-12">Status:</span>
                            <span class="d-block"><SpkBadge BadgeClass="bg-info">On going</SpkBadge></span>
                        </div>
                        <div class="d-flex gap-3 align-items-center">
                            <span class="fs-12">Priority:</span>
                            <span class="d-block fs-14 fw-medium"><SpkBadge BadgeClass="bg-primary3">Medium</SpkBadge></span>
                        </div>
                    </div>
                </div>                            
            </div>  
            <div class="card custom-card overflow-hidden">
                <div class="card-header justify-content-between">
                    <div class="card-title">To Do Tasks</div>
                    <SpkButtons ButtonClass="btn-primary-light" ButtonSize="btn-sm"><i class="ri-add-line align-middle me-1 fw-medium"></i>Add Task</SpkButtons>
                </div>
                <div class="card-body p-0 position-relative" id="todo-content">
                    <SpkTables Items="ProjectService.GetTodoHeadersData()" Tableclass="text-nowrap" ShowCheckbox=true SelectAllClick="ToggleSelectAll" id="todo-drag">
                        @foreach(var TodoList in ProjectService.GetTodoData()) {
                            <tr class="todo-box">
                                <td class="task-checkbox"><input class="form-check-input" type="checkbox" value="" aria-label="..." @bind="@TodoList.Selected"></td>
                                <td><SpkButtons ButtonClass="todo-handle btn-light btn-icon" ButtonSize="btn-sm">: :</SpkButtons></td>
                                <td><span class="fw-medium">@TodoList.ProjectTitle</span></td>
                                <td>
                                    <span class="fw-medium @(TodoList.Status == "Not Started" ? "text-primary2" : TodoList.Status == "Completed" ? "text-success fs-12"  : TodoList.Status == "Pending" ? "text-warning" : "text-primary")"><i class="ri-circle-line fw-semibold fs-7 me-2 lh-1 align-middle"></i>@TodoList.Status</span>
                                </td>
                                <td>@TodoList.Due</td>
                                <td class="text-end">
                                    <div class="d-flex gap-2">
                                        <SpkButtons Tag="a" ButtonClass="btn-icon btn-info-light" ButtonSize="btn-sm"><i class="ri-edit-line"></i></SpkButtons>
                                        <SpkButtons Tag="a" ButtonClass="btn-icon btn-danger-light" ButtonSize="btn-sm" @onclick="@(() => DeleteTodo(TodoList.ProjectId))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                    </div>
                                </td>
                            </tr>
                        }
                    </SpkTables>
                </div>
            </div>
        </div>
        <div class="col-xxl-4">
            <div class="card custom-card justify-content-between">
                <div class="card-header pb-0">
                    <div class="card-title">Project Discussions</div>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled profile-timeline">
                        @foreach(var activitylist in ProjectService.GetActivityData()){
                            <SpkActivity activity="activitylist"></SpkActivity>
                        }
                    </ul>
                </div>
                <div class="card-footer">
                    <div class="d-sm-flex align-items-center lh-1">
                        <div class="me-sm-2 mb-2 mb-sm-0 p-1 rounded-circle bg-primary-transparent d-inline-block">
                            <img src="../assets/images/faces/5.jpg" alt="" class="avatar avatar-sm avatar-rounded">
                        </div>
                        <div class="flex-fill">
                            <div class="input-group flex-nowrap">
                                <input type="text" class="form-control w-sm-50 border shadow-none" placeholder="Share your thoughts" aria-label="Recipient's username with two button addons">
                                <SpkButtons ButtonClass="btn-primary-light"><i class="bi bi-emoji-smile"></i></SpkButtons>
                                <SpkButtons ButtonClass="btn-primary-light"><i class="bi bi-paperclip"></i></SpkButtons>
                                <SpkButtons ButtonClass="btn-primary-light"><i class="bi bi-camera"></i></SpkButtons>
                                <SpkButtons ButtonClass="btn-primary text-nowrap">Post</SpkButtons>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card custom-card overflow-hidden">
                <div class="card-header justify-content-between">
                    <div class="card-title">
                        Project Documents
                    </div>
                    <SpkDropdowns DropdownClass="btn-light btn-full btn-sm" DropdownText="View All<i class='ti ti-chevron-down ms-1'></i>" DropdownToggle=false>
                        <ChildContent2>
                            <ul class="dropdown-menu" role="menu">
                                <li><a class="dropdown-item" href="javascript:void(0);">Download</a>
                                </li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Import</a></li>
                                <li><a class="dropdown-item" href="javascript:void(0);">Export</a></li>
                            </ul>
                        </ChildContent2>
                    </SpkDropdowns>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach(var Docs in ProjectService.GetDocumentsData()){
                        <li class="list-group-item">
                            <div class="d-flex align-items-center flex-wrap gap-2">
                                <span class="avatar avatar-md avatar-rounded p-2 bg-light lh-1">
                                    <img src="@Docs.Project" alt="">
                                </span>
                                <div class="flex-fill">
                                    <a href="javascript:void(0);"><span class="d-block fw-medium">@Docs.ProjectTitle</span></a>
                                    <span class="d-block text-muted fs-12 fw-normal">@Docs.Status</span>
                                </div>
                                <div class="btn-list">
                                    <SpkButtons ButtonClass="btn-icon btn-info-light" ButtonSize="btn-sm"><i class="ri-edit-line"></i></SpkButtons>
                                    <SpkButtons ButtonClass="btn-icon btn-danger-light" ButtonSize="btn-sm" @onclick="@(() => DeleteDocs(Docs.ProjectId))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                </div>
                            </div>
                        </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->

    <!-- Dragula JS -->
    <script src="../assets/libs/dragula/dist/dragula.min.js"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/js/project-overview.js")"></script>



@code {    
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Apps" },
        new SpkPageHeader.PageItem { PageTitle = "Projects" },
        new SpkPageHeader.PageItem { PageTitle = "Projects List" },
    };
    private bool selectAll;
    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var TodoList in ProjectService.GetTodoData())
        {
            TodoList.Selected = selectAll;
        }
    }
    
    protected void DeleteTodo(decimal ProjectId)
    {
        var TodoToRemove = ProjectService.GetTodoData().FirstOrDefault(o => o.ProjectId == ProjectId);
        if (TodoToRemove != null)
        {
            ProjectService.GetTodoData().Remove(TodoToRemove);
        }
    }
    protected void DeleteDocs(decimal ProjectId)
    {
        var DocsToRemove = ProjectService.GetDocumentsData().FirstOrDefault(o => o.ProjectId == ProjectId);
        if (DocsToRemove != null)
        {
            ProjectService.GetDocumentsData().Remove(DocsToRemove);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("window.interop.initializeTooltips");
        }
    }
}