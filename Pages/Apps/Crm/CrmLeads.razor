@page "/crm-leads"
@inject Microsoft.AspNetCore.Components.NavigationManager NavigationManager // This line is used to generate URLs dynamically //
@using Sandbox._Spk
@using CrmData
@inject CrmDataService CrmDataService

    <!-- Start::page-header -->
    <SpkPageHeader PageItems="PageItems" />
    <!-- End::page-header -->

    <!-- Start::row-1 -->
    <div class="row">
        <div class="col-xl-12">
            <div class="card custom-card">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div class="card-title">Leads<SpkBadge BadgeClass="bg-primary ms-2 fs-12 align-middle">28</SpkBadge></div>
                    <div class="d-flex flex-wrap gap-2">
                        <SpkButtons ButtonClass="btn-primary" ButtonSize="btn-sm" data-bs-toggle="modal" data-bs-target="#create-contact"><i class="ri-add-line me-1 fw-medium align-middle"></i>Create Lead</SpkButtons>
                        <SpkButtons ButtonClass="btn-success-light" ButtonSize="btn-sm">Export As CSV</SpkButtons>
                        <SpkDropdowns Tag="a" DropdownClass="btn btn-light btn-sm" DropdownText="Sort By<i class='ri-arrow-down-s-line align-middle ms-1 d-inline-block'></i>" DropdownToggle=false>
                            <ChildContent2>
                                <ul class="dropdown-menu" role="menu">
                                    <li><a class="dropdown-item" href="javascript:void(0);">Newest</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">Date Added</a></li>
                                    <li><a class="dropdown-item" href="javascript:void(0);">A - Z</a></li>
                                </ul>
                            </ChildContent2>
                        </SpkDropdowns>
                    </div>
                </div>
                <div class="card-body p-0">
                    
                    <SpkTables Tableclass="text-nowrap table-hover" Items="CrmDataService.GetLeadsHeadersData()"  ShowCheckbox=true SelectAllClick="ToggleSelectAll">
                        
                            @foreach (var CrmLeads in CrmDataService.GetCrmLeads())
                            {
                            <tr class="crm-contact leads-list">
                                <td class="leads-checkbox">
                                    <input class="form-check-input" type="checkbox" value="" @bind="@CrmLeads.Selected" aria-label="...">
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lh-1">
                                            <span class="avatar avatar-rounded avatar-sm">
                                                <img src="@CrmLeads.ContactImg" alt="">
                                            </span>
                                        </div>
                                        <div>
                                            <span class="d-block fw-medium">@CrmLeads.ContactName</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lh-1">
                                            <span class="avatar avatar-sm p-1 bg-light avatar-rounded">
                                                <img src="@CrmLeads.CompanyImg" alt="">
                                            </span>
                                        </div>
                                        <div>@CrmLeads.CompanyName</div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        <span class="d-block mb-1"><i class="ri-mail-line me-2 align-middle fs-14 text-muted d-inline-block"></i>@CrmLeads.Email</span>
                                    </div>
                                </td>
                                <td>
                                    <SpkBadge BadgeClass="@(CrmLeads.Status == "Prospect"? "bg-primary-transparent":"bg-primary1-transparent")">@CrmLeads.Status</SpkBadge>
                                </td>
                                <td>
                                    <div>
                                        <span class="d-block"><i class="ri-phone-line me-2 align-middle fs-14 text-muted"></i>@CrmLeads.Phone</span>
                                    </div>
                                </td>
                                <td>
                                    @CrmLeads.LeadsSource
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="lh-1">
                                            <span class="avatar avatar-rounded avatar-sm">
                                                <img src="@CrmLeads.OwnerImg" alt="Avatar">
                                            </span>
                                        </div>
                                        <div>
                                            <span class="d-block fw-medium">@CrmLeads.OwnerName</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-medium">
                                    @CrmLeads.LastContacted
                                </td>
                                <td>
                                    <div class="btn-list">
                                        <SpkButtons Tag="a" ButtonSize="btn-sm" ButtonClass="btn-primary-light btn-icon"><i class="ri-eye-line"></i></SpkButtons>
                                        <SpkButtons Tag="a" ButtonSize="btn-sm" ButtonClass="btn-info-light btn-icon"><i class="ri-pencil-line"></i></SpkButtons>
                                        <SpkButtons Tag="a" ButtonSize="btn-sm" ButtonClass="btn-primary2-light btn-icon contact-delete" @onclick="@(() => DeleteCrmLeads(CrmLeads.ContactName))"><i class="ri-delete-bin-line"></i></SpkButtons>
                                    </div>
                                </td>
                            </tr>
                            }
                    </SpkTables>
                </div>
                <div class="card-footer border-top-0">
                    <div class="d-flex align-items-center">
                        <div>
                            Showing 9 Entries <i class="bi bi-arrow-right ms-2 fw-medium"></i>
                        </div>
                        <div class="ms-auto">
                            <nav aria-label="Page navigation" class="pagination-style-4">
                                <ul class="pagination mb-0">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="javascript:void(0);">
                                            Prev
                                        </a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="javascript:void(0);">1</a></li>
                                    <li class="page-item"><a class="page-link" href="javascript:void(0);">2</a></li>
                                    <li class="page-item">
                                        <a class="page-link text-primary" href="javascript:void(0);">
                                            next
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--End::row-1 -->

    <!-- Start:: Create Contact -->
    <div class="modal fade" id="create-contact" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title">Create Lead</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row gy-3">
                        <div class="col-xl-12">
                            <div class="mb-0 text-center">
                                <span class="avatar avatar-xxl avatar-rounded">
                                    <img src="@imageDataUrl" alt="Selected Image" id="profile-img" />
                                    <SpkBadge BadgeClass="bg-primary avatar-badge" IsRounded=true>
                                        <InputFile id="profile-change" class="position-absolute w-100 h-100 op-0" OnChange="LoadFile"></InputFile> <i class="fe fe-camera"></i>
                                    </SpkBadge>
                                </span>
                            </div>
                        </div>
                        <div class="col-xl-12">
                            <label for="contact-name" class="form-label">Contact Name</label>
                            <input type="text" class="form-control" id="contact-name" placeholder="Contact Name">
                        </div>
                        <div class="col-xl-12">
                            <label for="contact-mail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="contact-mail" placeholder="Enter Email">
                        </div>
                        <div class="col-xl-12">
                            <label for="contact-phone" class="form-label">Phone No</label>
                            <input type="tel" class="form-control" id="contact-phone" placeholder="Enter Phone Number">
                        </div>
                        <div class="col-xl-12">
                            <label for="company-name" class="form-label">Company Name</label>
                            <input type="text" class="form-control" id="company-name" placeholder="Company Name">
                        </div>
                        <div class="col-xl-12">
                            <label class="form-label">Lead Status</label>
                            <select class="form-control tomselect" name="choices-multiple-remove-button3" id="choices-multiple-remove-button3">
                                <option value="">Select Status</option>
                                <option value="Choice 1">New</option>
                                <option value="Choice 2">Follow-up</option>
                                <option value="Choice 3">Closed</option>
                                <option value="Choice 4">Contacted</option>
                                <option value="Choice 5">Disqualified</option>
                                <option value="Choice 6">Qualified</option>
                            </select>
                        </div>
                        <div class="col-xl-12">
                            <label class="form-label">Lead Source</label>
                            <select class="form-control tomselect" name="choices-multiple-remove-button1" id="choices-multiple-remove-button1">
                                <option value="Choice 1">Social Media</option>
                                <option value="Choice 2">Direct mail</option>
                                <option value="Choice 3">Blog Articles</option>
                                <option value="Choice 4">Affiliates</option>
                                <option value="Choice 5">Organic search</option>
                            </select>
                        </div>
                        <div class="col-xl-12">
                            <label class="form-label">Tags</label>
                            <select class="form-control tomselect-multiple" name="choices-multiple-remove-button2" id="choices-multiple-remove-button2" multiple>
                                <option value="Choice 1">New Lead</option>
                                <option value="Choice 2">Prospect</option>
                                <option value="Choice 3">Customer</option>
                                <option value="Choice 4">Hot Lead</option>
                                <option value="Choice 5">Partner</option>
                                <option value="Choice 6">LostCustomer</option>
                                <option value="Choice 7">Influencer</option>
                                <option value="Choice 8">Subscriber</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <SpkButtons ButtonClass="m-0 btn-primary1-light me-2" data-bs-dismiss="modal">Cancel</SpkButtons>
                    <SpkButtons ButtonClass="m-0 btn-primary">Create Lead</SpkButtons>
                </div>
            </div>
        </div>
    </div>
    <!-- End:: Create Contact -->

    <!-- TomSelect JS -->
    <script src="@($"{NavigationManager.BaseUri}assets/libs/tom-select/dist/js/tom-select.complete.min.js")"></script>
    <script src="@($"{NavigationManager.BaseUri}assets/js/tomselect.js")"></script>

@code {
    private List<SpkPageHeader.PageItem> PageItems = new List<SpkPageHeader.PageItem> {
        new SpkPageHeader.PageItem { PageTitle = "Apps" },
        new SpkPageHeader.PageItem { PageTitle = "CRM" },
        new SpkPageHeader.PageItem { PageTitle = "Leads" },
    };
    protected void DeleteCrmLeads(string? ContactName)
    {
        var LeadToRemove = CrmDataService.GetCrmLeads().FirstOrDefault(o => o.ContactName == ContactName);
        if (LeadToRemove != null)
        {
            CrmDataService.GetCrmLeads().Remove(LeadToRemove);
        }
    }
    private bool selectAll;
    private void ToggleSelectAll()
    {
        selectAll = !selectAll;
        foreach (var CrmLeads in CrmDataService.GetCrmLeads())
        {
           CrmLeads.Selected = selectAll;
        }
    }
}
@code {
    string imageDataUrl ="../assets/images/faces/9.jpg";

    async Task LoadFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && file.ContentType.Contains("image"))
        {
            var buffer = new byte[file.Size];
            await file.OpenReadStream().ReadAsync(buffer);
            var imageBase64 = Convert.ToBase64String(buffer);
            imageDataUrl = $"data:{file.ContentType};base64,{imageBase64}";
        }
        else
        {
            imageDataUrl = "";
            imageDataUrl = "Invalid image selected";
        }
    }
}