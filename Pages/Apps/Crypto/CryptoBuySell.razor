                SeriesType = SeriesType.Line,
                Name="Sell",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = e => e.Sum(e => e.Viewers),
            },
            new SeriesConfig<AudienceMetric>
            {
                SeriesType = SeriesType.Bar,
                Name="Buy",
                XValueSelector = e => e.Month ?? "unknown",
                YAggregateSelector = e => e.Sum(e => e.Sessions),
            },
        };
    }
}