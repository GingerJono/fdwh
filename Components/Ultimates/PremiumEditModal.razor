@using sandboxapp.Models.Ultimates
@using sandboxapp.Services
@inject UltimatesService UltimatesService
@inject ILogger<PremiumEditModal> Logger

<!-- Full-screen modal overlay -->
<div class="modal-overlay" @onclick="HandleOverlayClick">
    <div class="modal-container" @onclick:stopPropagation="true">
        <div class="modal-header-custom">
            <h3>@(IsNew ? "Create New Premium Record" : $"Edit Premium: {Premium?.Class} / {Premium?.ReservingClass} / {Premium?.YOA}")</h3>
            <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
        </div>

        <div class="modal-body-custom">
            @if (Premium != null)
            {
                <div class="container-fluid">
                    <!-- Key Fields (editable for new, read-only for existing) -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h5 class="border-bottom pb-2">Identification</h5>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Class <span class="text-danger">*</span></label>
                            @if (IsNew)
                            {
                                <input type="text" class="form-control" @bind="Premium.Class" required />
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Premium.Class" disabled />
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Reserving Class <span class="text-danger">*</span></label>
                            @if (IsNew)
                            {
                                <input type="text" class="form-control" @bind="Premium.ReservingClass" required />
                            }
                            else
                            {
                                <input type="text" class="form-control" value="@Premium.ReservingClass" disabled />
                            }
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">Year of Account <span class="text-danger">*</span></label>
                            @if (IsNew)
                            {
                                <input type="number" class="form-control" @bind="Premium.YOA" required />
                            }
                            else
                            {
                                <input type="number" class="form-control" value="@Premium.YOA" disabled />
                            }
                        </div>
                    </div>

                    <!-- Selection Fields -->
                    <div class="row mb-4 mt-5">
                        <div class="col-12">
                            <h5 class="border-bottom pb-2">Selection</h5>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Selection <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="Premium.Selection" required>
                                <option value="Plan">Plan</option>
                                <option value="Written">Written</option>
                                <option value="Signed">Signed</option>
                                <option value="Manual">Manual</option>
                            </select>
                            <small class="form-text text-muted">
                                Determines which set of values to use (Plan, Written, Signed, or Manual entry)
                            </small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Gross/Net Entry <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="Premium.GrossNetEntry" required>
                                <option value="Gross">Gross</option>
                                <option value="Net">Net</option>
                            </select>
                            <small class="form-text text-muted">
                                Specifies whether entered values represent Gross or Net premium
                            </small>
                        </div>
                    </div>

                    <!-- Comments -->
                    <div class="row mb-4 mt-5">
                        <div class="col-12">
                            <h5 class="border-bottom pb-2">Comments</h5>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label fw-bold">Update Comments</label>
                            <textarea class="form-control" rows="4" @bind="Premium.UpdateComments"
                                      placeholder="Optional comments about this update..."></textarea>
                        </div>
                    </div>

                    @if (!IsNew)
                    {
                        <!-- Audit Info (Read-only) -->
                        <div class="row mb-4 mt-5">
                            <div class="col-12">
                                <h5 class="border-bottom pb-2">Audit Information</h5>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label fw-bold">Version</label>
                                <input type="number" class="form-control" value="@Premium.Version" disabled />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Last Updated</label>
                                <input type="text" class="form-control" value="@Premium.DateUpdated.ToString("yyyy-MM-dd HH:mm")" disabled />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold">Updated By</label>
                                <input type="text" class="form-control" value="@Premium.UpdatedBy" disabled />
                            </div>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@errorMessage
                        </div>
                    }

                    <!-- Success Message -->
                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>@successMessage
                        </div>
                    }
                </div>
            }
        </div>

        <div class="modal-footer-custom">
            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                }
                <i class="bi bi-save me-2"></i>Save
            </button>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .modal-container {
        background: white;
        border-radius: 8px;
        width: calc(100vw - 80px);
        max-width: 1400px;
        height: calc(100vh - 80px);
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    }

    .modal-header-custom {
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 8px 8px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-header-custom h3 {
        margin: 0;
        font-size: 1.5rem;
    }

    .modal-body-custom {
        flex: 1;
        overflow-y: auto;
        padding: 2rem;
    }

    .modal-footer-custom {
        padding: 1.5rem 2rem;
        border-top: 1px solid #dee2e6;
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
    }
</style>

@code {
    [Parameter] public PremiumModel? Premium { get; set; }
    [Parameter] public bool IsNew { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private bool isSaving = false;
    private string? errorMessage;
    private string? successMessage;

    private async Task Save()
    {
        if (Premium == null) return;

        errorMessage = null;
        successMessage = null;

        // Validation
        if (string.IsNullOrWhiteSpace(Premium.Class))
        {
            errorMessage = "Class is required";
            return;
        }

        if (string.IsNullOrWhiteSpace(Premium.ReservingClass))
        {
            errorMessage = "Reserving Class is required";
            return;
        }

        if (Premium.YOA < 1900 || Premium.YOA > 2100)
        {
            errorMessage = "Year of Account must be between 1900 and 2100";
            return;
        }

        isSaving = true;

        try
        {
            await UltimatesService.SavePremium(Premium);
            successMessage = "Premium saved successfully!";

            await Task.Delay(1000);
            await OnSave.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving Premium");
            errorMessage = $"Error saving: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task HandleOverlayClick()
    {
        // Close modal when clicking outside
        await Close();
    }
}
