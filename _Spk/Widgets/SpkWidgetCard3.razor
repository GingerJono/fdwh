@typeparam TItem where TItem : class
@using Sandbox._Spk
@using ApexCharts
@using ApexSeries
@using CardModel 
@using WidgetData 
@inject WidgetService WidgetService

@code {
    [Parameter] public WidgetElements? MainCard { get; set; }
    [Parameter] public List<TItem>? ChartItems { get; set; }
    [Parameter] public ApexChartOptions<TItem>? ChartOptions { get; set; }
    [Parameter] public List<SeriesConfig<TItem>>? SeriesConfigs { get; set; }
}

@if(MainCard != null){
    <div class="card custom-card ">
        <div class="card-body">
            <div class=" d-flex align-items-center justify-conent-between">
                <div class="flex-fill">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="avatar avatar-rounded avatar-md bg-@MainCard?.IconClass svg-white">
                         @((MarkupString)(MainCard?.Icon ?? string.Empty))
                        </span>
                    </div>
                    <p class="flex-fill text-muted fs-14 mb-0">@MainCard?.Title</p>
                </div>
                <div id="chart-10" class="">
                    <SpkApex TItem="TItem"  ChartOptions="ChartOptions" Items="ChartItems"  Series="SeriesConfigs" />
                </div>
            </div>
            <div class="d-flex align-items-end justify-content-between">
                <div class="fs-24 fw-medium mb-0 d-flex align-items-center">@MainCard?.Value
                </div>
                <div class="text-muted fs-13 text-end ms-auto">@(MainCard?.IsIncreased == true ? "Increased By" : "Decreased By") <span class="@(MainCard?.IsIncreased == true ? "text-success" : "text-danger")">@MainCard?.Percentage<i class="@(MainCard?.IsIncreased == true ? "ti ti-arrow-narrow-up" : "ti ti-arrow-narrow-down") fs-16"></i>
                </span></div>
            </div>
        </div>
    </div>
} 