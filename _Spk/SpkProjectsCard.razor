@typeparam TItem where TItem : class
@using Sandbox._Spk
@using ApexCharts
@using ApexSeries
@using CardModel

@code {
    [Parameter] public MainCard? ProjectsMainCard { get; set; }
    [Parameter] public List<TItem>? ChartItems { get; set; }
    [Parameter] public ApexChartOptions<TItem>? ChartOptions { get; set; }
    [Parameter] public List<SeriesConfig<TItem>>? SeriesConfigs { get; set; }
}

@if(ProjectsMainCard != null){
    <div class="card custom-card overflow-hidden">
        <div class="card-body">
            <div class="mb-3 d-flex align-items-start justify-content-between">
                <span class="avatar avatar-sm bg-@ProjectsMainCard.iconclass svg-white">
                    <i class="@ProjectsMainCard.icon fs-16"></i>
                </span>
                <SpkBadge BadgeClass="@(ProjectsMainCard.IsIncreased  ? "bg-success-transparent":"bg-danger-transparent")">@ProjectsMainCard.percentage</SpkBadge>
            </div>
            <div class="d-flex align-items-end justify-content-between flex-wrap">
                <div class="flex-shrink-0">
                    <div class="text-muted mb-1">@ProjectsMainCard.title</div>
                    <h4 class="mb-0 fs-20 fw-medium">@ProjectsMainCard.price</h4>
                </div>
                <div id="Projects-2" class="flex-shrink-0 text-end ms-auto">
                    <SpkApex TItem="TItem"  ChartOptions="ChartOptions" Items="ChartItems"  Series="SeriesConfigs" />
                </div>
            </div>
        </div>
    </div>
}

