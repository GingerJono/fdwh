
@using CardModel
@code {
    [Parameter] public Poscard? Poscard { get; set; }    
}
@if(Poscard != null) {
    <div class="col-xxl-3 col-xl-4 col-md-6 card-item @Poscard.Category" data-category="@Poscard.Category">
        <div class="card custom-card p-3 @(Poscard.InStock ? "":"out-of-stock")">
            <img src="@Poscard.imgSrc" class="card-img-top" alt="...">
            <div class="card-body bg-secondary-transparent rounded-bottom">
                <div class="mb-3">
                    <a href="javascript:void(0);" class="fw-medium fs-16">@Poscard.title</a>
                    <span class="fs-12 text-muted d-block">@Poscard.item</span>
                </div>
                <div class="d-flex align-items-center gap-2 justify-content-between flex-wrap">
                    <h5 class="fw-medium mb-0">@Poscard.price</h5>
                    <div>
                        <SpkButtons ButtonClass="btn-primary" ButtonSize="btn-sm" data-bs-toggle="offcanvas" data-bs-target="#viewcart"><i class="ri-add-fill me-1"></i>Add To Cart</SpkButtons>
                    </div>
                </div>
            </div>
        </div>
    </div>
}