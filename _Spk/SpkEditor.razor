@using Blazored.TextEditor
@using System.Text
@code {
    

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}

<BlazoredTextEditor @ref="EditorRef" @attributes="AdditionalAttributes" >
    <ToolbarContent>
        @((MarkupString)(toolbar ?? string.Empty))
    </ToolbarContent>

    <EditorContent>
        @((MarkupString)(Body ?? string.Empty))
    </EditorContent>
</BlazoredTextEditor>

@code {
    [CascadingParameter] public BlazoredTextEditor? EditorRef { get; set; }
    [Parameter] public string? Body { get; set; }
    [Parameter] public bool ShowMainHeader { get; set; } = true;
    [Parameter] public bool ShowFont { get; set; } = true;
    [Parameter] public bool ShowTextFormatting { get; set; } = true;
    [Parameter] public bool ShowBlockFormatting { get; set; } = true;
    [Parameter] public bool ShowHeader { get; set; } = true;
    [Parameter] public bool ShowLists { get; set; } = true;
    [Parameter] public bool ShowScript { get; set; } = false;
    [Parameter] public bool ShowIndent { get; set; } = false;
    [Parameter] public bool ShowDirection { get; set; } = false;
    [Parameter] public bool ShowColor { get; set; } = true;
    [Parameter] public bool ShowImage { get; set; } = true;
    [Parameter] public bool ShowAlignment { get; set; } = true;
    [Parameter] public bool ShowClean { get; set; } = true;
    [Parameter] public bool Bubble { get; set; } = false;

    private string? toolbar;

    protected override void OnInitialized()
    {
        toolbar = GenerateToolbar();
    }
    private string GenerateToolbar()
    {
        StringBuilder toolbarBuilder = new StringBuilder();
        if (ShowMainHeader)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <select class='ql-header'>
                        <option value='1'></option>
                        <option value='2'></option>
                        <option value='3'></option>
                        <option value='4'></option>
                        <option value='5'></option>
                        <option value='6'></option>
                        <option selected=''></option>
                    </select>
                </span>");
        }
        if (ShowFont)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <select class='ql-font'>
                        <option selected=''></option>
                        <option value='serif'></option>
                        <option value='monospace'></option>
                    </select>
                </span>");
        }
        if (ShowTextFormatting)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-bold'></button>
                    <button class='ql-italic'></button>
                    <button class='ql-underline'></button>
                    <button class='ql-strike'></button>
                </span>");
        }
        if (ShowBlockFormatting)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-blockquote' value='blockquote'></button>
                    <button class='ql-code-block' value='code-block'></button>
                </span>");
        }
        if (ShowHeader)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-header' value='1'></button>
                    <button class='ql-header' value='2'></button>
                </span>");
        }
        if (ShowLists)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-list' value='ordered'></button>
                    <button class='ql-list' value='bullet'></button>
                </span>");
        }
        if (ShowScript)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-script' value='sub'></button>
                    <button class='ql-script' value='super'></button>
                </span>");
        }
        if (ShowIndent)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-indent' value='-1'></button>
                    <button class='ql-indent' value='+1'></button>
                </span>");
        }
        if (ShowDirection)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-direction' value='rtl'></button>
                </span>");
        }
        if (ShowColor)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-color'></button>
                    <button class='ql-background'></button>
                </span>");
        }
        if (ShowImage)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-image'></button>
                    <button class='ql-video'></button>
                </span>");
        }
        if (ShowAlignment)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <select class='ql-align'>
                        <option selected=''></option>
                        <option value='center'></option>
                        <option value='right'></option>
                        <option value='justify'></option>
                    </select>
                </span>");
        }
        if (ShowClean)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-clean'></button>
                </span>");
        }
        if (Bubble)
        {
            toolbarBuilder.Append(@"
                <span class='ql-formats'>
                    <button class='ql-bold'></button>
                    <button class='ql-italic'></button>
                    <button class='ql-link'></button>
                    <button class='ql-header' value='1'></button>
                    <button class='ql-header' value='2'></button>
                    <button class='ql-blockquote'></button>
                </span>");
        }

        return toolbarBuilder.ToString();
    }
}

