@using JobData

@code {
    [Parameter] public Candidate? Candidate { get; set; }    
}

@if(Candidate != null){
    <div class="card custom-card">
        <div class="card-body">
            <div class="float-end">
                <SpkTooltip Tag="a" TooltipClass="avatar avatar-rounded avatar-sm bg-info-transparent" TooltipPlacement="top" TooltipTitle="Download CV">
                    <span><i class="ri-download-cloud-line fs-14"></i></span>
                </SpkTooltip>
                <SpkTooltip Tag="a" TooltipClass="avatar avatar-rounded avatar-sm bg-danger-transparent" TooltipPlacement="top" TooltipTitle="Add to Wishlist">
                    <span><i class="ri-heart-line fs-14"></i></span>
                </SpkTooltip>
            </div>
            <div class="d-flex mb-3 align-items-center flex-wrap gap-2">
                <div>
                    <span class="avatar avatar-lg avatar-rounded">
                        <img src="@Candidate.Img" alt="Profile Picture">
                    </span>
                </div>    
                <div>
                    <h6 class="fw-medium mb-1 d-flex align-items-center">
                        <a href="/job-candidate-details"> @Candidate.Name 
                            <SpkTooltip Tag="span" TooltipClass="bg-transparent" TooltipTitle="Verified candidate">
                                <i class="ri-verified-badge-fill text-primary fs-14"></i>
                            </SpkTooltip>
                        </a>
                    </h6>
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="javascript:void(0);">@Candidate.JobTitle </a>
                        <p class="mb-0 fs-12 text-muted"><i class="ri-map-pin-line fs-11"></i> @Candidate.Location</p>
                    </div> 
                    <div class="d-flex align-items-center fs-12 text-muted flex-wrap">
                        <p class="fs-12 mb-0">Ratings : </p>
                        <div class="min-w-fit-content ms-2">
                            @foreach (var rating in Candidate.Ratings ?? Enumerable.Empty<Ratings>())
                            {
                                <span class="@(rating.NotRated?"text-muted ms-1":"text-warning ms-1")"><i class="@rating.Rate"></i></span>
                            }
                        </div>
                        <a href="javascript:void(0);" class="ms-1 min-w-fit-content text-muted">
                           <span>(@Candidate.RatingCount)</span>
                            <span>Ratings</span>
                        </a>
                    </div>
                </div>
            </div>
            <div class="popular-tags mb-3 d-flex gap-2 flex-wrap">
                @foreach (var badge in Candidate.JobBadge ?? Enumerable.Empty<JobBadge>())
                {
                    <SpkBadge Tag="a" BadgeClass=@($"fs-11 border border-opacity-10 border-{badge.BadgeColor} text-{badge.BadgeColor}") IsRounded="true">
                        <i class="@badge.Icon me-1"></i> @badge.Badge
                    </SpkBadge>
                }
            </div>                                        
            <div class="d-flex align-items-center flex-wrap gap-3">
                <div>
                    <p class="mb-1 flex-grow-1"><span class="text-muted">Annual Pay :</span> <span class="fw-medium"> @Candidate.AnnualPay</span> </p>
                    <p class="mb-0"><span class="text-muted"> Languages :</span> <span class="fw-medium"> @Candidate.Languages</span></p>
                </div>
                <div class="ms-auto">
                    <SpkButtons ButtonClass="btn-primary">View Profile <i class="ri-arrow-right-line"></i></SpkButtons>
                </div>
            </div>
        </div>                                
    </div>
}